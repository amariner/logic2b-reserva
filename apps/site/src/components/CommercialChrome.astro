---
import type { Locale } from '@logic-reserva/config';
import CommercialClosing from './CommercialClosing.astro';
import CommercialFooter from './CommercialFooter.astro';
import CommercialHeader from './CommercialHeader.astro';
import CommercialTour from './CommercialTour.astro';
import CookiePreferences from './CookiePreferences.astro';

interface Props { locale?: Locale; languageHref: string; closing?: boolean }

const { locale = 'es', languageHref, closing = true } = Astro.props;
---

<CommercialHeader locale={locale} languageHref={languageHref} />

<slot />

{closing && <CommercialClosing locale={locale} />}
<CommercialFooter locale={locale} languageHref={languageHref} />
<CookiePreferences locale={locale} />
<CommercialTour locale={locale} />

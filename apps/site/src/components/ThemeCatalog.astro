---
import type { Locale } from '@logic-reserva/config';
import { PRODUCT } from '@logic-reserva/config';
import { THEME_CATALOG, type ThemeCatalogEntry, type ThemeTier } from '@logic-reserva/config/themes';
import Base from '../layouts/Base.astro';
import { SITE_CONTENT } from '../content';
import BrandLockup from './BrandLockup.astro';

interface Props { locale?: Locale; path: string }

const { locale = 'es', path } = Astro.props;
const shared = SITE_CONTENT[locale];
const themes: readonly ThemeCatalogEntry[] = THEME_CATALOG;
const prefix = locale === 'en' ? '/en' : '';
const languageHref = locale === 'en' ? path : `/en${path}`;
const pageUrl = new URL(`${prefix}${path}`, PRODUCT.url).href;
const localize = (value: ThemeCatalogEntry['name']): string => value[locale];
const tierLabels: Record<ThemeTier, string> = locale === 'en'
  ? { basico: 'Basic', gestion: 'Management', inteligente: 'Intelligent' }
  : { basico: 'Básico', gestion: 'Gestión', inteligente: 'Inteligente' };
const themeHref = (theme: ThemeCatalogEntry) => theme.deepDemo ? `${prefix}/demos/${theme.deepDemo}/` : `${prefix}/demos/temas/${theme.slug}/`;
const ui = locale === 'en'
  ? { title: 'Twelve restaurant identities. One operating idea.', intro: 'Explore twelve fictional directions on the Logic Reserva foundation: three with deep product journeys and nine visual web previews ready for a project.', search: 'Search by name, format or tone', searchPlaceholder: 'Try “terrace”, “bar” or “seasonal”', filter: 'Filter by level', all: 'All levels', count: 'directions', open: 'Open direction', back: 'Back to Logic Reserva', demo: 'Web preview', footer: 'Twelve identities · three deep product journeys · fictional data' }
  : { title: 'Doce identidades de restaurante. Una misma forma de operar.', intro: 'Explora doce direcciones ficticias sobre la base de Logic Reserva: tres con recorrido de producto y nueve previews web listas para un proyecto.', search: 'Busca por nombre, formato o tono', searchPlaceholder: 'Prueba «terraza», «bar» o «temporada»', filter: 'Filtra por nivel', all: 'Todos los niveles', count: 'direcciones', open: 'Abrir dirección', back: 'Volver a Logic Reserva', demo: 'Preview web', footer: 'Doce identidades · tres recorridos profundos · datos ficticios' };
const pageTitle = locale === 'en' ? 'Twelve restaurant identities | Logic Reserva' : 'Doce identidades de restaurante | Logic Reserva';
const structuredData: Array<Record<string, unknown>> = [
  { '@context': 'https://schema.org', '@type': 'CollectionPage', name: ui.title, description: ui.intro, url: pageUrl, isPartOf: { '@id': `${PRODUCT.url}/#website` } },
  { '@context': 'https://schema.org', '@type': 'ItemList', numberOfItems: themes.length, itemListElement: themes.map((theme, index) => ({ '@type': 'ListItem', position: index + 1, name: localize(theme.name), url: new URL(themeHref(theme), PRODUCT.url).href })) },
];
---

<Base locale={locale} title={pageTitle} description={ui.intro} structuredData={structuredData}>
  <header class="themes-nav">
    <div class="shell">
      <BrandLockup locale={locale} homeHref={`${prefix}/`} />
      <div><a class="themes-language" href={languageHref} lang={locale === 'en' ? 'es' : 'en'}>{shared.nav.language}</a><a class="pill themes-contact" href={`${prefix}/#contacto`}>{shared.nav.contact}</a></div>
    </div>
  </header>
  <main id="contenido" class="themes-main shell" tabindex="-1">
    <a class="themes-back" href={`${prefix}/`}><span aria-hidden="true">←</span> {ui.back}</a>
    <header class="themes-intro"><p class="eyebrow">{shared.nav.demos}</p><h1 class="display">{ui.title}</h1><p>{ui.intro}</p></header>
    <div class="themes-toolbar" role="search" aria-label={ui.search}>
      <label>{ui.search}<input type="search" data-theme-search placeholder={ui.searchPlaceholder} /></label>
      <label>{ui.filter}<select data-theme-filter><option value="all">{ui.all}</option><option value="basico">{tierLabels.basico}</option><option value="gestion">{tierLabels.gestion}</option><option value="inteligente">{tierLabels.inteligente}</option></select></label>
      <p data-theme-count aria-live="polite">{THEME_CATALOG.length} {ui.count}</p>
    </div>
    <div class="theme-grid" data-theme-grid>
      {themes.map((theme) => (
        <article id={`theme-${theme.slug}`} class="theme-card" data-theme-card data-theme-level={theme.level} data-theme-searchable={`${theme.name.es} ${theme.name.en} ${theme.format.es} ${theme.format.en} ${theme.tone.es} ${theme.tone.en}`}>
          <a href={themeHref(theme)} aria-label={`${ui.open}: ${localize(theme.name)}`}>
            <div class="theme-card__visual" style={`--theme-accent: ${theme.accent}; --theme-surface: ${theme.surface};`}><span class="theme-card__mark" aria-hidden="true">{theme.mark}</span><span class="theme-card__format">{localize(theme.format)}</span><i aria-hidden="true"></i></div>
            <div class="theme-card__copy"><div class="theme-card__meta"><span>{tierLabels[theme.level]}</span>{theme.deepDemo && <strong>{ui.demo}</strong>}</div><h2>{localize(theme.name)}</h2><p>{localize(theme.promise)}</p><small>{localize(theme.tone)}</small></div>
          </a>
        </article>
      ))}
    </div>
    <p class="themes-empty" data-theme-empty hidden>{locale === 'en' ? 'No direction matches that search.' : 'Ninguna dirección coincide con esa búsqueda.'}</p>
  </main>
  <footer class="themes-footer"><div class="shell"><span>{ui.footer}</span><nav><a href={`${prefix}/planes/`}>{shared.footer.plans}</a><a href={`${prefix}/legal/`}>{shared.footer.legal}</a><a href={`${prefix}/privacidad/`}>{shared.footer.privacy}</a></nav></div></footer>
</Base>

<script>
  const themeSearch = document.querySelector<HTMLInputElement>('[data-theme-search]');
  const themeFilter = document.querySelector<HTMLSelectElement>('[data-theme-filter]');
  const themeCards = Array.from(document.querySelectorAll<HTMLElement>('[data-theme-card]'));
  const themeCount = document.querySelector<HTMLElement>('[data-theme-count]');
  const themeEmpty = document.querySelector<HTMLElement>('[data-theme-empty]');
  const updateThemes = () => {
    const query = (themeSearch?.value ?? '').trim().toLocaleLowerCase();
    const level = themeFilter?.value ?? 'all';
    let visible = 0;
    themeCards.forEach((card) => {
      const matchesQuery = !query || (card.dataset.themeSearchable ?? '').toLocaleLowerCase().includes(query);
      const matchesLevel = level === 'all' || card.dataset.themeLevel === level;
      const matches = matchesQuery && matchesLevel;
      card.hidden = !matches;
      if (matches) visible += 1;
    });
    if (themeCount) themeCount.textContent = `${visible} ${themeCount.textContent?.replace(/^\d+\s*/, '') ?? ''}`;
    if (themeEmpty) themeEmpty.hidden = visible !== 0;
  };
  themeSearch?.addEventListener('input', updateThemes);
  themeFilter?.addEventListener('change', updateThemes);
</script>

<style>
  .themes-nav { position: sticky; z-index: 50; top: 0; height: 72px; border-bottom: 1px solid var(--line); background: rgb(255 254 252 / 92%); box-shadow: var(--shadow-nav); backdrop-filter: blur(14px); }
  .themes-nav .shell, .themes-footer .shell { display: flex; height: 100%; align-items: center; justify-content: space-between; gap: 20px; }
  .themes-nav > .shell > div { display: flex; align-items: center; gap: 12px; }
  .themes-language { display: inline-flex; min-width: 44px; min-height: 44px; align-items: center; justify-content: center; color: var(--slate); font-size: .84rem; text-decoration: none; }
  .themes-contact { min-height: 44px; }
  .themes-main { padding-block: clamp(48px, 8vw, 104px) clamp(76px, 10vw, 140px); }
  .themes-back { display: inline-flex; min-height: 44px; align-items: center; gap: 8px; margin-bottom: clamp(52px, 8vw, 94px); color: var(--slate); font-size: .84rem; text-decoration: none; }
  .themes-intro { max-width: 940px; }
  .themes-intro h1 { max-width: 880px; }
  .themes-intro > p:last-child { max-width: 68ch; margin: 26px 0 0; color: var(--slate); font-family: var(--serif); font-size: clamp(1.12rem, 1.8vw, 1.4rem); line-height: 1.58; }
  .themes-toolbar { display: grid; grid-template-columns: 1.35fr .65fr auto; align-items: end; gap: 16px; margin-top: clamp(58px, 8vw, 96px); padding-block: 18px; border-top: 1px solid var(--line); border-bottom: 1px solid var(--line); }
  .themes-toolbar label { display: grid; gap: 8px; color: var(--slate); font-size: .72rem; font-weight: 700; }
  .themes-toolbar input, .themes-toolbar select { min-height: 46px; border: 1px solid var(--line); border-radius: 8px; padding: 10px 12px; color: var(--ink); background: white; font: inherit; }
  .themes-toolbar p { margin: 0 0 12px; color: var(--slate); font-size: .76rem; white-space: nowrap; }
  .theme-grid { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 12px; margin-top: 28px; }
  .theme-card { min-width: 0; overflow: hidden; border: 1px solid var(--line); border-radius: 12px; background: white; transition: transform 180ms ease, box-shadow 180ms ease; }
  .theme-card[hidden] { display: none; }
  .theme-card:hover { box-shadow: var(--shadow-artifact); transform: translateY(-2px); }
  .theme-card > a { display: block; height: 100%; color: inherit; text-decoration: none; }
  .theme-card__visual { position: relative; display: flex; min-height: 220px; align-items: flex-end; justify-content: space-between; overflow: hidden; padding: 20px; color: var(--theme-accent); background: var(--theme-surface); }
  .theme-card__visual::before, .theme-card__visual::after { position: absolute; border: 1px solid color-mix(in srgb, var(--theme-accent) 35%, transparent); border-radius: 50%; content: ''; }
  .theme-card__visual::before { width: 250px; height: 250px; top: -100px; right: -60px; }
  .theme-card__visual::after { width: 160px; height: 160px; right: 35px; bottom: -82px; }
  .theme-card__visual i { position: absolute; top: 26px; left: 24px; width: 62%; height: 1px; background: color-mix(in srgb, var(--theme-accent) 42%, transparent); transform: rotate(-7deg); }
  .theme-card__mark { position: relative; z-index: 1; display: grid; width: 64px; height: 64px; place-items: center; border: 2px solid currentColor; border-radius: 50%; font-family: var(--serif); font-size: 1.6rem; font-weight: 700; }
  .theme-card__format { position: relative; z-index: 1; max-width: 14ch; color: color-mix(in srgb, var(--theme-accent) 88%, var(--ink)); font-size: .7rem; font-weight: 750; text-align: right; }
  .theme-card__copy { padding: 18px 18px 20px; }
  .theme-card__meta { display: flex; align-items: center; justify-content: space-between; gap: 10px; color: var(--slate); font-size: .66rem; font-weight: 750; letter-spacing: .07em; text-transform: uppercase; }
  .theme-card__meta strong { color: var(--color-notion-blue-strong); font-size: .6rem; letter-spacing: 0; text-transform: none; }
  .theme-card h2 { margin: 22px 0 7px; font-size: clamp(1.25rem, 2vw, 1.65rem); letter-spacing: -.04em; }
  .theme-card p { min-height: 44px; margin: 0; color: var(--slate); font-family: var(--serif); font-size: .92rem; line-height: 1.42; }
  .theme-card small { display: block; margin-top: 16px; color: var(--slate); font-size: .7rem; }
  .themes-empty { margin: 28px 0 0; color: var(--slate); font-family: var(--serif); }
  .themes-footer { min-height: 92px; border-top: 1px solid var(--line); color: var(--slate); background: white; font-size: .76rem; }
  .themes-footer nav { display: flex; flex-wrap: wrap; gap: 14px 20px; }
  .themes-footer a { display: inline-flex; min-width: 44px; min-height: 44px; align-items: center; text-decoration: none; }
  @media (max-width: 820px) { .theme-grid { grid-template-columns: repeat(2, minmax(0, 1fr)); }.themes-toolbar { grid-template-columns: 1fr 1fr; }.themes-toolbar p { grid-column: 1 / -1; margin: 0; } }
  @media (max-width: 560px) { .themes-contact { display: none; }.themes-nav .shell { width: min(100% - 24px, var(--page-max-width)); }.themes-main { padding-top: 38px; }.themes-toolbar, .theme-grid { grid-template-columns: 1fr; }.themes-toolbar { gap: 12px; }.themes-toolbar p { grid-column: auto; }.theme-card__visual { min-height: 190px; } }
  @media (prefers-reduced-motion: reduce) { .theme-card { transition: none; }.theme-card:hover { transform: none; } }
</style>

---
import type { Locale } from '@logic-reserva/config';
import ThemesPage from './ThemesPage.astro';

/**
 * Compatibility adapter for the catalogue component used before the Camp
 * parity merge. The canonical implementation now lives in ThemesPage.
 */
interface Props { locale?: Locale; path: string }

const { locale = 'es' } = Astro.props;
---

<ThemesPage locale={locale} />

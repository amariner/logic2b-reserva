---
import { PRODUCT, type Locale } from '@logic-reserva/config';
import {
  THEME_CATALOG,
  getTheme,
  localizedThemeText,
  themeContactUrl,
  themeDetailUrl,
  themeMetaDescription,
  themeUrl,
  type ThemeSlug,
  type ThemeText,
} from '@logic-reserva/config/themes';
import Base from '../layouts/Base.astro';
import CommercialChrome from './CommercialChrome.astro';

interface Props { locale?: Locale; slug: ThemeSlug }

const { locale = 'es', slug } = Astro.props;
const theme = getTheme(slug);
if (!theme) throw new Error(`Unknown public theme: ${slug}`);
const local = (value: ThemeText) => localizedThemeText(value, locale);
const prefix = locale === 'en' ? '/en' : '';
const index = THEME_CATALOG.findIndex((entry) => entry.slug === slug);
const related = [1, 2, 3].map((offset) => THEME_CATALOG[(index + offset) % THEME_CATALOG.length]);
const metadata = themeMetaDescription(theme);
const ui = locale === 'en' ? {
  titleSuffix: ' | Restaurant website by Logic Reserva', back: 'All website directions', product: 'Restaurant website direction',
  fictional: 'Fictional navigable demonstration', responsive: 'Responsive', address: `${theme.slug}.yourdomain.com`,
  summary: `A complete website direction for presenting ${theme.name} as a ${local(theme.format).toLocaleLowerCase()}, turning visits into better prepared enquiries without losing its identity.`,
  open: 'Open navigable website', want: 'I want a website like this', frameTitle: `Navigable preview of the fictional ${theme.name} website`,
  demoLabel: 'Navigable demo', fit: 'Why this direction works', fitTitle: 'An identity shaped to sell and operate.',
  fitBody: 'This is not a closed template. The useful structure, performance and conversion logic stay shared while photography, voice, rhythm, offer and calls to action adapt to the real restaurant.',
  capabilities: [
    'Visual direction applied to the homepage, menu, story and contact',
    'Hierarchy prepared for mobile, desktop and accessible reading',
    'Enquiry or booking shaped around the restaurant format',
    'One shared product base, configured without duplicating the project',
  ],
  details: 'Website details', level: 'Starting point', status: 'Status', scope: 'Demonstrated scope', delivery: 'Delivery',
  deliveryValue: 'Defined in an approved proposal', deep: 'Website, booking and management journey', webOnly: 'Responsive website direction; no booking engine or manager',
  included: 'Includes', tone: 'Visual tone', format: 'Restaurant format', location: 'Fictional location', related: 'Related website directions', all: 'View all twelve websites',
} : {
  titleSuffix: ' | Web para restaurantes · Logic Reserva', back: 'Todas las direcciones web', product: 'Dirección web para restaurantes',
  fictional: 'Demostración ficticia navegable', responsive: 'Responsive', address: `${theme.slug}.tudominio.com`,
  summary: `Una dirección web completa para presentar ${theme.name} como ${local(theme.format).toLocaleLowerCase()}, convertir visitas en solicitudes mejor preparadas y conservar su identidad.`,
  open: 'Abrir web navegable', want: 'Quiero una web así', frameTitle: `Vista navegable de la web ficticia ${theme.name}`,
  demoLabel: 'Demo navegable', fit: 'Qué resuelve esta dirección', fitTitle: 'Una identidad pensada para vender y operar.',
  fitBody: 'No es una plantilla cerrada. La estructura, el rendimiento y la lógica de conversión se comparten; fotografía, voz, ritmo, oferta y llamadas a la acción se adaptan al restaurante real.',
  capabilities: [
    'Dirección visual aplicada a portada, carta, historia y contacto',
    'Jerarquía preparada para móvil, escritorio y lectura accesible',
    'Solicitud o reserva adaptada al formato del restaurante',
    'Una misma base de producto, configurada sin duplicar el proyecto',
  ],
  details: 'Detalles de la web', level: 'Punto de partida', status: 'Estado', scope: 'Alcance demostrado', delivery: 'Entrega',
  deliveryValue: 'Definida en propuesta aprobada', deep: 'Web, reserva y recorrido de gestión', webOnly: 'Dirección web responsive; sin motor de reservas ni gestor',
  included: 'Incluye', tone: 'Tono visual', format: 'Formato de restaurante', location: 'Ubicación ficticia', related: 'Direcciones web relacionadas', all: 'Ver las doce webs',
};
const scope = theme.depth === 'deep' ? ui.deep : ui.webOnly;
const currentUrl = new URL(themeDetailUrl(theme.slug as ThemeSlug, locale), PRODUCT.url).href;
const structuredData = [{
  '@context': 'https://schema.org', '@type': 'WebPage', name: theme.name, description: local(metadata), url: currentUrl,
  inLanguage: locale, isPartOf: { '@id': `${PRODUCT.url}/#website` },
  about: { '@type': 'CreativeWork', name: `${theme.name} · ${local(theme.format)}`, description: ui.summary },
}, {
  '@context': 'https://schema.org', '@type': 'BreadcrumbList', itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Logic Reserva', item: `${PRODUCT.url}${prefix}/` },
    { '@type': 'ListItem', position: 2, name: locale === 'en' ? 'Website directions' : 'Direcciones web', item: `${PRODUCT.url}${prefix}/temas/` },
    { '@type': 'ListItem', position: 3, name: theme.name, item: currentUrl },
  ],
}];
const themeStyle = `--theme-primary:${theme.palette.primary};--theme-accent:${theme.palette.accent};--theme-paper:${theme.palette.paper};--theme-ink:${theme.palette.ink};--theme-muted:${theme.palette.muted};`;
---

<Base
  locale={locale}
  title={`${theme.name}${ui.titleSuffix}`}
  description={local(metadata)}
  image={`/images/screens/${theme.screenshotBase}-desktop.png`}
  imageAlt={`${theme.name} · ${local(theme.format)}`}
  imageWidth={1366}
  imageHeight={900}
  structuredData={structuredData}
>
  <CommercialChrome locale={locale} languageHref={themeDetailUrl(theme.slug as ThemeSlug, locale === 'en' ? 'es' : 'en')}>
    <main id="contenido" class="theme-detail" tabindex="-1" style={themeStyle}>
      <article>
        <header class="shell theme-detail__hero">
          <a class="back" href={`${prefix}/temas/`}><span aria-hidden="true">←</span>{ui.back}</a>
          <div class="theme-detail__heading">
            <div>
              <p class="eyebrow">{ui.product}</p>
              <h1>{theme.name}</h1>
            </div>
            <div class="theme-detail__intro">
              <p>{ui.summary}</p>
              <ul aria-label={ui.included}>
                <li>{local(theme.level)}</li><li>{local(theme.tone)}</li><li>{ui.responsive}</li>
              </ul>
            </div>
          </div>
        </header>

        <section class="shell theme-detail__browser" aria-label={ui.frameTitle}>
          <div class="browser-bar"><span aria-hidden="true"><i></i><i></i><i></i></span><code>{ui.address}</code><b>{ui.fictional}</b></div>
          <div class="browser-view">
            <picture>
              <source media="(max-width: 640px)" srcset={`/images/screens/${theme.screenshotBase}-mobile.png`} />
              <img src={`/images/screens/${theme.screenshotBase}-desktop.png`} alt={ui.frameTitle} width="1366" height="900" loading="eager" decoding="async" />
            </picture>
          </div>
        </section>

        <section class="shell theme-detail__decision" aria-labelledby="theme-demo-title">
          <div>
            <p class="eyebrow">{ui.demoLabel}</p>
            <h2 id="theme-demo-title">{theme.name}</h2>
            <p>{local(theme.promise)} {scope}.</p>
          </div>
          <ul>{ui.capabilities.map((capability) => <li><span aria-hidden="true">✓</span>{capability}</li>)}</ul>
          <div class="theme-detail__actions">
            <a class="theme-detail__open" href={themeUrl(theme.slug as ThemeSlug, locale)}>{ui.open}<span aria-hidden="true">↗</span></a>
            <a class="theme-detail__contact" href={themeContactUrl(theme.slug as ThemeSlug, locale)}>{ui.want}<span aria-hidden="true">→</span></a>
          </div>
        </section>

        <section class="theme-detail__fit" aria-labelledby="theme-fit-title">
          <div class="shell theme-detail__fit-grid">
            <div><p class="eyebrow">{ui.fit}</p><h2 id="theme-fit-title">{ui.fitTitle}</h2><p>{ui.fitBody}</p></div>
            <ol>{ui.capabilities.map((capability, capabilityIndex) => <li><span>0{capabilityIndex + 1}</span><p>{capability}</p></li>)}</ol>
          </div>
        </section>

        <section class="shell theme-detail__facts" aria-labelledby="theme-details-title">
          <div class="theme-detail__fact-card">
            <h2 id="theme-details-title">{ui.details}</h2>
            <dl>
              <div><dt>{ui.level}</dt><dd>{local(theme.level)}</dd></div>
              <div><dt>{ui.status}</dt><dd>{ui.fictional}</dd></div>
              <div><dt>{ui.scope}</dt><dd>{scope}</dd></div>
              <div><dt>{ui.delivery}</dt><dd>{ui.deliveryValue}</dd></div>
            </dl>
          </div>
          <div class="theme-detail__included">
            <h2>{ui.included}</h2>
            <dl>
              <div><dt>{ui.format}</dt><dd>{local(theme.format)}</dd></div>
              <div><dt>{ui.tone}</dt><dd>{local(theme.tone)}</dd></div>
              <div><dt>{ui.location}</dt><dd>{local(theme.location)}</dd></div>
            </dl>
            <a href={themeContactUrl(theme.slug as ThemeSlug, locale)}>{ui.want}<span aria-hidden="true">→</span></a>
          </div>
        </section>

        <section class="shell theme-detail__related" aria-labelledby="related-title">
          <div><h2 id="related-title">{ui.related}</h2><a href={`${prefix}/temas/`}>{ui.all}<span aria-hidden="true">→</span></a></div>
          <div class="related-grid">
            {related.map((entry) => (
              <a href={themeDetailUrl(entry.slug as ThemeSlug, locale)} style={`--related-paper:${entry.palette.paper};--related-ink:${entry.palette.ink};--related-accent:${entry.palette.accent}`}>
                <span>{localizedThemeText(entry.format, locale)}</span><strong>{entry.name}</strong><small>{localizedThemeText(entry.tone, locale)}</small><i aria-hidden="true">↗</i>
              </a>
            ))}
          </div>
        </section>
      </article>
    </main>
  </CommercialChrome>
</Base>

<style>
  .theme-detail { color: var(--ink); background: var(--paper); }.back { display: inline-flex; min-height: 44px; align-items: center; gap: 8px; color: var(--slate); font-size: .82rem; text-decoration: none; }
  .theme-detail__hero { padding-top: 28px; }.theme-detail__heading { display: grid; grid-template-columns: minmax(0, 1.35fr) minmax(300px, .65fr); gap: clamp(44px, 8vw, 130px); align-items: end; padding: clamp(38px, 6vw, 78px) 0 34px; }
  .theme-detail h1 { margin: 0; font-size: clamp(4.6rem, 10vw, 9rem); font-weight: 620; letter-spacing: -.075em; line-height: .82; }.theme-detail__intro > p { margin: 0; color: var(--slate); font-family: var(--serif); font-size: clamp(1.1rem, 1.5vw, 1.28rem); line-height: 1.55; }
  .theme-detail__intro ul { display: flex; flex-wrap: wrap; gap: 8px; margin: 24px 0 0; padding: 0; list-style: none; }.theme-detail__intro li { border: 1px solid color-mix(in srgb, var(--theme-primary) 25%, transparent); border-radius: 999px; padding: 7px 11px; color: var(--theme-primary); background: color-mix(in srgb, var(--theme-paper) 76%, white); font-size: .72rem; font-weight: 700; }
  .theme-detail__browser { margin-bottom: 0; }.browser-bar { display: grid; grid-template-columns: 72px 1fr auto; gap: 18px; align-items: center; min-height: 52px; border: 1px solid rgb(0 0 0 / 14%); border-bottom: 0; border-radius: 14px 14px 0 0; padding: 8px 16px; color: var(--slate); background: #f2f2f1; }.browser-bar > span { display: flex; gap: 7px; }.browser-bar i { width: 10px; height: 10px; border-radius: 50%; background: #cbc9c5; }.browser-bar code { justify-self: center; min-width: min(520px, 70%); border: 1px solid rgb(0 0 0 / 10%); border-radius: 6px; padding: 7px 14px; color: var(--theme-ink); background: white; font-family: inherit; font-size: .75rem; text-align: center; }.browser-bar b { font-size: .64rem; font-weight: 650; letter-spacing: .035em; text-transform: uppercase; }
  .browser-view { position: relative; aspect-ratio: 1366 / 900; overflow: hidden; border: 1px solid rgb(0 0 0 / 14%); background: var(--theme-paper); }.browser-view picture, .browser-view img { display: block; width: 100%; height: 100%; }.browser-view img { object-fit: cover; object-position: top; }
  .theme-detail__decision { display: grid; grid-template-columns: minmax(0, .8fr) minmax(320px, 1fr) minmax(220px, .55fr); gap: clamp(28px, 5vw, 72px); padding-block: clamp(55px, 8vw, 100px); }.theme-detail__decision h2, .theme-detail__fit h2 { margin: 8px 0 18px; font-size: clamp(2.5rem, 4.7vw, 5rem); letter-spacing: -.06em; line-height: .92; }.theme-detail__decision p { margin: 0; color: var(--slate); line-height: 1.55; }.theme-detail__decision ul { display: grid; gap: 14px; align-content: start; margin: 0; padding: 0; list-style: none; }.theme-detail__decision li { display: grid; grid-template-columns: 22px 1fr; gap: 10px; font-size: .92rem; line-height: 1.4; }.theme-detail__decision li span { color: var(--theme-primary); font-weight: 800; }
  .theme-detail__actions { display: grid; gap: 10px; align-content: start; }.theme-detail__actions a, .theme-detail__included > a { display: flex; min-height: 50px; align-items: center; justify-content: space-between; gap: 12px; border-radius: 7px; padding: 10px 14px; font-size: .78rem; font-weight: 750; text-decoration: none; }.theme-detail__open { color: white; background: var(--theme-primary); }.theme-detail__contact { border: 1px solid rgb(0 0 0 / 15%); color: var(--ink); background: white; }
  .theme-detail__fit { color: white; background: #111; }.theme-detail__fit-grid { display: grid; grid-template-columns: minmax(0, .85fr) minmax(380px, 1.15fr); gap: clamp(48px, 10vw, 150px); padding-block: clamp(74px, 10vw, 140px); }.theme-detail__fit .eyebrow { color: var(--theme-accent); }.theme-detail__fit-grid > div > p:last-child { max-width: 58ch; margin: 0; color: #c6c6c6; font-family: var(--serif); font-size: 1.08rem; line-height: 1.6; }.theme-detail__fit ol { display: grid; gap: 0; margin: 0; padding: 0; list-style: none; }.theme-detail__fit li { display: grid; grid-template-columns: 54px 1fr; gap: 18px; border-top: 1px solid #383838; padding: 20px 0; }.theme-detail__fit li:last-child { border-bottom: 1px solid #383838; }.theme-detail__fit li span { color: var(--theme-accent); font-size: .72rem; }.theme-detail__fit li p { margin: 0; line-height: 1.45; }
  .theme-detail__facts { display: grid; grid-template-columns: 1fr 1fr; gap: 1px; padding-block: clamp(70px, 9vw, 130px); background: var(--line); }.theme-detail__facts > div { padding: clamp(30px, 5vw, 64px); background: white; }.theme-detail__facts h2 { margin: 0 0 34px; font-size: clamp(1.7rem, 3vw, 2.8rem); letter-spacing: -.045em; }.theme-detail__facts dl { margin: 0; }.theme-detail__facts dl div { display: grid; grid-template-columns: 150px 1fr; gap: 20px; border-top: 1px solid var(--line); padding: 14px 0; }.theme-detail__facts dt { color: var(--slate); font-size: .72rem; }.theme-detail__facts dd { margin: 0; font-size: .87rem; line-height: 1.4; }.theme-detail__included > a { margin-top: 24px; color: white; background: var(--theme-primary); }
  .theme-detail__related { padding-bottom: clamp(90px, 10vw, 150px); }.theme-detail__related > div:first-child { display: flex; align-items: end; justify-content: space-between; gap: 24px; margin-bottom: 28px; }.theme-detail__related h2 { margin: 0; font-size: clamp(2.1rem, 4vw, 4.2rem); letter-spacing: -.055em; }.theme-detail__related > div:first-child a { display: inline-flex; min-height: 44px; align-items: center; gap: 8px; color: var(--ink); font-size: .82rem; text-decoration: none; }.related-grid { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 12px; }.related-grid a { position: relative; display: flex; min-height: 220px; flex-direction: column; justify-content: end; overflow: hidden; padding: 24px; color: var(--related-ink); background: var(--related-paper); text-decoration: none; }.related-grid a::before { position: absolute; inset: 0 0 auto; height: 8px; background: var(--related-accent); content: ''; }.related-grid span, .related-grid small { font-size: .68rem; text-transform: uppercase; }.related-grid strong { margin: 18px 0 8px; font-size: clamp(2rem, 4vw, 3.6rem); letter-spacing: -.06em; line-height: .9; }.related-grid i { position: absolute; top: 24px; right: 24px; font-style: normal; }
  @media (max-width: 960px) { .theme-detail__heading, .theme-detail__decision, .theme-detail__fit-grid { grid-template-columns: 1fr; }.theme-detail__heading { gap: 30px; }.theme-detail__decision { gap: 32px; }.theme-detail__actions { grid-template-columns: 1fr 1fr; }.theme-detail__facts { grid-template-columns: 1fr; }.related-grid { grid-template-columns: 1fr 1fr; }.related-grid a:last-child { grid-column: 1 / -1; }.browser-bar { grid-template-columns: 50px 1fr; }.browser-bar b { display: none; }.browser-bar code { min-width: 0; width: 100%; } }
  @media (max-width: 620px) { .theme-detail__hero { padding-top: 16px; }.theme-detail__heading { padding-top: 30px; }.theme-detail h1 { font-size: clamp(4rem, 21vw, 6rem); }.browser-bar { gap: 8px; padding-inline: 10px; }.browser-bar code { overflow: hidden; padding-inline: 8px; text-overflow: ellipsis; white-space: nowrap; }.browser-view { aspect-ratio: 375 / 812; }.theme-detail__decision { padding-block: 52px; }.theme-detail__actions { grid-template-columns: 1fr; }.theme-detail__fit-grid { padding-block: 70px; }.theme-detail__facts dl div { grid-template-columns: 1fr; gap: 5px; }.theme-detail__facts { margin-inline: 14px; padding-block: 54px; }.theme-detail__related > div:first-child { align-items: start; flex-direction: column; }.related-grid { grid-template-columns: 1fr; }.related-grid a:last-child { grid-column: auto; }.related-grid a { min-height: 180px; } }
</style>

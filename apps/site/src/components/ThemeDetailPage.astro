---
import { PRODUCT, type Locale } from '@logic-reserva/config';
import {
  THEME_CATALOG,
  getTheme,
  localizedThemeText,
  themeContactUrl,
  themeDetailUrl,
  themeDemoScope,
  themeMetaDescription,
  themePreviewBase,
  themeUrl,
  type ThemeLayout,
  type ThemeSlug,
  type ThemeText,
  type ThemeType,
} from '@logic-reserva/config/themes';
import Base from '../layouts/Base.astro';
import CommercialChrome from './CommercialChrome.astro';

interface Props { locale?: Locale; slug: ThemeSlug }

const { locale = 'es', slug } = Astro.props;
const theme = getTheme(slug);
if (!theme) throw new Error(`Unknown public theme: ${slug}`);
const local = (value: ThemeText) => localizedThemeText(value, locale);
const prefix = locale === 'en' ? '/en' : '';
const index = THEME_CATALOG.findIndex((entry) => entry.slug === slug);
const related = [1, 2, 3].map((offset) => THEME_CATALOG[(index + offset) % THEME_CATALOG.length]!);
const metadata = themeMetaDescription(theme);
const pad = (value: number) => String(value).padStart(2, '0');
const previewBase = themePreviewBase(theme.slug as ThemeSlug, locale);

const layoutNames: Record<ThemeLayout, ThemeText> = {
  editorial: { es: 'Editorial', en: 'Editorial' },
  split: { es: 'Dividida', en: 'Split' },
  poster: { es: 'Cartel', en: 'Poster' },
  panorama: { es: 'Panorámica', en: 'Panoramic' },
  minimal: { es: 'Mínima', en: 'Minimal' },
  modular: { es: 'Modular', en: 'Modular' },
  market: { es: 'Mercado', en: 'Market' },
};
const layoutHints: Record<ThemeLayout, ThemeText> = {
  editorial: { es: 'Titular y texto a la izquierda, fotografía protagonista a la derecha.', en: 'Headline and copy on the left, hero photography on the right.' },
  split: { es: 'Pantalla partida: el mensaje y la imagen pesan lo mismo.', en: 'Split screen: message and image carry equal weight.' },
  poster: { es: 'Titular a toda anchura, gráfico y directo como un cartel.', en: 'Full-width headline, graphic and direct like a poster.' },
  panorama: { es: 'Imagen panorámica a sangre con el mensaje encima.', en: 'Full-bleed panoramic image with the message on top.' },
  minimal: { es: 'Mucho aire, un titular contenido y detalles precisos.', en: 'Generous space, a restrained headline and precise details.' },
  modular: { es: 'Módulos repetibles para varias casas o propuestas.', en: 'Repeatable modules for several venues or offers.' },
  market: { es: 'Rejilla de puestos o cocinas, como un plano del lugar.', en: 'A grid of stalls or kitchens, like a map of the place.' },
};
const typeNames: Record<ThemeType, ThemeText> = {
  serif: { es: 'Serif editorial', en: 'Editorial serif' },
  sans: { es: 'Sans humanista', en: 'Humanist sans' },
  condensed: { es: 'Display condensada', en: 'Condensed display' },
  mixed: { es: 'Mixta · serif + sans', en: 'Mixed · serif + sans' },
};

type Block = { x: number; y: number; w: number; h: number; kind: 'title' | 'text' | 'img' | 'cta' | 'shape' | 'line' | 'light' };
const header: Block[] = [{ x: 4, y: 4, w: 13, h: 3.4, kind: 'title' }, { x: 83, y: 3.4, w: 13, h: 4.6, kind: 'cta' }];
const wireframes: Record<ThemeLayout, Block[]> = {
  editorial: [{ x: 4, y: 17, w: 40, h: 10, kind: 'title' }, { x: 4, y: 31, w: 34, h: 3, kind: 'text' }, { x: 4, y: 36, w: 28, h: 3, kind: 'text' }, { x: 4, y: 45, w: 14, h: 5, kind: 'cta' }, { x: 52, y: 14, w: 44, h: 42, kind: 'img' }],
  split: [{ x: 4, y: 20, w: 38, h: 10, kind: 'title' }, { x: 4, y: 34, w: 34, h: 3, kind: 'text' }, { x: 4, y: 39, w: 26, h: 3, kind: 'text' }, { x: 4, y: 47, w: 14, h: 5, kind: 'cta' }, { x: 50, y: 11, w: 50, h: 51, kind: 'img' }],
  poster: [{ x: 4, y: 14, w: 92, h: 17, kind: 'title' }, { x: 4, y: 36, w: 54, h: 20, kind: 'img' }, { x: 66, y: 33, w: 25, h: 25, kind: 'shape' }, { x: 4, y: 58.5, w: 14, h: 0.8, kind: 'line' }],
  panorama: [{ x: 0, y: 11, w: 100, h: 51, kind: 'img' }, { x: 26, y: 25, w: 48, h: 10, kind: 'light' }, { x: 34, y: 38, w: 32, h: 3, kind: 'light' }, { x: 43, y: 45, w: 14, h: 5, kind: 'cta' }],
  minimal: [{ x: 31, y: 18, w: 38, h: 6, kind: 'title' }, { x: 46, y: 28, w: 8, h: 0.8, kind: 'line' }, { x: 33, y: 32, w: 34, h: 3, kind: 'text' }, { x: 40, y: 40, w: 20, h: 16, kind: 'img' }],
  modular: [{ x: 4, y: 15, w: 40, h: 7, kind: 'title' }, { x: 4, y: 27, w: 29, h: 30, kind: 'img' }, { x: 35.5, y: 27, w: 29, h: 30, kind: 'img' }, { x: 67, y: 27, w: 29, h: 30, kind: 'img' }],
  market: [{ x: 4, y: 15, w: 34, h: 7, kind: 'title' }, ...[0, 1, 2, 3].flatMap((column) => [0, 1].map((row) => ({ x: 4 + column * 23.3, y: 27 + row * 16, w: 21, h: 14, kind: (column + row) % 2 ? 'text' : 'img' } as Block)))],
};
const wireframe = [...header, ...wireframes[theme.layout]];

const planCell = { es: ['Básico', 'Básico', 'Gestión', 'Gestión', 'Inteligente'], en: ['Basic', 'Basic', 'Management', 'Management', 'Intelligent'] }[locale];
const scopeRows = locale === 'en'
  ? ['Responsive website with menu and story', 'Table enquiry by form', 'Booking with 15-minute availability', 'Floor manager, waitlist and groups', 'Events, deposits and private hire']
  : ['Web responsive con carta e historia', 'Solicitud de mesa por formulario', 'Reserva con disponibilidad por franjas', 'Gestor de sala, espera y grupos', 'Eventos, garantías y privatizaciones'];
const demoScope: Record<string, readonly boolean[]> = {
  brasca: [true, true, false, false, false],
  vedra: [true, false, true, true, false],
  solane: [true, false, true, true, true],
};
const scopeInDemo = demoScope[theme.slug] ?? [true, false, false, false, false];

const ui = locale === 'en' ? {
  titleSuffix: ' | Restaurant website by Logic Reserva', back: 'All website directions', product: 'Restaurant website direction',
  fictional: 'Fictional navigable demonstration', responsive: 'Responsive', address: `${theme.slug}.yourdomain.com`,
  summary: `A complete website direction for presenting ${theme.name} as a ${local(theme.format).toLocaleLowerCase()}, turning visits into better prepared enquiries without losing its identity.`,
  open: 'Open navigable website', want: 'I want a website like this', frameTitle: `Screenshot of the fictional ${theme.name} website`, mobileTitle: `${theme.name} on mobile`,
  sheet: 'Spec sheet', sheetNote: 'Fictional brand · real product',
  anatomyEyebrow: 'Homepage anatomy', anatomy: [
    { title: 'Brand and promise first', body: 'Name, tone and one clear sentence set the scene in the first second.' },
    { title: 'Booking always within reach', body: 'The main action stays in the header while the guest scrolls.' },
    { title: 'Mobile-first action', body: 'On a phone, photo and booking come before anything else.' },
  ],
  demoLabel: 'What this direction includes', demoTitle: 'One direction, ready to adapt.',
  capabilities: [
    'Visual direction applied to the homepage, menu, story and contact',
    'Hierarchy prepared for mobile, desktop and accessible reading',
    'Enquiry or booking shaped around the restaurant format',
    'One shared product base, configured without duplicating the project',
  ],
  systemEyebrow: 'Visual system', systemTitle: 'The pieces that make it recognisable.',
  palette: 'Palette', type: 'Typography', layout: 'Layout pattern', roles: { primary: 'Primary', accent: 'Accent', paper: 'Paper', ink: 'Ink', muted: 'Secondary text' },
  scopeEyebrow: 'What you can try', scopeTitle: 'Demo today, project tomorrow.', scopeDemo: 'In this demo', scopeProject: 'With Logic Reserva', yes: 'Demonstrated', no: 'Not in this demo',
  scopeNote: 'Every direction can be combined with any plan. The demo only shows what is marked.',
  fit: 'How we adapt it', fitTitle: 'Your restaurant’s personality, online too.',
  fitBody: 'We adapt photography, colours, copy and menus to your restaurant. Clear on mobile and desktop, with booking always within reach.',
  fitSteps: [
    { title: 'Your photos and menu', body: 'Real dishes, rooms and prices replace the fictional content.' },
    { title: 'Your colours and type', body: 'The palette and typography follow your brand, not ours.' },
    { title: 'Your way of booking', body: 'Enquiry, direct booking or events, depending on your plan.' },
    { title: 'Your domain', body: 'Published on your own address, measured and maintained.' },
  ],
  details: 'Website details', level: 'Starting point', status: 'Status', scope: 'Demonstrated scope', delivery: 'Delivery',
  deliveryValue: 'Defined in an approved proposal', tone: 'Visual tone', format: 'Restaurant format', location: 'Fictional location', layoutLabel: 'Layout', typeLabel: 'Typography',
  related: 'Related website directions', all: 'View all twelve websites', of: 'of',
} : {
  titleSuffix: ' | Web para restaurantes · Logic Reserva', back: 'Todas las direcciones web', product: 'Dirección web para restaurantes',
  fictional: 'Demostración ficticia navegable', responsive: 'Responsive', address: `${theme.slug}.tudominio.com`,
  summary: `Una dirección web completa para presentar ${theme.name} como ${local(theme.format).toLocaleLowerCase()}, convertir visitas en solicitudes mejor preparadas y conservar su identidad.`,
  open: 'Abrir web navegable', want: 'Quiero una web así', frameTitle: `Captura de la web ficticia ${theme.name}`, mobileTitle: `${theme.name} en móvil`,
  sheet: 'Ficha técnica', sheetNote: 'Marca ficticia · producto real',
  anatomyEyebrow: 'Anatomía de la portada', anatomy: [
    { title: 'Marca y promesa primero', body: 'Nombre, tono y una frase clara sitúan al cliente en el primer segundo.' },
    { title: 'La reserva siempre a mano', body: 'La acción principal se queda en la cabecera mientras el cliente navega.' },
    { title: 'Pensada para el móvil', body: 'En el teléfono, la foto y la reserva van antes que todo lo demás.' },
  ],
  demoLabel: 'Qué incluye esta dirección', demoTitle: 'Una dirección, lista para adaptar.',
  capabilities: [
    'Dirección visual aplicada a portada, carta, historia y contacto',
    'Jerarquía preparada para móvil, escritorio y lectura accesible',
    'Solicitud o reserva adaptada al formato del restaurante',
    'Una misma base de producto, configurada sin duplicar el proyecto',
  ],
  systemEyebrow: 'Sistema visual', systemTitle: 'Las piezas que la hacen reconocible.',
  palette: 'Paleta', type: 'Tipografía', layout: 'Esquema de maquetación', roles: { primary: 'Principal', accent: 'Acento', paper: 'Papel', ink: 'Tinta', muted: 'Texto secundario' },
  scopeEyebrow: 'Qué puedes probar', scopeTitle: 'Demo hoy, proyecto mañana.', scopeDemo: 'En esta demo', scopeProject: 'Con Logic Reserva', yes: 'Demostrado', no: 'No en esta demo',
  scopeNote: 'Cada dirección se combina con cualquier plan. La demo solo enseña lo marcado.',
  fit: 'Cómo la adaptamos', fitTitle: 'La esencia de tu restaurante, también online.',
  fitBody: 'Adaptamos fotografía, colores, textos y carta a tu restaurante. Una web clara en móvil y escritorio, con la reserva siempre a mano.',
  fitSteps: [
    { title: 'Tus fotos y tu carta', body: 'Platos, salas y precios reales sustituyen el contenido ficticio.' },
    { title: 'Tus colores y tu tipografía', body: 'La paleta y la letra siguen tu marca, no la nuestra.' },
    { title: 'Tu forma de reservar', body: 'Solicitud, reserva directa o eventos, según tu plan.' },
    { title: 'Tu dominio', body: 'Publicada en tu propia dirección, medida y mantenida.' },
  ],
  details: 'Detalles de la web', level: 'Punto de partida', status: 'Estado', scope: 'Alcance demostrado', delivery: 'Entrega',
  deliveryValue: 'Definida en propuesta aprobada', tone: 'Tono visual', format: 'Formato de restaurante', location: 'Ubicación ficticia', layoutLabel: 'Maquetación', typeLabel: 'Tipografía',
  related: 'Direcciones web relacionadas', all: 'Ver las doce webs', of: 'de',
};
const scope = themeDemoScope(theme, locale);
const currentUrl = new URL(themeDetailUrl(theme.slug as ThemeSlug, locale), PRODUCT.url).href;
const structuredData = [{
  '@context': 'https://schema.org', '@type': 'WebPage', name: theme.name, description: local(metadata), url: currentUrl,
  inLanguage: locale, isPartOf: { '@id': `${PRODUCT.url}/#website` },
  about: { '@type': 'CreativeWork', name: `${theme.name} · ${local(theme.format)}`, description: ui.summary },
}, {
  '@context': 'https://schema.org', '@type': 'BreadcrumbList', itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Logic Reserva', item: `${PRODUCT.url}${prefix}/` },
    { '@type': 'ListItem', position: 2, name: locale === 'en' ? 'Website directions' : 'Direcciones web', item: `${PRODUCT.url}${prefix}/temas/` },
    { '@type': 'ListItem', position: 3, name: theme.name, item: currentUrl },
  ],
}];
const themeStyle = `--theme-primary:${theme.palette.primary};--theme-accent:${theme.palette.accent};--theme-paper:${theme.palette.paper};--theme-ink:${theme.palette.ink};--theme-muted:${theme.palette.muted};`;
const swatches = (['primary', 'accent', 'paper', 'ink', 'muted'] as const).map((role) => ({ role, label: ui.roles[role], value: theme.palette[role] }));
---

<Base
  locale={locale}
  title={`${theme.name}${ui.titleSuffix}`}
  description={local(metadata)}
  image={`${previewBase}-desktop.webp`}
  imageAlt={`${theme.name} · ${local(theme.format)}`}
  imageWidth={1366}
  imageHeight={900}
  structuredData={structuredData}
>
  <CommercialChrome locale={locale} languageHref={themeDetailUrl(theme.slug as ThemeSlug, locale === 'en' ? 'es' : 'en')}>
    <main id="contenido" class="theme-detail" tabindex="-1" style={themeStyle} data-theme-type={theme.type} data-theme-layout={theme.layout}>
      <article>
        <header class="shell theme-detail__hero">
          <a class="back" href={`${prefix}/temas/`}><span aria-hidden="true">←</span>{ui.back}</a>
          <div class="theme-detail__heading">
            <div class="theme-detail__lead">
              <p class="eyebrow">{ui.product}<span class="theme-detail__count">{pad(index + 1)} {ui.of} {pad(THEME_CATALOG.length)}</span></p>
              <h1>{theme.name}</h1>
              <p class="theme-detail__promise" lang={locale}>«{local(theme.promise)}»</p>
              <div class="theme-detail__intro">
                <p>{ui.summary}</p>
                <ul aria-label={ui.product}>
                  <li>{local(theme.level)}</li><li>{local(theme.tone)}</li><li>{ui.responsive}</li>
                </ul>
              </div>
              <div class="theme-detail__actions">
                <a class="theme-detail__open" href={themeUrl(theme.slug as ThemeSlug, locale)}>{ui.open}<span aria-hidden="true">↗</span></a>
                <a class="theme-detail__contact" href={themeContactUrl(theme.slug as ThemeSlug, locale)}>{ui.want}<span aria-hidden="true">→</span></a>
              </div>
            </div>
            <aside class="theme-detail__facts" aria-labelledby="theme-details-title">
              <div class="theme-detail__sheet-head">
                <h2 id="theme-details-title">{ui.sheet}</h2>
                <span>{ui.sheetNote}</span>
              </div>
              <dl>
                <div><dt>{ui.format}</dt><dd>{local(theme.format)}</dd></div>
                <div><dt>{ui.location}</dt><dd>{local(theme.location)}</dd></div>
                <div><dt>{ui.tone}</dt><dd>{local(theme.tone)}</dd></div>
                <div><dt>{ui.layoutLabel}</dt><dd>{local(layoutNames[theme.layout])}</dd></div>
                <div><dt>{ui.typeLabel}</dt><dd>{local(typeNames[theme.type])}</dd></div>
                <div><dt>{ui.level}</dt><dd>{local(theme.level)}</dd></div>
                <div><dt>{ui.status}</dt><dd>{ui.fictional}</dd></div>
                <div><dt>{ui.scope}</dt><dd>{scope}</dd></div>
                <div><dt>{ui.delivery}</dt><dd>{ui.deliveryValue}</dd></div>
              </dl>
              <span class="theme-detail__palette-strip" aria-hidden="true">{swatches.map((swatch) => <i style={`background:${swatch.value}`}></i>)}</span>
            </aside>
          </div>
        </header>

        <section class="theme-detail__showcase" aria-labelledby="theme-anatomy-title">
          <div class="shell">
            <div class="theme-detail__stage">
              <div class="theme-detail__browser" aria-label={ui.frameTitle} role="group">
                <div class="browser-bar"><span aria-hidden="true"><i></i><i></i><i></i></span><code>{ui.address}</code><b>{ui.fictional}</b></div>
                <div class="browser-view">
                  <picture>
                    <source media="(max-width: 620px)" srcset={`${previewBase}-mobile.webp`} />
                    <img src={`${previewBase}-desktop.webp`} alt={ui.frameTitle} width="1366" height="900" loading="eager" decoding="async" />
                  </picture>
                  <i class="theme-pin theme-pin--brand" aria-hidden="true">1</i>
                  <i class="theme-pin theme-pin--cta" aria-hidden="true">2</i>
                </div>
              </div>
              <figure class="theme-detail__phone">
                <span class="theme-detail__notch" aria-hidden="true"></span>
                <img src={`${previewBase}-mobile.webp`} alt={ui.mobileTitle} width="375" height="812" loading="lazy" decoding="async" />
                <i class="theme-pin theme-pin--phone" aria-hidden="true">3</i>
              </figure>
            </div>
            <div class="theme-detail__anatomy">
              <p class="eyebrow" id="theme-anatomy-title">{ui.anatomyEyebrow}</p>
              <ol>{ui.anatomy.map((item, itemIndex) => <li><b aria-hidden="true">{itemIndex + 1}</b><div><strong>{item.title}</strong><p>{item.body}</p></div></li>)}</ol>
            </div>
          </div>
        </section>

        <section class="shell theme-detail__decision" aria-labelledby="theme-demo-title">
          <div>
            <p class="eyebrow">{ui.demoLabel}</p>
            <h2 id="theme-demo-title">{ui.demoTitle}</h2>
            <p>{local(theme.promise)} {scope}.</p>
          </div>
          <ul>{ui.capabilities.map((capability, capabilityIndex) => <li><span aria-hidden="true">{pad(capabilityIndex + 1)}</span>{capability}</li>)}</ul>
        </section>

        <section class="shell theme-detail__system" aria-labelledby="theme-system-title">
          <div class="theme-detail__section-head"><p class="eyebrow">{ui.systemEyebrow}</p><h2 id="theme-system-title">{ui.systemTitle}</h2></div>
          <div class="theme-detail__system-grid">
            <article class="theme-card-palette">
              <h3>{ui.palette}</h3>
              <ul>
                {swatches.map((swatch) => (
                  <li><span style={`background:${swatch.value}`} aria-hidden="true"></span><strong>{swatch.label}</strong><code>{swatch.value.toUpperCase()}</code></li>
                ))}
              </ul>
            </article>
            <article class="theme-card-type">
              <h3>{ui.type}</h3>
              <div class={`theme-specimen theme-specimen--${theme.type}`} aria-hidden="true"><span>Aa</span><p>{local(theme.promise)}</p></div>
              <p><strong>{local(typeNames[theme.type])}</strong></p>
            </article>
            <article class="theme-card-layout">
              <h3>{ui.layout}</h3>
              <div class="theme-wireframe" aria-hidden="true">
                {wireframe.map((block) => <i class={`wf wf--${block.kind}`} style={`left:${block.x}%;top:${(block.y / 62) * 100}%;width:${block.w}%;height:${(block.h / 62) * 100}%`}></i>)}
              </div>
              <p><strong>{local(layoutNames[theme.layout])}</strong> · {local(layoutHints[theme.layout])}</p>
            </article>
          </div>
        </section>

        <section class="shell theme-detail__scope" aria-labelledby="theme-scope-title">
          <div class="theme-detail__section-head"><p class="eyebrow">{ui.scopeEyebrow}</p><h2 id="theme-scope-title">{ui.scopeTitle}</h2></div>
          <div class="theme-scope" role="table" aria-labelledby="theme-scope-title">
            <div class="theme-scope__row theme-scope__row--head" role="row"><span role="columnheader"><span class="sr-only">{ui.scopeTitle}</span></span><span role="columnheader">{ui.scopeDemo}</span><span role="columnheader">{ui.scopeProject}</span></div>
            {scopeRows.map((row, rowIndex) => (
              <div class="theme-scope__row" role="row" data-in-demo={scopeInDemo[rowIndex] ? 'true' : 'false'}>
                <span role="rowheader"><i aria-hidden="true">{pad(rowIndex + 1)}</i>{row}</span>
                <span role="cell" class="theme-scope__state">{scopeInDemo[rowIndex] ? <><b aria-hidden="true">✓</b>{ui.yes}</> : <><b aria-hidden="true">—</b>{ui.no}</>}</span>
                <span role="cell"><em data-plan={rowIndex < 2 ? 'basico' : rowIndex < 4 ? 'gestion' : 'inteligente'}>{planCell[rowIndex]}</em></span>
              </div>
            ))}
          </div>
          <div class="theme-detail__scope-foot">
            <p>{ui.scopeNote}</p>
            <a class="theme-detail__scope-cta" href={themeContactUrl(theme.slug as ThemeSlug, locale)}>{ui.want}<span aria-hidden="true">→</span></a>
          </div>
        </section>

        <section class="theme-detail__fit" aria-labelledby="theme-fit-title">
          <div class="shell theme-detail__fit-grid">
            <div><p class="eyebrow">{ui.fit}</p><h2 id="theme-fit-title">{ui.fitTitle}</h2><p>{ui.fitBody}</p></div>
            <ol>{ui.fitSteps.map((step, stepIndex) => <li><span>{pad(stepIndex + 1)}</span><div><strong>{step.title}</strong><p>{step.body}</p></div></li>)}</ol>
          </div>
        </section>

        <section class="shell theme-detail__related" aria-labelledby="related-title">
          <div><h2 id="related-title">{ui.related}</h2><a href={`${prefix}/temas/`}>{ui.all}<span aria-hidden="true">→</span></a></div>
          <div class="related-grid">
            {related.map((entry) => (
              <a href={themeDetailUrl(entry.slug as ThemeSlug, locale)} style={`--related-paper:${entry.palette.paper};--related-ink:${entry.palette.ink};--related-accent:${entry.palette.accent};--related-primary:${entry.palette.primary}`}>
                <span class="related-grid__shot"><img src={`${themePreviewBase(entry.slug as ThemeSlug, locale)}-desktop.webp`} alt="" width="1366" height="900" loading="lazy" decoding="async" /></span>
                <span class="related-grid__copy"><span>{localizedThemeText(entry.format, locale)}</span><strong>{entry.name}</strong><small>{localizedThemeText(entry.tone, locale)}</small></span>
                <span class="related-grid__palette" aria-hidden="true"><i style={`background:${entry.palette.primary}`}></i><i style={`background:${entry.palette.accent}`}></i><i style={`background:${entry.palette.paper}`}></i></span>
                <i aria-hidden="true">↗</i>
              </a>
            ))}
          </div>
        </section>
      </article>
    </main>
  </CommercialChrome>
</Base>

<script>
  import { preserveDetailContactPlan } from '../commercial-context';
  preserveDetailContactPlan();
</script>

<style>
  .theme-detail { color: var(--ink); background: var(--paper); }
  .sr-only { position: absolute; width: 1px; height: 1px; overflow: hidden; clip: rect(0, 0, 0, 0); white-space: nowrap; }

  /* ---------- Hero ---------- */
  .theme-detail__hero { padding-top: 22px; }
  .theme-detail__heading { display: grid; grid-template-columns: minmax(0, 1.2fr) minmax(320px, .8fr); gap: clamp(36px, 6vw, 96px); align-items: start; padding: clamp(34px, 5vw, 64px) 0 clamp(40px, 5vw, 64px); }
  .theme-detail__lead .eyebrow { flex-wrap: wrap; }
  .theme-detail__count { margin-left: 4px; border-left: 1px solid var(--lr-line-strong); padding-left: 10px; color: var(--lr-mute); }
  .theme-detail h1 { margin: 18px 0 0; font-size: clamp(3.6rem, 7vw, 6.6rem); line-height: .95; overflow-wrap: anywhere; }

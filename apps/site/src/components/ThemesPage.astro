---
import type { Locale } from '@logic-reserva/config';
import { PRODUCT } from '@logic-reserva/config';
import { THEME_CATALOG, localizedThemeText, themeDetailUrl, themeUrl, type ThemeEntry } from '@logic-reserva/config/themes';
import Base from '../layouts/Base.astro';
import CommercialChrome from './CommercialChrome.astro';

interface Props { locale?: Locale }

const { locale = 'es' } = Astro.props;
const prefix = locale === 'en' ? '/en' : '';
const homeHref = `${prefix}/`;
const languageHref = locale === 'en' ? '/temas/' : '/en/temas/';
const local = (value: ThemeEntry['format']) => localizedThemeText(value, locale);
const ui = locale === 'en' ? {
  metaTitle: 'Restaurant website directions | Logic Reserva',
  title: 'Twelve restaurant websites. One commercial system.',
  description: 'Explore twelve fictional restaurant website directions by format, tone and product depth. Three include the full Logic Reserva journey.',
  eyebrow: 'Website direction library',
  intro: 'A working catalogue for comparing how the same commercial proposition changes with the room, the occasion and the brand. Every concept is fictional.',
  back: 'Back to Logic Reserva', language: 'ES', contact: 'Discuss my website',
  searchLabel: 'Search by brand, format, location or tone', searchPlaceholder: 'Try “terrace” or “Bilbao”',
  depthLabel: 'Journey depth', all: 'All', deep: 'Full journey', webOnly: 'Website only',
  formatLabel: 'Restaurant format', allFormats: 'All formats', reset: 'Clear filters',
  count: 'directions shown', oneCount: 'direction shown', noResults: 'No direction matches those filters.',
  expand: 'Why this direction works', promise: 'Commercial promise', tone: 'Visual tone', level: 'Product depth',
  details: 'View full details', open: 'Open website', deepNote: 'Navigable website, booking journey and manager.', webNote: 'Navigable website direction; no booking engine or manager.',
  fictional: 'Fictional concept', catalogue: 'Restaurant website directions', footer: 'Commercial exploration · No real restaurants or bookings',
} : {
  metaTitle: 'Webs para restaurantes | Logic Reserva',
  title: 'Doce webs de restaurante. Un sistema comercial.',
  description: 'Explora doce direcciones web ficticias para restaurantes por formato, tono y profundidad de producto. Tres incluyen el recorrido completo de Logic Reserva.',
  eyebrow: 'Biblioteca de direcciones web',
  intro: 'Un catálogo de trabajo para comparar cómo cambia una misma propuesta comercial según la sala, la ocasión y la marca. Todos los conceptos son ficticios.',
  back: 'Volver a Logic Reserva', language: 'EN', contact: 'Hablar de mi web',
  searchLabel: 'Buscar por marca, formato, ubicación o tono', searchPlaceholder: 'Prueba “terraza” o “Bilbao”',
  depthLabel: 'Profundidad del recorrido', all: 'Todas', deep: 'Recorrido completo', webOnly: 'Solo web',
  formatLabel: 'Formato de restaurante', allFormats: 'Todos los formatos', reset: 'Limpiar filtros',
  count: 'direcciones visibles', oneCount: 'dirección visible', noResults: 'Ninguna dirección coincide con esos filtros.',
  expand: 'Por qué funciona esta dirección', promise: 'Promesa comercial', tone: 'Tono visual', level: 'Profundidad de producto',
  details: 'Ver ficha completa', open: 'Abrir web', deepNote: 'Web, reserva y gestor navegables.', webNote: 'Dirección web navegable; sin motor de reservas ni gestor.',
  fictional: 'Concepto ficticio', catalogue: 'Direcciones web para restauración', footer: 'Exploración comercial · Sin restaurantes ni reservas reales',
};
const formats = [...new Map(THEME_CATALOG.map((theme) => [local(theme.format), theme.format.es])).entries()]
  .sort(([a], [b]) => a.localeCompare(b, locale));
const itemList = {
  '@context': 'https://schema.org',
  '@type': 'CollectionPage',
  name: ui.title,
  description: ui.description,
  url: new URL(`${prefix}/temas/`, PRODUCT.url).href,
  mainEntity: {
    '@type': 'ItemList',
    numberOfItems: THEME_CATALOG.length,
    itemListElement: THEME_CATALOG.map((theme, index) => ({
      '@type': 'ListItem',
      position: index + 1,
      name: theme.name,
      url: new URL(themeDetailUrl(theme.slug, locale), PRODUCT.url).href,
    })),
  },
};
---

<Base locale={locale} title={ui.metaTitle} description={ui.description} structuredData={[itemList]}>
  <CommercialChrome locale={locale} languageHref={languageHref}>
    <main id="contenido" class="themes-main" tabindex="-1">
    <section class="shell themes-intro" aria-labelledby="themes-title">
      <a class="back" href={homeHref}><span aria-hidden="true">←</span>{ui.back}</a>
      <div class="themes-intro__grid">
        <div>
          <p class="eyebrow">{ui.eyebrow}</p>
          <h1 id="themes-title">{ui.title}</h1>
        </div>
        <p>{ui.intro}</p>
      </div>
    </section>

    <section class="shell catalogue" aria-labelledby="catalogue-title" data-theme-catalogue>
      <h2 id="catalogue-title" class="sr-only">{ui.catalogue}</h2>
      <form class="theme-filters" data-theme-filters>
        <div class="search-control">
          <label for={`theme-search-${locale}`}>{ui.searchLabel}</label>
          <span><svg aria-hidden="true" viewBox="0 0 24 24"><circle cx="11" cy="11" r="7"></circle><path d="m16.5 16.5 4 4"></path></svg><input id={`theme-search-${locale}`} type="search" placeholder={ui.searchPlaceholder} autocomplete="off" data-theme-search /></span>
        </div>
        <fieldset class="depth-control">
          <legend>{ui.depthLabel}</legend>
          <div>
            <label><input type="radio" name="depth" value="all" checked /><span>{ui.all}</span></label>
            <label><input type="radio" name="depth" value="deep" /><span>{ui.deep}</span></label>
            <label><input type="radio" name="depth" value="web-only" /><span>{ui.webOnly}</span></label>
          </div>
        </fieldset>
        <div class="format-control">
          <label for={`theme-format-${locale}`}>{ui.formatLabel}</label>
          <select id={`theme-format-${locale}`} data-theme-format>
            <option value="all">{ui.allFormats}</option>
            {formats.map(([label, value]) => <option value={value}>{label}</option>)}
          </select>
        </div>
        <button class="reset-control" type="reset" data-theme-reset>{ui.reset}</button>
      </form>

      <div class="results-heading">
        <p><strong data-theme-count>{THEME_CATALOG.length}</strong> <span data-count-label data-one={ui.oneCount} data-many={ui.count}>{ui.count}</span></p>
        <span aria-hidden="true">01—12</span>
      </div>

      <div class="theme-grid" data-theme-grid>
        {THEME_CATALOG.map((theme, index) => {
          const searchable = [theme.name, theme.format.es, theme.format.en, theme.location.es, theme.location.en, theme.tone.es, theme.tone.en].join(' ').toLocaleLowerCase();
          const visualStyle = `--theme-primary:${theme.palette.primary};--theme-accent:${theme.palette.accent};--theme-paper:${theme.palette.paper};--theme-ink:${theme.palette.ink};--theme-muted:${theme.palette.muted};`;
          const imageBase = 'imageBase' in theme ? theme.imageBase : undefined;
          return (
            <article class="theme-card" data-theme-card data-depth={theme.depth} data-format={theme.format.es} data-search={searchable} style={visualStyle}>
              <div class:list={['theme-visual', `theme-visual--${theme.layout}`, `theme-visual--${theme.type}`]} aria-hidden="true">
                {imageBase ? (
                  <picture>
                    <source type="image/avif" srcset={`${imageBase}-640.avif 640w, ${imageBase}-1600.avif 1600w`} sizes="(max-width: 760px) calc(100vw - 28px), (max-width: 1100px) 50vw, 33vw" />
                    <img src={`${imageBase}-640.avif`} alt="" width="640" height="480" loading={index === 0 ? 'eager' : 'lazy'} decoding="async" />
                  </picture>
                ) : <div class="theme-shape"></div>}
                <span class="theme-index">{String(index + 1).padStart(2, '0')}</span>
                <span class="theme-mark">{theme.mark}</span>
                <strong>{theme.name}</strong>
                <small>{local(theme.format)}</small>
              </div>
              <div class="theme-card__body">
                <div class="theme-meta"><span>{local(theme.location)}</span><span>{ui.fictional}</span></div>
                <h3>{theme.name}</h3>
                <p class="theme-promise">{local(theme.promise)}</p>
                <div class="theme-depth"><span data-depth={theme.depth}>{theme.depth === 'deep' ? ui.deep : ui.webOnly}</span><p>{theme.depth === 'deep' ? ui.deepNote : ui.webNote}</p></div>
                <details>
                  <summary>{ui.expand}<span aria-hidden="true">+</span></summary>
                  <dl>
                    <div><dt>{ui.promise}</dt><dd>{local(theme.promise)}</dd></div>
                    <div><dt>{ui.tone}</dt><dd>{local(theme.tone)}</dd></div>
                    <div><dt>{ui.level}</dt><dd>{local(theme.level)}</dd></div>
                  </dl>
                </details>
                <div class="theme-card__actions">
                  <a class="theme-details" href={themeDetailUrl(theme.slug, locale)}>{ui.details}<span aria-hidden="true">→</span></a>
                  <a class="theme-open" href={themeUrl(theme.slug, locale)}>{ui.open}<span aria-hidden="true">↗</span></a>
                </div>
              </div>
            </article>
          );
        })}
      </div>
      <p class="empty-state" data-theme-empty hidden>{ui.noResults}</p>
      <p class="sr-only" role="status" aria-live="polite" aria-atomic="true" data-theme-status></p>
    </section>
    </main>
  </CommercialChrome>
</Base>

<script>
  const catalogue = document.querySelector<HTMLElement>('[data-theme-catalogue]');
  if (catalogue) {
    const form = catalogue.querySelector<HTMLFormElement>('[data-theme-filters]');
    const search = catalogue.querySelector<HTMLInputElement>('[data-theme-search]');
    const format = catalogue.querySelector<HTMLSelectElement>('[data-theme-format]');
    const cards = [...catalogue.querySelectorAll<HTMLElement>('[data-theme-card]')];
    const count = catalogue.querySelector<HTMLElement>('[data-theme-count]');
    const label = catalogue.querySelector<HTMLElement>('[data-count-label]');
    const empty = catalogue.querySelector<HTMLElement>('[data-theme-empty]');
    const status = catalogue.querySelector<HTMLElement>('[data-theme-status]');
    const normalise = (value: string) => value.normalize('NFD').replace(/[\u0300-\u036f]/g, '').toLocaleLowerCase().trim();
    const apply = () => {
      const query = normalise(search?.value ?? '');
      const depth = form?.querySelector<HTMLInputElement>('input[name="depth"]:checked')?.value ?? 'all';
      const selectedFormat = format?.value ?? 'all';
      let visible = 0;
      for (const card of cards) {
        const matchesSearch = !query || normalise(card.dataset.search ?? '').includes(query);
        const matchesDepth = depth === 'all' || card.dataset.depth === depth;
        const matchesFormat = selectedFormat === 'all' || card.dataset.format === selectedFormat;
        card.hidden = !(matchesSearch && matchesDepth && matchesFormat);
        if (!card.hidden) visible += 1;
      }
      if (count) count.textContent = String(visible);
      if (label) label.textContent = visible === 1 ? (label.dataset.one ?? '') : (label.dataset.many ?? '');
      if (empty) empty.hidden = visible !== 0;
      if (status && label) status.textContent = `${visible} ${label.textContent}`;
    };
    form?.addEventListener('input', apply);
    form?.addEventListener('reset', () => requestAnimationFrame(apply));
  }
</script>

<style>
  .themes-main { padding-bottom: clamp(80px, 10vw, 150px); }.themes-intro { padding-top: 34px; }.back { display: inline-flex; min-height: 44px; align-items: center; gap: 8px; color: var(--slate); font-size: .82rem; text-decoration: none; }
  .themes-intro__grid { display: grid; grid-template-columns: minmax(0, 1.45fr) minmax(260px, .55fr); gap: clamp(40px, 8vw, 120px); align-items: end; padding: clamp(42px, 7vw, 90px) 0 clamp(44px, 6vw, 72px); }
  .themes-intro h1 { max-width: 980px; margin: 0; font-size: clamp(3.2rem, 7.4vw, 7.4rem); font-weight: 600; letter-spacing: -.064em; line-height: .9; }
  .themes-intro__grid > p { margin: 0 0 4px; color: var(--slate); font-family: var(--serif); font-size: clamp(1.05rem, 1.5vw, 1.25rem); line-height: 1.55; }
  .catalogue { scroll-margin-top: 90px; }.theme-filters { display: grid; grid-template-columns: minmax(250px, 1.4fr) minmax(310px, 1fr) minmax(190px, .7fr) auto; gap: 12px; align-items: end; border-block: 1px solid var(--line); padding: 18px 0; }
  .theme-filters label, .theme-filters legend { display: block; margin: 0 0 8px; color: var(--slate); font-size: .72rem; font-weight: 650; letter-spacing: .035em; }
  .search-control span { position: relative; display: block; }.search-control svg { position: absolute; top: 50%; left: 14px; width: 18px; height: 18px; fill: none; stroke: currentColor; stroke-width: 1.8; transform: translateY(-50%); }
  .search-control input, .format-control select { width: 100%; min-height: 48px; border: 1px solid rgb(0 0 0 / 16%); border-radius: 8px; color: var(--ink); background: white; }
  .search-control input { padding: 10px 14px 10px 44px; }.format-control select { padding: 10px 36px 10px 12px; }
  .depth-control { min-width: 0; margin: 0; border: 0; padding: 0; }.depth-control > div { display: grid; grid-template-columns: repeat(3, 1fr); gap: 4px; border-radius: 9px; padding: 4px; background: #e9e7e4; }
  .depth-control label { position: relative; margin: 0; }.depth-control input { position: absolute; opacity: 0; }.depth-control span { display: flex; min-height: 44px; align-items: center; justify-content: center; border-radius: 6px; padding: 7px 9px; color: var(--slate); font-size: .76rem; text-align: center; cursor: pointer; }
  .depth-control input:checked + span { color: var(--ink); background: white; box-shadow: 0 1px 3px rgb(0 0 0 / 10%); }.depth-control input:focus-visible + span { outline: 3px solid var(--bordeaux); outline-offset: 2px; }
  .reset-control { min-height: 48px; border: 1px solid rgb(0 0 0 / 14%); border-radius: 8px; padding: 8px 14px; color: var(--slate); background: transparent; cursor: pointer; }.reset-control:hover { color: var(--ink); background: white; }
  .results-heading { display: flex; align-items: center; justify-content: space-between; padding: 24px 0 16px; color: var(--slate); font-size: .78rem; }.results-heading p { margin: 0; }.results-heading strong { color: var(--ink); font-size: 1.05rem; }
  .theme-grid { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 18px; }.theme-card { min-width: 0; overflow: hidden; border: 1px solid rgb(0 0 0 / 11%); border-radius: 12px; background: white; }.theme-card[hidden] { display: none; }
  .theme-visual { position: relative; isolation: isolate; min-height: 265px; overflow: hidden; padding: 22px; color: var(--theme-ink); background: var(--theme-paper); }.theme-visual::before, .theme-visual::after { position: absolute; z-index: -1; content: ''; }.theme-visual::before { inset: auto -12% -32% 28%; height: 80%; background: var(--theme-accent); transform: rotate(-9deg); }.theme-visual::after { inset: 0 auto 0 0; width: 8px; background: var(--theme-primary); }
  .theme-visual picture, .theme-visual img { position: absolute; z-index: -2; inset: 0; width: 100%; height: 100%; object-fit: cover; }.theme-visual picture::after { position: absolute; inset: 0; background: linear-gradient(180deg, rgb(0 0 0 / 6%), rgb(0 0 0 / 68%)); content: ''; }.theme-visual:has(picture) { color: white; }.theme-visual:has(picture)::before { opacity: .72; mix-blend-mode: multiply; }.theme-visual:has(picture)::after { display: none; }
  .theme-index { position: absolute; top: 18px; right: 18px; font-size: .7rem; letter-spacing: .08em; }.theme-mark { display: grid; width: 46px; height: 46px; place-items: center; border: 1px solid currentColor; border-radius: 50%; font-size: .7rem; font-weight: 800; }
  .theme-visual strong { position: absolute; right: 22px; bottom: 38px; left: 22px; font-size: clamp(2.4rem, 4vw, 4.1rem); font-weight: 650; letter-spacing: -.06em; line-height: .85; }.theme-visual small { position: absolute; right: 22px; bottom: 18px; left: 22px; font-size: .68rem; letter-spacing: .06em; text-transform: uppercase; }
  .theme-visual--serif strong { font-family: var(--serif); font-weight: 520; letter-spacing: -.045em; }.theme-visual--condensed strong { font-stretch: condensed; font-weight: 800; letter-spacing: -.075em; text-transform: uppercase; }.theme-visual--mixed strong::first-letter { font-family: var(--serif); }
  .theme-visual--split::before { inset: 0 0 0 52%; height: auto; transform: none; }.theme-visual--split strong { right: 45%; }.theme-visual--poster::before { inset: 17% -5% auto 34%; height: 31%; transform: rotate(-4deg); }.theme-visual--poster .theme-shape { position: absolute; right: 8%; bottom: 4%; width: 38%; aspect-ratio: 1; border: 2px solid var(--theme-primary); border-radius: 50%; }.theme-visual--minimal::before { inset: 26px 26px auto auto; width: 24%; height: 3px; transform: none; }.theme-visual--minimal::after { width: 3px; }.theme-visual--minimal strong { max-width: 65%; }.theme-visual--panorama::before { inset: auto -10% -38% -10%; height: 82%; border-radius: 50% 50% 0 0; transform: none; }.theme-visual--modular::before { inset: 20% 10% 13% 48%; height: auto; transform: none; }.theme-visual--modular::after { inset: 20% 52% 13% 10%; width: auto; background: var(--theme-primary); }.theme-visual--market { background-image: linear-gradient(var(--theme-muted) 1px, transparent 1px), linear-gradient(90deg, var(--theme-muted) 1px, transparent 1px); background-size: 48px 48px; }.theme-visual--market::before { inset: 17% 9% 14% 45%; height: auto; transform: rotate(3deg); }
  .theme-card__body { padding: 20px; }.theme-meta { display: flex; justify-content: space-between; gap: 12px; color: var(--slate); font-size: .68rem; text-transform: uppercase; }.theme-card h3 { margin: 24px 0 8px; font-size: 1.6rem; letter-spacing: -.035em; }.theme-promise { min-height: 48px; margin: 0; color: var(--theme-primary); font-family: var(--serif); font-size: 1.03rem; line-height: 1.4; }
  .theme-depth { display: grid; grid-template-columns: auto 1fr; gap: 9px; align-items: start; margin: 22px 0; border-top: 1px solid var(--line); padding-top: 16px; }.theme-depth > span { display: inline-flex; min-height: 26px; align-items: center; border-radius: 999px; padding: 4px 8px; color: #665000; background: #fff1b8; font-size: .67rem; font-weight: 700; }.theme-depth > span[data-depth='deep'] { color: #185c36; background: #dcf3e6; }.theme-depth p { margin: 2px 0 0; color: var(--slate); font-size: .73rem; line-height: 1.35; }
  .theme-card details { border-block: 1px solid var(--line); }.theme-card summary { display: flex; min-height: 48px; align-items: center; justify-content: space-between; gap: 12px; color: var(--slate); font-size: .76rem; cursor: pointer; list-style: none; }.theme-card summary::-webkit-details-marker { display: none; }.theme-card summary span { font-size: 1.2rem; transition: transform 180ms ease; }.theme-card details[open] summary span { transform: rotate(45deg); }.theme-card dl { margin: 0 0 16px; }.theme-card dl div { display: grid; grid-template-columns: 105px 1fr; gap: 8px; padding: 6px 0; }.theme-card dt { color: var(--slate); font-size: .68rem; }.theme-card dd { margin: 0; font-size: .78rem; line-height: 1.35; }
  .theme-card__actions { display: grid; grid-template-columns: 1fr 1fr; gap: 8px; margin-top: 14px; }.theme-card__actions a { display: flex; min-height: 50px; align-items: center; justify-content: space-between; gap: 8px; border-radius: 7px; padding: 10px 13px; font-size: .78rem; font-weight: 700; text-decoration: none; }.theme-details { color: white; background: var(--theme-primary); }.theme-open { border: 1px solid color-mix(in srgb, var(--theme-primary) 30%, transparent); color: var(--theme-primary); background: white; }.theme-card__actions a:hover { color: white; background: var(--theme-ink); }.empty-state { margin: 0; border: 1px dashed var(--line); border-radius: 12px; padding: 60px 20px; color: var(--slate); text-align: center; }
  @media (max-width: 1080px) { .theme-filters { grid-template-columns: 1fr 1fr; }.theme-grid { grid-template-columns: repeat(2, minmax(0, 1fr)); }.reset-control { justify-self: stretch; }.themes-intro__grid { grid-template-columns: 1fr; }.themes-intro__grid > p { max-width: 55ch; } }
  @media (max-width: 680px) { .themes-intro { padding-top: 18px; }.themes-intro__grid { gap: 26px; padding-top: 32px; }.themes-intro h1 { font-size: clamp(3rem, 16vw, 4.7rem); }.theme-filters { grid-template-columns: 1fr; }.theme-grid { grid-template-columns: 1fr; }.theme-visual { min-height: 250px; }.theme-card__actions { grid-template-columns: 1fr; } }
  @media (prefers-reduced-motion: reduce) { .theme-card summary span { transition: none; } }
</style>

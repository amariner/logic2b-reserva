---
import type { Locale } from '@logic-reserva/config';
import { COMMERCIAL_PLANS, commercialContactUrl, commercialDemoUrl, localizedCommercialText } from '@logic-reserva/config/commercial';
interface Props { locale?: Locale }
const { locale = 'es' } = Astro.props;
const local = (value: { es: string; en: string }) => localizedCommercialText(value, locale);
const prefix = locale === 'en' ? '/en' : '';
const price = new Intl.NumberFormat(locale === 'en' ? 'en-GB' : 'es-ES', { style: 'currency', currency: 'EUR', maximumFractionDigits: 0 });
const ui = locale === 'en' ? {
 month: '/month', setup: 'One-time setup', choose: 'Request this plan', web: 'View website demo', manager: 'Try the manager', recommended: 'For daily service',
 note: 'Prices exclude VAT, per restaurant. No Logic2B booking commission. Payment provider fees, messaging, migration and custom integrations are quoted separately. Six-month minimum term for Basic; other terms are agreed in the proposal.',
 demo: 'Try the demos with fictional data. A working restaurant service requires an agreed implementation.', details: 'Demo scope',
} : {
 month: '/mes', setup: 'Alta única', choose: 'Solicitar este plan', web: 'Ver web demo', manager: 'Probar el gestor', recommended: 'Para el día a día',
 note: 'Precios sin IVA, por restaurante. Sin comisión de Logic2B por reserva. Pasarela de pago, mensajería, migración e integraciones a medida se presupuestan aparte. Básico: permanencia de 6 meses; resto de condiciones en la propuesta.',
 demo: 'Prueba las demos con datos ficticios. El servicio para tu restaurante requiere una implantación acordada.', details: 'Qué incluye la demo',
};
---
<div class="pricing-grid offer-grid plan-grid">
 {COMMERCIAL_PLANS.map((plan, index) => (
  <article class="pricing-card offer-card plan-card" data-plan={plan.slug}>
   <div class="pricing-top"><span>{local(plan.eyebrow)}</span>{index === 1 && <b>{ui.recommended}</b>}</div>
   <h3>{local(plan.name)}</h3>
   <p class="pricing-price"><strong>{price.format(plan.monthlyPriceCents / 100)}</strong><span>{ui.month}</span></p>
   <p class="pricing-setup">{price.format(plan.onboardingPriceCents / 100)} · {ui.setup}</p>
   <a class="pricing-cta" href={commercialContactUrl(plan, locale)}>{ui.choose}<span aria-hidden="true">↗</span></a>
   <a class="pricing-image" href={`${prefix}/demos/${plan.demo.name.toLowerCase()}/`} aria-label={`${ui.web} · ${plan.demo.name}`}><img src={`/images/restaurant-previews/${plan.demo.name.toLowerCase()}.webp`} width="800" height="527" alt={`${plan.demo.name} · ${local(plan.name)}`} loading="lazy" decoding="async" /></a>
   <p class="pricing-promise">{local(plan.promise)}</p>
   <ul>{plan.capabilities.map((capability) => <li><span aria-hidden="true">✓</span>{local(capability)}</li>)}</ul>
   <div class="pricing-links"><a href={`${prefix}/demos/${plan.demo.name.toLowerCase()}/`}>{ui.web}<span aria-hidden="true">↗</span></a>{index > 0 && <a href={commercialDemoUrl(plan, locale)}>{ui.manager}<span aria-hidden="true">↗</span></a>}</div>
   <details><summary>{ui.details}</summary><p>{local(plan.boundary)}</p></details>
  </article>
 ))}
</div>
<p class="pricing-terms">{ui.note}</p>
<p class="pricing-demo">{ui.demo}</p>
<style>
.pricing-grid{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:20px}
.pricing-card{display:flex;flex-direction:column;min-width:0;border:1px solid var(--line);border-radius:20px;padding:28px;background:#fff;color:var(--color-midnight-ink)}
.pricing-card[data-plan='gestion']{border-color:#88a6c1;background:#f1f7fc;box-shadow:0 8px 30px #16314e08}
.pricing-top{display:flex;min-height:38px;align-items:flex-start;justify-content:space-between;gap:8px;color:var(--slate);font-size:.7rem;line-height:1.5}
.pricing-top b{border-radius:20px;padding:3px 8px;background:#dbe9f4;color:#234d71;font-size:.64rem;white-space:nowrap}
.pricing-card h3{margin:12px 0 14px;font:500 clamp(1.8rem,2.6vw,2.5rem)/1.1 var(--serif);letter-spacing:-.04em}
.pricing-price{display:flex;align-items:baseline;gap:6px;margin:0}.pricing-price strong{font-size:clamp(2.5rem,3.7vw,3.5rem);font-weight:560;letter-spacing:-.055em}.pricing-price span{font-size:.86rem;color:var(--slate)}
.pricing-setup{margin:8px 0 22px;color:var(--slate);font-size:.8rem}.pricing-cta{display:flex;justify-content:space-between;align-items:center;min-height:46px;border:1px solid #c6d0d9;border-radius:999px;padding:10px 18px;font-size:.84rem;font-weight:600;text-decoration:none}.pricing-card[data-plan='gestion'] .pricing-cta{background:var(--color-midnight-ink);color:#fff;border-color:var(--color-midnight-ink)}.pricing-cta:hover{box-shadow:0 3px 12px #18314d20}
.pricing-image{display:block;margin:26px 0 18px;border:1px solid var(--line);border-radius:10px;overflow:hidden;background:var(--paper);aspect-ratio:1.52}.pricing-image img{width:100%;height:100%;object-fit:cover;object-position:top;transition:transform 200ms}.pricing-image:hover img{transform:scale(1.025)}
.pricing-promise{min-height:52px;margin:0 0 14px;font-size:.95rem;line-height:1.55}.pricing-card ul{display:grid;gap:12px;margin:0 0 20px;padding:0;list-style:none}.pricing-card li{display:flex;gap:10px;color:var(--slate);font-size:.81rem;line-height:1.55}.pricing-card li span{color:#3b6b5a}
.pricing-links{display:flex;flex-wrap:wrap;gap:4px 18px;margin-top:auto}.pricing-links a{display:inline-flex;min-height:44px;gap:10px;align-items:center;font-size:.77rem;text-underline-offset:4px}.pricing-card details{border-top:1px solid var(--line);margin-top:12px;color:var(--slate);font-size:.74rem}.pricing-card summary{display:flex;align-items:center;min-height:44px;cursor:pointer}.pricing-card summary:after{content:'+';margin-left:auto}.pricing-card details[open] summary:after{content:'−'}.pricing-card details p{line-height:1.6;margin:0 0 8px}.pricing-terms,.pricing-demo{max-width:960px;margin:26px auto 0;color:var(--slate);font-size:.77rem;line-height:1.65;text-align:center}.pricing-demo{margin-top:8px}
@media(max-width:900px){.pricing-grid{grid-template-columns:1fr}.pricing-card{padding:24px}.pricing-promise{min-height:0}.pricing-image{max-height:280px}.pricing-top{min-height:24px}}
@media(prefers-reduced-motion:reduce){.pricing-image img{transition:none}}
</style>

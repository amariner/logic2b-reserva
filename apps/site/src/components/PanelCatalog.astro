---
import type { Locale } from '@logic-reserva/config';
import { PRODUCT } from '@logic-reserva/config';
import { PANEL_CATALOG, type PanelCatalogEntry, type PanelTier } from '@logic-reserva/config/panels';
import Base from '../layouts/Base.astro';
import { SITE_CONTENT } from '../content';
import BrandLockup from './BrandLockup.astro';

interface Props { locale?: Locale; path: string }

const { locale = 'es', path } = Astro.props;
const shared = SITE_CONTENT[locale];
const panels: readonly PanelCatalogEntry[] = PANEL_CATALOG;
const prefix = locale === 'en' ? '/en' : '';
const languageHref = locale === 'en' ? path : `/en${path}`;
const pageUrl = new URL(`${prefix}${path}`, PRODUCT.url).href;
const localize = (value: PanelCatalogEntry['name']): string => value[locale];
const tierLabels: Record<PanelTier, string> = locale === 'en'
  ? { gestion: 'Management', inteligente: 'Intelligent' }
  : { gestion: 'Gestión', inteligente: 'Inteligente' };
const panelHref = (panel: PanelCatalogEntry) => `${prefix}${panel.route}`;
const ui = locale === 'en'
  ? {
    title: 'Six doors into restaurant operations.',
    intro: 'Explore the real manager surfaces behind Logic Reserva: daily service, floor capacity, bookings, groups, reports and explainable signals.',
    search: 'Search by panel, audience or decision',
    searchPlaceholder: 'Try “groups”, “floor” or “reports”',
    filter: 'Filter by tier',
    all: 'All tiers',
    count: 'panels',
    audience: 'For',
    decision: 'Decision',
    evidence: 'Evidence',
    capabilities: 'What is visible',
    limit: 'Honest boundary',
    open: 'Open reproducible manager state',
    capture: 'Real product evidence',
    back: 'Back to Logic Reserva',
    footer: 'Six restaurant panels · fictional data · local demo state',
  }
  : {
    title: 'Seis puertas a la operativa del restaurante.',
    intro: 'Explora las superficies reales del gestor de Logic Reserva: servicio, capacidad de sala, reservas, grupos, informes y señales explicables.',
    search: 'Busca por panel, equipo o decisión',
    searchPlaceholder: 'Prueba «grupos», «sala» o «informes»',
    filter: 'Filtra por nivel',
    all: 'Todos los niveles',
    count: 'paneles',
    audience: 'Para',
    decision: 'Decisión',
    evidence: 'Evidencia',
    capabilities: 'Qué se ve',
    limit: 'Límite honesto',
    open: 'Abrir estado reproducible del gestor',
    capture: 'Evidencia real de producto',
    back: 'Volver a Logic Reserva',
    footer: 'Seis paneles de restauración · datos ficticios · estado local de demo',
  };
const pageTitle = locale === 'en' ? 'Restaurant operation panels | Logic Reserva' : 'Paneles para restauración | Logic Reserva';
const structuredData: Array<Record<string, unknown>> = [
  { '@context': 'https://schema.org', '@type': 'CollectionPage', name: ui.title, description: ui.intro, url: pageUrl, isPartOf: { '@id': `${PRODUCT.url}/#website` } },
  { '@context': 'https://schema.org', '@type': 'ItemList', numberOfItems: panels.length, itemListElement: panels.map((panel, index) => ({ '@type': 'ListItem', position: index + 1, name: localize(panel.name), url: new URL(panelHref(panel), PRODUCT.url).href })) },
];
---

<Base locale={locale} title={pageTitle} description={ui.intro} structuredData={structuredData}>
  <header class="panels-nav">
    <div class="shell">
      <BrandLockup locale={locale} homeHref={`${prefix}/`} />
      <div><a class="panels-language" href={languageHref} lang={locale === 'en' ? 'es' : 'en'}>{shared.nav.language}</a><a class="pill panels-contact" href={`${prefix}/#contacto`}>{shared.nav.contact}</a></div>
    </div>
  </header>
  <main id="contenido" class="panels-main shell" tabindex="-1">
    <a class="panels-back" href={`${prefix}/`}><span aria-hidden="true">←</span> {ui.back}</a>
    <header class="panels-intro"><p class="eyebrow">{shared.nav.demos}</p><h1 class="display">{ui.title}</h1><p>{ui.intro}</p></header>
    <div class="panels-toolbar" role="search" aria-label={ui.search}>
      <label>{ui.search}<input type="search" data-panel-search placeholder={ui.searchPlaceholder} /></label>
      <label>{ui.filter}<select data-panel-filter><option value="all">{ui.all}</option><option value="gestion">{tierLabels.gestion}</option><option value="inteligente">{tierLabels.inteligente}</option></select></label>
      <p data-panel-count aria-live="polite">{panels.length} {ui.count}</p>
    </div>
    <div class="panel-grid" data-panel-grid>
      {panels.map((panel) => (
        <article id={`panel-${panel.slug}`} class="panel-card" data-panel-card data-panel-tier={panel.tier} data-panel-searchable={`${panel.name.es} ${panel.name.en} ${panel.audience.es} ${panel.audience.en} ${panel.decision.es} ${panel.decision.en}`}>
          <div class="panel-card__visual" style={`--panel-accent: ${panel.accent}; --panel-surface: ${panel.surface};`}>
            <img src={panel.image} alt={panel.imageAlt[locale]} width="1366" height="900" loading="lazy" decoding="async" />
            <span class="panel-card__mark" aria-hidden="true">{panel.mark}</span>
            <span class="panel-card__capture">{ui.capture}</span>
          </div>
          <div class="panel-card__body">
            <div class="panel-card__meta"><span>{tierLabels[panel.tier]}</span><span>{localize(panel.name)}</span></div>
            <h2>{localize(panel.name)}</h2>
            <p class="panel-card__strapline">{localize(panel.strapline)}</p>
            <dl class="panel-card__facts">
              <div><dt>{ui.audience}</dt><dd>{localize(panel.audience)}</dd></div>
              <div><dt>{ui.decision}</dt><dd>{localize(panel.decision)}</dd></div>
            </dl>
            <div class="panel-card__evidence"><p class="panel-card__label">{ui.evidence}</p><p>{localize(panel.evidence)}</p></div>
            <div class="panel-card__capabilities"><p class="panel-card__label">{ui.capabilities}</p><ul>{panel.capabilities.map((capability) => <li>{localize(capability)}</li>)}</ul></div>
            <p class="panel-card__limit"><strong>{ui.limit}</strong> {localize(panel.limit)}</p>
            <a class="panel-card__action" href={panelHref(panel)}>{ui.open}<span aria-hidden="true"> ↗</span></a>
          </div>
        </article>
      ))}
    </div>
    <p class="panels-empty" data-panel-empty hidden>{locale === 'en' ? 'No panel matches that search.' : 'Ningún panel coincide con esa búsqueda.'}</p>
  </main>
  <footer class="panels-footer"><div class="shell"><span>{ui.footer}</span><nav><a href={`${prefix}/temas/`}>{shared.nav.demos}</a><a href={`${prefix}/planes/`}>{shared.footer.plans}</a><a href={`${prefix}/legal/`}>{shared.footer.legal}</a><a href={`${prefix}/privacidad/`}>{shared.footer.privacy}</a></nav></div></footer>
</Base>

<script>
  const panelSearch = document.querySelector<HTMLInputElement>('[data-panel-search]');
  const panelFilter = document.querySelector<HTMLSelectElement>('[data-panel-filter]');
  const panelCards = Array.from(document.querySelectorAll<HTMLElement>('[data-panel-card]'));
  const panelCount = document.querySelector<HTMLElement>('[data-panel-count]');
  const panelEmpty = document.querySelector<HTMLElement>('[data-panel-empty]');
  const updatePanels = () => {
    const query = (panelSearch?.value ?? '').trim().toLocaleLowerCase();
    const tier = panelFilter?.value ?? 'all';
    let visible = 0;
    panelCards.forEach((card) => {
      const matchesQuery = !query || (card.dataset.panelSearchable ?? '').toLocaleLowerCase().includes(query);
      const matchesTier = tier === 'all' || card.dataset.panelTier === tier;
      const matches = matchesQuery && matchesTier;
      card.hidden = !matches;
      if (matches) visible += 1;
    });
    if (panelCount) panelCount.textContent = `${visible} ${panelCount.textContent?.replace(/^\d+\s*/, '') ?? ''}`;
    if (panelEmpty) panelEmpty.hidden = visible !== 0;
  };
  panelSearch?.addEventListener('input', updatePanels);
  panelFilter?.addEventListener('change', updatePanels);
</script>

<style>
  .panels-nav { position: sticky; z-index: 50; top: 0; height: 72px; border-bottom: 1px solid var(--line); background: rgb(255 254 252 / 92%); box-shadow: var(--shadow-nav); backdrop-filter: blur(14px); }
  .panels-nav .shell, .panels-footer .shell { display: flex; height: 100%; align-items: center; justify-content: space-between; gap: 20px; }
  .panels-nav > .shell > div { display: flex; align-items: center; gap: 12px; }
  .panels-language { display: inline-flex; min-width: 44px; min-height: 44px; align-items: center; justify-content: center; color: var(--slate); font-size: .84rem; text-decoration: none; }
  .panels-contact { min-height: 44px; }
  .panels-main { padding-block: clamp(48px, 8vw, 104px) clamp(76px, 10vw, 140px); }
  .panels-back { display: inline-flex; min-height: 44px; align-items: center; gap: 8px; margin-bottom: clamp(52px, 8vw, 94px); color: var(--slate); font-size: .84rem; text-decoration: none; }
  .panels-intro { max-width: 940px; }
  .panels-intro h1 { max-width: 880px; }
  .panels-intro > p:last-child { max-width: 68ch; margin: 26px 0 0; color: var(--slate); font-family: var(--serif); font-size: clamp(1.12rem, 1.8vw, 1.4rem); line-height: 1.58; }
  .panels-toolbar { display: grid; grid-template-columns: 1.35fr .65fr auto; align-items: end; gap: 16px; margin-top: clamp(58px, 8vw, 96px); padding-block: 18px; border-top: 1px solid var(--line); border-bottom: 1px solid var(--line); }
  .panels-toolbar label { display: grid; gap: 8px; color: var(--slate); font-size: .72rem; font-weight: 700; }
  .panels-toolbar input, .panels-toolbar select { min-height: 46px; border: 1px solid var(--line); border-radius: 8px; padding: 10px 12px; color: var(--ink); background: white; font: inherit; }
  .panels-toolbar p { margin: 0 0 12px; color: var(--slate); font-size: .76rem; white-space: nowrap; }
  .panel-grid { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: clamp(20px, 3vw, 36px); margin-top: clamp(36px, 5vw, 64px); }
  .panel-card { overflow: hidden; border: 1px solid var(--line); border-radius: 14px; background: var(--paper); box-shadow: 0 12px 30px rgb(28 34 38 / 6%); }
  .panel-card[hidden] { display: none; }
  .panel-card__visual { position: relative; min-height: 230px; overflow: hidden; background: var(--panel-surface); }
  .panel-card__visual::after { position: absolute; inset: 0; background: linear-gradient(135deg, rgb(255 255 255 / 0%), rgb(0 0 0 / 12%)); content: ''; pointer-events: none; }
  .panel-card__visual img { display: block; width: 100%; height: 230px; object-fit: cover; object-position: top left; }
  .panel-card__mark { position: absolute; z-index: 1; top: 18px; left: 18px; display: grid; width: 46px; height: 46px; place-items: center; border-radius: 50%; color: white; background: var(--panel-accent); font-size: .9rem; font-weight: 800; letter-spacing: -.04em; }
  .panel-card__capture { position: absolute; z-index: 1; right: 14px; bottom: 14px; border-radius: 999px; padding: 7px 10px; color: white; background: rgb(18 26 30 / 82%); font-size: .67rem; font-weight: 750; }
  .panel-card__body { padding: clamp(22px, 3vw, 32px); }
  .panel-card__meta { display: flex; justify-content: space-between; gap: 12px; color: var(--slate); font-size: .68rem; font-weight: 750; letter-spacing: .05em; text-transform: uppercase; }
  .panel-card__meta span:first-child { color: var(--panel-accent); }
  .panel-card h2 { margin: 14px 0 0; font-size: clamp(1.45rem, 2.2vw, 2rem); letter-spacing: -.04em; }
  .panel-card__strapline { margin: 7px 0 0; color: var(--panel-accent); font-family: var(--serif); font-size: 1.08rem; }
  .panel-card__facts { display: grid; gap: 13px; margin: 24px 0 0; }
  .panel-card__facts div { display: grid; grid-template-columns: 92px 1fr; gap: 12px; border-top: 1px solid var(--line); padding-top: 12px; }
  .panel-card__facts dt, .panel-card__label { color: var(--slate); font-size: .66rem; font-weight: 800; letter-spacing: .07em; text-transform: uppercase; }
  .panel-card__facts dd { margin: 0; font-size: .82rem; font-weight: 600; line-height: 1.4; }
  .panel-card__evidence, .panel-card__capabilities { margin-top: 24px; }
  .panel-card__evidence p:last-child { margin: 8px 0 0; color: var(--slate); font-family: var(--serif); font-size: .94rem; line-height: 1.45; }
  .panel-card__capabilities ul { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 8px; margin: 10px 0 0; padding: 0; list-style: none; }
  .panel-card__capabilities li { min-height: 68px; border-top: 2px solid var(--panel-accent); padding: 9px 7px 0 0; font-size: .76rem; font-weight: 700; line-height: 1.35; }
  .panel-card__limit { margin: 24px 0 10px; color: var(--slate); font-family: var(--serif); font-size: .86rem; line-height: 1.48; }
  .panel-card__limit strong { color: var(--ink); font-family: var(--sans); font-size: .68rem; }
  .panel-card__action { display: inline-flex; min-width: 44px; min-height: 44px; align-items: center; color: var(--color-notion-blue-strong); font-size: .8rem; font-weight: 750; text-decoration: none; }
  .panel-card__action:hover { text-decoration: underline; text-underline-offset: 4px; }
  .panels-empty { margin: 48px 0 0; color: var(--slate); font-family: var(--serif); font-size: 1.1rem; }
  .panels-footer { min-height: 90px; border-top: 1px solid var(--line); color: var(--slate); font-size: .74rem; }
  .panels-footer nav { display: flex; flex-wrap: wrap; gap: 18px; justify-content: flex-end; }
  .panels-footer a { display: inline-flex; min-width: 44px; min-height: 44px; align-items: center; color: var(--slate); text-decoration: none; }
  .panels-footer a:hover { color: var(--ink); text-decoration: underline; text-underline-offset: 4px; }
  @media (max-width: 760px) {
    .panels-toolbar, .panel-grid { grid-template-columns: 1fr; }
    .panels-toolbar p { margin: 3px 0 0; }
    .panel-card__visual, .panel-card__visual img { min-height: 210px; height: 210px; }
    .panel-card__capabilities ul { grid-template-columns: 1fr; }
    .panel-card__capabilities li { min-height: 44px; }
    .panels-footer { padding-block: 20px; }
    .panels-footer .shell { height: auto; align-items: flex-start; flex-direction: column; }
    .panels-footer nav { justify-content: flex-start; }
  }
  @media (max-width: 560px) {
    .panels-contact { display: none; }
    .panels-nav .shell { width: min(100% - 24px, var(--page-max-width)); }
    .panels-toolbar, .panel-grid { grid-template-columns: 1fr; }
    .panel-card__facts div { grid-template-columns: 78px minmax(0, 1fr); }
  }
  @media (prefers-reduced-motion: reduce) { .panel-card__action { transition: none; } }
</style>

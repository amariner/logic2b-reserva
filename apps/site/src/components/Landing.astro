  .implementation-boundary a { display: flex; min-height: 46px; flex: 0 0 auto; align-items: center; gap: 18px; border-radius: 999px; padding: 9px 17px; color: var(--ink); background: var(--color-marigold); font-size: .78rem; font-weight: 700; text-decoration: none; }

  .guides-teaser-section { border-bottom: 1px solid var(--line); }

---
import type { Locale } from '@logic-reserva/config';
import { logic2bContact } from '@logic-reserva/config/contact';
import { SITE_CONTENT } from '../content';
import BrandLockup from './BrandLockup.astro';

interface Props { locale?: Locale }

const { locale = 'es' } = Astro.props;
const c = SITE_CONTENT[locale];
const prefix = locale === 'en' ? '/en' : '';
const languageHref = locale === 'en' ? '/' : '/en/';
const contact = logic2bContact(locale, 'commercial');
const pageHref = (path: string) => `${prefix}${path}`;
const ui = locale === 'en' ? {
  mainNav: 'Main navigation', otherLanguage: 'es', menu: 'Menu', product: 'How it works', productLinks: 'Product links', legalLinks: 'Legal links', cookies: 'Cookie preferences', flowLabel: 'One availability view', flow: ['Guest books', 'Inventory updates', 'Floor team decides'], restaurantSolution: 'Restaurant bookings', groupSolution: 'Groups and events', productView: 'Product view', productTitle: 'The event takes up tables too.', productDetail: 'Publish a dinner and the booking engine stops offering the tables it uses.', productAction: 'Open this scenario', productAlt: 'Solane floor plan showing tables reserved for service and a wine pairing event', inventoryAction: 'Open inventory', productEvidence: 'Product journey · demo data', webs: 'Websites', manager: 'Manager', heroWeb: 'View web demo', heroJourney: 'See guided journey', heroPathsLabel: 'Explore the product', portfolioLabel: 'Three identities, one operating idea', ecosystemTitle: 'Context-aware ecosystem', ecosystemStateLabel: 'Maturity',
  } : {
  mainNav: 'Navegación principal', otherLanguage: 'en', menu: 'Menú', product: 'Cómo funciona', productLinks: 'Enlaces de producto', legalLinks: 'Enlaces legales', cookies: 'Preferencias de cookies', flowLabel: 'Una sola disponibilidad', flow: ['El cliente reserva', 'El inventario se actualiza', 'Sala decide'], restaurantSolution: 'Reservas de restaurante', groupSolution: 'Grupos y eventos', productView: 'Vista de producto', productTitle: 'El evento también ocupa mesa.', productDetail: 'Publica una cena y el motor deja de ofrecer las mesas que utiliza.', productAction: 'Abrir este escenario', productAlt: 'Plano de Solane con mesas reservadas para el servicio y para una cena maridaje', inventoryAction: 'Abrir inventario', productEvidence: 'Recorrido de producto · datos demo', webs: 'Webs', manager: 'Gestor', heroWeb: 'Ver web demo', heroJourney: 'Ver recorrido guiado', heroPathsLabel: 'Explora el producto', portfolioLabel: 'Tres identidades, una misma forma de operar', ecosystemTitle: 'Ecosistema con contexto', ecosystemStateLabel: 'Madurez',
};
const demoTones = { solane: 'warning', vedra: 'success', brasca: 'info' } as const;
const navItems = [
  { href: '#portfolio', label: ui.webs },
  { href: `${prefix}/demos/solane/gestion/?vista=plano`, label: ui.manager },
  { href: pageHref('/planes/'), label: c.nav.plans },
];
---

<div class="landing">
  <header class="site-header">
    <div class="shell nav-shell">
      <BrandLockup locale={locale} homeHref={pageHref('/')} />
      <nav class="main-nav" aria-label={ui.mainNav}>
        {navItems.map((item) => <a href={item.href}>{item.label}</a>)}
      </nav>
      <div class="nav-actions">
        <a class="language-link" href={languageHref} lang={ui.otherLanguage}>{c.nav.language}</a>
        <a class="pill nav-cta" href="#contacto">{c.nav.contact}</a>
        <details class="mobile-menu">
          <summary>{ui.menu}<span aria-hidden="true">+</span></summary>
          <nav aria-label={ui.mainNav}>{navItems.map((item) => <a href={item.href}>{item.label}</a>)}<a href="#contacto">{c.nav.contact}</a></nav>
        </details>
      </div>
    </div>
  </header>

  <main id="contenido" tabindex="-1">
    <section class="hero shell" aria-labelledby="hero-title">
      <div class="hero-grid">
        <div class="hero-copy">
          <p class="eyebrow">{c.hero.eyebrow}</p>
          <h1 id="hero-title" class="hero-title">
            {c.hero.beforeHighlight}<span>{c.hero.highlight}</span>{c.hero.afterHighlight}
          </h1>
          <p class="hero-promise">{c.hero.promise}</p>
          <p class="hero-body">{c.hero.body}</p>
          <div class="hero-actions">
            <a class="hero-primary" href={`${prefix}/demos/solane/gestion/?vista=plano`}>{c.hero.primary}<span aria-hidden="true">↗</span></a>
            <a class="hero-secondary" href={`${prefix}/demos/brasca/`}>{ui.heroWeb}<span aria-hidden="true">↗</span></a>
            <a class="hero-secondary" href={`${prefix}/demos/vedra/gestion/?vista=plano`}>{ui.heroJourney}<span aria-hidden="true">↗</span></a>
            <a class="hero-secondary" href="#contacto">{c.hero.secondary}<span aria-hidden="true">→</span></a>
          </div>
          <p class="hero-support"><span aria-hidden="true">2B</span>{c.hero.support}</p>
          <form id="hero-lead-form" class="hero-capture" data-lead-form aria-labelledby="hero-capture-title" novalidate>
            <div class="hero-capture__intro"><strong id="hero-capture-title">{c.hero.capture.title}</strong><span>{c.hero.capture.body}</span></div>
            <div class="hero-capture__fields">
              <label>{c.hero.capture.name}<input name="name" required autocomplete="name" /></label>
              <label>{c.hero.capture.email}<input name="email" type="email" required autocomplete="email" /></label>
              <label>{c.hero.capture.level}<select name="level">{c.lead.priorities.map((priority) => <option value={priority.value} selected={priority.value === 'gestion'}>{priority.label}</option>)}</select></label>
            </div>
            <input type="hidden" name="restaurant" value={c.hero.capture.restaurant} />
            <input type="hidden" name="message" value={c.hero.capture.message} />
            <label class="hero-capture__privacy"><input name="privacyAccepted" type="checkbox" required /><span>{c.hero.capture.privacy} <a href={pageHref('/privacidad/')}>{c.footer.privacy}</a>.</span></label>
            <input name="website" class="honeypot" tabindex="-1" autocomplete="off" aria-hidden="true" />
            <button class="hero-capture__submit" type="submit">{c.hero.capture.submit}<span aria-hidden="true">→</span></button>
            <p class="lead-status" data-lead-status data-disabled={c.lead.disabled} data-invalid={c.lead.invalid} data-failure={c.lead.failure} data-success={c.lead.success} data-limited={c.lead.limited} role="status"></p>
          </form>
        </div>

        <div class="hero-product">
          <figure class="product-proof artifact">
            <div class="product-proof__bar">
              <span class="status">{ui.productView}</span>
              <span>Solane · 18.09.2026</span>
            </div>
            <div class="product-proof__screen">
              <picture>
                <source media="(max-width: 640px)" srcset="/images/screens/05-solane-inventario-mobile.png" />
                <img src="/images/screens/05-solane-inventario-desktop.png" alt={ui.productAlt} width="1366" height="900" loading="eager" fetchpriority="high" decoding="async" />
              </picture>
            </div>
            <figcaption><div><strong>{ui.productTitle}</strong><span>{ui.productDetail}</span></div><a href={`${prefix}/demos/solane/gestion/?vista=plano`}>{ui.productAction}<span aria-hidden="true">↗</span></a></figcaption>
          </figure>
          <p class="demo-note">{c.hero.note}</p>
          <div id="portfolio" class="hero-portfolio" aria-labelledby="portfolio-title">
            <div class="hero-portfolio__heading"><span id="portfolio-title">{ui.portfolioLabel}</span><a href="#demos">{c.nav.demos}<span aria-hidden="true">↗</span></a></div>
            <div class="portfolio-strip">
              {c.demos.items.map((demo) => (
                <a class={`portfolio-card portfolio-card--${demo.slug}`} href={`${prefix}/demos/${demo.slug}/`}>
                  <img src={`/images/heroes/${demo.slug}-v2-640.avif`} alt={demo.alt} width="640" height="480" loading="lazy" decoding="async" />
                  <span><strong>{demo.name}</strong><small>{demo.level}</small></span>
                </a>
              ))}
            </div>
          </div>
        </div>
      </div>
      <div class="hero-flow" aria-label={ui.flowLabel}>
        <strong>{ui.flowLabel}</strong>
        {ui.flow.map((step, index) => <span><i>0{index + 1}</i>{step}</span>)}
      </div>
    </section>

    <section id="ecosistema" class="ecosystem-rail" aria-labelledby="ecosystem-title">
      <div class="shell ecosystem-rail__inner">
        <div class="ecosystem-rail__intro"><p class="eyebrow">{c.ecosystem.eyebrow}</p><h2 id="ecosystem-title" class="heading">{c.ecosystem.title}</h2><p class="editorial">{c.ecosystem.intro}</p></div>
        <div class="ecosystem-grid">
          {c.ecosystem.items.map((item) => <article class="ecosystem-card"><div><h3>{item.name}</h3><span class="ecosystem-status" data-state={item.state}>{item.state}</span></div><p>{item.body}</p><small>{ui.ecosystemStateLabel}: {item.state}</small></article>)}
        </div>
      </div>
    </section>

    <section id="diferenciales" class="section shell product-section" aria-labelledby="differences-title">
      <div class="section-intro">
        <p class="eyebrow">{c.differences.eyebrow}</p>
        <h2 id="differences-title" class="heading">{c.differences.title}</h2>
        <p class="editorial">{c.differences.intro}</p>
      </div>
      <div class="path-grid">
        {c.differences.paths.map((path, index) => (
          <article class={`path-card path-card--${path.id}`}>
            <span class="path-card__index">0{index + 1}</span>
            <p class="path-card__eyebrow">{path.eyebrow}</p>
            <h3>{path.title}</h3>
            <p class="path-card__body">{path.body}</p>
            <ul>{path.points.map((point) => <li>{point}</li>)}</ul>
            <a href={path.id === 'restaurant' ? pageHref('/soluciones/restaurantes/') : pageHref('/soluciones/grupos-y-eventos/')}>{path.action}<span aria-hidden="true"> ↗</span></a>
          </article>
        ))}
      </div>
    </section>

    <section id="demos" class="section shell" aria-labelledby="demos-title">
      <div class="section-intro">
        <p class="eyebrow">{c.demos.eyebrow}</p>
        <h2 id="demos-title" class="heading">{c.demos.title}</h2>
        <p class="editorial">{c.demos.intro}</p>
      </div>
      <div class="demo-grid">
        {c.demos.items.map((demo) => (
          <article class={`demo-card demo-card--${demo.slug}`}>
            <div class="demo-card__preview">
              {demo.slug === 'solane' ? (
                <>
                  <picture>
                    <source media="(max-width: 640px)" srcset="/images/screens/07-solane-privatizacion-mobile.png" />
                    <img src="/images/screens/07-solane-privatizacion-desktop.png" alt={demo.alt} width="1366" height="900" loading="lazy" decoding="async" />
                  </picture>
                  <span class="demo-card__evidence">{ui.productEvidence}</span>
                </>
              ) : (
                <picture>
                  <source type="image/avif" srcset={`/images/heroes/${demo.slug}-v2-640.avif 640w, /images/heroes/${demo.slug}-v2-960.avif 960w, /images/heroes/${demo.slug}-v2-1600.avif 1600w`} sizes="(max-width: 1000px) 100vw, 34vw" />
                  <img src={`/images/heroes/${demo.slug}-v2-960.avif`} alt={demo.alt} width="960" height="720" loading="lazy" decoding="async" />
                </picture>
              )}
            </div>
            <div class="demo-card__copy"><span class="badge" data-tone={demoTones[demo.slug]}>{demo.level}</span><h3>{demo.name}</h3><h4>{demo.title}</h4><p>{demo.body}</p><div class="demo-card__actions"><a href={`${prefix}/demos/${demo.slug}/`}>{demo.action}<span aria-hidden="true"> →</span></a>{demo.slug === 'solane' && <a class="demo-card__manager" href={`${prefix}/demos/solane/gestion/?vista=plano`}>{ui.inventoryAction}<span aria-hidden="true"> ↗</span></a>}</div></div>
          </article>
        ))}
      </div>
    </section>

    <section id="acompanamiento" class="section human-section" aria-labelledby="human-title">
      <div class="shell">
        <div class="human-intro">
          <div>
            <p class="eyebrow">{c.human.eyebrow}</p>
            <h2 id="human-title" class="heading">{c.human.title}</h2>
          </div>
          <p>{c.human.body}</p>
        </div>
        <div class="human-steps">
          {c.human.items.map((item) => (
            <article>
              <span>{item.number}</span>
              <h3>{item.title}</h3>
              <p>{item.body}</p>
            </article>
          ))}
        </div>
        <div class="human-promise">
          <p>{c.human.closing}</p>
          <a class="pill" href="#contacto">{c.human.action}<span aria-hidden="true"> →</span></a>
        </div>
      </div>
    </section>

    <section id="preguntas" class="section shell faq-section" aria-labelledby="faq-title">
      <div class="section-intro"><p class="eyebrow">{c.faq.eyebrow}</p><h2 id="faq-title" class="heading">{c.faq.title}</h2></div>
      <div class="faq-list">{c.faq.items.map((item, index) => <details open={index === 0}><summary>{item.question}<span aria-hidden="true">+</span></summary><p>{item.answer}</p></details>)}</div>
    </section>

    <section id="contacto" class="section shell contact-section" aria-labelledby="contact-title">
      <div class="contact-copy"><p class="eyebrow">{c.lead.eyebrow}</p><h2 id="contact-title" class="heading">{c.lead.title}</h2><p class="editorial">{c.lead.body}</p><a class="whatsapp-link" href={contact.href} target="_blank" rel="noreferrer">{c.lead.whatsapp}<span aria-hidden="true"> ↗</span></a></div>
      <form id="lead-form" class="lead-form card" data-lead-form novalidate>
        <div class="field-row"><label>{c.lead.fields.name}<input name="name" required autocomplete="name" /></label><label>{c.lead.fields.restaurant}<input name="restaurant" required autocomplete="organization" /></label></div>
        <label>{c.lead.fields.email}<input name="email" type="email" required autocomplete="email" /></label>
        <label>{c.lead.fields.level}<select name="level">{c.lead.priorities.map((priority) => <option value={priority.value} selected={priority.value === 'gestion'}>{priority.label}</option>)}</select></label>
        <label>{c.lead.fields.message}<textarea name="message" rows="4" required></textarea></label>
        <label class="privacy-check"><input name="privacyAccepted" type="checkbox" required /><span>{c.lead.fields.privacy} <a href={pageHref('/privacidad/')}>{c.footer.privacy}</a>.</span></label>
        <input name="website" class="honeypot" tabindex="-1" autocomplete="off" aria-hidden="true" />
        <button class="lead-submit" type="submit">{c.lead.submit}<span aria-hidden="true">→</span></button>
        <p class="lead-status" data-lead-status data-disabled={c.lead.disabled} data-invalid={c.lead.invalid} data-failure={c.lead.failure} data-success={c.lead.success} data-limited={c.lead.limited} role="status"></p>
      </form>
    </section>
  </main>

  <footer class="site-footer">
    <div class="shell footer-grid"><div><BrandLockup locale={locale} homeHref={pageHref('/')} /><p>{c.footer.line}</p></div><nav aria-label={ui.productLinks}><a href={pageHref('/planes/')}>{c.footer.plans}</a><a href={pageHref('/soluciones/restaurantes/')}>{c.footer.restaurants}</a><a href={pageHref('/soluciones/grupos-y-eventos/')}>{c.footer.groups}</a></nav><nav aria-label={ui.legalLinks}><a href={pageHref('/legal/')}>{c.footer.legal}</a><a href={pageHref('/privacidad/')}>{c.footer.privacy}</a><a href={pageHref('/cookies/')}>{c.footer.cookies}</a></nav></div>
    <div class="shell footer-bottom"><span>© 2026 Logic2B</span><span>{c.footer.demo}</span></div>
  </footer>

  <aside class="cookie-banner card" data-cookie-banner hidden aria-label={ui.cookies}>
    <p>{c.cookies.text}</p><div><button type="button" class="pill ghost" data-cookie-choice="necessary">{c.cookies.reject}</button><button type="button" class="pill" data-cookie-choice="analytics">{c.cookies.accept}</button></div>
  </aside>
</div>

<script>
  const submitLead = async (leadForm: HTMLFormElement) => {
    const leadStatus = leadForm.querySelector<HTMLElement>('[data-lead-status]');
    if (!leadForm.checkValidity()) {
      if (leadStatus) leadStatus.textContent = leadStatus.dataset.invalid ?? '';
      leadForm.reportValidity();
      return;
    }
    const submit = leadForm.querySelector<HTMLButtonElement>('button[type="submit"]');
    if (submit) submit.disabled = true;
    try {
      const formData = new FormData(leadForm);
      const payload = {
        name: String(formData.get('name') ?? ''), restaurant: String(formData.get('restaurant') ?? ''),
        email: String(formData.get('email') ?? ''),
        level: String(formData.get('level') ?? ''), message: String(formData.get('message') ?? ''),
        website: String(formData.get('website') ?? ''), accept: formData.get('privacyAccepted') === 'on',
        lang: document.documentElement.lang === 'en' ? 'en' : 'es',
      };
      const response = await fetch('/api/leads', { method: 'POST', headers: { 'content-type': 'application/json' }, body: JSON.stringify(payload) });
      const body = await response.json().catch(() => ({})) as { ref?: string };
      if (leadStatus) {
        if (response.status === 202) leadStatus.textContent = `${leadStatus.dataset.success ?? ''}${body.ref ? ` · ${body.ref}` : ''}`;
        else if (response.status === 429) leadStatus.textContent = leadStatus.dataset.limited ?? '';
        else if (response.status === 403 || response.status === 503) leadStatus.textContent = leadStatus.dataset.disabled ?? '';
        else leadStatus.textContent = leadStatus.dataset.failure ?? '';
      }
      if (response.status === 202) leadForm.reset();
    } catch {
      if (leadStatus) leadStatus.textContent = leadStatus.dataset.failure ?? '';
    } finally {
      if (submit) submit.disabled = false;
    }
  };
  document.querySelectorAll<HTMLFormElement>('[data-lead-form]').forEach((leadForm) => leadForm.addEventListener('submit', (event) => {
    event.preventDefault();
    void submitLead(leadForm);
  }));

  const cookieBanner = document.querySelector<HTMLElement>('[data-cookie-banner]');
  try {
    if (cookieBanner && localStorage.getItem('logic-reserva-consent-v1') === null) cookieBanner.hidden = false;
    document.querySelectorAll<HTMLButtonElement>('[data-cookie-choice]').forEach((button) => button.addEventListener('click', () => {
      localStorage.setItem('logic-reserva-consent-v1', button.dataset.cookieChoice ?? 'necessary');
      if (cookieBanner) cookieBanner.hidden = true;
    }));
  } catch {
    if (cookieBanner) cookieBanner.hidden = false;
  }

  const mobileMenu = document.querySelector<HTMLDetailsElement>('.mobile-menu');
  mobileMenu?.querySelectorAll('a').forEach((link) => link.addEventListener('click', () => {
    mobileMenu.open = false;
  }));
</script>

<style>
  .landing { overflow: clip; background: var(--paper); }
  section[id] { scroll-margin-top: 92px; }
  .site-header { position: fixed; z-index: 50; top: 0; right: 0; left: 0; height: 72px; border-bottom: 1px solid var(--line); background: rgb(255 254 252 / 92%); box-shadow: var(--shadow-nav); backdrop-filter: blur(14px); }
  .nav-shell { display: flex; height: 100%; align-items: center; justify-content: space-between; gap: 20px; }
  .main-nav { display: flex; align-items: center; gap: 2px; }
  .main-nav a, .language-link { display: inline-flex; min-width: 44px; min-height: 44px; align-items: center; justify-content: center; border-radius: 8px; padding: 10px 11px; color: rgb(0 0 0 / 58%); font-size: .78rem; font-weight: 500; text-decoration: none; transition: color 200ms ease, background-color 200ms ease; }
  .main-nav a:hover, .language-link:hover { color: var(--ink); background: rgb(0 0 0 / 4%); }
  .nav-actions { display: flex; flex: 0 0 auto; align-items: center; gap: 4px; }
  .nav-cta { min-height: 44px; border-radius: 999px; padding-inline: 17px; }
  .mobile-menu { position: relative; display: none; width: max-content; flex: 0 0 auto; }
  .mobile-menu summary { display: flex; min-height: 44px; align-items: center; gap: 8px; border-radius: 8px; padding: 8px 10px; color: var(--slate); cursor: pointer; font-size: .8rem; font-weight: 600; list-style: none; }
  .mobile-menu summary::-webkit-details-marker { display: none; }
  .mobile-menu summary span { font-size: 1.1rem; transition: transform 180ms ease; }
  .mobile-menu[open] summary span { transform: rotate(45deg); }
  .mobile-menu nav { position: absolute; top: calc(100% + 8px); right: 0; display: grid; width: min(310px, calc(100vw - 28px)); overflow: hidden; border: 1px solid var(--line); border-radius: 12px; padding: 8px; background: white; box-shadow: var(--shadow-artifact); }
  .mobile-menu nav a { display: flex; min-height: 46px; align-items: center; border-radius: 8px; padding: 10px 12px; color: var(--slate); font-size: .84rem; font-weight: 550; text-decoration: none; }
  .mobile-menu nav a:hover { color: var(--ink); background: var(--color-sky-tint); }

  .hero { padding-top: clamp(128px, 14vh, 164px); padding-bottom: 54px; }
  .hero-grid { display: grid; min-height: min(690px, calc(100dvh - 174px)); grid-template-columns: .88fr 1.12fr; align-items: center; gap: clamp(44px, 5.5vw, 88px); }
  .hero-copy { padding-bottom: 22px; }
  .hero-title { max-width: 720px; margin: 0; font-size: clamp(3.8rem, 5.6vw, 5.7rem); font-weight: 600; letter-spacing: -.062em; line-height: .92; text-wrap: balance; }
  .hero-title span { position: relative; display: inline-block; z-index: 0; white-space: nowrap; }
  .hero-title span::after { position: absolute; z-index: -1; right: -.05em; bottom: .02em; left: -.05em; height: .22em; border-radius: 999px; background: var(--color-sky-wash); content: ''; opacity: .62; transform: rotate(-1.5deg); }
  .hero-promise { max-width: 610px; margin: 28px 0 0; font-size: clamp(1.15rem, 1.55vw, 1.35rem); font-weight: 680; letter-spacing: -.018em; line-height: 1.25; }
  .hero-body { max-width: 590px; margin: 12px 0 0; color: var(--slate); font-family: var(--serif); font-size: clamp(1.02rem, 1.35vw, 1.18rem); line-height: 1.58; }
  .hero-actions { display: flex; flex-wrap: wrap; align-items: center; gap: 18px; margin-top: 32px; }
  .hero-primary, .lead-submit { display: inline-flex; min-height: 48px; align-items: center; justify-content: center; gap: 18px; border: 0; border-radius: 8px; padding: 10px 18px; color: white; background: var(--color-notion-blue); font: inherit; font-size: .9rem; font-weight: 650; text-decoration: none; cursor: pointer; transition: background-color 180ms ease, transform 180ms ease; }
  .hero-primary:hover, .lead-submit:hover { background: #0065bd; transform: translateY(-2px); }
  .hero-primary span, .lead-submit span { font-size: 1.05rem; transition: transform 180ms ease; }
  .hero-primary:hover span { transform: translate(3px, 3px); }
  .lead-submit:hover span { transform: translateX(3px); }
  .hero-secondary { display: inline-flex; min-height: 44px; align-items: center; gap: 10px; border-bottom: 1px solid rgb(0 0 0 / 28%); padding: 10px 2px 8px; font-size: .9rem; font-weight: 650; text-decoration: none; transition: border-color 180ms ease, color 180ms ease; }
  .hero-secondary:hover { border-color: var(--color-notion-blue-strong); color: var(--color-notion-blue-strong); }
  .hero-support { display: flex; max-width: 600px; align-items: center; gap: 12px; margin: 24px 0 0; color: rgb(0 0 0 / 58%); font-size: .78rem; line-height: 1.45; }
  .hero-support span { display: grid; width: 36px; height: 36px; flex: 0 0 auto; place-items: center; border-radius: 50%; color: white; background: var(--color-midnight-ink); font-size: .68rem; font-weight: 750; letter-spacing: .04em; }
  .hero-capture { display: grid; gap: 12px; max-width: 640px; margin-top: 26px; border: 1px solid var(--line); border-radius: 12px; padding: 16px; background: rgb(255 255 255 / 70%); }
  .hero-capture__intro { display: grid; gap: 4px; }

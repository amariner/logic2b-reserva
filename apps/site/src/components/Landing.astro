---
import type { Locale } from '@logic-reserva/config';
import { logic2bContact } from '@logic-reserva/config/contact';
import { SITE_CONTENT } from '../content';

interface Props { locale?: Locale }

const { locale = 'es' } = Astro.props;
const c = SITE_CONTENT[locale];
const prefix = locale === 'en' ? '/en' : '';
const languageHref = locale === 'en' ? '/' : '/en/';
const contact = logic2bContact(locale, 'commercial');
const pageHref = (path: string) => `${prefix}${path}`;
const ui = locale === 'en' ? {
  mainNav: 'Main navigation', otherLanguage: 'es', mockupLabel: 'Logic Reserva service view preview', mockupDate: 'Friday 18 September', mockupService: 'Dinner service', live: 'Live', guests: 'guests', tables: 'tables', event: 'event', seated: 'Seated · Tasting menu', confirmed: 'Confirmed · Website', eventName: 'Wine pairing dinner', eventDetail: 'Tables 7 + 8 · 8 seats', productLinks: 'Product links', legalLinks: 'Legal links', cookies: 'Cookie preferences',
} : {
  mainNav: 'Navegación principal', otherLanguage: 'en', mockupLabel: 'Vista previa del servicio en Logic Reserva', mockupDate: 'Viernes, 18 de septiembre', mockupService: 'Servicio de cena', live: 'En vivo', guests: 'comensales', tables: 'mesas', event: 'evento', seated: 'Sentados · Menú degustación', confirmed: 'Confirmada · Desde la web', eventName: 'Cena maridaje', eventDetail: 'Mesas 7 + 8 · 8 plazas', productLinks: 'Enlaces de producto', legalLinks: 'Enlaces legales', cookies: 'Preferencias de cookies',
};
---

<div class="landing">
  <header class="site-header">
    <div class="shell nav-shell">
      <a class="brand-lockup" href={pageHref('/')} aria-label="Logic Reserva, inicio">
        <span class="brand-lockup__mark" aria-hidden="true">R</span>
        <span>Logic Reserva</span>
      </a>
      <nav class="main-nav" aria-label={ui.mainNav}>
        <a href="#problema">{c.nav.problem}</a>
        <a href="#diferenciales">{c.nav.differences}</a>
        <a href="#demos">{c.nav.demos}</a>
        <a href="#niveles">{c.nav.plans}</a>
        <a href="#preguntas">{c.nav.faq}</a>
      </nav>
      <div class="nav-actions">
        <a class="language-link" href={languageHref} lang={ui.otherLanguage}>{c.nav.language}</a>
        <a class="pill nav-cta" href="#contacto">{c.nav.contact}</a>
      </div>
    </div>
  </header>

  <main>
    <section class="hero shell" aria-labelledby="hero-title">
      <div class="character-row" aria-hidden="true">
        <span class="character character--coral">●</span><span class="character character--blue">✦</span><span class="character character--yellow">◡</span><span class="character character--sky">◆</span><span class="character character--coral">✺</span><span class="character character--blue">●</span><span class="character character--yellow">↗</span>
      </div>
      <p class="eyebrow">{c.hero.eyebrow}</p>
      <h1 id="hero-title" class="hero-title">
        {c.hero.beforeHighlight}<span>{c.hero.highlight}</span>{c.hero.afterHighlight}
      </h1>
      <p class="hero-body">{c.hero.body}</p>
      <div class="hero-actions">
        <a class="pill" href="#configurador">{c.hero.primary}</a>
        <a class="pill ghost" href="#demos">{c.hero.secondary}</a>
      </div>
      <p class="demo-note"><span aria-hidden="true"></span>{c.hero.note}</p>

      <div class="product-mockup artifact" aria-label={ui.mockupLabel}>
        <div class="mockup-sidebar">
          <div class="mockup-logo"><span>R</span><b>Solane</b></div>
          <div class="mockup-nav-line active"></div><div class="mockup-nav-line"></div><div class="mockup-nav-line short"></div>
          <div class="mockup-nav-line"></div><div class="mockup-nav-line short"></div>
        </div>
        <div class="mockup-main">
          <div class="mockup-topbar"><div><small>{ui.mockupDate}</small><strong>{ui.mockupService}</strong></div><span class="badge" data-tone="success">{ui.live}</span></div>
          <div class="service-summary"><div><b>42</b><span>{ui.guests}</span></div><div><b>6</b><span>{ui.tables}</span></div><div><b>1</b><span>{ui.event}</span></div></div>
          <div class="mockup-board">
            <article><span class="badge" data-tone="success">19:30</span><b>Mesa 3 · 3</b><small>{ui.seated}</small></article>
            <article><span class="badge" data-tone="warning">20:00</span><b>Mesa 1 · 2</b><small>{ui.confirmed}</small></article>
            <article class="event-card"><span class="badge" data-tone="danger">21:00</span><b>{ui.eventName}</b><small>{ui.eventDetail}</small></article>
          </div>
        </div>
      </div>
    </section>

    <section id="problema" class="section shell problem-section" aria-labelledby="problem-title">
      <div class="section-intro">
        <p class="eyebrow">{c.problem.eyebrow}</p>
        <h2 id="problem-title" class="heading">{c.problem.title}</h2>
        <p class="editorial">{c.problem.intro}</p>
      </div>
      <div class="stats-grid">
        {c.problem.stats.map((stat, index) => <article class={`stat-card stat-card--${index + 1}`}><strong>{stat.value}</strong><span>{stat.label}</span></article>)}
      </div>
      <p class="source-note">{c.problem.source}</p>
    </section>

    <section id="diferenciales" class="section shell" aria-labelledby="differences-title">
      <div class="section-intro centered">
        <p class="eyebrow">{c.differences.eyebrow}</p>
        <h2 id="differences-title" class="heading">{c.differences.title}</h2>
      </div>
      <div class="difference-grid">
        {c.differences.items.map((item) => (
          <article class={`difference-card difference-card--${item.tone}`}>
            <span>{item.number}</span><h3>{item.title}</h3><p>{item.body}</p>
          </article>
        ))}
      </div>
    </section>

    <section id="demos" class="section shell" aria-labelledby="demos-title">
      <div class="section-intro">
        <p class="eyebrow">{c.demos.eyebrow}</p>
        <h2 id="demos-title" class="heading">{c.demos.title}</h2>
        <p class="editorial">{c.demos.intro}</p>
      </div>
      <div class="demo-grid">
        {c.demos.items.map((demo, index) => (
          <article class={`demo-card demo-card--${demo.slug}`}>
            <div class="demo-card__preview" aria-hidden="true"><span>{demo.name.charAt(0)}</span><i></i><i></i><i></i></div>
            <div class="demo-card__copy"><span class="badge" data-tone={index === 0 ? 'warning' : index === 1 ? 'success' : 'info'}>{demo.level}</span><h3>{demo.name}</h3><h4>{demo.title}</h4><p>{demo.body}</p><a href={`${prefix}/demos/${demo.slug}/`}>{demo.action}<span aria-hidden="true"> →</span></a></div>
          </article>
        ))}
      </div>
    </section>

    <section id="niveles" class="section levels-section" aria-labelledby="levels-title">
      <div class="shell">
        <div class="section-intro centered">
          <p class="eyebrow">{c.levels.eyebrow}</p>
          <h2 id="levels-title" class="heading">{c.levels.title}</h2>
        </div>
        <div class="level-grid">
          {c.levels.items.map((level, index) => (
            <article class="level-card" data-level-card={level.id}>
              <span class="level-index">0{index + 1}</span><span class="level-maturity">{level.maturity}</span><h3>{level.name}</h3><p>{level.body}</p><small>{level.evidence}</small>
            </article>
          ))}
        </div>
        <p class="levels-link"><a href={pageHref('/planes/')}>{c.footer.plans}<span aria-hidden="true"> →</span></a></p>
      </div>
    </section>

    <section id="configurador" class="section shell tool-grid" aria-labelledby="config-title">
      <div class="tool-copy">
        <p class="eyebrow">{c.configurator.eyebrow}</p><h2 id="config-title" class="heading">{c.configurator.title}</h2><p class="editorial">{c.configurator.body}</p>
      </div>
      <form id="scope-form" class="tool-card card" data-description-basico={c.configurator.descriptions.basico} data-description-gestion={c.configurator.descriptions.gestion} data-description-inteligente={c.configurator.descriptions.inteligente}>
        <div class="field-row"><label>{c.configurator.fields.services}<select name="servicesPerDay"><option value="1">{c.configurator.fields.servicesOne}</option><option value="2" selected>{c.configurator.fields.servicesTwo}</option></select></label><label>{c.configurator.fields.seats}<input name="seats" type="number" min="1" max="1000" value="60" /></label></div>
        <div class="check-grid"><label><input name="wantsOnlineBooking" type="checkbox" checked />{c.configurator.fields.online}</label><label><input name="hasGroupsOrMenus" type="checkbox" checked />{c.configurator.fields.groups}</label><label><input name="noShowPain" type="checkbox" />{c.configurator.fields.noShow}</label><label><input name="wantsPrivateHire" type="checkbox" />{c.configurator.fields.privateHire}</label></div>
        <label>{c.configurator.fields.events}<input name="eventsPerMonth" type="range" min="0" max="12" value="0" /><output data-events-output>0</output></label>
        <div class="recommendation" aria-live="polite"><span>{c.configurator.resultPrefix}</span><strong data-recommendation-name>Gestión</strong><p data-recommendation-description>{c.configurator.descriptions.gestion}</p></div>
        <button class="pill" type="button" data-use-recommendation>{c.configurator.action}</button>
      </form>
    </section>

    <section class="section calculator-band" aria-labelledby="calculator-title">
      <div class="shell calculator-grid">
        <div><p class="eyebrow">{c.calculator.eyebrow}</p><h2 id="calculator-title" class="heading">{c.calculator.title}</h2><p class="editorial">{c.calculator.body}</p></div>
        <div class="calculator-card card">
          <label>{c.calculator.covers}<input id="covers-input" type="number" min="0" max="100000" step="10" value="1130" /></label>
          <div class="saving-row"><span>{c.calculator.monthly}</span><strong data-monthly-saving>3.390 €</strong></div><div class="saving-row"><span>{c.calculator.yearly}</span><strong data-yearly-saving>40.680 €</strong></div>
          <p class="estimate-label">{c.calculator.disclaimer}</p>
        </div>
      </div>
    </section>

    <section id="preguntas" class="section shell faq-section" aria-labelledby="faq-title">
      <div class="section-intro"><p class="eyebrow">{c.faq.eyebrow}</p><h2 id="faq-title" class="heading">{c.faq.title}</h2></div>
      <div class="faq-list">{c.faq.items.map((item, index) => <details open={index === 0}><summary>{item.question}<span aria-hidden="true">+</span></summary><p>{item.answer}</p></details>)}</div>
    </section>

    <section id="contacto" class="section shell contact-section" aria-labelledby="contact-title">
      <div class="contact-copy"><p class="eyebrow">{c.lead.eyebrow}</p><h2 id="contact-title" class="heading">{c.lead.title}</h2><p class="editorial">{c.lead.body}</p><a class="whatsapp-link" href={contact.href} target="_blank" rel="noreferrer">{c.lead.whatsapp}<span aria-hidden="true"> ↗</span></a></div>
      <form id="lead-form" class="lead-form card" novalidate>
        <div class="field-row"><label>{c.lead.fields.name}<input name="name" required autocomplete="name" /></label><label>{c.lead.fields.restaurant}<input name="restaurant" required autocomplete="organization" /></label></div>
        <div class="field-row"><label>{c.lead.fields.email}<input name="email" type="email" required autocomplete="email" /></label><label>{c.lead.fields.phone}<input name="phone" type="tel" autocomplete="tel" /></label></div>
        <label>{c.lead.fields.level}<select name="level" data-lead-level>{c.levels.items.map((level) => <option value={level.id} selected={level.id === 'gestion'}>{level.name}</option>)}</select></label>
        <label>{c.lead.fields.message}<textarea name="message" rows="4" required></textarea></label>
        <label class="privacy-check"><input name="privacyAccepted" type="checkbox" required /><span>{c.lead.fields.privacy} <a href={pageHref('/privacidad/')}>{c.footer.privacy}</a>.</span></label>
        <input name="website" class="honeypot" tabindex="-1" autocomplete="off" aria-hidden="true" />
        <button class="pill" type="submit">{c.lead.submit}</button>
        <p class="lead-status" data-lead-status data-disabled={c.lead.disabled} data-invalid={c.lead.invalid} data-failure={c.lead.failure} data-success={c.lead.success} data-limited={c.lead.limited} role="status"></p>
      </form>
    </section>
  </main>

  <footer class="site-footer">
    <div class="shell footer-grid"><div><a class="brand-lockup" href={pageHref('/')}><span class="brand-lockup__mark">R</span><span>Logic Reserva</span></a><p>{c.footer.line}</p></div><nav aria-label={ui.productLinks}><a href={pageHref('/planes/')}>{c.footer.plans}</a><a href={pageHref('/soluciones/restaurantes/')}>{c.footer.restaurants}</a><a href={pageHref('/soluciones/grupos-y-eventos/')}>{c.footer.groups}</a></nav><nav aria-label={ui.legalLinks}><a href={pageHref('/legal/')}>{c.footer.legal}</a><a href={pageHref('/privacidad/')}>{c.footer.privacy}</a><a href={pageHref('/cookies/')}>{c.footer.cookies}</a></nav></div>
    <div class="shell footer-bottom"><span>© 2026 Logic2B</span><span>{c.footer.demo}</span></div>
  </footer>

  <aside class="cookie-banner card" data-cookie-banner hidden aria-label={ui.cookies}>
    <p>{c.cookies.text}</p><div><button type="button" class="pill ghost" data-cookie-choice="necessary">{c.cookies.reject}</button><button type="button" class="pill" data-cookie-choice="analytics">{c.cookies.accept}</button></div>
  </aside>
</div>

<script>
  import { marketplaceSavings, recommendLevel, type PlanLevel } from '@logic-reserva/domain';

  const scopeForm = document.querySelector<HTMLFormElement>('#scope-form');
  const leadLevel = document.querySelector<HTMLSelectElement>('[data-lead-level]');
  let currentLevel: PlanLevel = 'gestion';

  const levelName = (level: PlanLevel): string => {
    const option = leadLevel?.querySelector<HTMLOptionElement>(`option[value="${level}"]`);
    return option?.textContent?.trim() ?? level;
  };

  const updateRecommendation = () => {
    if (!scopeForm) return;
    const field = <T extends HTMLInputElement | HTMLSelectElement>(name: string) => scopeForm.elements.namedItem(name) as T;
    const servicesValue = Number(field<HTMLSelectElement>('servicesPerDay').value);
    currentLevel = recommendLevel({
      servicesPerDay: servicesValue === 1 ? 1 : 2,
      seats: Math.max(1, Number(field<HTMLInputElement>('seats').value) || 1),
      wantsOnlineBooking: field<HTMLInputElement>('wantsOnlineBooking').checked,
      hasGroupsOrMenus: field<HTMLInputElement>('hasGroupsOrMenus').checked,
      eventsPerMonth: Math.max(0, Number(field<HTMLInputElement>('eventsPerMonth').value) || 0),
      noShowPain: field<HTMLInputElement>('noShowPain').checked,
      wantsPrivateHire: field<HTMLInputElement>('wantsPrivateHire').checked,
    });
    const name = scopeForm.querySelector<HTMLElement>('[data-recommendation-name]');
    const description = scopeForm.querySelector<HTMLElement>('[data-recommendation-description]');
    const eventsOutput = scopeForm.querySelector<HTMLOutputElement>('[data-events-output]');
    if (name) name.textContent = levelName(currentLevel);
    if (description) description.textContent = scopeForm.dataset[`description${currentLevel.charAt(0).toUpperCase()}${currentLevel.slice(1)}`] ?? '';
    if (eventsOutput) eventsOutput.value = field<HTMLInputElement>('eventsPerMonth').value;
  };

  scopeForm?.addEventListener('input', updateRecommendation);
  scopeForm?.querySelector('[data-use-recommendation]')?.addEventListener('click', () => {
    if (leadLevel) leadLevel.value = currentLevel;
    document.querySelector('#contacto')?.scrollIntoView({ behavior: 'smooth' });
    window.setTimeout(() => document.querySelector<HTMLInputElement>('#lead-form input[name="name"]')?.focus(), 350);
  });
  updateRecommendation();

  const coversInput = document.querySelector<HTMLInputElement>('#covers-input');
  const formatMoney = (cents: number) => new Intl.NumberFormat(document.documentElement.lang, { style: 'currency', currency: 'EUR', maximumFractionDigits: 0 }).format(cents / 100);
  const updateSavings = () => {
    const covers = Math.max(0, Math.trunc(Number(coversInput?.value) || 0));
    const estimate = marketplaceSavings(covers);
    const monthly = document.querySelector<HTMLElement>('[data-monthly-saving]');
    const yearly = document.querySelector<HTMLElement>('[data-yearly-saving]');
    if (monthly) monthly.textContent = formatMoney(estimate.monthlyCents);
    if (yearly) yearly.textContent = formatMoney(estimate.yearlyCents);
  };
  coversInput?.addEventListener('input', updateSavings);
  updateSavings();

  const leadForm = document.querySelector<HTMLFormElement>('#lead-form');
  const leadStatus = document.querySelector<HTMLElement>('[data-lead-status]');
  leadForm?.addEventListener('submit', async (event) => {
    event.preventDefault();
    if (!leadForm.checkValidity()) {
      if (leadStatus) leadStatus.textContent = leadStatus.dataset.invalid ?? '';
      leadForm.reportValidity();
      return;
    }
    const submit = leadForm.querySelector<HTMLButtonElement>('button[type="submit"]');
    if (submit) submit.disabled = true;
    try {
      const formData = new FormData(leadForm);
      const payload = {
        name: String(formData.get('name') ?? ''), restaurant: String(formData.get('restaurant') ?? ''),
        email: String(formData.get('email') ?? ''), phone: String(formData.get('phone') ?? ''),
        level: String(formData.get('level') ?? ''), message: String(formData.get('message') ?? ''),
        website: String(formData.get('website') ?? ''), accept: formData.get('privacyAccepted') === 'on',
        lang: document.documentElement.lang === 'en' ? 'en' : 'es',
      };
      const response = await fetch('/api/leads', { method: 'POST', headers: { 'content-type': 'application/json' }, body: JSON.stringify(payload) });
      const body = await response.json().catch(() => ({})) as { ref?: string };
      if (leadStatus) {
        if (response.status === 202) leadStatus.textContent = `${leadStatus.dataset.success ?? ''}${body.ref ? ` · ${body.ref}` : ''}`;
        else if (response.status === 429) leadStatus.textContent = leadStatus.dataset.limited ?? '';
        else if (response.status === 503) leadStatus.textContent = leadStatus.dataset.disabled ?? '';
        else leadStatus.textContent = leadStatus.dataset.failure ?? '';
      }
      if (response.status === 202) leadForm.reset();
    } catch {
      if (leadStatus) leadStatus.textContent = leadStatus.dataset.failure ?? '';
    } finally {
      if (submit) submit.disabled = false;
    }
  });

  const cookieBanner = document.querySelector<HTMLElement>('[data-cookie-banner]');
  try {
    if (cookieBanner && localStorage.getItem('logic-reserva-consent-v1') === null) cookieBanner.hidden = false;
    document.querySelectorAll<HTMLButtonElement>('[data-cookie-choice]').forEach((button) => button.addEventListener('click', () => {
      localStorage.setItem('logic-reserva-consent-v1', button.dataset.cookieChoice ?? 'necessary');
      if (cookieBanner) cookieBanner.hidden = true;
    }));
  } catch {
    if (cookieBanner) cookieBanner.hidden = false;
  }
</script>

<style>
  .landing { overflow: clip; background: var(--paper); }
  section[id] { scroll-margin-top: 84px; }
  .site-header { position: fixed; z-index: 50; top: 0; right: 0; left: 0; height: 64px; border-bottom: 1px solid var(--line); background: rgb(246 245 244 / 92%); box-shadow: var(--shadow-nav); backdrop-filter: blur(12px); }
  .nav-shell { display: flex; height: 100%; align-items: center; justify-content: space-between; gap: 20px; }
  .brand-lockup { display: inline-flex; align-items: center; gap: 10px; color: var(--ink); font-weight: 700; text-decoration: none; white-space: nowrap; }
  .brand-lockup__mark { display: grid; width: 30px; height: 30px; place-items: center; border: 1px solid var(--ink); border-radius: 8px; font-size: .88rem; }
  .main-nav { display: flex; align-items: center; gap: 2px; }
  .main-nav a, .language-link { border-radius: 8px; padding: 10px 12px; color: rgb(0 0 0 / 58%); font-size: .84rem; font-weight: 500; text-decoration: none; transition: color 200ms ease, background-color 200ms ease; }
  .main-nav a:hover, .language-link:hover { color: var(--ink); background: rgb(0 0 0 / 4%); }
  .nav-actions { display: flex; align-items: center; gap: 4px; }
  .nav-cta { min-height: 38px; }
  .hero { display: flex; min-height: 100vh; flex-direction: column; align-items: center; padding-top: clamp(132px, 16vh, 180px); text-align: center; }
  .character-row { display: flex; justify-content: center; gap: clamp(7px, 1.6vw, 16px); margin-bottom: 30px; }
  .character { display: grid; width: clamp(38px, 4vw, 48px); height: clamp(38px, 4vw, 48px); place-items: center; border: 2px solid currentColor; border-radius: 50%; background: #fff; font-size: 1.05rem; animation: character-bounce 3.6s ease-in-out infinite; }
  .character:nth-child(even) { animation-delay: -.9s; }.character:nth-child(3n) { animation-delay: -1.8s; }
  .character--coral { color: var(--color-coral); }.character--blue { color: var(--color-signal-blue); }.character--yellow { color: #c78200; }.character--sky { color: #3188d3; }
  @keyframes character-bounce { 0%, 100% { transform: translateY(0) rotate(-2deg); } 50% { transform: translateY(-7px) rotate(3deg); } }
  .hero .eyebrow { max-width: 64ch; }
  .hero-title { max-width: 1160px; margin: 0; font-size: clamp(3.6rem, 8.2vw, 7.3rem); font-weight: 600; letter-spacing: -.058em; line-height: .94; text-wrap: balance; }
  .hero-title span { display: inline-block; border-radius: var(--radius-pills); padding: .02em .22em .08em; background: var(--blush); white-space: nowrap; }
  .hero-body { max-width: 720px; margin: 30px auto 0; color: var(--slate); font-family: var(--serif); font-size: clamp(1.1rem, 1.8vw, 1.35rem); line-height: 1.55; }
  .hero-actions { display: flex; flex-wrap: wrap; justify-content: center; gap: 10px; margin-top: 30px; }
  .demo-note { display: flex; align-items: center; gap: 8px; margin: 20px 0 0; color: rgb(0 0 0 / 48%); font-size: .76rem; }
  .demo-note span { width: 7px; height: 7px; border-radius: 50%; background: var(--state-warning); }
  .product-mockup { display: grid; width: min(1120px, 100%); min-height: 510px; grid-template-columns: 210px 1fr; margin-top: 64px; overflow: hidden; text-align: left; }
  .mockup-sidebar { padding: 24px 18px; border-right: 1px solid var(--line); background: #fafafa; }
  .mockup-logo { display: flex; align-items: center; gap: 10px; margin-bottom: 40px; }.mockup-logo span { display: grid; width: 30px; height: 30px; place-items: center; border-radius: 8px; color: white; background: var(--color-midnight-ink); }
  .mockup-nav-line { width: 78%; height: 9px; margin: 22px 8px; border-radius: 8px; background: #d8d6d4; }.mockup-nav-line.short { width: 54%; }.mockup-nav-line.active { height: 34px; width: 100%; margin: 0 0 22px; background: var(--color-sky-tint); }

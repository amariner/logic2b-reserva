  .faq-list summary { display: flex; align-items: center; justify-content: space-between; gap: 20px; padding: 22px 0; cursor: pointer; font-size: 1.08rem; font-weight: 650; list-style: none; }
  .faq-list summary::-webkit-details-marker { display: none; }
  .faq-list summary span { font-size: 1.5rem; transition: transform 200ms ease; }
  .faq-list details[open] summary span { transform: rotate(45deg); }
  .faq-list p { margin: 0; padding: 0 40px 24px 0; color: var(--slate); font-family: var(--serif); line-height: 1.6; }
  .closing-section { padding-top: clamp(82px, 9vw, 126px); padding-bottom: 0; color: white; background: var(--color-midnight-ink); }
  .closing-showcase { display: grid; min-height: 650px; grid-template-columns: .82fr 1.18fr; align-items: center; gap: clamp(42px, 7vw, 100px); padding-bottom: clamp(74px, 8vw, 112px); }
  .closing-copy .eyebrow { color: var(--color-marigold); }
  .closing-copy .heading { color: white; }
  .closing-copy > p:not(.eyebrow) { max-width: 54ch; color: rgb(255 255 255 / 72%); font-family: var(--serif); font-size: 1.08rem; line-height: 1.6; }
  .closing-proof-list { display: grid; gap: 10px; margin: 24px 0 0; padding: 0; list-style: none; }
  .closing-proof-list li { display: flex; align-items: center; gap: 10px; color: rgb(255 255 255 / 88%); font-size: .8rem; font-weight: 700; }
  .closing-proof-list li span { display: grid; width: 22px; height: 22px; place-items: center; border: 1px solid rgb(255 255 255 / 32%); border-radius: 50%; color: var(--color-marigold); font-size: .68rem; }
  .closing-copy > div { display: flex; flex-wrap: wrap; gap: 8px; margin-top: 30px; }
  .closing-copy > div a { display: flex; min-height: 48px; align-items: center; gap: 18px; border: 1px solid rgb(255 255 255 / 25%); border-radius: 999px; padding: 10px 16px; color: white; font-size: .78rem; font-weight: 700; text-decoration: none; }
  .closing-copy > div a:first-child { color: var(--ink); border-color: var(--color-marigold); background: var(--color-marigold); }
  .closing-visual { position: relative; min-width: 0; min-height: 540px; }
  .closing-visual figure { position: absolute; overflow: hidden; margin: 0; border: 1px solid rgb(255 255 255 / 25%); border-radius: 12px; background: #eef0f5; box-shadow: 0 32px 70px rgb(0 0 0 / 28%); }
  .closing-visual img { display: block; width: 100%; height: 100%; object-fit: cover; object-position: center top; }
  .closing-visual figcaption { display: flex; min-height: 42px; align-items: center; padding: 8px 12px; color: white; background: rgb(7 14 43 / 96%); font-size: .68rem; }
  .closing-desktop { top: 18px; right: 0; left: 0; }
  .closing-desktop img { aspect-ratio: 1.52 / 1; }
  .closing-mobile { z-index: 2; right: -14px; bottom: 0; width: 31%; }
  .closing-mobile img { aspect-ratio: .46 / 1; }
  .contact-grid { display: grid; grid-template-columns: .78fr 1.22fr; gap: clamp(40px, 8vw, 120px); padding-block: clamp(72px, 8vw, 108px); color: var(--ink); background: var(--paper); }
  .contact-grid::before { position: absolute; z-index: -1; top: 0; bottom: 0; left: 50%; width: 100vw; background: var(--paper); content: ''; transform: translateX(-50%); }
  .contact-grid { position: relative; z-index: 0; }
  .whatsapp-link { display: inline-flex; min-height: 44px; align-items: center; font-weight: 650; text-decoration: none; }
  .whatsapp-link:hover { color: var(--color-notion-blue-strong); }
  .contact-copy .whatsapp-link { margin-top: 26px; }
  .contact-grid .contact-copy .heading { color: var(--ink); }
  .lead-status { min-height: 44px; margin: 14px 0 0; color: var(--state-warning); font-size: .82rem; line-height: 1.5; }
  .honeypot { position: absolute; left: -9999px; }


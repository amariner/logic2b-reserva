---
import type { Locale } from '@logic-reserva/config';
import { COMMERCIAL_PLANS, IMPLEMENTATION_PATH, commercialContactUrl, commercialDemoUrl, localizedCommercialText, type CommercialText } from '@logic-reserva/config/commercial';
import { GUIDE_CATALOG, guideUrl, localizedGuideText, type GuideText } from '@logic-reserva/config/guides';
import { PANEL_CATALOG, localizedPanelText, panelContactUrl, panelDemoUrl, panelDetailUrl, type PanelText } from '@logic-reserva/config/panels';
import { THEME_CATALOG, localizedThemeText, themeContactUrl, themeDetailUrl, themeUrl, type ThemeText } from '@logic-reserva/config/themes';
import { SITE_CONTENT } from '../content';
import CommercialFooter from './CommercialFooter.astro';
import CommercialHeader from './CommercialHeader.astro';
import CommercialClosing from './CommercialClosing.astro';
import CommercialPreviewDialog from './CommercialPreviewDialog.astro';
import CommercialTour from './CommercialTour.astro';
import CookiePreferences from './CookiePreferences.astro';

interface Props { locale?: Locale }

const { locale = 'es' } = Astro.props;
const c = SITE_CONTENT[locale];
const prefix = locale === 'en' ? '/en' : '';
const pageHref = (path: string) => `${prefix}${path}`;
const localCommercial = (value: CommercialText) => localizedCommercialText(value, locale);
const localTheme = (value: ThemeText) => localizedThemeText(value, locale);
const localPanel = (value: PanelText) => localizedPanelText(value, locale);
const localGuide = (value: GuideText) => localizedGuideText(value, locale);
const demoDomain = locale === 'en' ? 'yourdomain.com' : 'tudominio.com';
const themePreview = (slug: string, _depth: string, index: number) => {
  const theme = THEME_CATALOG[index] ?? THEME_CATALOG.find((entry) => entry.slug === slug);
  return theme ? `/images/screens/${theme.screenshotBase}-desktop.png` : '/images/screens/18-logic-reserva-home-desktop.png';
};
const ui = locale === 'en' ? {
  mainNav: 'Main navigation', otherLanguage: 'es', menu: 'Menu', product: 'How it works', productLinks: 'Product links', legalLinks: 'Legal links', flowLabel: 'One availability view', flow: ['Guest books', 'Inventory updates', 'Floor team decides'], restaurantSolution: 'Restaurant bookings', groupSolution: 'Groups and events', productView: 'Product view', productTitle: 'The event takes up tables too.', productDetail: 'Publish a dinner and the booking engine stops offering the tables it uses.', productAction: 'Open this scenario', productAlt: 'Solane floor plan showing tables reserved for service and a wine pairing event', inventoryAction: 'Open inventory', productEvidence: 'Product journey · demo data', contact: 'Contact', guides: 'Guides',
  offersEyebrow: 'Three commercial starting points', offersTitle: 'Start where the operation hurts most.', offersIntro: 'The same product can begin with an owned website, a shared operation or advanced decision support. Scope and price are defined in a proposal.', offersFor: 'A fit when', offersIncludes: 'First capabilities', offersContact: 'Discuss this plan', offersDemo: 'Open evidence', offersAll: 'Compare scope and implementation',
  portfolioEyebrow: 'Twelve ways to welcome', portfolioTitle: 'The system adapts. The restaurant keeps its identity.', portfolioIntro: 'Twelve fictional directions show how format, occasion and tone change the website. Three open the complete booking and management journey.', portfolioAll: 'Explore all twelve websites', portfolioDeep: 'Full journey', portfolioWeb: 'Website direction', portfolioDetails: 'View website details', portfolioOpen: 'Open website', portfolioPreview: 'Preview website', previewThemeTone: 'Visual direction', previewThemeJourney: 'Navigable scope', previewThemeJourneyDeep: 'Website, booking and management journey', previewThemeJourneyWeb: 'Complete responsive website direction', previewThemeBoundary: 'Fictional brand and content. Domain, materials and real enquiry delivery are defined per project.', previewWantWebsite: 'I want a website like this', previewResponsive: 'Responsive',
  panelsEyebrow: 'Product before promises', panelsTitle: 'Six views built around restaurant decisions.', panelsIntro: 'Each panel starts with a job the team needs to do and links to a reproducible state in Vedra or Solane.', panelsAll: 'Explore all product views', panelsDecision: 'Decision', panelsLevelManagement: 'Management', panelsLevelIntelligent: 'Intelligent', panelsDetails: 'View product details', panelsOpen: 'Open view', panelsPreview: 'Preview panel', previewPanelEvidence: 'Demonstrated evidence', previewBoundary: 'Current boundary', previewWantPanel: 'I want this product view', previewReproducible: 'Reproducible state',
  implementationEyebrow: 'Guided implementation', implementationTitle: 'From restaurant context to an accepted launch.', implementationIntro: 'Each stage names what would be reviewed, who validates it and which commitments still depend on an approved proposal.', implementationOwner: 'Owner', implementationAll: 'Review scope, maintenance and responsibilities',
  guidesEyebrow: 'Five roles, one shared contract', guidesTitle: 'The guide changes with who has to decide.', guidesIntro: 'Floor, operations, management, ownership and technical teams can prepare their part before implementation begins.', guidesFor: 'For', guidesOpen: 'Open guide', guidesAll: 'Read all implementation guides',
  closingEyebrow: 'See the operation before defining scope', closingTitle: 'Open a real product view. Then tell us what needs ordering.', closingIntro: 'The screens use fictional data and local state, but the decisions are specific: service, floor, groups, events and explainable reports.', closingProof: ['Website under your own brand', 'One view of service capacity', 'Implementation defined with Logic2B'], closingDesktop: 'Desktop · Solane shared inventory', closingMobile: 'Mobile · Vedra group journey', closingDemo: 'Open the guided demo', closingContact: 'Or define my starting point',
  exploreLinks: 'Explore', demoLinks: 'Working demos', companyLinks: 'Logic Reserva', footerPortfolio: '12 website directions', footerPanels: '6 product views', footerGuides: '5 role guides', footerBasic: 'Brasca · Basic', footerManagement: 'Vedra · Management', footerIntelligent: 'Solane · Intelligent', footerLanguage: 'Español', footerHome: 'Home', footerContact: 'Contact',
  } : {
  mainNav: 'Navegación principal', otherLanguage: 'en', menu: 'Menú', product: 'Cómo funciona', productLinks: 'Enlaces de producto', legalLinks: 'Enlaces legales', flowLabel: 'Una sola disponibilidad', flow: ['El cliente reserva', 'El inventario se actualiza', 'Sala decide'], restaurantSolution: 'Reservas de restaurante', groupSolution: 'Grupos y eventos', productView: 'Vista de producto', productTitle: 'El evento también ocupa mesa.', productDetail: 'Publica una cena y el motor deja de ofrecer las mesas que utiliza.', productAction: 'Abrir este escenario', productAlt: 'Plano de Solane con mesas reservadas para el servicio y para una cena maridaje', inventoryAction: 'Abrir inventario', productEvidence: 'Recorrido de producto · datos demo', contact: 'Contactar', guides: 'Guías',
  offersEyebrow: 'Tres puntos de partida comerciales', offersTitle: 'Empieza donde más duele la operativa.', offersIntro: 'El mismo producto puede empezar por una web propia, una operación compartida o apoyo avanzado a la decisión. Alcance y precio se concretan en propuesta.', offersFor: 'Encaja cuando', offersIncludes: 'Primeras capacidades', offersContact: 'Hablar de este plan', offersDemo: 'Abrir evidencia', offersAll: 'Comparar alcance e implantación',
  portfolioEyebrow: 'Doce formas de recibir', portfolioTitle: 'El sistema se adapta. El restaurante conserva su identidad.', portfolioIntro: 'Doce direcciones ficticias muestran cómo cambian la web, la ocasión y el tono según el formato. Tres abren el recorrido completo de reserva y gestión.', portfolioAll: 'Explorar las doce webs', portfolioDeep: 'Recorrido completo', portfolioWeb: 'Dirección web', portfolioDetails: 'Ver ficha de la web', portfolioOpen: 'Abrir web', portfolioPreview: 'Previsualizar web', previewThemeTone: 'Dirección visual', previewThemeJourney: 'Alcance navegable', previewThemeJourneyDeep: 'Web, reserva y recorrido de gestión', previewThemeJourneyWeb: 'Dirección web responsive completa', previewThemeBoundary: 'Marca y contenidos ficticios. Dominio, materiales y recepción real de solicitudes se definen por proyecto.', previewWantWebsite: 'Quiero una web así', previewResponsive: 'Responsive',
  panelsEyebrow: 'Producto antes que promesas', panelsTitle: 'Seis vistas construidas alrededor de decisiones de restaurante.', panelsIntro: 'Cada panel parte de una tarea que el equipo necesita resolver y enlaza un estado reproducible de Vedra o Solane.', panelsAll: 'Explorar todas las vistas', panelsDecision: 'Decisión', panelsLevelManagement: 'Gestión', panelsLevelIntelligent: 'Inteligente', panelsDetails: 'Ver ficha del panel', panelsOpen: 'Abrir vista', panelsPreview: 'Previsualizar panel', previewPanelEvidence: 'Evidencia demostrada', previewBoundary: 'Límite actual', previewWantPanel: 'Quiero esta vista de producto', previewReproducible: 'Estado reproducible',
  implementationEyebrow: 'Implantación guiada', implementationTitle: 'Del contexto del restaurante a un lanzamiento aceptado.', implementationIntro: 'Cada etapa nombra qué se revisaría, quién lo valida y qué compromisos siguen dependiendo de una propuesta aprobada.', implementationOwner: 'Responsable', implementationAll: 'Revisar alcance, mantenimiento y responsabilidades',
  guidesEyebrow: 'Cinco roles, un contrato compartido', guidesTitle: 'La guía cambia según quién tenga que decidir.', guidesIntro: 'Sala, gestión, dirección, propiedad y técnica pueden preparar su parte antes de que empiece la implantación.', guidesFor: 'Para', guidesOpen: 'Abrir guía', guidesAll: 'Leer todas las guías de implantación',
  closingEyebrow: 'Ver la operativa antes de definir alcance', closingTitle: 'Abre una vista real de producto. Después, cuéntanos qué necesitas ordenar.', closingIntro: 'Las pantallas usan datos ficticios y estado local, pero las decisiones son específicas: servicio, plano, grupos, eventos e informes explicables.', closingProof: ['Web bajo tu propia marca', 'Una sola capacidad de servicio', 'Implantación definida con Logic2B'], closingDesktop: 'Escritorio · Inventario compartido de Solane', closingMobile: 'Móvil · Recorrido de grupo de Vedra', closingDemo: 'Abrir la demo guiada', closingContact: 'O definir mi punto de partida',
  exploreLinks: 'Explorar', demoLinks: 'Demos navegables', companyLinks: 'Logic Reserva', footerPortfolio: '12 direcciones web', footerPanels: '6 vistas de producto', footerGuides: '5 guías por rol', footerBasic: 'Brasca · Básico', footerManagement: 'Vedra · Gestión', footerIntelligent: 'Solane · Inteligente', footerLanguage: 'English', footerHome: 'Inicio', footerContact: 'Contacto',
};
const parity = c.parity;
const themeCards = THEME_CATALOG.map((theme, index) => ({
  theme,
  image: themePreview(theme.slug, theme.depth, index),
}));
const themeColumns = [
  themeCards.filter((_, index) => index % 2 === 0),
  themeCards.filter((_, index) => index % 2 === 1),
];
---

<div class="landing">
  <CommercialHeader locale={locale} home />

  <main id="contenido" tabindex="-1">
    <section class="hero" aria-labelledby="hero-title" data-home-block="hero">
      <div class="shell hero-grid">
        <div class="hero-copy">
          <p class="eyebrow">{c.hero.eyebrow}</p>
          <h1 id="hero-title" class="hero-title" aria-label={parity.heroAria}>
            <span class="hero-title__line" aria-hidden="true">{parity.heroBefore}</span>
            <span class="hero-word-window" aria-hidden="true">
              <span class="hero-word-counter">
                {[...parity.heroWords, parity.heroWords[0]].map((word) => <span>{word}</span>)}
              </span>
            </span>
            <span class="hero-title__line" aria-hidden="true">{parity.heroAfter}</span>
          </h1>
          <p class="hero-promise">{c.hero.promise}</p>
          <p class="hero-body">{c.hero.body}</p>
          <form id="brief-lead-form" class="hero-lead-form" action={`${prefix}/empezar/`} method="get" data-brief-transition data-brief-target={`${prefix}/empezar/`}>
            <label class="sr-only" for={`brief-email-${locale}`}>{c.hero.briefEmail}</label>
            <input id={`brief-email-${locale}`} data-brief-email type="email" required autocomplete="email" placeholder={c.hero.briefEmail} aria-describedby={`brief-help-${locale}`} />
            <button type="submit">{c.hero.briefSubmit}<span aria-hidden="true">→</span></button>
          </form>
          <p class="brief-boundary"><span aria-hidden="true">✓</span>{c.hero.briefBoundary}</p>
          <span id={`brief-help-${locale}`} class="sr-only">{c.hero.briefBody}</span>
          <ul class="hero-shortcuts" aria-label={c.hero.proofLabel}>
            <li><a href={`${prefix}/demos/vedra/`}><span aria-hidden="true">✓</span>{parity.heroShortcutDemo}</a></li>
            <li><button type="button" data-tour-trigger aria-haspopup="dialog"><span aria-hidden="true">✓</span>{parity.heroShortcutTour}</button></li>
            <li><a href={`${prefix}/demos/solane/gestion/?vista=servicio`}><span aria-hidden="true">✓</span>{parity.heroShortcutManager}</a></li>
          </ul>
          <p class="demo-note">{c.hero.note}</p>
        </div>

        <div class="hero-product" data-theme-motion data-paused="false">
          <button class="hero-motion-toggle" type="button" aria-label={parity.heroPause} aria-pressed="false" data-theme-motion-toggle data-pause-label={parity.heroPause} data-resume-label={parity.heroResume}>
            <span data-pause-icon aria-hidden="true">Ⅱ</span><span data-play-icon aria-hidden="true">▶</span>
          </button>
          {themeColumns.map((column, columnIndex) => (
            <div class:list={['theme-rail-column', columnIndex === 0 ? 'theme-rail-column--down' : 'theme-rail-column--up']}>
              <div class="theme-rail-track">
                {[...column, ...column].map(({ theme, image }, index) => (
                  <article class="theme-rail-card" aria-hidden={index >= column.length ? 'true' : undefined}>
                    <a
                      href={themeDetailUrl(theme.slug, locale)}
                      tabindex={index >= column.length ? -1 : undefined}
                      aria-label={`${ui.portfolioPreview}: ${theme.name}`}
                      data-commercial-preview-trigger
                      data-preview-kind={theme.depth === 'deep' ? ui.portfolioDeep : ui.portfolioWeb}
                      data-preview-address={`${theme.slug}.${demoDomain}`}
                      data-preview-tag-one={localTheme(theme.level)}
                      data-preview-tag-two={ui.previewResponsive}
                      data-preview-tag-three={localTheme(theme.format)}
                      data-preview-title={theme.name}
                      data-preview-body={localTheme(theme.promise)}
                      data-preview-image={image}
                      data-preview-alt={`${theme.name} · ${localTheme(theme.format)}`}
                      data-preview-caption={`${localTheme(theme.format)} · ${localTheme(theme.location)}`}
                      data-preview-url={themeUrl(theme.slug, locale)}
                      data-preview-action={ui.portfolioOpen}
                      data-preview-detail-label={ui.previewThemeTone}
                      data-preview-detail={localTheme(theme.tone)}
                      data-preview-evidence-label={ui.previewThemeJourney}
                      data-preview-evidence={theme.depth === 'deep' ? ui.previewThemeJourneyDeep : ui.previewThemeJourneyWeb}
                      data-preview-limit-label={ui.previewBoundary}
                      data-preview-limit={ui.previewThemeBoundary}
                      data-preview-contact-action={ui.previewWantWebsite}
                      data-preview-contact-url={themeContactUrl(theme.slug, locale)}
                    >
                      <span class="theme-rail-visual" style={`--theme-paper:${theme.palette.paper};--theme-ink:${theme.palette.ink};--theme-accent:${theme.palette.accent}`}>
                        <img src={image} alt="" width="640" height="480" loading={columnIndex === 0 && index === 0 ? 'eager' : 'lazy'} decoding="async" />
                        <span class="theme-rail-browser"><i></i><i></i><i></i><b>{theme.mark}</b></span>
                      </span>
                      <span class="theme-rail-meta"><strong>{theme.name}</strong><small>{theme.depth === 'deep' ? ui.portfolioDeep : ui.portfolioWeb}</small></span>
                    </a>
                  </article>
                ))}
              </div>
            </div>
          ))}
          <a class="theme-rail-link" href={pageHref('/temas/')}>{ui.portfolioAll}<span aria-hidden="true">→</span></a>
          <div class="theme-rail-fade" aria-hidden="true"></div>
        </div>
      </div>
      <div class="shell hero-flow" aria-label={ui.flowLabel}>
        <strong>{ui.flowLabel}</strong>
        {ui.flow.map((step, index) => <span><i>0{index + 1}</i>{step}</span>)}
      </div>
    </section>

    <section id="ecosistema" class="ecosystem-section" aria-labelledby="ecosystem-title" data-home-block="ecosystem">
      <div class="shell ecosystem-intro">
        <div><p class="eyebrow">{c.ecosystem.eyebrow}</p><h2 id="ecosystem-title">{c.ecosystem.title}</h2></div>
        <p>{c.ecosystem.body}</p>
      </div>
      <div class="ecosystem-rail" role="list" aria-label={c.ecosystem.label}>
        <div class="ecosystem-track">
          {c.ecosystem.items.map((item) => (
            <article role="listitem" class="ecosystem-item" data-tone={item.tone}>
              <span class="ecosystem-mark" aria-hidden="true">{item.name.slice(0, 2)}</span>
              <div><strong>{item.name}</strong><small>{item.detail}</small></div>
              <span class="ecosystem-status">{item.status}</span>
            </article>
          ))}
        </div>
      </div>
    </section>

    <section id="recorrido" class="section shell journey-section" aria-labelledby="journey-title" data-home-block="journey">
      <div class="journey-intro">
        <div>
          <p class="eyebrow">{c.productFlow.eyebrow}</p>
          <h2 id="journey-title" class="heading">{c.productFlow.title}</h2>
        </div>
        <p class="editorial">{c.productFlow.intro}</p>
      </div>
      <div class="journey-controls" data-journey-controls hidden>
        <button type="button" data-journey-previous aria-label={c.productFlow.previous}><span aria-hidden="true">←</span></button>
        <span aria-hidden="true">01—07</span>
        <button type="button" data-journey-next aria-label={c.productFlow.next}><span aria-hidden="true">→</span></button>
      </div>
      <div class="journey-viewport" data-journey-viewport tabindex="0" aria-label={c.productFlow.label}>
        <ol class="journey-track">
          {c.productFlow.steps.map((step, index) => (
            <li class={`journey-step journey-step--${step.id}`} data-journey-step>
              <div class="journey-step__top"><span>0{index + 1}</span><i aria-hidden="true">→</i></div>
              <p>{step.label}</p>
              <h3>{step.title}</h3>
              <div class="journey-step__body">{step.body}</div>
            </li>
          ))}
        </ol>
      </div>
    </section>

    <section id="plataforma" class="section platform-section" aria-labelledby="platform-title" data-home-block="platform">
      <div class="shell platform-shell">
        <div class="platform-intro">
          <div>
            <p class="eyebrow">{c.platform.eyebrow}</p>
            <h2 id="platform-title" class="heading">{c.platform.title}</h2>
          </div>
          <p class="editorial">{c.platform.intro}</p>
        </div>
        <nav class="platform-tabs" data-platform-tabs aria-label={c.platform.tabsLabel}>
          {c.platform.items.map((moment, index) => (
            <a href={`#moment-${moment.id}`} data-platform-tab data-platform-target={moment.id} class={index === 0 ? 'is-active' : undefined}>
              <span>0{index + 1}</span>{moment.label}
            </a>
          ))}
        </nav>
        <div class="platform-panels" data-platform-panels>
          {c.platform.items.map((moment, index) => (
            <article id={`moment-${moment.id}`} class="platform-panel" data-platform-panel data-platform-id={moment.id} data-active={index === 0 ? '' : undefined}>
              <div class="platform-panel__copy">
                <div class="platform-panel__meta"><span>{c.platform.resultLabel}</span><span class="maturity-status" data-tone={moment.tone}>{moment.status}</span></div>
                <h3>{moment.result}</h3>
                <div class="platform-capabilities">
                  <p>{c.platform.capabilitiesLabel}</p>
                  <ul>{moment.capabilities.map((capability) => <li>{capability}</li>)}</ul>
                </div>
                <div class="platform-limit"><span>{c.platform.limitLabel}</span><p>{moment.limit}</p></div>
                <a class="platform-action" href={pageHref(moment.href)}>{moment.action}<span aria-hidden="true">↗</span></a>
              </div>
              <figure class="platform-evidence artifact">
                <div class="platform-evidence__bar"><span>{c.platform.evidenceLabel}</span><span>{moment.label} · {moment.status}</span></div>
                <picture>
                  <source media="(max-width: 640px)" srcset={`/images/screens/${moment.image}-mobile.png`} />
                  <img src={`/images/screens/${moment.image}-desktop.png`} alt={moment.alt} width="1366" height="900" loading="lazy" decoding="async" />
                </picture>
              </figure>
            </article>
          ))}
        </div>
      </div>
    </section>

    <section id="conexiones" class="section shell connections-section" aria-labelledby="connections-title" data-home-block="connections">
      <div class="connections-intro">
        <div>
          <p class="eyebrow">{c.connections.eyebrow}</p>
          <h2 id="connections-title" class="heading">{c.connections.title}</h2>
        </div>
        <p class="editorial">{c.connections.intro}</p>
      </div>
      <div class="connections-grid" role="list" aria-label={c.connections.label}>
        {c.connections.families.map((family, familyIndex) => (
          <article class={`connection-family connection-family--${family.id}`} role="listitem">
            <div class="connection-family__heading"><span>0{familyIndex + 1}</span><div><h3>{family.title}</h3><p>{family.body}</p></div></div>
            <ul>
              {family.items.map((item) => (
                <li>
                  <div><strong>{item.name}</strong><span>{item.detail}</span></div>
                  <span class="maturity-status" data-tone={item.tone}>{item.status}</span>
                </li>
              ))}
            </ul>
          </article>
        ))}
      </div>
    </section>

    <section id="planes" class="section offers-section" aria-labelledby="offers-title" data-home-block="plans">
      <div class="shell">
        <div class="offers-intro">
          <div><p class="eyebrow">{ui.offersEyebrow}</p><h2 id="offers-title" class="heading">{ui.offersTitle}</h2></div>
          <p class="editorial">{ui.offersIntro}</p>
        </div>
        <div class="pricing-toggle" role="group" aria-label={parity.pricingLabel} data-pricing-toggle>
          <button type="button" class="is-active" aria-pressed="true" data-pricing-mode="start">{parity.pricingMode}</button>
          <button type="button" aria-pressed="false" data-pricing-mode="evolution">{parity.pricingContinuity}</button>
        </div>
        <div class="offer-grid">
          {COMMERCIAL_PLANS.map((plan, index) => (
            <article class="offer-card" data-plan={plan.slug}>
              <div class="offer-card__top"><span>0{index + 1}</span><span>{localCommercial(plan.eyebrow)}</span></div>
              <h3>{localCommercial(plan.name)}</h3><p class="offer-promise">{localCommercial(plan.promise)}</p>
              <dl><div><dt>{ui.offersFor}</dt><dd>{localCommercial(plan.bestFor)}</dd></div></dl>
              <div class="offer-capabilities" data-pricing-start><strong>{ui.offersIncludes}</strong><ul>{plan.capabilities.slice(0, 2).map((capability) => <li>{localCommercial(capability)}</li>)}</ul></div>
              <div class="offer-capabilities offer-capabilities--evolution" data-pricing-evolution hidden><strong>{parity.pricingContinuity}</strong><p>{localCommercial(plan.nextStep)}</p><small>{localCommercial(plan.boundary)}</small></div>
              <div class="offer-actions">
                <a class="offer-contact" href={commercialContactUrl(plan, locale)}>{ui.offersContact} · {localCommercial(plan.name)}<span aria-hidden="true">→</span></a>
                <a class="offer-demo" href={commercialDemoUrl(plan, locale)}>{ui.offersDemo} · {plan.demo.name}<span aria-hidden="true">↗</span></a>
              </div>
            </article>
          ))}
        </div>
        <a class="offers-all" href={pageHref('/planes/')}>{ui.offersAll}<span aria-hidden="true">→</span></a>
      </div>
    </section>

    <section id="portfolio" class="section shell portfolio-section" aria-labelledby="portfolio-title" data-home-block="portfolio" data-card-slider>
      <div class="catalogue-intro">
        <div><p class="eyebrow">{ui.portfolioEyebrow}</p><h2 id="portfolio-title" class="heading">{ui.portfolioTitle}</h2></div>
        <p class="editorial">{ui.portfolioIntro}</p>
      </div>
      <div class="catalogue-controls" aria-label={parity.themeSliderLabel}>
        <button type="button" aria-label={parity.sliderPrevious} data-card-prev disabled>←</button>
        <button type="button" aria-label={parity.sliderNext} data-card-next>→</button>
      </div>
      <div class="portfolio-grid" role="list" data-card-viewport tabindex="0">
        {THEME_CATALOG.map((theme, index) => (
          <article
            class:list={['portfolio-card', theme.depth === 'deep' && 'portfolio-card--deep']}
            role="listitem"
            style={`--portfolio-primary:${theme.palette.primary};--portfolio-accent:${theme.palette.accent};--portfolio-paper:${theme.palette.paper}`}
          >
            <a class="portfolio-card__surface" href={themeDetailUrl(theme.slug, locale)} aria-label={`${ui.portfolioDetails}: ${theme.name}`}>
              <picture><img src={themePreview(theme.slug, theme.depth, index)} alt="" width="640" height="480" loading="lazy" decoding="async" /></picture>
              <span class="portfolio-card__index">{String(index + 1).padStart(2, '0')}</span>

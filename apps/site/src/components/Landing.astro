<script>
  const briefTransition = document.querySelector<HTMLFormElement>('[data-brief-transition]');
  briefTransition?.addEventListener('submit', (event) => {
    const email = briefTransition.querySelector<HTMLInputElement>('[data-brief-email]');
    const target = briefTransition.dataset.briefTarget;
    if (!email || !target || !briefTransition.checkValidity()) return;
    event.preventDefault();
    const destination = new URL(target, window.location.origin);
    destination.hash = new URLSearchParams({ email: email.value.trim() }).toString();
    window.location.assign(`${destination.pathname}${destination.hash}`);
  });

  const journeyViewport = document.querySelector<HTMLElement>('[data-journey-viewport]');
  const journeyControls = document.querySelector<HTMLElement>('[data-journey-controls]');
  const journeyPrevious = journeyControls?.querySelector<HTMLButtonElement>('[data-journey-previous]');
  const journeyNext = journeyControls?.querySelector<HTMLButtonElement>('[data-journey-next]');
  const reducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)');
  const compactJourney = window.matchMedia('(max-width: 860px)');

  const updateJourneyControls = () => {
    if (!journeyViewport || !journeyControls) return;
    const scrollable = compactJourney.matches && journeyViewport.scrollWidth > journeyViewport.clientWidth + 2;
    journeyControls.hidden = !scrollable;
    if (!scrollable) return;
    if (journeyPrevious) journeyPrevious.disabled = journeyViewport.scrollLeft <= 2;
    if (journeyNext) journeyNext.disabled = journeyViewport.scrollLeft + journeyViewport.clientWidth >= journeyViewport.scrollWidth - 2;
  };
  const moveJourney = (direction: -1 | 1) => {
    if (!journeyViewport) return;
    const step = journeyViewport.querySelector<HTMLElement>('[data-journey-step]');
    journeyViewport.scrollBy({ left: direction * (step?.offsetWidth ?? journeyViewport.clientWidth) * 0.9, behavior: reducedMotion.matches ? 'auto' : 'smooth' });
  };
  journeyPrevious?.addEventListener('click', () => moveJourney(-1));
  journeyNext?.addEventListener('click', () => moveJourney(1));
  journeyViewport?.addEventListener('scroll', updateJourneyControls, { passive: true });
  journeyViewport?.addEventListener('keydown', (event) => {
    if (event.key !== 'ArrowLeft' && event.key !== 'ArrowRight') return;
    event.preventDefault();
    moveJourney(event.key === 'ArrowRight' ? 1 : -1);
  });
  compactJourney.addEventListener('change', updateJourneyControls);
  window.addEventListener('resize', updateJourneyControls);
  requestAnimationFrame(updateJourneyControls);

  const platformTabsRoot = document.querySelector<HTMLElement>('[data-platform-tabs]');
  const platformTabs = [...document.querySelectorAll<HTMLAnchorElement>('[data-platform-tab]')];
  const platformPanels = [...document.querySelectorAll<HTMLElement>('[data-platform-panel]')];
  if (platformTabsRoot && platformTabs.length === platformPanels.length) {
    platformTabsRoot.setAttribute('role', 'tablist');
    const activatePlatformTab = (targetId: string, moveFocus = false) => {
      platformTabs.forEach((tab) => {
        const active = tab.dataset.platformTarget === targetId;
        tab.classList.toggle('is-active', active);
        tab.setAttribute('aria-selected', String(active));
        tab.tabIndex = active ? 0 : -1;
        if (active && moveFocus) tab.focus();
      });
      platformPanels.forEach((panel) => {
        const active = panel.dataset.platformId === targetId;
        panel.hidden = !active;
        panel.toggleAttribute('data-active', active);
      });
    };
    platformTabs.forEach((tab, index) => {
      const targetId = tab.dataset.platformTarget ?? '';
      const panel = platformPanels.find((candidate) => candidate.dataset.platformId === targetId);
      tab.id = `platform-tab-${targetId}`;
      tab.setAttribute('role', 'tab');
      tab.setAttribute('aria-controls', panel?.id ?? '');
      panel?.setAttribute('role', 'tabpanel');
      panel?.setAttribute('aria-labelledby', tab.id);
      tab.addEventListener('click', (event) => {
        event.preventDefault();
        activatePlatformTab(targetId);
      });
      tab.addEventListener('keydown', (event) => {
        let nextIndex = index;
        if (event.key === 'ArrowRight') nextIndex = (index + 1) % platformTabs.length;
        else if (event.key === 'ArrowLeft') nextIndex = (index - 1 + platformTabs.length) % platformTabs.length;
        else if (event.key === 'Home') nextIndex = 0;
        else if (event.key === 'End') nextIndex = platformTabs.length - 1;
        else return;
        event.preventDefault();
        activatePlatformTab(platformTabs[nextIndex]?.dataset.platformTarget ?? targetId, true);
      });
    });
    const hashTarget = window.location.hash.startsWith('#moment-') ? window.location.hash.replace('#moment-', '') : '';
    activatePlatformTab(platformTabs.some((tab) => tab.dataset.platformTarget === hashTarget) ? hashTarget : (platformTabs[0]?.dataset.platformTarget ?? ''));
  }

</script>


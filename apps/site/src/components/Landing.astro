  .guide-teaser-card { position: relative; display: flex; min-width: 0; min-height: 360px; flex-direction: column; border: 1px solid var(--line); border-radius: 12px; padding: 22px; color: var(--ink); background: white; text-decoration: none; }
  .guide-teaser-card:hover { border-color: rgb(35 85 185 / 38%); background: var(--color-sky-tint); }
  .guide-teaser-card > span { color: var(--color-notion-blue-strong); font-size: .7rem; font-weight: 750; letter-spacing: .08em; }
  .guide-teaser-card > p { margin: 34px 0 10px; color: var(--slate); font-size: .68rem; font-weight: 700; letter-spacing: .04em; text-transform: uppercase; }
  .guide-teaser-card h3 { margin: 0; font-size: 1.55rem; letter-spacing: -.04em; line-height: 1.04; }
  .guide-teaser-card > div { display: grid; gap: 7px; margin-top: auto; border-top: 1px solid var(--line); padding-top: 16px; color: var(--slate); font-family: var(--serif); font-size: .78rem; line-height: 1.45; }
  .guide-teaser-card strong { color: var(--color-notion-blue-strong); font-family: var(--sans); font-size: .65rem; text-transform: uppercase; }
  .guide-teaser-card > i { position: absolute; top: 19px; right: 20px; font-style: normal; }

  .faq-section { display: grid; grid-template-columns: .78fr 1.22fr; gap: clamp(40px, 8vw, 120px); }
  .faq-list { border-top: 1px solid var(--line); }

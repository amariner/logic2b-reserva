---
import '@fontsource-variable/source-serif-4/wght-italic.css';
import type { Locale } from '@logic-reserva/config';
import { logic2bContact } from '@logic-reserva/config/contact';
import { IMPLEMENTATION_PATH, localizedCommercialText, type CommercialText } from '@logic-reserva/config/commercial';
import { GUIDE_CATALOG, guideUrl, localizedGuideText, type GuideText } from '@logic-reserva/config/guides';
import { PANEL_CATALOG, localizedPanelText, panelContactUrl, panelDemoUrl, panelDetailUrl, panelPreviewBase, type PanelText } from '@logic-reserva/config/panels';
import { THEME_CATALOG, localizedThemeText, themeContactUrl, themeDetailUrl, themeDemoScope, themePreviewBase, themeUrl, type ThemeText } from '@logic-reserva/config/themes';
import { SITE_CONTENT, homeContent } from '../content';
import {
  siCloudflare,
  siGooglecalendar,
  siGooglemaps,
  siMailchimp,
  siOdoo,
  siPrestashop,
  siResend,
  siShopify,
  siSquarespace,
  siStripe,
  siWhatsapp,
  siWix,
  siWoocommerce,
  siWordpress,
  siZapier,
  type SimpleIcon,
} from 'simple-icons';
import PricingCards from './PricingCards.astro';
import CommercialFooter from './CommercialFooter.astro';
import CommercialHeader from './CommercialHeader.astro';
import CommercialLeadForm from './CommercialLeadForm.astro';
import CommercialPreviewDialog from './CommercialPreviewDialog.astro';
import CommercialTour from './CommercialTour.astro';
import CookiePreferences from './CookiePreferences.astro';
import InterfaceIcon from './InterfaceIcon.astro';
import RestaurantPlatformVisual from './RestaurantPlatformVisual.astro';
import ServiceDiagram from './ServiceDiagram.astro';

interface Props { locale?: Locale }

type Theme = (typeof THEME_CATALOG)[number];

const { locale = 'es' } = Astro.props;
const c = SITE_CONTENT[locale];
const prefix = locale === 'en' ? '/en' : '';
const contact = logic2bContact(locale, 'commercial');
const pageHref = (path: string) => `${prefix}${path}`;
const localCommercial = (value: CommercialText) => localizedCommercialText(value, locale);
const localTheme = (value: ThemeText) => localizedThemeText(value, locale);
const localPanel = (value: PanelText) => localizedPanelText(value, locale);
const localGuide = (value: GuideText) => localizedGuideText(value, locale);
const demoDomain = locale === 'en' ? 'yourdomain.com' : 'tudominio.com';
const themePreview = (slug: Theme['slug']) => `${themePreviewBase(slug, locale)}-desktop.webp`;
const ui = homeContent(locale);
const heroThemes = [THEME_CATALOG[0], THEME_CATALOG[2], THEME_CATALOG[1], THEME_CATALOG[8], THEME_CATALOG[7], THEME_CATALOG[4]];
// Two offset columns; Brasca stays first so it keeps the first preview trigger.
const heroColumns = [[0, 2, 4], [1, 3, 5]];
const pad = (value: number) => String(value).padStart(2, '0');
const brandIcons: Record<string, SimpleIcon> = {
  Resend: siResend,
  Cloudflare: siCloudflare,
  Stripe: siStripe,
  WhatsApp: siWhatsapp,
  'Google Maps': siGooglemaps,
  Zapier: siZapier,
};
const commerceBrands = [siShopify, siWoocommerce, siPrestashop, siSquarespace, siWix, siWordpress];
const operationsBrands = [siGooglecalendar, siWhatsapp, siMailchimp, siResend, siZapier, siOdoo];
const paymentBrands = [siStripe];
const guideIcons: Record<string, string> = { sala: 'floor', gestion: 'bookings', direccion: 'decision', propietario: 'guarantee', tecnica: 'web' };
const floorDots = [
  [18, 30, 'busy'], [42, 30, 'busy'], [66, 30, ''], [86, 30, 'event'],
  [18, 70, ''], [42, 70, 'selected'], [66, 70, 'busy'], [86, 70, 'event'],
] as const;
const decisionBars = [38, 54, 46, 72, 88, 64];
const loadBars = [32, 44, 40, 58, 66, 74, 82, 78, 70, 62, 48, 36];

const themePreviewData = (theme: Theme) => ({
  'data-commercial-preview-trigger': true,
  'data-preview-kind': theme.depth === 'deep' ? ui.portfolioDeep : ui.portfolioWeb,
  'data-preview-address': `${theme.slug}.${demoDomain}`,
  'data-preview-tag-one': localTheme(theme.level),
  'data-preview-tag-two': ui.previewResponsive,
  'data-preview-tag-three': localTheme(theme.format),
  'data-preview-title': theme.name,
  'data-preview-body': localTheme(theme.promise),
  'data-preview-image': themePreview(theme.slug),
  'data-preview-alt': `${theme.name} · ${localTheme(theme.format)}`,
  'data-preview-caption': `${localTheme(theme.format)} · ${localTheme(theme.location)}`,
  'data-preview-url': themeUrl(theme.slug, locale),
  'data-preview-detail-url': themeDetailUrl(theme.slug, locale),
  'data-preview-action': ui.portfolioOpen,
  'data-preview-detail-label': ui.previewThemeTone,
  'data-preview-detail': localTheme(theme.tone),
  'data-preview-evidence-label': ui.previewThemeJourney,
  'data-preview-evidence': themeDemoScope(theme, locale),
  'data-preview-limit-label': ui.previewBoundary,
  'data-preview-limit': ui.previewThemeBoundary,
  'data-preview-contact-action': ui.previewWantWebsite,
  'data-preview-contact-url': themeContactUrl(theme.slug, locale),
});
---

<div class="landing">
  <CommercialHeader locale={locale} home />

  <main id="contenido" tabindex="-1">
    <section class="hero shell" aria-labelledby="hero-title" data-home-block="hero" data-hero>
      <div class="hero-grid">
        <div class="hero-copy">
          <p class="eyebrow hero-eyebrow"><span class="live-dot" aria-hidden="true"></span>{c.hero.eyebrow}<span class="hero-eyebrow__meta">{ui.heroLive}</span></p>
          <h1 id="hero-title" class="hero-title">
            <span class="hero-title__line">{c.hero.beforeHighlight}</span><span class="hero-title__highlight">{c.hero.highlight}<svg viewBox="0 0 400 24" preserveAspectRatio="none" aria-hidden="true"><path d="M4 17C72 7 160 4 238 7c58 2 110 6 158 11" /></svg></span><span class="hero-title__line">{c.hero.afterHighlight}</span>
          </h1>
          <p class="hero-promise">{c.hero.promise}</p>
          <form id="brief-lead-form" class="hero-lead-form" action={`${prefix}/empezar/`} method="get" data-brief-transition data-brief-target={`${prefix}/empezar/`}>
            <div class="hero-lead-form__copy"><strong>{c.hero.briefTitle}</strong><span id={`brief-help-${locale}`}>{c.hero.briefBody}</span></div>
            <div class="hero-lead-form__field">
              <label for={`brief-email-${locale}`}>{c.hero.briefEmail}</label>
              <svg class="hero-lead-form__icon" viewBox="0 0 24 24" aria-hidden="true"><path d="M3.5 6.5h17v11h-17z" /><path d="m4 7 8 6 8-6" /></svg>
              <input id={`brief-email-${locale}`} data-brief-email type="email" autocomplete="email" placeholder={c.hero.briefEmail} aria-describedby={`brief-help-${locale} brief-note-${locale}`} />
              <button type="submit">{c.hero.briefSubmit}<span aria-hidden="true">→</span></button>
            </div>
          </form>
          <p id={`brief-note-${locale}`} class="brief-boundary">{c.hero.briefBoundary}</p>
          <div class="hero-proof">
            <p class="hero-proof-label">{c.hero.proofLabel}</p>
            <div class="hero-actions">
              <a class="hero-entry hero-entry--web" href={`${prefix}/demos/vedra/`}><span class="hero-entry__icon" aria-hidden="true"><InterfaceIcon name="web" size={18} /></span><span class="hero-entry__text"><strong>{c.hero.webAction}</strong><small>{ui.heroEntryHints.web}</small></span></a>
              <a class="hero-entry hero-entry--guided" href={`${prefix}/?recorrido=intro`} data-tour-trigger aria-haspopup="dialog"><span class="hero-entry__icon" aria-hidden="true"><svg viewBox="0 0 24 24" width="18" height="18"><path d="M8 5.5v13l10.5-6.5z" /></svg></span><span class="hero-entry__text"><strong>{c.hero.guidedAction}</strong><small>{ui.heroEntryHints.guided}</small></span></a>
              <a class="hero-entry hero-entry--manager" href={`${prefix}/demos/solane/gestion/?vista=plano`}><span class="hero-entry__icon" aria-hidden="true"><InterfaceIcon name="floor" size={18} /></span><span class="hero-entry__text"><strong>{c.hero.primary}</strong><small>{ui.heroEntryHints.manager}</small></span></a>
            </div>
          </div>
        </div>

        <div class="hero-product" role="group" aria-label={c.hero.portfolioLabel}>
          <div class="hero-stage">
            <svg class="hero-stage__pattern" aria-hidden="true"><defs><pattern id={`hero-dots-${locale}`} width="22" height="22" patternUnits="userSpaceOnUse"><circle cx="1.5" cy="1.5" r="1.1" /></pattern></defs><rect width="100%" height="100%" fill={`url(#hero-dots-${locale})`} /></svg>
            <div class="hero-mosaic">
              {heroColumns.map((column, columnIndex) => (
                <div class="hero-column" data-hero-column={columnIndex}>
                  {column.map((themeIndex) => {
                    const theme = heroThemes[themeIndex]!;
                    return (
                      <a class="hero-brand-card" href={themeDetailUrl(theme.slug, locale)} aria-label={`${ui.portfolioPreview}: ${theme.name}`} style={`--theme-primary:${theme.palette.primary};--theme-accent:${theme.palette.accent}`} {...themePreviewData(theme)}>
                        <span class="hero-brand-card__chrome" aria-hidden="true"><i></i><i></i><i></i><em>{theme.slug}.{demoDomain}</em></span>
                        <img src={themePreview(theme.slug)} alt={`${theme.name} · ${localTheme(theme.format)}`} width="800" height="527" loading={themeIndex < 4 ? 'eager' : 'lazy'} decoding="async" />
                        <span class="hero-brand-card__label"><b>{theme.name}</b><small>{localTheme(theme.format)}</small><i aria-hidden="true">↗</i></span>
                      </a>
                    );
                  })}
                </div>
              ))}
            </div>
          </div>

          <div class="hero-float hero-float--request" aria-hidden="true">
            <span class="hero-float__check"><svg viewBox="0 0 24 24"><path d="m6 12.5 4 4 8-9" /></svg></span>
            <div><strong>{ui.heroFloat.request}</strong><small>{ui.heroFloat.requestMeta}</small></div>
            <b>{ui.heroFloat.requestTag}</b>
          </div>
          <div class="hero-float hero-float--load" aria-hidden="true">
            <div class="hero-float__head"><small>{ui.heroFloat.load}</small><em>{ui.heroFloat.demo}</em></div>
            <strong>{ui.heroFloat.loadValue}</strong>
            <span class="hero-float__bars">{loadBars.map((height, index) => <i style={`--h:${height}%`} class={index === 6 ? 'is-now' : undefined}></i>)}</span>
          </div>
          <div class="hero-float hero-float--event" aria-hidden="true">
            <span class="hero-float__swatch"></span>
            <div><strong>{ui.heroFloat.event}</strong><small>{ui.heroFloat.eventMeta}</small></div>
          </div>

          <a class="demo-note" href={pageHref('/temas/')}>{ui.portfolioAll}<span aria-hidden="true">→</span></a>
        </div>
      </div>

      <div class="hero-baseline">
        <dl class="hero-stats">
          {ui.heroStats.map((stat) => <div><dt>{stat.label}</dt><dd>{stat.value}</dd></div>)}
        </dl>
        <p class="hero-support"><span aria-hidden="true">2B</span><span>{c.hero.support} <a href={`${prefix}/planes/`}>{c.hero.secondary} →</a></span></p>
      </div>
    </section>

    <section id="ecosistema" class="ecosystem-section" aria-labelledby="ecosystem-title" data-home-block="ecosystem">
      <div class="shell ecosystem-shell">
        <p id="ecosystem-title" class="ecosystem-label">{c.ecosystem.eyebrow}</p>
        <div class="ecosystem-rail" role="list" aria-label={c.ecosystem.label}>
          {c.ecosystem.items.map((item) => (
            <article role="listitem" class="ecosystem-item" data-tone={item.tone}>
              {brandIcons[item.name] && <span class="ecosystem-mark" style={`--brand:#${brandIcons[item.name].hex}`}><svg viewBox="0 0 24 24" role="img" aria-label={brandIcons[item.name].title}><path d={brandIcons[item.name].path} /></svg></span>}
              <div class="ecosystem-item__copy"><strong>{item.name}</strong><small>{item.detail}</small></div>
              <span class="ecosystem-status">{item.status}</span>
            </article>
          ))}
        </div>
      </div>
    </section>

    <section id="recorrido" class="section shell journey-section" aria-labelledby="journey-title" data-home-block="journey">
      <div class="section-head" data-reveal>
        <div class="section-head__rule" aria-hidden="true"><span>01</span><i></i><span>{ui.sectionTotal}</span></div>
        <div class="section-head__title"><p class="eyebrow">{c.productFlow.eyebrow}</p><h2 id="journey-title" class="heading">{c.productFlow.title}</h2></div>
        <p class="editorial">{c.productFlow.intro}</p>
      </div>
      <div class="home-diagram" data-reveal><ServiceDiagram kind="system" locale={locale} heading={false} /></div>
      <div class="journey-toolbar">
        <div class="journey-progress" aria-hidden="true"><span data-journey-progress></span></div>
        <div class="journey-controls" data-journey-controls hidden>
          <span data-journey-position aria-hidden="true">01 — 07</span>
          <button type="button" data-journey-previous aria-label={c.productFlow.previous}><span aria-hidden="true">←</span></button>
          <button type="button" data-journey-next aria-label={c.productFlow.next}><span aria-hidden="true">→</span></button>
        </div>
      </div>
      <div class="journey-viewport" data-journey-viewport tabindex="0" aria-label={c.productFlow.label}>
        <ol class="journey-track">
          {c.productFlow.steps.map((step, index) => (
            <li class={`journey-step journey-step--${step.id}`} data-journey-step data-reveal style={`--reveal-delay:${index * 70}ms`}>
              <div class="journey-step__top"><span class="journey-step__index">{pad(index + 1)}</span><span class="journey-step__icon"><InterfaceIcon name={step.id} size={20} /></span></div>
              <div class={`journey-visual journey-visual--${step.id}`} aria-hidden="true">
                {step.id === 'web' && <div class="jv-browser"><span class="jv-browser__bar"><i></i><i></i><i></i></span><span class="jv-browser__photo"></span><span class="jv-line jv-line--title"></span><span class="jv-line"></span><span class="jv-pill"></span></div>}
                {step.id === 'availability' && <div class="jv-slots">{['13:30', '14:00', '14:30', '20:30', '21:00', '21:30'].map((time) => <span class:list={[time === '21:00' && 'is-chosen', time === '14:30' && 'is-full']}>{time}</span>)}</div>}
                {step.id === 'booking' && <div class="jv-form">{[0, 1, 2].map((row) => <span class="jv-form__row"><i>✓</i><b style={`--w:${[72, 56, 64][row]}%`}></b></span>)}<span class="jv-form__submit"></span></div>}
                {step.id === 'service' && <div class="jv-floor">{floorDots.map(([x, y, state]) => <span class={state || undefined} style={`--x:${x}%;--y:${y}%`}></span>)}</div>}
                {step.id === 'guarantee' && <div class="jv-ring"><svg viewBox="0 0 64 64"><circle cx="32" cy="32" r="26" /><circle class="jv-ring__value" cx="32" cy="32" r="26" pathLength="100" /></svg><b>25 %</b></div>}
                {step.id === 'communication' && <div class="jv-chat"><span class="jv-chat__in"><b></b><b></b></span><span class="jv-chat__out"><b></b><i>✓✓</i></span></div>}
                {step.id === 'decision' && <div class="jv-bars">{decisionBars.map((height, barIndex) => <i style={`--h:${height}%`} class={barIndex === 4 ? 'is-peak' : undefined}></i>)}</div>}
              </div>
              <p>{step.label}</p>
              <h3>{step.title}</h3>
              <div class="journey-step__body">{step.body}</div>
            </li>
          ))}
        </ol>
      </div>
    </section>

    <section id="plataforma" class="section platform-section" aria-labelledby="platform-title" data-home-block="platform">
      <div class="shell platform-shell">
        <div class="section-head" data-reveal>
          <div class="section-head__rule" aria-hidden="true"><span>02</span><i></i><span>{ui.sectionTotal}</span></div>
          <div class="section-head__title"><p class="eyebrow">{c.platform.eyebrow}</p><h2 id="platform-title" class="heading">{c.platform.title}</h2></div>
          <p class="editorial">{c.platform.intro}</p>
        </div>
        <div class="home-diagram home-diagram--inventory" data-reveal><ServiceDiagram kind="inventory" locale={locale} /></div>
        <nav class="platform-tabs" data-platform-tabs aria-label={c.platform.tabsLabel}>
          <span class="platform-tabs__indicator" data-platform-indicator aria-hidden="true"></span>
          {c.platform.items.map((moment, index) => (
            <button type="button" data-platform-tab data-platform-target={moment.id} class={index === 0 ? 'is-active' : undefined}>
              <InterfaceIcon name={moment.id} size={18} /><span>{moment.label}</span>
            </button>
          ))}
        </nav>
        <div class="platform-panels" data-platform-panels>
          {c.platform.items.map((moment, index) => (
            <article id={`moment-${moment.id}`} class="platform-panel" data-platform-panel data-platform-id={moment.id} data-active={index === 0 ? '' : undefined}>
              <div class="platform-panel__copy">
                <div class="platform-panel__meta"><span class="platform-panel__count">{pad(index + 1)} / {pad(c.platform.items.length)}</span><span>{c.platform.resultLabel}</span><span class="maturity-status" data-tone={moment.tone}>{moment.status}</span></div>
                <h3>{moment.result}</h3>
                <div class="platform-capabilities">
                  <p>{c.platform.capabilitiesLabel}</p>
                  <ul>{moment.capabilities.map((capability) => <li>{capability}</li>)}</ul>
                </div>
                <a class="platform-action" href={pageHref(moment.href)}>{moment.action}<span aria-hidden="true">↗</span></a>
                <details class="platform-limit"><summary>{c.platform.limitLabel}</summary><p>{moment.limit}</p></details>
              </div>
              <figure class="platform-evidence">
                <RestaurantPlatformVisual kind={moment.id} label={moment.label} alt={moment.alt} locale={locale} />
                <figcaption><span>{c.platform.evidenceLabel}</span><span>{moment.label} · {moment.status}</span></figcaption>
              </figure>
            </article>
          ))}
        </div>
      </div>
    </section>

    <section id="conexiones" class="section shell connections-section" aria-labelledby="connections-title" data-home-block="connections">
      <div class="section-head" data-reveal>
        <div class="section-head__rule" aria-hidden="true"><span>03</span><i></i><span>{ui.sectionTotal}</span></div>
        <div class="section-head__title"><p class="eyebrow">{c.connections.eyebrow}</p><h2 id="connections-title" class="heading">{c.connections.title}</h2></div>
        <p class="editorial">{c.connections.intro}</p>
      </div>
      <div class="connections-grid" role="list" aria-label={c.connections.label}>
        <article class="connection-family connection-family--commerce" role="listitem" data-reveal>
          <div class="connection-family__heading"><span>01</span><div><h3>{ui.connectionFamilies.commerce.title}</h3><p>{ui.connectionFamilies.commerce.body}</p></div></div>
          <ul class="brand-cloud" aria-label={ui.connectionFamilies.commerce.label}>
            {commerceBrands.map((brand) => <li style={`--brand:#${brand.hex}`}><span><svg viewBox="0 0 24 24" aria-hidden="true"><path d={brand.path} /></svg></span><strong>{brand.title}</strong></li>)}
          </ul>
          <div class="connection-route" aria-hidden="true">
            <span class="route-node">{ui.connectionFlow.source}</span>
            <span class="route-wire"><i></i></span>
            <b class="route-core"><img src="/logo-mark.svg" alt="" width="18" height="18" />{ui.connectionFlow.core}</b>
            <span class="route-wire"><i></i></span>
            <span class="route-node route-node--target"><em>✓</em>{ui.connectionFlow.target}</span>
            <small>{ui.connectionFlow.caption}</small>
          </div>
        </article>
        <article class="connection-family connection-family--operations" role="listitem" data-reveal style="--reveal-delay:80ms">
          <div class="connection-family__heading"><span>02</span><div><h3>{ui.connectionFamilies.operations.title}</h3><p>{ui.connectionFamilies.operations.body}</p></div></div>
          <ul class="brand-cloud brand-cloud--compact" aria-label={ui.connectionFamilies.operations.label}>
            {operationsBrands.map((brand) => <li style={`--brand:#${brand.hex}`}><span><svg viewBox="0 0 24 24" aria-hidden="true"><path d={brand.path} /></svg></span><strong>{brand.title}</strong></li>)}
          </ul>
          <div class="connection-feed">
            <p>{ui.connectionFeedLabel}</p>
            <ol>{ui.connectionFeed.map((entry) => <li><time>{entry.time}</time><span>{entry.text}</span></li>)}</ol>
          </div>
        </article>
        <article class="connection-family connection-family--payments" role="listitem" data-reveal style="--reveal-delay:160ms">
          <div class="connection-family__heading"><span>03</span><div><h3>{ui.connectionFamilies.payments.title}</h3><p>{ui.connectionFamilies.payments.body}</p></div></div>
          <div class="payment-cloud"><span class="redsys-wordmark" role="img" aria-label="Redsys"><i>red</i><b>sys</b></span>{paymentBrands.map((brand) => <span style={`--brand:#${brand.hex}`} role="img" aria-label={brand.title}><svg viewBox="0 0 24 24" aria-hidden="true"><path d={brand.path} /></svg><strong>{brand.title}</strong></span>)}</div>
          <dl class="deposit-ticket">
            <div class="deposit-ticket__head"><dt>{ui.depositTicket.title}</dt><dd>{ui.depositTicket.note}</dd></div>
            <div><dt>{ui.depositTicket.rule}</dt><dd><strong>{ui.depositTicket.amount}</strong></dd></div>
            <div><dt><span aria-hidden="true">✓</span> {ui.depositTicket.status}</dt></div>
          </dl>
          <p class="connections-boundary">{ui.connectionsBoundary}</p>
        </article>
      </div>
    </section>

    <section id="planes" class="section offers-section" aria-labelledby="offers-title" data-home-block="plans">
      <div class="shell">
        <div class="section-head" data-reveal>
          <div class="section-head__rule" aria-hidden="true"><span>04</span><i></i><span>{ui.sectionTotal}</span></div>
          <div class="section-head__title"><p class="eyebrow">{ui.offersEyebrow}</p><h2 id="offers-title" class="heading">{ui.offersTitle}</h2></div>
          <p class="editorial">{ui.offersIntro}</p>
        </div>
        <PricingCards locale={locale} />
        <a class="offers-all" href={pageHref('/planes/')}>{ui.offersAll}<span aria-hidden="true">→</span></a>
      </div>
    </section>

    <section id="portfolio" class="section shell portfolio-section" aria-labelledby="portfolio-title" data-home-block="portfolio">
      <div class="section-head" data-reveal>
        <div class="section-head__rule" aria-hidden="true"><span>05</span><i></i><span>{ui.sectionTotal}</span></div>
        <div class="section-head__title"><p class="eyebrow">{ui.portfolioEyebrow}</p><h2 id="portfolio-title" class="heading">{ui.portfolioTitle}</h2></div>
        <p class="editorial">{ui.portfolioIntro}</p>
      </div>
      <div class="catalogue-controls" data-catalogue-controls="theme-rail" hidden>
        <span data-catalogue-position aria-hidden="true">01 / 12</span>
        <button type="button" data-catalogue-previous aria-label={ui.railPrevious} aria-controls="theme-rail"><span aria-hidden="true">←</span></button>
        <button type="button" data-catalogue-next aria-label={ui.railNext} aria-controls="theme-rail"><span aria-hidden="true">→</span></button>
      </div>
      <div id="theme-rail" class="portfolio-grid" role="list" tabindex="0" aria-label={ui.portfolioTitle}>
        {THEME_CATALOG.map((theme, index) => (
          <article
            class:list={['portfolio-card', theme.depth === 'deep' && 'portfolio-card--deep']}
            role="listitem"
            style={`--portfolio-primary:${theme.palette.primary};--portfolio-accent:${theme.palette.accent};--portfolio-paper:${theme.palette.paper}`}
          >

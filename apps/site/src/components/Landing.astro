  /* Paridad estructural con CAMP, reinterpretada con la identidad azul de Reserva. */
  .landing {
    --parity-ink: var(--color-midnight-ink);
    --parity-accent: var(--color-notion-blue);
    --parity-highlight: var(--color-sky-wash);
    --parity-mint: #d9ecfb;
    --parity-slate: #d2e2ee;
    --parity-paper: #fbfaf9;
    color: var(--parity-ink);
    background: var(--parity-paper);
  }
  .landing h1, .landing h2, .landing h3 { color: var(--parity-ink); font-family: var(--serif); font-weight: 450; }
  .landing .eyebrow { color: color-mix(in srgb, var(--parity-ink) 62%, white); font-weight: 700; }

  .hero {
    min-height: calc(100svh - 4px);
    margin: 0;
    padding: clamp(112px, 10vw, 154px) 0 clamp(42px, 5vw, 70px);
    background: linear-gradient(180deg, #e3f1fc 0%, #d5eafb 100%);
  }
  .hero-grid {
    display: grid;
    width: calc(100% - clamp(32px, 5vw, 72px));
    max-width: 1600px;
    grid-template-columns: minmax(440px, .88fr) minmax(520px, 1.12fr);
    gap: clamp(42px, 5vw, 84px);
    align-items: center;
  }
  .hero-copy { min-width: 0; padding: 0; text-align: center; }
  .hero-title {
    display: block;
    max-width: 620px;
    margin: 18px auto 0;
    color: var(--parity-ink);
    font-family: var(--serif);
    font-size: clamp(62px, 5vw, 82px);
    font-weight: 450;
    letter-spacing: -.055em;
    line-height: .94;
    text-wrap: balance;
  }
  .hero-title > span { position: relative; display: block; white-space: normal; }
  .hero-title > span::after { content: none; }
  .hero-word-window {
    z-index: 0;
    width: max-content;
    max-width: 100%;
    height: .98em;
    margin-inline: auto;
    overflow: hidden;
  }
  .hero-word-window::after {
    position: absolute;
    right: 1%;
    bottom: .03em;
    left: 1%;
    z-index: -1;
    height: .13em;
    border-radius: 999px 45% 999px 55%;
    background: var(--parity-highlight);
    content: '' !important;
    transform: rotate(-.7deg);
  }
  .hero-word-counter { display: block; animation: parity-word-counter 9s cubic-bezier(.76,0,.24,1) infinite; will-change: transform; }
  .hero-word-counter > span { display: block; height: .98em; line-height: .98; }
  @keyframes parity-word-counter {
    0%, 27% { transform: translateY(0); }
    34%, 60% { transform: translateY(-25%); }
    67%, 93% { transform: translateY(-50%); }
    100% { transform: translateY(-75%); }
  }
  .hero-promise { max-width: 540px; margin: 26px auto 0; color: var(--parity-ink); font-size: clamp(17px, 1.2vw, 20px); }
  .hero-body { max-width: 560px; margin: 10px auto 0; color: color-mix(in srgb, var(--parity-ink) 66%, white); font-family: var(--sans); font-size: 15px; line-height: 1.55; }
  .hero-lead-form {
    display: flex;
    width: min(500px, 100%);
    min-height: 62px;
    align-items: center;
    gap: 8px;
    margin: 28px auto 0;
    border: 1px solid color-mix(in srgb, var(--parity-ink) 16%, transparent);
    border-radius: 999px;
    background: rgb(255 255 255 / 88%);
    box-shadow: 0 14px 36px rgb(2 9 58 / 9%);
    padding: 6px;
  }
  .hero-lead-form input { min-width: 0; min-height: 48px; flex: 1; border: 0; outline: 0; background: transparent; padding: 0 8px 0 18px; color: var(--parity-ink); font-size: 15px; }
  .hero-lead-form button { display: inline-flex; min-width: 152px; min-height: 50px; align-items: center; justify-content: space-between; gap: 20px; border: 0; border-radius: 999px; padding: 10px 18px; color: white; background: var(--parity-ink); font-size: 14px; font-weight: 700; cursor: pointer; }
  .hero-lead-form:focus-within { border-color: var(--parity-accent); box-shadow: 0 0 0 3px rgb(0 117 222 / 18%), 0 14px 36px rgb(2 9 58 / 9%); }
  .brief-boundary { width: min(500px, 100%); margin: 9px auto 0; justify-content: center; color: color-mix(in srgb, var(--parity-ink) 58%, white); }
  .hero-shortcuts { display: grid; width: min(590px, 100%); grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 8px; margin: 16px auto 0; padding: 0; list-style: none; }
  .hero-shortcuts a, .hero-shortcuts button { display: inline-flex; min-height: 44px; align-items: center; justify-content: center; gap: 7px; border: 0; padding: 4px; color: color-mix(in srgb, var(--parity-ink) 68%, white); background: transparent; font: inherit; font-size: 12px; text-decoration: none; cursor: pointer; }
  .hero-shortcuts span { display: grid; width: 20px; height: 20px; flex: 0 0 auto; place-items: center; border-radius: 50%; color: var(--parity-ink); background: #a9d8fa; font-size: 11px; font-weight: 800; }
  .hero .demo-note { display: none; }

  .hero-product {
    position: relative;
    display: grid;
    height: clamp(550px, 61svh, 650px);
    min-width: 0;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 12px;
    align-self: center;
    overflow: hidden;
    border-radius: clamp(20px, 2vw, 30px);
    background: var(--parity-slate);
    padding: clamp(22px, 2.3vw, 36px);
  }
  .hero-motion-toggle { position: absolute; z-index: 8; top: 34px; right: 34px; display: grid; width: 44px; height: 44px; place-items: center; border: 1px solid rgb(2 9 58 / 15%); border-radius: 50%; color: var(--parity-ink); background: rgb(255 255 255 / 92%); box-shadow: 0 8px 22px rgb(2 9 58 / 13%); cursor: pointer; }
  .hero-motion-toggle [data-play-icon] { display: none; font-size: 11px; }
  .hero-motion-toggle[aria-pressed='true'] [data-pause-icon] { display: none; }
  .hero-motion-toggle[aria-pressed='true'] [data-play-icon] { display: inline; }
  .theme-rail-column { min-width: 0; overflow: hidden; }
  .theme-rail-track { display: grid; gap: 12px; will-change: transform; }
  .theme-rail-column--down .theme-rail-track { animation: parity-themes-down 48s linear infinite; }
  .theme-rail-column--up .theme-rail-track { animation: parity-themes-up 54s linear infinite; }
  .hero-product:hover .theme-rail-track, .hero-product[data-paused='true'] .theme-rail-track, .hero-product:focus-within .theme-rail-track { animation-play-state: paused; }
  @keyframes parity-themes-up { from { transform: translateY(0); } to { transform: translateY(calc(-50% - 6px)); } }
  @keyframes parity-themes-down { from { transform: translateY(calc(-50% - 6px)); } to { transform: translateY(0); } }
  .theme-rail-card { overflow: hidden; border-radius: 14px; background: white; box-shadow: 0 8px 24px rgb(2 9 58 / 8%); }
  .theme-rail-card > a { display: block; width: 100%; border: 0; padding: 0; color: var(--theme-ink, var(--parity-ink)); background: transparent; text-align: left; text-decoration: none; cursor: zoom-in; }
  .theme-rail-visual { position: relative; display: block; aspect-ratio: 1.28; overflow: hidden; background: var(--theme-paper); }
  .theme-rail-visual::after { position: absolute; inset: 0; background: linear-gradient(180deg, transparent 42%, rgb(2 9 58 / 30%)); content: ''; pointer-events: none; }
  .theme-rail-visual img { display: block; width: 100%; height: 100%; object-fit: cover; object-position: center top; transition: transform 400ms ease; }
  .theme-rail-card:hover img { transform: scale(1.035); }
  .theme-rail-browser { position: absolute; z-index: 2; top: 10px; right: 10px; left: 10px; display: flex; align-items: center; gap: 4px; border-radius: 7px; padding: 7px 8px; color: var(--theme-ink); background: color-mix(in srgb, var(--theme-paper) 88%, transparent); backdrop-filter: blur(8px); }
  .theme-rail-browser i { width: 4px; height: 4px; border-radius: 50%; background: currentColor; opacity: .45; }
  .theme-rail-browser b { margin-left: auto; font-size: 9px; letter-spacing: .08em; }
  .theme-rail-meta { display: flex; align-items: center; justify-content: space-between; gap: 8px; padding: 11px 13px 13px; }

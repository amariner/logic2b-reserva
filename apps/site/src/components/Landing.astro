  .implementation-path h3 { margin: 40px 0 12px; font-size: clamp(1.45rem, 2vw, 2rem); letter-spacing: -.04em; }
  .implementation-path p { margin: 0; color: rgb(255 255 255 / 70%); font-family: var(--serif); line-height: 1.55; }
  .implementation-path article > div { display: grid; gap: 5px; margin-top: auto; border-top: 1px solid rgb(255 255 255 / 18%); padding-top: 16px; color: rgb(255 255 255 / 78%); font-size: .76rem; line-height: 1.4; }

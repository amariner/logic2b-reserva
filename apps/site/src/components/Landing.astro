---
import type { Locale } from '@logic-reserva/config';
import { logic2bContact } from '@logic-reserva/config/contact';
import { IMPLEMENTATION_PATH, localizedCommercialText, type CommercialText } from '@logic-reserva/config/commercial';
import { GUIDE_CATALOG, guideUrl, localizedGuideText, type GuideText } from '@logic-reserva/config/guides';
import { PANEL_CATALOG, localizedPanelText, panelContactUrl, panelDemoUrl, panelDetailUrl, type PanelText } from '@logic-reserva/config/panels';
import { THEME_CATALOG, localizedThemeText, themeContactUrl, themeDetailUrl, themeDemoScope, themePreviewBase, themeUrl, type ThemeText } from '@logic-reserva/config/themes';
import { SITE_CONTENT, homeContent } from '../content';
import PricingCards from './PricingCards.astro';
import CommercialFooter from './CommercialFooter.astro';
import CommercialHeader from './CommercialHeader.astro';
import CommercialLeadForm from './CommercialLeadForm.astro';
import CommercialPreviewDialog from './CommercialPreviewDialog.astro';
import CommercialTour from './CommercialTour.astro';
import CookiePreferences from './CookiePreferences.astro';

interface Props { locale?: Locale }

const { locale = 'es' } = Astro.props;
const c = SITE_CONTENT[locale];
const prefix = locale === 'en' ? '/en' : '';
const contact = logic2bContact(locale, 'commercial');
const pageHref = (path: string) => `${prefix}${path}`;
const localCommercial = (value: CommercialText) => localizedCommercialText(value, locale);
const localTheme = (value: ThemeText) => localizedThemeText(value, locale);
const localPanel = (value: PanelText) => localizedPanelText(value, locale);
const localGuide = (value: GuideText) => localizedGuideText(value, locale);
const demoDomain = locale === 'en' ? 'yourdomain.com' : 'tudominio.com';
const themePreview = (slug: (typeof THEME_CATALOG)[number]['slug']) => `${themePreviewBase(slug, locale)}-desktop.webp`;
const ui = homeContent(locale);
const heroThemes = [THEME_CATALOG[0], THEME_CATALOG[2], THEME_CATALOG[1], THEME_CATALOG[8], THEME_CATALOG[7], THEME_CATALOG[4]];
---

<div class="landing">
  <CommercialHeader locale={locale} home />

  <main id="contenido" tabindex="-1">
    <section class="hero shell" aria-labelledby="hero-title" data-home-block="hero">
      <div class="hero-grid">
        <div class="hero-copy">
          <p class="eyebrow">{c.hero.eyebrow}</p>
          <h1 id="hero-title" class="hero-title">
            {c.hero.beforeHighlight}<span>{c.hero.highlight}</span>{c.hero.afterHighlight}
          </h1>
          <p class="hero-promise">{c.hero.promise}</p>
          <form id="brief-lead-form" class="hero-lead-form" action={`${prefix}/empezar/`} method="get" data-brief-transition data-brief-target={`${prefix}/empezar/`}>
            <div class="hero-lead-form__copy"><strong>{c.hero.briefTitle}</strong><span id={`brief-help-${locale}`}>{c.hero.briefBody}</span></div>
            <div class="hero-lead-form__field"><label for={`brief-email-${locale}`}>{c.hero.briefEmail}</label><input id={`brief-email-${locale}`} data-brief-email type="email" required autocomplete="email" placeholder={c.hero.briefEmail} aria-describedby={`brief-help-${locale}`} /><button type="submit">{c.hero.briefSubmit}<span aria-hidden="true">→</span></button></div>
            <p class="brief-boundary"><span aria-hidden="true">✓</span>{c.hero.briefBoundary}</p>
          </form>
          <p class="hero-proof-label">{c.hero.proofLabel}</p>
          <div class="hero-actions">
            <a class="hero-entry hero-entry--web" href={`${prefix}/demos/vedra/`}><span aria-hidden="true">✓</span><strong>{c.hero.webAction}</strong></a>
            <a class="hero-entry hero-entry--guided" href={`${prefix}/?recorrido=intro`} data-tour-trigger aria-haspopup="dialog"><span aria-hidden="true">✓</span><strong>{c.hero.guidedAction}</strong></a>
            <a class="hero-entry hero-entry--manager" href={`${prefix}/demos/solane/gestion/?vista=plano`}><span aria-hidden="true">✓</span><strong>{c.hero.primary}</strong><small>{c.hero.managerAction}</small></a>
          </div>
          <p class="hero-support"><span aria-hidden="true">2B</span><span>{c.hero.support} <a href={`${prefix}/planes/`}>{c.hero.secondary} →</a></span></p>
        </div>

        <div class="hero-product" aria-label={c.hero.portfolioLabel}>
          <div class="hero-mosaic">
            {heroThemes.map((theme, index) => (
              <a class="hero-brand-card" href={themeUrl(theme.slug, locale)}>
                <img src={themePreview(theme.slug)} alt={`${theme.name} · ${localTheme(theme.format)}`} width="800" height="527" loading={index < 4 ? 'eager' : 'lazy'} decoding="async" />
                <span><b>{theme.name}</b><small>{localTheme(theme.format)}</small><i aria-hidden="true">↗</i></span>
              </a>
            ))}
          </div>
          <a class="demo-note" href={pageHref('/temas/')}>{ui.portfolioAll}<span aria-hidden="true">→</span></a>
        </div>
      </div>
    </section>

    <section id="ecosistema" class="ecosystem-section" aria-labelledby="ecosystem-title" data-home-block="ecosystem">
      <div class="shell ecosystem-intro"><p id="ecosystem-title">{c.ecosystem.eyebrow}</p></div>
      <div class="ecosystem-rail" role="list" aria-label={c.ecosystem.label}>
        <div class="ecosystem-track">
          {c.ecosystem.items.map((item) => (
            <article role="listitem" class="ecosystem-item" data-tone={item.tone}>
              <span class="ecosystem-mark" aria-hidden="true">{item.name.slice(0, 2)}</span>
              <div><strong>{item.name}</strong><small>{item.detail}</small></div>
              <span class="ecosystem-status">{item.status}</span>
            </article>
          ))}
        </div>
      </div>
    </section>

    <section id="recorrido" class="section shell journey-section" aria-labelledby="journey-title" data-home-block="journey">
      <div class="journey-intro">
        <div>
          <p class="eyebrow">{c.productFlow.eyebrow}</p>
          <h2 id="journey-title" class="heading">{c.productFlow.title}</h2>
        </div>
        <p class="editorial">{c.productFlow.intro}</p>
      </div>
      <div class="journey-controls" data-journey-controls hidden>
        <button type="button" data-journey-previous aria-label={c.productFlow.previous}><span aria-hidden="true">←</span></button>
        <span aria-hidden="true">01—07</span>
        <button type="button" data-journey-next aria-label={c.productFlow.next}><span aria-hidden="true">→</span></button>
      </div>
      <div class="journey-viewport" data-journey-viewport tabindex="0" aria-label={c.productFlow.label}>
        <ol class="journey-track">
          {c.productFlow.steps.map((step, index) => (
            <li class={`journey-step journey-step--${step.id}`} data-journey-step>
              <div class="journey-step__top"><span>0{index + 1}</span><i aria-hidden="true">→</i></div>
              <p>{step.label}</p>
              <h3>{step.title}</h3>
              <div class="journey-step__body">{step.body}</div>
            </li>
          ))}
        </ol>
      </div>
    </section>

    <section id="plataforma" class="section platform-section" aria-labelledby="platform-title" data-home-block="platform">
      <div class="shell platform-shell">
        <div class="platform-intro">
          <div>
            <p class="eyebrow">{c.platform.eyebrow}</p>
            <h2 id="platform-title" class="heading">{c.platform.title}</h2>
          </div>
          <p class="editorial">{c.platform.intro}</p>
        </div>
        <nav class="platform-tabs" data-platform-tabs aria-label={c.platform.tabsLabel}>
          {c.platform.items.map((moment, index) => (
            <a href={`#moment-${moment.id}`} data-platform-tab data-platform-target={moment.id} class={index === 0 ? 'is-active' : undefined}>
              <span>0{index + 1}</span>{moment.label}
            </a>
          ))}
        </nav>
        <div class="platform-panels" data-platform-panels>
          {c.platform.items.map((moment, index) => (
            <article id={`moment-${moment.id}`} class="platform-panel" data-platform-panel data-platform-id={moment.id} data-active={index === 0 ? '' : undefined}>
              <div class="platform-panel__copy">
                <div class="platform-panel__meta"><span>{c.platform.resultLabel}</span><span class="maturity-status" data-tone={moment.tone}>{moment.status}</span></div>
                <h3>{moment.result}</h3>
                <div class="platform-capabilities">
                  <p>{c.platform.capabilitiesLabel}</p>
                  <ul>{moment.capabilities.map((capability) => <li>{capability}</li>)}</ul>
                </div>
                <details class="platform-limit"><summary>{c.platform.limitLabel}</summary><p>{moment.limit}</p></details>
                <a class="platform-action" href={pageHref(moment.href)}>{moment.action}<span aria-hidden="true">↗</span></a>
              </div>
              <figure class="platform-evidence artifact">
                <div class="platform-evidence__bar"><span>{c.platform.evidenceLabel}</span><span>{moment.label} · {moment.status}</span></div>
                <picture>
                  <source media="(max-width: 640px)" srcset={`/images/screens/${moment.image}-mobile.png`} />
                  <img src={`/images/screens/${moment.image}-desktop.png`} alt={moment.alt} width="1366" height="900" loading="lazy" decoding="async" />
                </picture>
              </figure>
            </article>
          ))}
        </div>
      </div>
    </section>

    <section id="conexiones" class="section shell connections-section" aria-labelledby="connections-title" data-home-block="connections">
      <div class="connections-intro">
        <div>
          <p class="eyebrow">{c.connections.eyebrow}</p>
          <h2 id="connections-title" class="heading">{c.connections.title}</h2>
        </div>
        <p class="editorial">{c.connections.intro}</p>
      </div>
      <div class="connections-grid" role="list" aria-label={c.connections.label}>
        {c.connections.families.map((family, familyIndex) => (
          <article class={`connection-family connection-family--${family.id}`} role="listitem">
            <div class="connection-family__heading"><span>0{familyIndex + 1}</span><div><h3>{family.title}</h3><p>{family.body}</p></div></div>
            <ul>
              {family.items.map((item) => (
                <li>
                  <div><strong>{item.name}</strong><span>{item.detail}</span></div>
                  <span class="maturity-status" data-tone={item.tone}>{item.status}</span>
                </li>
              ))}
            </ul>
          </article>
        ))}
      </div>
    </section>

    <section id="planes" class="section offers-section" aria-labelledby="offers-title" data-home-block="plans">
      <div class="shell">
        <div class="offers-intro">
          <div><p class="eyebrow">{ui.offersEyebrow}</p><h2 id="offers-title" class="heading">{ui.offersTitle}</h2></div>
          <p class="editorial">{ui.offersIntro}</p>
        </div>
        <PricingCards locale={locale} />
        <a class="offers-all" href={pageHref('/planes/')}>{ui.offersAll}<span aria-hidden="true">→</span></a>
      </div>
    </section>

    <section id="portfolio" class="section shell portfolio-section" aria-labelledby="portfolio-title" data-home-block="portfolio">
      <div class="catalogue-intro">
        <div><p class="eyebrow">{ui.portfolioEyebrow}</p><h2 id="portfolio-title" class="heading">{ui.portfolioTitle}</h2></div>
        <p class="editorial">{ui.portfolioIntro}</p>
      </div>
      <div class="portfolio-grid" role="list" tabindex="0" aria-label={ui.portfolioTitle}>
        {THEME_CATALOG.map((theme, index) => (
          <article
            class:list={['portfolio-card', theme.depth === 'deep' && 'portfolio-card--deep']}
            role="listitem"
            style={`--portfolio-primary:${theme.palette.primary};--portfolio-accent:${theme.palette.accent};--portfolio-paper:${theme.palette.paper}`}
          >
            <a class="portfolio-card__surface" href={themeDetailUrl(theme.slug, locale)} aria-label={`${ui.portfolioDetails}: ${theme.name}`}>
              <picture><img src={themePreview(theme.slug)} alt="" width="1366" height="900" loading="lazy" decoding="async" /></picture>
              <span class="portfolio-card__index">{String(index + 1).padStart(2, '0')}</span>
              <div class="portfolio-card__copy"><span>{theme.depth === 'deep' ? ui.portfolioDeep : ui.portfolioWeb}</span><h3>{theme.name}</h3><p>{localTheme(theme.format)} · {localTheme(theme.location)}</p></div>
              <i aria-hidden="true">↗</i>
            </a>
            <button
              class="portfolio-card__preview"
              type="button"
              aria-label={`${ui.portfolioPreview}: ${theme.name}`}
              data-commercial-preview-trigger
              data-preview-kind={theme.depth === 'deep' ? ui.portfolioDeep : ui.portfolioWeb}
              data-preview-address={`${theme.slug}.${demoDomain}`}
              data-preview-tag-one={localTheme(theme.level)}
              data-preview-tag-two={ui.previewResponsive}
              data-preview-tag-three={localTheme(theme.format)}
              data-preview-title={theme.name}
              data-preview-body={localTheme(theme.promise)}
              data-preview-image={themePreview(theme.slug)}
              data-preview-alt={`${theme.name} · ${localTheme(theme.format)}`}
              data-preview-caption={`${localTheme(theme.format)} · ${localTheme(theme.location)}`}
              data-preview-url={themeUrl(theme.slug, locale)}
              data-preview-action={ui.portfolioOpen}
              data-preview-detail-label={ui.previewThemeTone}
              data-preview-detail={localTheme(theme.tone)}
              data-preview-evidence-label={ui.previewThemeJourney}
              data-preview-evidence={themeDemoScope(theme, locale)}
              data-preview-limit-label={ui.previewBoundary}
              data-preview-limit={ui.previewThemeBoundary}
              data-preview-contact-action={ui.previewWantWebsite}
              data-preview-contact-url={themeContactUrl(theme.slug, locale)}
            ><span aria-hidden="true">＋</span></button>
          </article>
        ))}
      </div>
      <a class="section-link" href={pageHref('/temas/')}>{ui.portfolioAll}<span aria-hidden="true">→</span></a>
    </section>

    <section id="paneles" class="section panels-teaser-section" aria-labelledby="panels-title" data-home-block="panels">
      <div class="shell">
        <div class="catalogue-intro">
          <div><p class="eyebrow">{ui.panelsEyebrow}</p><h2 id="panels-title" class="heading">{ui.panelsTitle}</h2></div>
          <p class="editorial">{ui.panelsIntro}</p>
        </div>
        <div class="panel-teaser-grid" tabindex="0" aria-label={ui.panelsTitle}>
          {PANEL_CATALOG.map((panel, index) => (
            <article class="panel-teaser-card" data-level={panel.level}>
              <figure>
                <picture><source media="(max-width: 640px)" srcset={`/images/screens/${panel.screenshot.base}-mobile.png`} /><img src={`/images/screens/${panel.screenshot.base}-desktop.png`} alt={localPanel(panel.screenshot.alt)} width="1366" height="900" loading="lazy" decoding="async" /></picture>
                <figcaption><span>0{index + 1}</span>{localPanel(panel.screenshot.caption)}</figcaption>
              </figure>
              <div class="panel-teaser-card__copy">
                <div class="panel-teaser-card__meta"><span>{localPanel(panel.eyebrow)}</span><span>{panel.level === 'intelligent' ? ui.panelsLevelIntelligent : ui.panelsLevelManagement}</span></div>
                <h3>{localPanel(panel.title)}</h3><p>{localPanel(panel.summary)}</p>
                <dl><dt>{ui.panelsDecision}</dt><dd>{localPanel(panel.decision)}</dd></dl>
                <div class="panel-teaser-card__actions">
                  <button
                    type="button"
                    data-commercial-preview-trigger
                    data-preview-kind={panel.level === 'intelligent' ? ui.panelsLevelIntelligent : ui.panelsLevelManagement}
                    data-preview-address={`panel.${demoDomain}/${panel.slug}`}
                    data-preview-tag-one={localPanel(panel.user)}
                    data-preview-tag-two={panel.level === 'intelligent' ? ui.panelsLevelIntelligent : ui.panelsLevelManagement}
                    data-preview-tag-three={ui.previewReproducible}
                    data-preview-title={localPanel(panel.title)}
                    data-preview-body={localPanel(panel.summary)}
                    data-preview-image={`/images/screens/${panel.screenshot.base}-desktop.png`}
                    data-preview-alt={localPanel(panel.screenshot.alt)}
                    data-preview-caption={localPanel(panel.screenshot.caption)}
                    data-preview-url={panelDemoUrl(panel, locale)}
                    data-preview-action={ui.panelsOpen}
                    data-preview-detail-label={ui.panelsDecision}
                    data-preview-detail={localPanel(panel.decision)}
                    data-preview-evidence-label={ui.previewPanelEvidence}
                    data-preview-evidence={localPanel(panel.evidence)}
                    data-preview-limit-label={ui.previewBoundary}
                    data-preview-limit={localPanel(panel.limit)}
                    data-preview-contact-action={ui.previewWantPanel}
                    data-preview-contact-url={panelContactUrl(panel, locale)}
                  >{ui.panelsPreview}<span aria-hidden="true">＋</span></button>
                  <a href={panelDetailUrl(panel, locale)}>{ui.panelsDetails}<span aria-hidden="true">→</span></a>
                </div>
              </div>
            </article>
          ))}
        </div>
        <a class="section-link" href={pageHref('/paneles/')}>{ui.panelsAll}<span aria-hidden="true">→</span></a>
      </div>
    </section>

    <CommercialPreviewDialog locale={locale} />

    <section id="implantacion" class="section implementation-section" aria-labelledby="implementation-title" data-home-block="implementation">
      <div class="shell">
        <div class="catalogue-intro">
          <div><p class="eyebrow">{ui.implementationEyebrow}</p><h2 id="implementation-title" class="heading">{ui.implementationTitle}</h2></div>
          <p class="editorial">{ui.implementationIntro}</p>
        </div>
        <ol class="implementation-path">
          {IMPLEMENTATION_PATH.map((step, index) => (
            <li data-step={step.slug}><article><span>0{index + 1}</span><h3>{localCommercial(step.title)}</h3><p>{localCommercial(step.summary)}</p><div><strong>{ui.implementationOwner}</strong>{localCommercial(step.owner)}</div></article></li>
          ))}
        </ol>
        <div class="implementation-boundary"><p>{c.human.closing}</p><a href={pageHref('/planes/')}>{ui.implementationAll}<span aria-hidden="true">→</span></a></div>
      </div>
    </section>

    <section id="guias" class="section shell guides-teaser-section" aria-labelledby="guides-title" data-home-block="guides">
      <div class="catalogue-intro">
        <div><p class="eyebrow">{ui.guidesEyebrow}</p><h2 id="guides-title" class="heading">{ui.guidesTitle}</h2></div>
        <p class="editorial">{ui.guidesIntro}</p>
      </div>
      <div class="guide-teaser-grid">
        {GUIDE_CATALOG.map((guide, index) => (
          <a class="guide-teaser-card" href={guideUrl(guide, locale)}>
            <span>0{index + 1}</span><p>{localGuide(guide.eyebrow)}</p><h3>{localGuide(guide.title)}</h3><div><strong>{ui.guidesFor}</strong>{localGuide(guide.audience)}</div><i aria-hidden="true">↗</i>
          </a>
        ))}
      </div>
      <a class="section-link" href={pageHref('/docs/')}>{ui.guidesAll}<span aria-hidden="true">→</span></a>
    </section>

    <section id="preguntas" class="section shell faq-section" aria-labelledby="faq-title" data-home-block="faq">
      <div class="section-intro"><p class="eyebrow">{c.faq.eyebrow}</p><h2 id="faq-title" class="heading">{c.faq.title}</h2></div>
      <div class="faq-list">{c.faq.items.map((item) => <details><summary>{item.question}<span aria-hidden="true">+</span></summary><p>{item.answer}</p></details>)}</div>
    </section>

    <section id="contacto" class="section closing-section" aria-labelledby="contact-title" data-home-block="closing">
      <div class="shell closing-showcase">
        <div class="closing-copy"><p class="eyebrow">{ui.closingEyebrow}</p><h2 id="contact-title" class="heading">{ui.closingTitle}</h2><p>{ui.closingIntro}</p><ul class="closing-proof-list">{ui.closingProof.map((proof) => <li><span aria-hidden="true">✓</span>{proof}</li>)}</ul><div><a href={`${prefix}/?recorrido=intro`} data-tour-trigger aria-haspopup="dialog">{ui.closingDemo}<span aria-hidden="true">↗</span></a><a href="#contact-form">{ui.closingContact}<span aria-hidden="true">↓</span></a></div></div>
        <div class="closing-visual">
          <figure class="closing-desktop"><img src="/images/screens/05-solane-inventario-desktop.png" alt={ui.productAlt} width="1366" height="900" loading="lazy" decoding="async" /><figcaption>{ui.closingDesktop}</figcaption></figure>
          <figure class="closing-mobile"><img src="/images/screens/04-vedra-grupo-mobile.png" alt={localPanel(PANEL_CATALOG[0].screenshot.alt)} width="390" height="844" loading="lazy" decoding="async" /><figcaption>{ui.closingMobile}</figcaption></figure>
        </div>
      </div>
      <div id="contact-form" class="shell contact-grid">
        <div class="contact-copy"><p class="eyebrow">{c.lead.eyebrow}</p><h3 class="heading">{c.lead.title}</h3><p class="editorial">{c.lead.body}</p><a class="whatsapp-link" href={contact.href} target="_blank" rel="noreferrer">{c.lead.whatsapp}<span aria-hidden="true"> ↗</span></a></div>
        <CommercialLeadForm locale={locale} />
      </div>
    </section>
  </main>

  <CommercialFooter locale={locale} home />
  <CookiePreferences locale={locale} />
  <CommercialTour locale={locale} />
</div>

<script>
  const briefTransition = document.querySelector<HTMLFormElement>('[data-brief-transition]');
  briefTransition?.addEventListener('submit', (event) => {
    const email = briefTransition.querySelector<HTMLInputElement>('[data-brief-email]');
    const target = briefTransition.dataset.briefTarget;
    if (!email || !target || !briefTransition.checkValidity()) return;
    event.preventDefault();
    const destination = new URL(target, window.location.origin);
    destination.hash = new URLSearchParams({ email: email.value.trim() }).toString();
    window.location.assign(`${destination.pathname}${destination.hash}`);
  });

  const journeyViewport = document.querySelector<HTMLElement>('[data-journey-viewport]');
  const journeyControls = document.querySelector<HTMLElement>('[data-journey-controls]');
  const journeyPrevious = journeyControls?.querySelector<HTMLButtonElement>('[data-journey-previous]');
  const journeyNext = journeyControls?.querySelector<HTMLButtonElement>('[data-journey-next]');
  const reducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)');
  const compactJourney = window.matchMedia('(max-width: 860px)');

  const updateJourneyControls = () => {
    if (!journeyViewport || !journeyControls) return;
    const scrollable = journeyViewport.scrollWidth > journeyViewport.clientWidth + 2;
    journeyControls.hidden = !scrollable;
    if (!scrollable) return;
    if (journeyPrevious) journeyPrevious.disabled = journeyViewport.scrollLeft <= 2;
    if (journeyNext) journeyNext.disabled = journeyViewport.scrollLeft + journeyViewport.clientWidth >= journeyViewport.scrollWidth - 2;
  };
  const moveJourney = (direction: -1 | 1) => {
    if (!journeyViewport) return;
    const step = journeyViewport.querySelector<HTMLElement>('[data-journey-step]');
    journeyViewport.scrollBy({ left: direction * (step?.offsetWidth ?? journeyViewport.clientWidth) * 0.9, behavior: reducedMotion.matches ? 'auto' : 'smooth' });
  };
  journeyPrevious?.addEventListener('click', () => moveJourney(-1));
  journeyNext?.addEventListener('click', () => moveJourney(1));
  journeyViewport?.addEventListener('scroll', updateJourneyControls, { passive: true });
  journeyViewport?.addEventListener('keydown', (event) => {
    if (event.key !== 'ArrowLeft' && event.key !== 'ArrowRight') return;
    event.preventDefault();
    moveJourney(event.key === 'ArrowRight' ? 1 : -1);
  });
  compactJourney.addEventListener('change', updateJourneyControls);
  window.addEventListener('resize', updateJourneyControls);
  requestAnimationFrame(updateJourneyControls);

  const platformTabsRoot = document.querySelector<HTMLElement>('[data-platform-tabs]');
  const platformTabs = [...document.querySelectorAll<HTMLAnchorElement>('[data-platform-tab]')];
  const platformPanels = [...document.querySelectorAll<HTMLElement>('[data-platform-panel]')];
  if (platformTabsRoot && platformTabs.length === platformPanels.length) {
    platformTabsRoot.setAttribute('role', 'tablist');
    const activatePlatformTab = (targetId: string, moveFocus = false) => {
      platformTabs.forEach((tab) => {
        const active = tab.dataset.platformTarget === targetId;
        tab.classList.toggle('is-active', active);

---
import { PRODUCT, type Locale } from '@logic-reserva/config';
import { COMMERCIAL_PLANS, IMPLEMENTATION_SERVICES, localizedCommercialText, type CommercialText } from '@logic-reserva/config/commercial';
import PricingCards from './PricingCards.astro';
import Base from '../layouts/Base.astro';
import CommercialChrome from './CommercialChrome.astro';

interface Props { locale?: Locale }

const { locale = 'es' } = Astro.props;
const prefix = locale === 'en' ? '/en' : '';
const local = (value: CommercialText) => localizedCommercialText(value, locale);
const ui = locale === 'en' ? {
  metaTitle: 'Restaurant booking plans | Logic Reserva',
  description: 'Compare three Logic Reserva plans, their working demos, implementation responsibilities, maintenance and growth path for restaurant teams.',
  eyebrow: 'Three commercial starting points', title: 'A plan for each stage of your restaurant.',
  intro: 'Three transparent starting points for one restaurant. Monthly pricing and launch are visible; providers, migration and custom integrations are quoted separately.',
  back: 'Back to Logic Reserva', bestFor: 'A fit when', includes: 'Included from the start', boundary: 'Current boundary', growth: 'Growth path', contactPlan: 'Choose this plan', demo: 'Open the demo', perMonth: '/month', onboarding: 'Launch',
  ladderEyebrow: 'Functional ladder', ladderTitle: 'Compare what you need.', ladderIntro: 'Each plan adds to the previous one. Start with your website and expand later.',
  stage: 'Capability', starts: 'Starts in', evidence: 'Evidence',
  implementationEyebrow: 'Getting started', implementationTitle: 'Launching, caring and improving are different jobs.',
  implementationIntro: 'We review setup, support and any separately quoted work with you.',
  scope: 'Scope boundary', responsibilityEyebrow: 'Shared responsibility', responsibilityTitle: 'What each party needs to bring.',
  restaurant: 'Restaurant', logic: 'Logic2B', proposal: 'Defined per proposal',
  restaurantItems: ['Business rules, content and authorised users', 'Ownership or authorised access to domain, DNS and provider accounts', 'Validation of data, privacy basis, payment rules and acceptance'],
  logicItems: ['Discovery, configuration and agreed implementation', 'Technical documentation, testing and handover', 'Maintenance and support only within the approved scope'],
  proposalItems: ['Migration volume and historical data', 'Payment, POS, messaging or other integrations', 'Timeline, service level, maintenance, price and exit support'],
  nextEyebrow: 'Inspect before deciding', nextTitle: 'Find your starting point.',
  websites: 'Compare restaurant websites', panels: 'Explore product views', guides: 'Read implementation guides', contact: 'Discuss my scope',
} : {
  metaTitle: 'Planes para restaurantes | Logic Reserva',
  description: 'Compara los tres planes de Logic Reserva, sus demos, responsabilidades de implantación, mantenimiento y camino de crecimiento para restauración.',
  eyebrow: 'Tres puntos de partida comerciales', title: 'Un plan para cada momento de tu restaurante.',
  intro: 'Tres puntos de partida transparentes para un restaurante. La cuota y la puesta en marcha son visibles; proveedores, migración e integraciones a medida se valoran aparte.',
  back: 'Volver a Logic Reserva', bestFor: 'Encaja cuando', includes: 'Incluido desde el inicio', boundary: 'Límite actual', growth: 'Camino de crecimiento', contactPlan: 'Elegir este plan', demo: 'Abrir la demo', perMonth: '/mes', onboarding: 'Puesta en marcha',
  ladderEyebrow: 'Escalera funcional', ladderTitle: 'Compara lo que necesitas.', ladderIntro: 'Cada plan añade funciones al anterior. Puedes empezar por la web y ampliar después.',
  stage: 'Capacidad', starts: 'Empieza en', evidence: 'Evidencia',
  implementationEyebrow: 'Puesta en marcha', implementationTitle: 'Lanzar, mantener y mejorar son trabajos distintos.',
  implementationIntro: 'Revisamos contigo qué incluye el alta, cómo te ayudamos y qué se presupuesta aparte.',
  scope: 'Límite de alcance', responsibilityEyebrow: 'Responsabilidad compartida', responsibilityTitle: 'Qué necesita aportar cada parte.',
  restaurant: 'Restaurante', logic: 'Logic2B', proposal: 'Se define por propuesta',
  restaurantItems: ['Reglas de negocio, contenidos y usuarios autorizados', 'Titularidad o acceso autorizado a dominio, DNS y cuentas de proveedores', 'Validación de datos, base de privacidad, reglas de cobro y aceptación'],
  logicItems: ['Descubrimiento, configuración e implantación acordada', 'Documentación técnica, pruebas y entrega', 'Mantenimiento y soporte solo dentro del alcance aprobado'],
  proposalItems: ['Volumen de migración y datos históricos', 'Cobros, TPV, mensajería u otras integraciones', 'Calendario, nivel de servicio, mantenimiento, precio y apoyo de salida'],
  nextEyebrow: 'Revisar antes de decidir', nextTitle: 'Encuentra tu punto de partida.',
  websites: 'Comparar webs de restaurante', panels: 'Explorar vistas de producto', guides: 'Leer guías de implantación', contact: 'Hablar de mi alcance',
};
const ladder = locale === 'en' ? [
  ['Brand and owned website', 'Basic', 'Brasca website, menu and enquiry journey'],
  ['Booking and availability', 'Management', 'Vedra widget and shared booking state'],
  ['Floor, waitlist and groups', 'Management', 'Vedra service, floor plan and group journey'],
  ['Events, deposits and private hire', 'Intelligent', 'Solane shared inventory and simulated commercial rules'],
  ['Explainable decision support', 'Intelligent', 'Solane deterministic reports and visible factors'],
] : [
  ['Marca y web propia', 'Básico', 'Web, carta y solicitud de Brasca'],
  ['Reserva y disponibilidad', 'Gestión', 'Widget de Vedra y estado compartido de la reserva'],
  ['Sala, espera y grupos', 'Gestión', 'Servicio, plano y recorrido de grupo de Vedra'],
  ['Eventos, depósitos y privatización', 'Inteligente', 'Inventario común y reglas comerciales simuladas de Solane'],
  ['Apoyo explicable a la decisión', 'Inteligente', 'Informes deterministas y factores visibles de Solane'],
];
const structuredData = [{
  '@context': 'https://schema.org', '@type': 'CollectionPage', name: ui.title, description: ui.description,
  url: new URL(`${prefix}/planes/`, PRODUCT.url).href,
  mainEntity: { '@type': 'ItemList', numberOfItems: 3, itemListElement: COMMERCIAL_PLANS.map((plan, index) => ({ '@type': 'ListItem', position: index + 1, name: local(plan.name), description: local(plan.promise) })) },
}, {
  '@context': 'https://schema.org', '@type': 'BreadcrumbList', itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Logic Reserva', item: `${PRODUCT.url}${prefix}/` },
    { '@type': 'ListItem', position: 2, name: ui.metaTitle, item: `${PRODUCT.url}${prefix}/planes/` },
  ],
}];
---

<Base locale={locale} title={ui.metaTitle} description={ui.description} structuredData={structuredData}>
  <CommercialChrome locale={locale} languageHref={locale === 'en' ? '/planes/' : '/en/planes/'}>
    <main id="contenido" class="plans-main" tabindex="-1">
      <section class="shell plans-hero" aria-labelledby="plans-title">
        <a class="back" href={`${prefix}/`}><span aria-hidden="true">←</span>{ui.back}</a>
        <div class="plans-hero__grid"><div><p class="eyebrow">{ui.eyebrow}</p><h1 id="plans-title">{ui.title}</h1></div><p>{ui.intro}</p></div>
      </section>

      <section class="shell" aria-label={ui.eyebrow}><PricingCards locale={locale} /></section>

      <section class="shell ladder" aria-labelledby="ladder-title">
        <div class="section-heading"><div><p class="eyebrow">{ui.ladderEyebrow}</p><h2 id="ladder-title">{ui.ladderTitle}</h2></div><p>{ui.ladderIntro}</p></div>
        <div class="ladder-table" role="table" aria-label={ui.ladderTitle}>
          <div class="ladder-row ladder-row--head" role="row"><span role="columnheader">{ui.stage}</span><span role="columnheader">{ui.starts}</span><span role="columnheader">{ui.evidence}</span></div>
          {ladder.map((row, index) => <div class="ladder-row" role="row"><span role="cell"><i>0{index + 1}</i>{row[0]}</span><strong role="cell">{row[1]}</strong><span role="cell">{row[2]}</span></div>)}
        </div>
      </section>

      <section class="implementation" aria-labelledby="implementation-title"><div class="shell">
        <div class="section-heading"><div><p class="eyebrow">{ui.implementationEyebrow}</p><h2 id="implementation-title">{ui.implementationTitle}</h2></div><p>{ui.implementationIntro}</p></div>
        <details class="scope-details"><summary>{ui.implementationTitle}</summary><div class="service-grid">{IMPLEMENTATION_SERVICES.map((service, index) => <article><span>0{index + 1}</span><h3>{local(service.title)}</h3><p>{local(service.summary)}</p><ol>{service.steps.map((step) => <li>{local(step)}</li>)}</ol><aside><strong>{ui.scope}</strong><p>{local(service.boundary)}</p></aside></article>)}</div></details>
      </div></section>

      <section class="shell responsibilities" aria-labelledby="responsibility-title">
        <div><p class="eyebrow">{ui.responsibilityEyebrow}</p><h2 id="responsibility-title">{ui.responsibilityTitle}</h2></div>
        <div class="responsibility-grid">
          <article><h3>{ui.restaurant}</h3><ul>{ui.restaurantItems.map((item) => <li>{item}</li>)}</ul></article>
          <article><h3>{ui.logic}</h3><ul>{ui.logicItems.map((item) => <li>{item}</li>)}</ul></article>
          <article><h3>{ui.proposal}</h3><ul>{ui.proposalItems.map((item) => <li>{item}</li>)}</ul></article>
        </div>
      </section>

      <section class="shell next" aria-labelledby="next-title"><div><p class="eyebrow">{ui.nextEyebrow}</p><h2 id="next-title">{ui.nextTitle}</h2></div><nav><a href={`${prefix}/temas/`}>{ui.websites}<span>↗</span></a><a href={`${prefix}/paneles/`}>{ui.panels}<span>↗</span></a><a href={`${prefix}/docs/`}>{ui.guides}<span>↗</span></a><a href={`${prefix}/#contacto`}>{ui.contact}<span>→</span></a></nav></section>
    </main>
  </CommercialChrome>
</Base>

<style>
  .plans-main { overflow: clip; padding-bottom: clamp(90px, 11vw, 160px); }.plans-hero { padding-top: 28px; }.back { display: inline-flex; min-height: 44px; align-items: center; gap: 8px; color: var(--slate); font-size: .82rem; text-decoration: none; }
  .plans-hero__grid, .section-heading { display: grid; grid-template-columns: minmax(0, 1.25fr) minmax(280px, .75fr); align-items: end; gap: clamp(40px, 8vw, 120px); padding: clamp(34px, 5vw, 64px) 0 clamp(42px, 5vw, 64px); }.plans-hero h1 { max-width: 820px; margin: 0; font-size: clamp(3.2rem, 5.8vw, 5.8rem); font-weight: 600; letter-spacing: -.06em; line-height: .92; }.plans-hero__grid > p, .section-heading > p { margin: 0; color: var(--slate); font-family: var(--serif); font-size: clamp(1.04rem, 1.5vw, 1.22rem); line-height: 1.58; }
  .ladder { padding-top: clamp(90px, 12vw, 170px); }.section-heading h2, .responsibilities h2, .next h2 { max-width: 860px; margin: 0; font-size: clamp(2.5rem, 5vw, 5.2rem); letter-spacing: -.058em; line-height: .94; }.ladder-table { border-top: 1px solid var(--line); }.ladder-row { display: grid; grid-template-columns: 1.05fr .35fr 1fr; gap: 24px; align-items: center; border-bottom: 1px solid var(--line); padding: 21px 0; }.ladder-row > span:first-child { display: flex; align-items: center; gap: 18px; font-weight: 650; }.ladder-row i { color: var(--color-notion-blue-strong); font-size: .7rem; font-style: normal; }.ladder-row > span:last-child { color: var(--slate); font-family: var(--serif); line-height: 1.45; }.ladder-row--head { color: var(--slate); padding-block: 13px; font-size: .7rem; font-weight: 700; letter-spacing: .05em; text-transform: uppercase; }.ladder-row--head > span:first-child { font-weight: 700; }
  .implementation { margin-top: clamp(90px, 12vw, 170px); padding: clamp(70px, 9vw, 120px) 0; background: var(--color-sky-tint); }.implementation .section-heading { padding-top: 0; }.service-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 14px; }.service-grid article { display: flex; flex-direction: column; border-radius: 12px; padding: clamp(22px, 3vw, 32px); background: white; }.service-grid article > span { color: var(--color-notion-blue-strong); font-size: .72rem; font-weight: 700; }.service-grid h3 { margin: 36px 0 12px; font-size: clamp(1.8rem, 2.7vw, 2.7rem); letter-spacing: -.045em; line-height: .98; }.service-grid article > p { min-height: 76px; margin: 0; color: var(--slate); font-family: var(--serif); line-height: 1.5; }.service-grid ol { margin: 22px 0; padding: 0; list-style: none; counter-reset: service; }.service-grid li { position: relative; border-top: 1px solid var(--line); padding: 12px 0 12px 30px; font-size: .82rem; line-height: 1.4; counter-increment: service; }.service-grid li::before { position: absolute; left: 0; color: var(--slate); content: counter(service, decimal-leading-zero); font-size: .65rem; }.service-grid aside { margin-top: auto; border-radius: 8px; padding: 14px; background: #f3f2ef; }.service-grid aside strong { color: var(--slate); font-size: .68rem; text-transform: uppercase; }.service-grid aside p { margin: 7px 0 0; font-size: .78rem; line-height: 1.45; }
  .responsibilities { display: grid; grid-template-columns: .75fr 1.25fr; gap: clamp(45px, 8vw, 120px); padding-top: clamp(90px, 12vw, 170px); }.responsibility-grid { display: grid; gap: 12px; }.responsibility-grid article { border-top: 1px solid var(--line); padding: 20px 0; }.responsibility-grid h3 { margin: 0; font-size: 1.35rem; letter-spacing: -.02em; }.responsibility-grid li { position: relative; padding: 8px 0 8px 22px; color: var(--slate); font-family: var(--serif); line-height: 1.5; }.responsibility-grid li::before { position: absolute; left: 0; color: var(--color-notion-blue-strong); content: '—'; }
  .next { display: grid; grid-template-columns: 1fr .85fr; gap: clamp(45px, 8vw, 120px); align-items: end; margin-top: clamp(90px, 12vw, 170px); border-radius: 12px; padding: clamp(28px, 5vw, 58px); color: white; background: var(--color-midnight-ink); }.next .eyebrow { color: var(--color-marigold); }.next nav { display: grid; border-top: 1px solid rgb(255 255 255 / 25%); }.next a { display: flex; min-height: 52px; align-items: center; justify-content: space-between; border-bottom: 1px solid rgb(255 255 255 / 25%); color: white; text-decoration: none; }
  @media (max-width: 980px) { .service-grid { grid-template-columns: 1fr; }.service-grid article > p { min-height: 0; }.plans-hero__grid, .section-heading, .responsibilities, .next { grid-template-columns: 1fr; }.responsibilities, .next { gap: 38px; } }
  @media (max-width: 660px) { .plans-hero { padding-top: 16px; }.plans-hero__grid { gap: 24px; }.plans-hero h1 { font-size: clamp(3rem, 13vw, 4.35rem); }.ladder-row { grid-template-columns: 1fr; gap: 7px; padding: 18px 0; }.ladder-row--head { display: none; }.ladder-row > span:first-child { gap: 10px; }.ladder-row strong { padding-left: 28px; }.ladder-row > span:last-child { padding-left: 28px; }.next { margin-inline: 14px; } }
</style>

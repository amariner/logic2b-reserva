---
import InterfaceIcon from './InterfaceIcon.astro';

interface Props { kind: string; label: string; alt: string; locale?: 'es' | 'en' }

const { kind, label, alt, locale = 'es' } = Astro.props;
const en = locale === 'en';
const copy = en ? {
  live: 'Live demo', website: 'Restaurant website', headline: 'A table worth remembering.', book: 'Book a table', menu: 'View menu', direct: 'Direct booking', prepared: 'Request ready',
  booking: 'Booking #2841', confirmed: 'Confirmed', guest: 'Clara Vidal', dinner: 'Dinner', diners: '4 guests', date: 'Fri 18 Sep · 21:00', table: 'Table 12', menuName: 'Seasonal menu', notes: 'Birthday · nut allergy', deposit: 'Deposit secured', amount: '€100 received',
  floor: 'Friday service', free: 'Free', occupied: 'Occupied', event: 'Event', selected: 'Table 12 selected', selectedMeta: '4 guests · 21:00 · Clara Vidal', assign: 'Open booking',
  groups: 'Groups & events', newLead: 'New enquiry', proposal: 'Proposal', depositPaid: 'Deposit', ready: 'Ready for service', eventName: 'Private dinner · 28 guests', room: 'Garden room', proposalSent: 'Proposal accepted', block: '8 tables blocked',
  reports: 'Service pulse', occupancy: 'Occupancy', directShare: 'Direct booking', noShows: 'No-show exposure', revenue: 'Expected covers', decision: 'Suggested next step', decisionTitle: 'Confirm the terrace turn', signals: '12 searches · 6 free tables', human: 'Human approval required', review: 'Review decision', detail: 'Highlighted detail',
} : {
  live: 'Demo navegable', website: 'Web del restaurante', headline: 'Una mesa para recordar.', book: 'Reservar mesa', menu: 'Ver la carta', direct: 'Reserva directa', prepared: 'Solicitud preparada',
  booking: 'Reserva #2841', confirmed: 'Confirmada', guest: 'Clara Vidal', dinner: 'Cena', diners: '4 comensales', date: 'Vie 18 sep · 21:00', table: 'Mesa 12', menuName: 'Menú de temporada', notes: 'Cumpleaños · alergia a frutos secos', deposit: 'Señal garantizada', amount: '100 € recibidos',
  floor: 'Servicio del viernes', free: 'Libre', occupied: 'Ocupada', event: 'Evento', selected: 'Mesa 12 seleccionada', selectedMeta: '4 comensales · 21:00 · Clara Vidal', assign: 'Abrir reserva',
  groups: 'Grupos y eventos', newLead: 'Nueva solicitud', proposal: 'Propuesta', depositPaid: 'Señal', ready: 'Listo para sala', eventName: 'Cena privada · 28 personas', room: 'Sala Jardín', proposalSent: 'Propuesta aceptada', block: '8 mesas bloqueadas',
  reports: 'Pulso del servicio', occupancy: 'Ocupación', directShare: 'Reserva directa', noShows: 'Exposición no-show', revenue: 'Cubiertos previstos', decision: 'Siguiente paso sugerido', decisionTitle: 'Confirmar el turno de terraza', signals: '12 búsquedas · 6 mesas libres', human: 'Requiere aprobación humana', review: 'Revisar decisión', detail: 'Detalle destacado',
};
---

<div class="interface-art" data-kind={kind} role="img" aria-label={alt}>
  <header class="interface-chrome" aria-hidden="true">
    <span class="chrome-dots"><i></i><i></i><i></i></span>
    <strong><InterfaceIcon name={kind} size={17} />{label}</strong>
    <span><i></i>{copy.live}</span>
  </header>

  {kind === 'web' && <div class="interface-scene web-scene" aria-hidden="true">
    <div class="web-nav"><b>SOLANE</b><span>{copy.menu}</span><button>{copy.book}</button></div>
    <div class="web-hero"><div><small>{copy.website}</small><h4>{copy.headline}</h4><button>{copy.book}<span>→</span></button></div><span class="web-orb"></span></div>
    <div class="zoom-card web-zoom"><small>{copy.detail}</small><div><i>✓</i><p><span>{copy.prepared}</span><strong>{copy.date}</strong></p></div><b>{copy.direct}</b></div>
  </div>}

  {kind === 'bookings' && <div class="interface-scene booking-scene" aria-hidden="true">
    <div class="booking-steps"><span class="done">✓ <b>{copy.booking}</b></span><i></i><span class="done">✓ {copy.depositPaid}</span><i></i><span class="current">3 {copy.confirmed}</span></div>
    <article class="booking-sheet"><header><div><small>{copy.booking}</small><h4>{copy.guest}</h4></div><span>{copy.confirmed}</span></header><div class="booking-grid"><p><small>{copy.dinner}</small><strong>{copy.date}</strong><span>{copy.diners}</span></p><p><small>{copy.table}</small><strong>12</strong><span>{copy.menuName}</span></p><p><small>{copy.notes}</small><strong>{copy.notes}</strong><span>VIP · Web</span></p></div></article>
    <div class="zoom-card booking-zoom"><small>{copy.detail}</small><div><i>✓</i><p><span>{copy.deposit}</span><strong>{copy.amount}</strong></p></div><b>Stripe · TEST</b></div>
  </div>}

  {kind === 'floor' && <div class="interface-scene floor-scene" aria-hidden="true">
    <div class="floor-toolbar"><strong>{copy.floor}</strong><span><i class="free"></i>{copy.free}</span><span><i class="busy"></i>{copy.occupied}</span><span><i class="event"></i>{copy.event}</span></div>
    <div class="floor-map"><span class="room-label">SALA</span>{['01','02','03','04','05','06','07','08','09','10','11','12'].map((table, index) => <span class:list={['table-dot', index < 4 && 'busy', index === 7 && 'event', index === 11 && 'selected']} style={`--x:${12 + (index % 4) * 24}%;--y:${18 + Math.floor(index / 4) * 31}%`}>{table}</span>)}<span class="service-line"></span></div>
    <div class="zoom-card floor-zoom"><small>{copy.detail}</small><div><i>12</i><p><span>{copy.selected}</span><strong>{copy.selectedMeta}</strong></p></div><b>{copy.assign} →</b></div>
  </div>}

  {kind === 'groups' && <div class="interface-scene groups-scene" aria-hidden="true">
    <div class="pipeline-title"><strong>{copy.groups}</strong><span>28 sep — 18 oct</span></div>
    <div class="pipeline"><section><h5>{copy.newLead}<b>3</b></h5><article><small>18 OCT</small><strong>Cena de empresa</strong><span>42 personas</span></article></section><section><h5>{copy.proposal}<b>2</b></h5><article class="active"><small>28 SEP</small><strong>{copy.eventName}</strong><span>{copy.room}</span></article></section><section><h5>{copy.depositPaid}<b>1</b></h5></section><section><h5>{copy.ready}<b>4</b></h5></section></div>
    <div class="zoom-card groups-zoom"><small>{copy.detail}</small><div><i>✓</i><p><span>{copy.proposalSent}</span><strong>{copy.eventName}</strong></p></div><b>{copy.block}</b></div>
  </div>}

  {kind === 'operations' && <div class="interface-scene operations-scene" aria-hidden="true">
    <div class="metrics"><article><span>{copy.occupancy}</span><strong>84%</strong><i>+7%</i></article><article><span>{copy.directShare}</span><strong>61%</strong><i>+12%</i></article><article><span>{copy.noShows}</span><strong>4</strong><i>−2</i></article><article><span>{copy.revenue}</span><strong>126</strong><i>+18</i></article></div>
    <div class="chart-card"><header><strong>{copy.reports}</strong><span>7 días</span></header><svg viewBox="0 0 620 210" preserveAspectRatio="none"><defs><linearGradient id={`area-${locale}`} x1="0" y1="0" x2="0" y2="1"><stop offset="0" stop-color="#18886d" stop-opacity=".3"/><stop offset="1" stop-color="#18886d" stop-opacity="0"/></linearGradient></defs><path class="grid" d="M0 42H620M0 84H620M0 126H620M0 168H620"/><path class="area" d="M0 178C55 170 74 124 124 134S202 163 250 108S327 84 372 101S451 128 496 67S560 42 620 24V210H0Z" fill={`url(#area-${locale})`}/><path class="line" d="M0 178C55 170 74 124 124 134S202 163 250 108S327 84 372 101S451 128 496 67S560 42 620 24"/><circle cx="496" cy="67" r="6"/></svg></div>
    <div class="zoom-card operations-zoom"><small>{copy.decision}</small><h4>{copy.decisionTitle}</h4><p>{copy.signals}</p><div><span>◇ {copy.human}</span><b>{copy.review} →</b></div></div>
  </div>}
</div>

<style>
  .interface-art{position:relative;min-height:560px;overflow:hidden;border:1px solid rgb(2 9 58 / 10%);border-radius:22px;background:#f7fafc;box-shadow:0 28px 70px rgb(18 48 72 / 14%)}
  .interface-chrome{display:flex;height:52px;align-items:center;justify-content:space-between;gap:14px;border-bottom:1px solid rgb(2 9 58 / 9%);padding:0 18px;background:#fff;color:#526675;font-size:11px}.interface-chrome strong,.interface-chrome>span:last-child{display:flex;align-items:center;gap:7px}.interface-chrome>span:last-child i{width:7px;height:7px;border-radius:50%;background:#24a16b}.chrome-dots{display:flex;gap:5px}.chrome-dots i{width:7px;height:7px;border-radius:50%;background:#d7dee4}.interface-scene{position:relative;min-height:508px;overflow:hidden;padding:clamp(18px,2.8vw,34px)}
  .web-scene{background:linear-gradient(135deg,#e8d9ca,#f7efe7 58%,#c5dace)}.web-nav{display:flex;align-items:center;justify-content:space-between;gap:14px;font-size:11px}.web-nav b{letter-spacing:.18em}.web-nav button,.web-hero button{border:0;border-radius:999px;padding:9px 13px;color:white;background:#16372f;font:inherit}.web-hero{display:grid;min-height:380px;place-items:center;isolation:isolate;text-align:center}.web-hero small{font-size:10px;letter-spacing:.15em;text-transform:uppercase}.web-hero h4{max-width:440px;margin:14px auto 23px;font:500 clamp(38px,5vw,68px)/.92 var(--serif);letter-spacing:-.06em}.web-hero button{padding:12px 18px}.web-hero button span{margin-left:18px}.web-orb{position:absolute;z-index:-1;width:330px;height:330px;border-radius:50%;background:radial-gradient(circle at 35% 30%,#fff8,#c28d6288),linear-gradient(135deg,#d6a982,#7c4d35);box-shadow:0 30px 90px #4d2b1d30}
  .booking-scene{background:#edf3f8}.booking-steps{display:flex;max-width:620px;align-items:center;gap:9px;margin:10px auto 30px;color:#667886;font-size:11px}.booking-steps>i{height:1px;flex:1;background:#b9c9d4}.booking-steps span{display:flex;align-items:center;gap:6px;white-space:nowrap}.booking-steps .done{color:#19714f}.booking-steps .current{color:#fff;border-radius:999px;padding:6px 9px;background:#163b55}.booking-sheet{max-width:670px;margin:auto;border:1px solid #ccd9e2;border-radius:15px;background:#fff;box-shadow:0 22px 55px #163b5518}.booking-sheet header{display:flex;align-items:center;justify-content:space-between;padding:22px;border-bottom:1px solid #e5ebef}.booking-sheet header small,.booking-grid small{display:block;color:#71808b;font-size:10px}.booking-sheet h4{margin:5px 0 0;font-size:22px}.booking-sheet header>span{border-radius:999px;padding:7px 10px;color:#176a49;background:#e2f5eb;font-size:10px}.booking-grid{display:grid;grid-template-columns:repeat(3,1fr);padding:22px}.booking-grid p{display:grid;gap:6px;margin:0;padding:8px 18px;border-right:1px solid #e6ebef}.booking-grid p:first-child{padding-left:0}.booking-grid p:last-child{border:0}.booking-grid strong{font-size:13px}.booking-grid span{color:#70818d;font-size:10px}
  .floor-scene{background:#e8efe9}.floor-toolbar{display:flex;align-items:center;gap:15px;padding:11px 14px;border-radius:10px;background:#fff;font-size:10px}.floor-toolbar strong{margin-right:auto;font-size:12px}.floor-toolbar span{display:flex;align-items:center;gap:5px}.floor-toolbar i{width:8px;height:8px;border-radius:50%;background:#73b88c}.floor-toolbar i.busy{background:#d89d54}.floor-toolbar i.event{background:#805ca9}.floor-map{position:relative;height:390px;margin-top:16px;overflow:hidden;border:1px solid #cad7cd;border-radius:18px;background:linear-gradient(90deg,#dce7dd 1px,transparent 1px),linear-gradient(#dce7dd 1px,transparent 1px),#f7fbf7;background-size:30px 30px}.room-label{position:absolute;top:16px;left:18px;color:#799080;font-size:9px;letter-spacing:.16em}.table-dot{position:absolute;left:var(--x);top:var(--y);display:grid;width:52px;height:52px;place-items:center;border:7px solid #d7ede0;border-radius:50%;color:#31734c;background:#fff;box-shadow:0 8px 17px #163b5510;font-size:10px;transform:translate(-50%,-50%)}.table-dot.busy{border-color:#f0d8ba;color:#8d5b1b}.table-dot.event{border-color:#e0d3ed;color:#6b458d}.table-dot.selected{outline:4px solid #1a78d1;outline-offset:4px;border-color:#cfe7fb;color:#1766ad}.service-line{position:absolute;inset:50% 8% auto;height:1px;border-top:2px dashed #bdcabe}
  .groups-scene{background:#f2f0ed}.pipeline-title{display:flex;align-items:center;justify-content:space-between;margin:4px 0 20px}.pipeline-title span{color:#71808b;font-size:10px}.pipeline{display:grid;grid-template-columns:repeat(4,1fr);gap:10px}.pipeline section{min-height:375px;border-radius:11px;padding:10px;background:#e8e5e1}.pipeline h5{display:flex;justify-content:space-between;margin:3px 2px 12px;color:#5f6d74;font-size:9px;text-transform:uppercase}.pipeline h5 b{display:grid;width:18px;height:18px;place-items:center;border-radius:50%;background:#fff}.pipeline article{display:grid;gap:5px;border-radius:9px;padding:13px;background:#fff;box-shadow:0 5px 14px #253b4e0c}.pipeline article.active{outline:2px solid #167c70}.pipeline article small{color:#7d8c94;font-size:8px}.pipeline article strong{font-size:11px}.pipeline article span{color:#73808a;font-size:9px}
  .operations-scene{background:#eaf0f6}.metrics{display:grid;grid-template-columns:repeat(4,1fr);gap:10px}.metrics article{display:grid;gap:7px;border-radius:12px;padding:14px;background:#fff}.metrics span{color:#778692;font-size:9px}.metrics strong{font-size:24px}.metrics i{width:fit-content;border-radius:99px;padding:3px 5px;color:#16714f;background:#e5f5ed;font-size:8px;font-style:normal}.chart-card{margin-top:14px;border-radius:14px;padding:18px;background:#fff}.chart-card header{display:flex;justify-content:space-between;font-size:11px}.chart-card header span{color:#71808b}.chart-card svg{width:100%;height:250px;margin-top:12px;overflow:visible}.chart-card .grid{fill:none;stroke:#e3e9ed;stroke-width:1}.chart-card .line{fill:none;stroke:#18886d;stroke-width:4;stroke-linecap:round}.chart-card circle{fill:#fff;stroke:#18886d;stroke-width:4}
  .zoom-card{position:absolute;z-index:3;right:clamp(14px,2vw,28px);bottom:clamp(14px,2vw,28px);width:min(300px,calc(100% - 28px));border:1px solid rgb(2 9 58 / 12%);border-radius:15px;padding:14px;background:#fff;box-shadow:0 24px 65px #142f4930;transform:rotate(-1.2deg)}.zoom-card>small{display:block;margin-bottom:9px;color:#697b88;font-size:8px;font-weight:750;letter-spacing:.12em;text-transform:uppercase}.zoom-card>div{display:flex;align-items:center;gap:10px}.zoom-card>div>i{display:grid;width:35px;height:35px;flex:none;place-items:center;border-radius:10px;color:#fff;background:#16866a;font-size:11px;font-style:normal}.zoom-card p{display:grid;gap:3px;margin:0}.zoom-card p span{color:#6d7c86;font-size:9px}.zoom-card p strong{font-size:11px}.zoom-card>b{display:block;margin-top:10px;border-top:1px solid #e5eaed;padding-top:9px;color:#176d59;font-size:9px}.floor-zoom>div>i{border-radius:50%;background:#176fbd}.operations-zoom{width:min(330px,calc(100% - 28px));color:#fff;background:#092943;transform:rotate(1deg)}.operations-zoom h4{margin:4px 0 8px;font-size:18px}.operations-zoom p{color:#a7c2d4;font-size:10px}.operations-zoom>div{justify-content:space-between;margin-top:15px;border-top:1px solid #ffffff26;padding-top:11px;font-size:9px}.operations-zoom>div span{color:#a7c2d4}.operations-zoom>div b{color:#fff}.web-zoom{transform:rotate(1.5deg)}
  @media(max-width:680px){.interface-art{min-height:480px}.interface-scene{min-height:428px;padding:14px}.interface-chrome>strong svg{display:none}.web-hero{min-height:340px}.web-orb{width:260px;height:260px}.booking-grid{grid-template-columns:1fr}.booking-grid p{border:0;border-bottom:1px solid #e6ebef;padding:10px 0}.booking-grid p:last-child{display:none}.booking-steps span b{display:none}.floor-map{height:335px}.table-dot{width:42px;height:42px;border-width:5px}.pipeline{grid-template-columns:repeat(4,145px);overflow:hidden}.metrics{grid-template-columns:repeat(2,1fr)}.metrics article:nth-child(n+3){display:none}.chart-card svg{height:205px}.zoom-card{right:12px;bottom:12px}.operations-zoom{right:12px}.interface-chrome{padding-inline:12px}}
  @media(prefers-reduced-motion:reduce){.zoom-card{transform:none}}
</style>

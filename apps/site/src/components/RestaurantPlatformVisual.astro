  .web-desktop{position:relative;overflow:hidden;border:1px solid #43312630;border-radius:8px;background:#f8f3e9;box-shadow:0 16px 35px #49332520}
  .web-nav{height:48px;padding:0 17px;color:#483b30;background:#f8f3e9;font-size:9px;gap:10px}

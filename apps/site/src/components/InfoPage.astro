---
import type { Locale } from '@logic-reserva/config';
import Base from '../layouts/Base.astro';
import { COMMERCIAL_PAGE_DETAILS, INFO_PAGES, type CommercialPageKey, type InfoPageKey } from '../content';
import CommercialChrome from './CommercialChrome.astro';

interface Props { locale?: Locale; page: InfoPageKey; path: string }

const { locale = 'es', page, path } = Astro.props;
const content = INFO_PAGES[locale][page];
const prefix = locale === 'en' ? '/en' : '';
const languageHref = locale === 'en' ? path : `/en${path}`;
const commercialPage: CommercialPageKey | null = page === 'planes' || page === 'restaurantes' || page === 'grupos' ? page : null;
const detail = commercialPage ? COMMERCIAL_PAGE_DETAILS[locale][commercialPage] : null;
const pageUrl = `https://reserva.logic2b.com${prefix}${path}`;
const structuredData: Array<Record<string, unknown>> = [{
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Logic Reserva', item: `https://reserva.logic2b.com${prefix}/` },
    { '@type': 'ListItem', position: 2, name: content.title, item: pageUrl },
  ],
}];
if (detail) {
  structuredData.push({
    '@context': 'https://schema.org',
    '@type': 'WebPage',
    name: content.title,
    description: detail.metaDescription,
    url: pageUrl,
    isPartOf: { '@id': 'https://reserva.logic2b.com/#website' },
    about: { '@type': 'Thing', name: locale === 'en' ? 'Restaurant booking commercial demo' : 'Demostración comercial de reservas para restaurantes' },
  });
  structuredData.push({
    '@context': 'https://schema.org',
    '@type': 'FAQPage',
    mainEntity: detail.faqs.map((item) => ({ '@type': 'Question', name: item.question, acceptedAnswer: { '@type': 'Answer', text: item.answer } })),
  });
}
const ui = locale === 'en'
  ? { back: 'Back to Logic Reserva', chapters: 'From bottleneck to service', outcomes: 'What changes for the team', faq: 'Questions before deciding', context: 'Scope to define', title: 'Your operation sets the requirements. Logic2B reviews the implementation scope.', action: 'Discuss my scope', related: 'Keep exploring', plans: 'Compare plans', restaurants: 'Restaurant bookings', groups: 'Groups and events' }
  : { back: 'Volver a Logic Reserva', chapters: 'Del cuello de botella al servicio', outcomes: 'Lo que cambia para el equipo', faq: 'Preguntas antes de decidir', context: 'Alcance por definir', title: 'Tu operativa marca los requisitos. Logic2B revisa el alcance de implantación.', action: 'Hablar de mi alcance', related: 'Sigue explorando', plans: 'Comparar planes', restaurants: 'Reservas de restaurante', groups: 'Grupos y eventos' };
const relatedLinks = [
  { key: 'planes', label: ui.plans, href: `${prefix}/planes/` },
  { key: 'restaurantes', label: ui.restaurants, href: `${prefix}/soluciones/restaurantes/` },
  { key: 'grupos', label: ui.groups, href: `${prefix}/soluciones/grupos-y-eventos/` },
].filter((item) => item.key !== commercialPage);
const fallbackTitles = locale === 'en'
  ? { legal: 'Legal notice | Logic Reserva', privacidad: 'Privacy and demo data | Logic Reserva', cookies: 'Cookies and local storage | Logic Reserva' }
  : { legal: 'Aviso legal | Logic Reserva', privacidad: 'Privacidad y datos de la demo | Logic Reserva', cookies: 'Cookies y almacenamiento local | Logic Reserva' };
---

<Base
  locale={locale}
  title={detail?.metaTitle ?? fallbackTitles[page as keyof typeof fallbackTitles]}
  description={detail?.metaDescription ?? content.intro}
  robots={commercialPage ? 'index, follow, max-image-preview:large' : 'index, nofollow'}
  structuredData={structuredData}
>
  <CommercialChrome locale={locale} languageHref={languageHref}>
  <main id="contenido" class="shell info-main" tabindex="-1">
    <a class="back-link" href={`${prefix}/`}><span aria-hidden="true">←</span> {ui.back}</a>
    <div class="info-grid">
      <section>
        <p class="eyebrow">{content.eyebrow}</p>
        <h1 class="display">{content.title}</h1>
        <p class="info-intro">{content.intro}</p>
      </section>
      <ol class="info-points">
        {content.points.map((point, index) => <li><span>0{index + 1}</span><p>{point}</p></li>)}
      </ol>
    </div>
    {detail && (
      <>
        <section class="detail-section" aria-labelledby="detail-title">
          <h2 id="detail-title">{ui.chapters}</h2>
          <div class="chapter-list">
            {detail.chapters.map((chapter, index) => <article><span>0{index + 1}</span><div><h3>{chapter.title}</h3><p>{chapter.body}</p></div></article>)}
          </div>
        </section>
        <section class="outcomes" aria-labelledby="outcomes-title">
          <h2 id="outcomes-title">{ui.outcomes}</h2>
          <ul>{detail.outcomes.map((outcome) => <li>{outcome}</li>)}</ul>
        </section>
        <section class="info-faq" aria-labelledby="info-faq-title">
          <div><p class="eyebrow">FAQ</p><h2 id="info-faq-title">{ui.faq}</h2></div>
          <div>{detail.faqs.map((item, index) => <details open={index === 0}><summary>{item.question}<span aria-hidden="true">+</span></summary><p>{item.answer}</p></details>)}</div>
        </section>
        <nav class="related-links" aria-label={ui.related}><span>{ui.related}</span>{relatedLinks.map((item) => <a href={item.href}>{item.label}<i aria-hidden="true">↗</i></a>)}</nav>
        <aside class="info-cta">
          <div><p class="eyebrow">{ui.context}</p><h2>{ui.title}</h2></div>
          <a class="pill" href={`${prefix}/#contacto`}>{ui.action}</a>
        </aside>
      </>
    )}
  </main>
  </CommercialChrome>
</Base>

<style>
  .info-main { padding-block: clamp(64px, 9vw, 120px); }.back-link { display: inline-flex; min-height: 44px; align-items: center; margin-bottom: clamp(60px, 9vw, 110px); color: var(--slate); font-size: .84rem; text-decoration: none; }.back-link:hover { color: var(--ink); }
  .info-grid { display: grid; grid-template-columns: 1.1fr .9fr; gap: clamp(50px, 10vw, 150px); }.info-grid h1 { max-width: 850px; }.info-intro { max-width: 62ch; margin: 30px 0 0; color: var(--slate); font-family: var(--serif); font-size: clamp(1.15rem, 1.8vw, 1.4rem); line-height: 1.6; }
  .info-points { margin: 0; padding: 0; border-top: 1px solid var(--line); list-style: none; }.info-points li { display: grid; grid-template-columns: 42px 1fr; gap: 14px; border-bottom: 1px solid var(--line); padding: 22px 0; }.info-points span { color: var(--color-notion-blue-strong); font-size: .74rem; font-weight: 700; }.info-points p { margin: 0; font-size: 1.05rem; line-height: 1.45; }
  .info-cta { display: flex; align-items: flex-end; justify-content: space-between; gap: 30px; margin-top: clamp(80px, 12vw, 160px); border-radius: 12px; padding: clamp(28px, 5vw, 56px); background: var(--color-marigold); }.info-cta h2 { max-width: 720px; margin: 0; font-size: clamp(2rem, 4vw, 4rem); letter-spacing: -.045em; line-height: 1; }.info-cta .eyebrow { color: var(--ink); }.info-cta .pill { flex: 0 0 auto; }
  .detail-section { margin-top: clamp(100px, 14vw, 190px); border-top: 1px solid var(--line); padding-top: clamp(56px, 8vw, 96px); }.detail-section > h2 { max-width: 850px; margin: 0 0 54px; font-size: clamp(2.4rem, 5vw, 4.8rem); letter-spacing: -.05em; line-height: .98; }.chapter-list { border-top: 1px solid var(--line); }.chapter-list article { display: grid; grid-template-columns: 70px 1fr; gap: 28px; border-bottom: 1px solid var(--line); padding: 32px 0; }.chapter-list article > span { color: var(--color-notion-blue-strong); font-size: .74rem; font-weight: 700; }.chapter-list h3 { margin: 0; font-size: clamp(1.45rem, 2.4vw, 2.1rem); letter-spacing: -.025em; }.chapter-list p { max-width: 72ch; margin: 12px 0 0; color: var(--slate); font-family: var(--serif); font-size: 1.08rem; line-height: 1.62; }
  .outcomes { display: grid; grid-template-columns: .75fr 1.25fr; gap: clamp(40px, 8vw, 120px); margin-top: clamp(80px, 10vw, 130px); border-radius: 12px; padding: clamp(28px, 5vw, 56px); color: white; background: var(--color-midnight-ink); }.outcomes h2 { margin: 0; font-size: clamp(2rem, 4vw, 3.6rem); letter-spacing: -.04em; line-height: 1; }.outcomes ul { margin: 0; padding: 0; list-style: none; }.outcomes li { border-top: 1px solid rgb(255 255 255 / 22%); padding: 20px 0; font-size: 1.04rem; }.outcomes li:last-child { border-bottom: 1px solid rgb(255 255 255 / 22%); }
  .info-faq { display: grid; grid-template-columns: .75fr 1.25fr; gap: clamp(40px, 8vw, 120px); margin-top: clamp(80px, 10vw, 130px); }.info-faq h2 { max-width: 500px; margin: 0; font-size: clamp(2.1rem, 4vw, 3.5rem); letter-spacing: -.04em; line-height: 1; }.info-faq details { border-top: 1px solid var(--line); }.info-faq details:last-child { border-bottom: 1px solid var(--line); }.info-faq summary { display: flex; justify-content: space-between; gap: 20px; padding: 22px 0; cursor: pointer; font-weight: 650; list-style: none; }.info-faq summary::-webkit-details-marker { display: none; }.info-faq summary span { font-size: 1.35rem; transition: transform 180ms ease; }.info-faq details[open] summary span { transform: rotate(45deg); }.info-faq details p { max-width: 68ch; margin: 0; padding: 0 40px 24px 0; color: var(--slate); font-family: var(--serif); line-height: 1.6; }
  .related-links { display: flex; flex-wrap: wrap; align-items: center; gap: 16px 28px; margin-top: 60px; border-top: 1px solid var(--line); padding-top: 24px; }.related-links > span { color: var(--slate); font-size: .82rem; }.related-links a { display: inline-flex; min-height: 44px; align-items: center; font-weight: 650; text-decoration: none; }.related-links i { margin-left: 7px; font-style: normal; }
  @media (max-width: 760px) { .info-grid, .outcomes, .info-faq { grid-template-columns: 1fr; }.info-main { padding-top: 44px; }.back-link { margin-bottom: 58px; }.chapter-list article { grid-template-columns: 40px 1fr; gap: 12px; }.info-cta { align-items: flex-start; flex-direction: column; } }
</style>

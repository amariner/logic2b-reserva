---
import type { Locale } from '@logic-reserva/config';
import { tourCopy, tourSteps, tourStepUrl } from '@logic-reserva/config/tour';
interface Props { locale?: Locale }
const { locale = 'es' } = Astro.props;
const ui = tourCopy(locale);
const steps = tourSteps(locale);
---

<dialog class="commercial-tour-intro" data-commercial-tour-intro aria-labelledby="commercial-tour-intro-title" aria-describedby="commercial-tour-intro-body">
  <article>
    <button class="commercial-tour-intro__close" type="button" data-tour-exit aria-label={ui.exit}>×</button>
    <p class="commercial-tour-intro__eyebrow">{ui.eyebrow}</p>
    <h2 id="commercial-tour-intro-title">{ui.title}</h2>
    <p id="commercial-tour-intro-body" class="commercial-tour-intro__body">{ui.body}</p>
    <ol class="commercial-tour-intro__steps" aria-label={ui.progress}>{steps.map((step, index) => <li><span>{String(index + 1).padStart(2, '0')}</span>{step.label}</li>)}</ol>
    <p class="commercial-tour-intro__meta">{ui.meta}</p>
    <div class="commercial-tour-intro__actions">
      <a href={tourStepUrl(steps[0])} data-tour-start><span data-tour-start-text>{ui.start}</span><span aria-hidden="true">→</span></a>
      <button type="button" data-tour-explore>{ui.explore}</button>
    </div>
  </article>
</dialog>

<style>
  .commercial-tour-intro { inset: 0; width: min(550px, calc(100vw - 24px)); max-height: calc(100dvh - 24px); margin: auto; overflow: auto; border: 1px solid var(--line); border-radius: 22px; padding: 0; color: var(--ink); background: var(--paper); box-shadow: 0 24px 90px rgb(2 9 58 / 25%); }
  .commercial-tour-intro::backdrop { background: rgb(2 9 58 / 56%); backdrop-filter: blur(5px); }
  .commercial-tour-intro > article { position: relative; padding: clamp(28px, 5vw, 42px); }
  .commercial-tour-intro__close { position: absolute; top: 12px; right: 12px; display: grid; width: 44px; height: 44px; place-items: center; border: 1px solid var(--line); border-radius: 50%; color: var(--slate); background: transparent; cursor: pointer; font-size: 1.25rem; }
  .commercial-tour-intro__eyebrow { margin: 0 48px 18px 0; color: var(--color-notion-blue-strong); font-size: .7rem; font-weight: 750; }
  .commercial-tour-intro h2 { max-width: 400px; margin: 0; font-size: clamp(2.5rem, 6vw, 3.5rem); letter-spacing: -.055em; line-height: 1; text-wrap: balance; }
  .commercial-tour-intro__body { margin: 18px 0 0; color: var(--slate); font-size: .9rem; line-height: 1.6; }
  .commercial-tour-intro__steps { display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); gap: 12px; margin: 26px 0 0; padding: 0; list-style: none; }
  .commercial-tour-intro__steps li { display: grid; gap: 9px; border-top: 1px solid var(--line); padding-top: 10px; font-size: .73rem; font-weight: 600; }
  .commercial-tour-intro__steps span { color: var(--color-notion-blue-strong); font-size: .64rem; }
  .commercial-tour-intro__meta { margin: 24px 0 0; color: var(--slate); font-size: .7rem; }
  .commercial-tour-intro__actions { display: grid; gap: 4px; margin-top: 18px; }
  .commercial-tour-intro__actions a, .commercial-tour-intro__actions button { display: inline-flex; min-height: 48px; align-items: center; justify-content: center; gap: 20px; border: 0; border-radius: 999px; padding: 10px 17px; color: var(--slate); background: transparent; cursor: pointer; font: inherit; font-size: .78rem; font-weight: 650; text-decoration: none; }
  .commercial-tour-intro__actions a { justify-content: space-between; color: white; background: var(--color-notion-blue-strong); }
  .commercial-tour-intro :is(button, a):focus-visible { outline: 2px solid var(--color-notion-blue-strong); outline-offset: 3px; }
  @media (max-width: 380px) { .commercial-tour-intro > article { padding: 28px 22px 20px; } .commercial-tour-intro__steps { gap: 8px; } .commercial-tour-intro__steps li { font-size: .67rem; } }
  @media (prefers-reduced-motion: reduce) { .commercial-tour-intro::backdrop { backdrop-filter: none; } }
</style>

<aside class="reserva-tour" data-tour-dock data-commercial-tour-dock aria-label={ui.tour} hidden>
  <div class="reserva-tour__heading">
    <p data-tour-eyebrow aria-live="polite"></p>
    <div class="reserva-tour__controls">
      <button type="button" data-tour-toggle aria-label={ui.collapse} aria-expanded="true" aria-controls="commercial-tour-content">−</button>
      <button type="button" data-tour-exit aria-label={ui.exit}>×</button>
    </div>
  </div>
  <div id="commercial-tour-content" data-tour-content>
    <h2 data-tour-title tabindex="-1"></h2>
    <p class="reserva-tour__body" data-tour-body></p>
    <nav class="reserva-tour__progress" aria-label={ui.progress}>
      {steps.map((step, index) => <button type="button" data-tour-jump={index} aria-label={`${index + 1}. ${step.label}`}><span></span><small>{step.label}</small></button>)}
    </nav>
    <div class="reserva-tour__actions">
      <button type="button" data-tour-back>{ui.back}</button>
      <a href={tourStepUrl(steps[1])} data-tour-next><span data-tour-next-text></span><span aria-hidden="true">→</span></a>
    </div>
    <a class="reserva-tour__return" href={locale === 'en' ? '/en/empezar/' : '/empezar/'} data-tour-contact>{ui.contact}<span aria-hidden="true">↗</span></a>
    <a class="reserva-tour__return" href={locale === 'en' ? '/en/' : '/'} data-tour-return hidden>{ui.return}</a>
  </div>
</aside>

<script>
  import { initCommercialTour } from '@logic-reserva/config/tour-client';
  initCommercialTour();
</script>

<style>
  .reserva-tour { position: fixed; z-index: 82; right: 20px; bottom: max(20px, env(safe-area-inset-bottom)); width: min(360px, calc(100vw - 40px)); max-height: calc(100dvh - 40px); overflow: auto; border: 1px solid rgb(2 9 58 / 14%); border-radius: 18px; padding: 12px 18px 18px; color: var(--ink, #02093a); background: var(--paper, #faf8f3); box-shadow: 0 12px 48px rgb(2 9 58 / 15%); font-family: var(--sans, 'Inter Variable', sans-serif); }
  .reserva-tour[hidden], .reserva-tour [hidden] { display: none; }
  .reserva-tour__heading { display: flex; align-items: center; justify-content: space-between; gap: 8px; }
  .reserva-tour__heading > p { margin: 0; color: var(--color-notion-blue-strong, #1557a5); font-size: .69rem; font-weight: 700; }
  .reserva-tour__controls { display: flex; }
  .reserva-tour__controls button { display: grid; place-items: center; width: 44px; height: 44px; border: 0; padding: 0; color: var(--slate, #41546b); background: transparent; font: inherit; font-size: 1.25rem; cursor: pointer; }
  .reserva-tour h2 { margin: 4px 0 0; color: inherit; font-family: var(--sans, 'Inter Variable', sans-serif); font-size: 1.3rem; line-height: 1.18; font-weight: 650; letter-spacing: -.035em; }
  .reserva-tour__body { margin: 10px 0 4px; color: var(--slate, #41546b); font-size: .78rem; line-height: 1.6; }
  .reserva-tour__progress { display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); gap: 6px; margin: 6px 0 8px; }
  .reserva-tour__progress button { min-height: 44px; border: 0; padding: 9px 0; text-align: left; color: var(--slate, #41546b); background: transparent; cursor: pointer; font: inherit; }
  .reserva-tour__progress button span { display: block; height: 3px; margin-bottom: 6px; border-radius: 4px; background: rgb(2 9 58 / 12%); }
  .reserva-tour__progress button small { display: block; font-size: .61rem; line-height: 1.3; }
  .reserva-tour__progress button[aria-current='step'] { color: var(--color-notion-blue-strong, #1557a5); font-weight: 750; }
  .reserva-tour__progress button[aria-current='step'] span { background: var(--color-notion-blue, #1871e3); }
  .reserva-tour__progress button[data-complete] span { background: var(--color-sky-wash, #9ed8ff); }
  .reserva-tour__actions { display: flex; gap: 8px; }
  .reserva-tour__actions > * { display: inline-flex; min-height: 44px; align-items: center; justify-content: center; gap: 12px; border: 1px solid rgb(2 9 58 / 15%); border-radius: 999px; padding: 10px 14px; color: inherit; background: transparent; cursor: pointer; font: inherit; font-size: .71rem; font-weight: 680; text-decoration: none; }
  .reserva-tour__actions > a { flex: 1; justify-content: space-between; color: white; background: var(--color-notion-blue-strong, #1557a5); border-color: transparent; }
  .reserva-tour__return { display: flex; min-height: 44px; align-items: center; justify-content: center; gap: 8px; margin-top: 5px; color: var(--slate, #41546b); font-size: .69rem; text-underline-offset: 3px; }
  .reserva-tour :is(button, a):focus-visible { outline: 2px solid var(--color-notion-blue-strong, #1557a5); outline-offset: 3px; }
  .reserva-tour [data-tour-title]:focus { outline: none; }
  .reserva-tour[data-collapsed] { width: min(280px, calc(100vw - 24px)); padding: 4px 8px 4px 16px; }
  @media (max-width: 620px) { .reserva-tour { right: 10px; bottom: max(10px, env(safe-area-inset-bottom)); width: calc(100vw - 20px); max-height: min(55dvh, 380px); padding: 7px 15px 15px; border-radius: 16px; } .reserva-tour h2 { font-size: 1.2rem; } }
  @media (prefers-reduced-motion: reduce) { .reserva-tour { scroll-behavior: auto; } }
</style>

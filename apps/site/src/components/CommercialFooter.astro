---
import { PRODUCT, type Locale } from '@logic-reserva/config';
import { logic2bContact } from '@logic-reserva/config/contact';
import { SITE_CONTENT } from '../content';
import BrandLockup from './BrandLockup.astro';

interface Props { locale?: Locale; home?: boolean; languageHref?: string }

const { locale = 'es', home = false, languageHref: requestedLanguageHref } = Astro.props;
const c = SITE_CONTENT[locale];
const prefix = locale === 'en' ? '/en' : '';
const languageHref = requestedLanguageHref ?? (locale === 'en' ? '/' : '/en/');
const directContact = logic2bContact(locale, 'commercial');
const ui = locale === 'en' ? {
  product: 'Product', explore: 'Explore', talk: 'Let’s talk', legal: 'Legal links',
  home: 'Home', plans: 'Plans', restaurants: 'Restaurant bookings', groups: 'Groups and events',
  portfolio: '12 website directions', panels: '6 product views', guides: '5 role guides',
  request: 'Discuss my project', whatsapp: 'WhatsApp Logic2B', email: 'Email Logic2B',
  featureEyebrow: 'Product before promises', featureTitle: 'Six views for decisions during service.',
  featureBody: 'Explore service, floor plan, waitlist, groups, reports and explainable support with reproducible demo states.',
  featureAction: 'Explore product views', language: 'Español', preferences: 'Cookie preferences',
} : {
  product: 'Producto', explore: 'Explora', talk: 'Hablemos', legal: 'Enlaces legales',
  home: 'Inicio', plans: 'Planes', restaurants: 'Reservas de restaurante', groups: 'Grupos y eventos',
  portfolio: '12 direcciones web', panels: '6 vistas de producto', guides: '5 guías por rol',
  request: 'Hablar de mi proyecto', whatsapp: 'WhatsApp Logic2B', email: 'Escribir a Logic2B',
  featureEyebrow: 'Producto antes que promesas', featureTitle: 'Seis vistas para decidir durante el servicio.',
  featureBody: 'Explora servicio, plano, espera, grupos, informes y apoyo explicable con estados de demo reproducibles.',
  featureAction: 'Explorar vistas de producto', language: 'English', preferences: 'Configurar cookies',
};
---

<footer class="site-footer" data-home-block={home ? 'footer' : undefined}>
  <div class="shell footer-main">
    <div class="footer-overview">
      <BrandLockup locale={locale} homeHref={`${prefix}/`} />
      <p>{c.footer.line}</p>
    </div>
    <div class="footer-links">
      <nav aria-label={ui.product}>
        <strong>{ui.product}</strong>
        <a href={`${prefix}/`}>{ui.home}</a>
        <a href={`${prefix}/planes/`}>{ui.plans}</a>
        <a href={`${prefix}/soluciones/restaurantes/`}>{ui.restaurants}</a>
        <a href={`${prefix}/soluciones/grupos-y-eventos/`}>{ui.groups}</a>
      </nav>
      <nav aria-label={ui.explore}>
        <strong>{ui.explore}</strong>
        <a href={`${prefix}/temas/`}>{ui.portfolio}</a>
        <a href={`${prefix}/paneles/`}>{ui.panels}</a>
        <a href={`${prefix}/docs/`}>{ui.guides}</a>
      </nav>
      <nav class="footer-talk" aria-label={ui.talk}>
        <strong>{ui.talk}</strong>
        <a class="footer-talk__request" href={`${prefix}/empezar/`} data-project-request-open aria-haspopup="dialog">{ui.request}<span aria-hidden="true">→</span></a>
        <div class="footer-direct">
          <a href={directContact.href} target="_blank" rel="noreferrer">{ui.whatsapp}<span aria-hidden="true">↗</span></a>
          <a href={`mailto:${PRODUCT.email}`}>{ui.email}<span aria-hidden="true">↗</span></a>
        </div>
      </nav>
    </div>
    <a class="footer-feature" href={`${prefix}/paneles/`}>
      <div>
        <p>{ui.featureEyebrow}</p>
        <h2>{ui.featureTitle}</h2>
        <span>{ui.featureBody}</span>
        <strong>{ui.featureAction}<i aria-hidden="true">→</i></strong>
      </div>
      <figure><img src="/images/screens/05-solane-inventario-desktop.png" alt="" width="1366" height="900" loading="lazy" decoding="async" /></figure>
    </a>
  </div>
  <div class="shell footer-bottom">
    <div><span>© 2026 Logic2B</span><span>{c.footer.demo}</span></div>
    <nav aria-label={ui.legal}>
      <a href={`${prefix}/legal/`}>{c.footer.legal}</a>
      <a href={`${prefix}/privacidad/`}>{c.footer.privacy}</a>
      <a href={`${prefix}/cookies/`}>{c.footer.cookies}</a>
      <button type="button" data-cookie-preferences hidden>{ui.preferences}</button>
      <a data-context-language-link href={languageHref} hreflang={locale === 'en' ? 'es' : 'en'}>{ui.language}</a>
    </nav>
  </div>
</footer>

<style>
  .site-footer { color: white; background: var(--color-midnight-ink); }
  .footer-main { display: grid; grid-template-columns: minmax(220px, .72fr) minmax(480px, 1.45fr) minmax(310px, .83fr); gap: clamp(36px, 5vw, 80px); padding-block: clamp(64px, 8vw, 104px); }
  .footer-overview { max-width: 310px; }
  .footer-overview :global(.brand-wordmark) { --ink: white; --slate: rgb(255 255 255 / 62%); --logo-2b: white; }
  .footer-overview > p { margin: 20px 0 0; color: rgb(255 255 255 / 58%); font-family: var(--serif); font-size: .92rem; line-height: 1.55; }
  .footer-links { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: clamp(24px, 4vw, 52px); }
  .footer-links nav { display: flex; min-width: 0; flex-direction: column; align-items: flex-start; }
  .footer-links nav > strong { min-height: 34px; color: rgb(255 255 255 / 48%); font-size: .67rem; letter-spacing: .09em; text-transform: uppercase; }
  .footer-links nav > a:not(.footer-talk__request), .footer-direct a { display: inline-flex; min-width: 44px; min-height: 44px; align-items: center; color: rgb(255 255 255 / 76%); font-size: .82rem; text-decoration: none; transition: color 160ms ease; }
  .footer-links nav > a:hover, .footer-direct a:hover { color: white; }
  .footer-talk__request { display: flex; width: 100%; min-height: 48px; align-items: center; justify-content: space-between; gap: 12px; border-radius: 999px; padding: 9px 14px; color: var(--color-midnight-ink); background: white; font-size: .76rem; font-weight: 740; text-decoration: none; }
  .footer-direct { display: grid; width: 100%; margin-top: 10px; }
  .footer-direct a { justify-content: space-between; gap: 10px; border-bottom: 1px solid rgb(255 255 255 / 12%); }
  .footer-feature { position: relative; display: grid; min-height: 320px; overflow: hidden; border: 1px solid rgb(255 255 255 / 14%); border-radius: 20px; color: white; background: rgb(255 255 255 / 7%); text-decoration: none; }
  .footer-feature > div { position: relative; z-index: 2; display: flex; flex-direction: column; padding: 26px; background: linear-gradient(180deg, var(--color-midnight-ink) 0, rgb(2 9 58 / 88%) 60%, transparent 100%); }
  .footer-feature p { margin: 0; color: var(--color-sky-wash); font-size: .65rem; font-weight: 750; letter-spacing: .08em; text-transform: uppercase; }
  .footer-feature h2 { margin: 12px 0 0; font-size: clamp(1.7rem, 2.4vw, 2.65rem); letter-spacing: -.05em; line-height: .95; }
  .footer-feature div > span { margin-top: 15px; color: rgb(255 255 255 / 64%); font-family: var(--serif); font-size: .8rem; line-height: 1.5; }
  .footer-feature strong { display: flex; align-items: center; justify-content: space-between; gap: 20px; margin-top: auto; padding-top: 18px; font-size: .73rem; }
  .footer-feature strong i { color: var(--color-sky-wash); font-style: normal; }
  .footer-feature figure { position: absolute; inset: auto 0 0; height: 46%; margin: 0; }
  .footer-feature img { display: block; width: 100%; height: 100%; object-fit: cover; object-position: top; opacity: .72; transition: transform 300ms ease, opacity 300ms ease; }
  .footer-feature:hover img { opacity: .9; transform: scale(1.025); }
  .footer-bottom { display: flex; min-height: 82px; align-items: center; justify-content: space-between; gap: 28px; border-top: 1px solid rgb(255 255 255 / 12%); color: rgb(255 255 255 / 48%); font-size: .68rem; }
  .footer-bottom > div { display: flex; flex-wrap: wrap; gap: 10px 22px; }
  .footer-bottom nav { display: flex; flex-wrap: wrap; align-items: center; justify-content: flex-end; gap: 4px 20px; }
  .footer-bottom a, .footer-bottom button { display: inline-flex; min-width: 44px; min-height: 44px; align-items: center; justify-content: center; border: 0; padding: 0; color: inherit; background: transparent; font: inherit; text-decoration: none; cursor: pointer; }
  .footer-bottom a:hover, .footer-bottom button:hover { color: white; }
  @media (max-width: 1050px) {
    .footer-main { grid-template-columns: 1fr; }
    .footer-overview { max-width: 520px; }
    .footer-feature { min-height: 390px; grid-template-columns: .8fr 1.2fr; }
    .footer-feature > div { min-height: 390px; background: linear-gradient(90deg, var(--color-midnight-ink) 0, rgb(2 9 58 / 94%) 78%, transparent 100%); }
    .footer-feature figure { inset: 0 0 0 auto; width: 60%; height: 100%; }
  }
  @media (max-width: 700px) {
    .footer-main { gap: 42px; padding-block: 58px; }
    .footer-links { grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 34px 24px; }
    .footer-talk { grid-column: 1 / -1; }
    .footer-feature { min-height: 520px; grid-template-columns: 1fr; }
    .footer-feature > div { min-height: 300px; background: linear-gradient(180deg, var(--color-midnight-ink) 0, rgb(2 9 58 / 92%) 85%, transparent 100%); }
    .footer-feature figure { inset: auto 0 0; width: 100%; height: 47%; }
    .footer-bottom { align-items: flex-start; flex-direction: column; padding-block: 24px; }
    .footer-bottom nav { justify-content: flex-start; }
  }
  @media (max-width: 390px) { .footer-links { grid-template-columns: 1fr; }.footer-talk { grid-column: auto; } }
  @media (prefers-reduced-motion: reduce) { .footer-feature img { transition: none; } }
</style>

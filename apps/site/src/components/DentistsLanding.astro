---
import type { Locale } from '@logic-reserva/config';
import Base from '../layouts/Base.astro';
import BrandLockup from './BrandLockup.astro';
import CookiePreferences from './CookiePreferences.astro';

interface Props { locale?: Locale }
const { locale = 'es' } = Astro.props;
const isEn = locale === 'en';
const prefix = isEn ? '/en' : '';
const languageHref = isEn ? '/dentistas/' : '/en/dentistas/';
const whatsappText = isEn
  ? 'Hello Logic2B, I would like to talk about the first dental clinic pilot.'
  : 'Hola Logic2B, me gustaría hablar de la primera propuesta para clínicas dentales.';
const contactHref = `https://wa.me/34626432316?text=${encodeURIComponent(whatsappText)}`;
const c = isEn ? {
  metaTitle: 'Web and appointment workflow for dental clinics | Logic2B',
  metaDescription: 'A first Logic2B proposal for dental clinics: owned website, appointment requests, a clear agenda and follow-up without losing context.',
  nav: ['The problem', 'The journey', 'First scope'], language: 'ES', contact: 'Discuss my clinic',
  eyebrow: 'Logic2B · Dental clinics', title: 'Fewer loose messages. More time for every patient.',
  intro: 'A website that explains your clinic clearly and an appointment workflow that carries the relevant context from the first enquiry to follow-up.',
  primary: 'Discuss my clinic', secondary: 'See the first journey', proof: ['Owned website', 'Organised appointment requests', 'One clear daily agenda'],
  mockLabel: 'Illustrative interface · Fictional data', today: 'Today · 26 September', agenda: 'Clinic agenda', next: 'Next patient', status: 'Confirmed',
  patient: 'Lucía R.', treatment: 'First assessment', note: 'Allergy noted · Review before appointment', timeline: ['Request received', 'Reception reviewed details', 'Appointment confirmed'], prepared: 'Ready for reception',
  problemEyebrow: 'The starting point', problemTitle: 'The leak is often between the call and the chair.',
  problems: [
    ['01', 'Requests arrive in different places', 'Calls, forms and messages force reception to rebuild the patient context.'],
    ['02', 'The agenda says when, but not always why', 'The team needs the reason for the visit and useful preparation without searching through conversations.'],
    ['03', 'Follow-up depends on memory', 'Pending actions need a visible owner and state instead of another informal reminder.'],
  ],
  journeyEyebrow: 'One continuous journey', journeyTitle: 'From choosing the clinic to preparing the appointment.',
  steps: [
    ['01', 'Explain and reassure', 'Services, team, location and a clear next step on an owned website.'],
    ['02', 'Request an appointment', 'The patient proposes a reason and availability; the clinic still confirms the appointment.'],
    ['03', 'Prepare the day', 'Reception sees time, status and the minimum context needed to coordinate the visit.'],
    ['04', 'Close the loop', 'A visible follow-up task helps the team decide the next action.'],
  ],
  scopeEyebrow: 'First pass', scopeTitle: 'Enough to validate the workflow. Not enough to make clinical promises.',
  inTitle: 'What this proposal explores', inItems: ['An owned, accessible clinic website', 'Appointment enquiries with explicit confirmation', 'A reception agenda with operational context', 'Follow-up tasks with a clear state'],
  outTitle: 'What is not active', outItems: ['No clinical record or diagnosis', 'No real messages or automatic reminders', 'No payment, insurer or practice integration', 'No processing of real patient data in this sample'],
  demo: 'Concept interface', demoText: 'Everything shown here is an initial commercial hypothesis with fictional data. The actual legal, clinical and technical scope must be reviewed with each clinic.',
  closeEyebrow: 'Choose the first bottleneck', closeTitle: 'Tell us where your clinic loses the thread today.', closeBody: 'We will review the current journey before proposing screens, integrations or automation.', closeAction: 'Talk on WhatsApp', back: 'Back to Logic Reserva', footer: 'First dental clinic pilot · Logic2B',
} : {
  metaTitle: 'Web y citas para clínicas dentales | Logic2B',
  metaDescription: 'Primera propuesta de Logic2B para clínicas dentales: web propia, solicitudes de cita, agenda clara y seguimiento sin perder contexto.',
  nav: ['El problema', 'El recorrido', 'Primer alcance'], language: 'EN', contact: 'Hablar de mi clínica',
  eyebrow: 'Logic2B · Clínicas dentales', title: 'Menos mensajes sueltos. Más tiempo para cada paciente.',
  intro: 'Una web que explica bien tu clínica y un recorrido de cita que conserva el contexto útil desde la primera solicitud hasta el seguimiento.',
  primary: 'Hablar de mi clínica', secondary: 'Ver el primer recorrido', proof: ['Web propia', 'Solicitudes de cita ordenadas', 'Agenda diaria clara'],
  mockLabel: 'Interfaz ilustrativa · Datos ficticios', today: 'Hoy · 26 de septiembre', agenda: 'Agenda de clínica', next: 'Siguiente paciente', status: 'Confirmada',
  patient: 'Lucía R.', treatment: 'Primera valoración', note: 'Alergia indicada · Revisar antes de la cita', timeline: ['Solicitud recibida', 'Recepción revisó los datos', 'Cita confirmada'], prepared: 'Lista para recepción',
  problemEyebrow: 'El punto de partida', problemTitle: 'La fuga suele estar entre la llamada y el sillón.',
  problems: [
    ['01', 'Las solicitudes llegan por sitios distintos', 'Llamadas, formularios y mensajes obligan a recepción a reconstruir el contexto del paciente.'],
    ['02', 'La agenda dice cuándo, pero no siempre por qué', 'El equipo necesita el motivo de visita y la preparación útil sin buscar en conversaciones.'],
    ['03', 'El seguimiento depende de la memoria', 'Las tareas pendientes necesitan responsable y estado visible, no otro recordatorio informal.'],
  ],
  journeyEyebrow: 'Un recorrido continuo', journeyTitle: 'De elegir clínica a preparar la cita.',
  steps: [
    ['01', 'Explicar y dar confianza', 'Servicios, equipo, ubicación y un siguiente paso claro desde una web propia.'],
    ['02', 'Solicitar una cita', 'El paciente propone motivo y disponibilidad; la clínica conserva la confirmación.'],
    ['03', 'Preparar el día', 'Recepción ve hora, estado y el contexto mínimo para coordinar la visita.'],
    ['04', 'Cerrar el círculo', 'Una tarea de seguimiento visible ayuda al equipo a decidir la próxima acción.'],
  ],
  scopeEyebrow: 'Primera pasada', scopeTitle: 'Suficiente para validar el recorrido. No para prometer funciones clínicas.',
  inTitle: 'Lo que explora esta propuesta', inItems: ['Web propia y accesible para la clínica', 'Solicitudes de cita con confirmación explícita', 'Agenda de recepción con contexto operativo', 'Tareas de seguimiento con estado claro'],
  outTitle: 'Lo que no está activo', outItems: ['Sin historia clínica ni diagnóstico', 'Sin mensajes ni recordatorios reales', 'Sin cobros, aseguradoras o integración clínica', 'Sin datos reales de pacientes en esta muestra'],
  demo: 'Interfaz de concepto', demoText: 'Todo lo que ves es una primera hipótesis comercial con datos ficticios. El alcance legal, clínico y técnico real se revisaría con cada clínica.',
  closeEyebrow: 'Elige el primer cuello de botella', closeTitle: 'Cuéntanos dónde pierde hoy el hilo tu clínica.', closeBody: 'Revisaremos el recorrido actual antes de proponer pantallas, integraciones o automatizaciones.', closeAction: 'Hablar por WhatsApp', back: 'Volver a Logic Reserva', footer: 'Primer piloto para clínicas dentales · Logic2B',
};
const structuredData = [{
  '@context': 'https://schema.org', '@type': 'WebPage', name: c.metaTitle,
  description: c.metaDescription, url: `https://reserva.logic2b.com${prefix}/dentistas/`,
  isPartOf: { '@id': 'https://reserva.logic2b.com/#website' },
  about: { '@type': 'Thing', name: isEn ? 'Dental clinic appointment workflow' : 'Gestión de solicitudes de cita dental' },
}];
---

<Base locale={locale} title={c.metaTitle} description={c.metaDescription} structuredData={structuredData} image="/logo-mark.svg" imageAlt="Logic2B">
  <header class="dentist-header">
    <div class="dentist-shell header-inner">
      <BrandLockup locale={locale} homeHref={`${prefix}/`} />
      <nav aria-label={isEn ? 'Main navigation' : 'Navegación principal'}>
        <a href="#problema">{c.nav[0]}</a><a href="#recorrido">{c.nav[1]}</a><a href="#alcance">{c.nav[2]}</a>
      </nav>
      <div class="header-actions"><a class="language" href={languageHref} hreflang={isEn ? 'es' : 'en'}>{c.language}</a><a class="button compact" href={contactHref} target="_blank" rel="noreferrer">{c.contact}</a></div>
    </div>
  </header>

  <main id="contenido" tabindex="-1">
    <section class="hero dentist-shell">
      <div class="hero-copy"><p class="kicker">{c.eyebrow}</p><h1>{c.title}</h1><p class="lead">{c.intro}</p>
        <div class="hero-actions"><a class="button" href={contactHref} target="_blank" rel="noreferrer">{c.primary}<span aria-hidden="true">↗</span></a><a class="text-link" href="#recorrido">{c.secondary}<span aria-hidden="true">↓</span></a></div>
        <ul class="proof">{c.proof.map((item) => <li><span aria-hidden="true">✓</span>{item}</li>)}</ul>
      </div>
      <div class="app-frame" aria-label={c.mockLabel}>
        <div class="app-top"><div class="clinic-mark"><span>LO</span><div><strong>LÓBULA</strong><small>Clínica dental</small></div></div><span class="demo-tag">{c.mockLabel}</span></div>
        <div class="app-body"><aside><i></i><i></i><i></i><i></i></aside><div class="agenda">
          <div class="agenda-head"><div><small>{c.today}</small><h2>{c.agenda}</h2></div><span>8:30 — 19:00</span></div>
          <div class="next-card"><div class="time"><strong>10:30</strong><small>45 min</small></div><div class="patient"><small>{c.next}</small><h3>{c.patient}</h3><p>{c.treatment}</p></div><span class="status">{c.status}</span></div>
          <div class="context-note"><span aria-hidden="true">i</span><p>{c.note}</p></div>
          <ol class="timeline">{c.timeline.map((item, index) => <li class:list={[index < 2 && 'done']}><span></span>{item}</li>)}</ol>
          <div class="ready"><span aria-hidden="true">✓</span>{c.prepared}</div>
        </div></div>
      </div>
    </section>

    <section id="problema" class="section dentist-shell"><p class="kicker">{c.problemEyebrow}</p><div class="section-heading"><h2>{c.problemTitle}</h2><p>{c.demoText}</p></div><div class="problem-grid">{c.problems.map((item) => <article><span>{item[0]}</span><h3>{item[1]}</h3><p>{item[2]}</p></article>)}</div></section>

    <section id="recorrido" class="journey"><div class="dentist-shell"><p class="kicker light">{c.journeyEyebrow}</p><h2>{c.journeyTitle}</h2><div class="steps">{c.steps.map((step) => <article><span>{step[0]}</span><div><h3>{step[1]}</h3><p>{step[2]}</p></div></article>)}</div></div></section>

    <section id="alcance" class="section dentist-shell"><p class="kicker">{c.scopeEyebrow}</p><div class="section-heading"><h2>{c.scopeTitle}</h2></div><div class="scope-grid"><article class="scope-card positive"><span aria-hidden="true">+</span><h3>{c.inTitle}</h3><ul>{c.inItems.map((item) => <li>{item}</li>)}</ul></article><article class="scope-card boundary"><span aria-hidden="true">—</span><h3>{c.outTitle}</h3><ul>{c.outItems.map((item) => <li>{item}</li>)}</ul></article></div><div class="disclaimer"><strong>{c.demo}</strong><p>{c.demoText}</p></div></section>

    <section class="closing dentist-shell"><div><p class="kicker light">{c.closeEyebrow}</p><h2>{c.closeTitle}</h2><p>{c.closeBody}</p></div><a class="button inverse" href={contactHref} target="_blank" rel="noreferrer">{c.closeAction}<span aria-hidden="true">↗</span></a></section>
  </main>

  <footer><div class="dentist-shell"><span>{c.footer}</span><a href={`${prefix}/`}>← {c.back}</a></div></footer>
  <CookiePreferences locale={locale} />
</Base>

<style>
  :global(.commercial-site){--dentist:#0b6668;--dentist-dark:#103d43;--mint:#d9eeea;--cream:#f8f5ee;background:#f8f5ee}.dentist-shell{width:min(1180px,calc(100% - 48px));margin-inline:auto}.dentist-header{position:sticky;z-index:20;top:0;padding:14px 0;background:rgb(248 245 238 / 88%);backdrop-filter:blur(16px)}.header-inner{display:flex;min-height:62px;align-items:center;gap:34px;border-bottom:1px solid #123f421c}.dentist-header nav{display:flex;gap:28px;margin-left:auto}.dentist-header a{color:var(--ink);font-size:.78rem;text-decoration:none}.header-actions{display:flex;align-items:center;gap:12px}.language{display:grid;min-width:44px;min-height:44px;place-items:center}.button{display:inline-flex;min-height:52px;align-items:center;justify-content:center;gap:20px;border:1px solid var(--dentist);border-radius:999px;padding:13px 22px;color:white;background:var(--dentist);font-size:.82rem;font-weight:700;text-decoration:none}.button.compact{min-height:44px;padding:9px 17px}.hero{display:grid;grid-template-columns:.9fr 1.1fr;min-height:730px;align-items:center;gap:clamp(50px,7vw,100px);padding-block:80px 110px}.kicker{margin:0 0 24px;color:var(--dentist);font-size:.68rem;font-weight:750;letter-spacing:.12em;text-transform:uppercase}.hero h1{max-width:650px;margin:0;font:500 clamp(3.2rem,5.7vw,6rem)/.96 var(--serif);letter-spacing:-.055em}.lead{max-width:570px;margin:30px 0 0;color:#486064;font:400 1.13rem/1.65 var(--sans)}.hero-actions{display:flex;align-items:center;gap:24px;margin-top:34px}.text-link{display:inline-flex;min-height:48px;align-items:center;gap:14px;color:var(--ink);font-size:.82rem;font-weight:650;text-underline-offset:5px}.proof{display:flex;flex-wrap:wrap;gap:12px 22px;margin:34px 0 0;padding:0;list-style:none}.proof li{display:flex;align-items:center;gap:8px;color:#526467;font-size:.76rem}.proof span{color:var(--dentist)}.app-frame{overflow:hidden;border:1px solid #154d4e26;border-radius:26px;background:#fff;box-shadow:0 30px 80px #163d3e24;transform:rotate(1.2deg)}.app-top{display:flex;min-height:74px;align-items:center;justify-content:space-between;padding:14px 18px;border-bottom:1px solid #143e4217}.clinic-mark{display:flex;align-items:center;gap:10px}.clinic-mark>span{display:grid;width:39px;height:39px;place-items:center;border-radius:50%;color:white;background:var(--dentist);font:700 .67rem var(--sans)}.clinic-mark div{display:grid}.clinic-mark strong{font-size:.76rem;letter-spacing:.13em}.clinic-mark small{color:#687a7c;font-size:.61rem}.demo-tag{border-radius:999px;padding:7px 10px;color:#506669;background:#eef5f3;font-size:.58rem}.app-body{display:grid;grid-template-columns:62px 1fr;min-height:495px}.app-body aside{display:flex;align-items:center;flex-direction:column;gap:24px;padding-top:29px;background:var(--dentist-dark)}.app-body aside i{width:20px;height:3px;border-radius:3px;background:#ffffff73}.app-body aside i:first-child{height:20px;border:5px solid #fff;background:transparent}.agenda{padding:34px}.agenda-head{display:flex;align-items:end;justify-content:space-between}.agenda-head small,.next-card small{color:#718083;font-size:.63rem}.agenda-head h2{margin:4px 0 0;font:600 1.55rem var(--serif)}.agenda-head>span{color:#718083;font-size:.65rem}.next-card{display:grid;grid-template-columns:65px 1fr auto;align-items:center;gap:18px;margin-top:26px;border:1px solid #15595b25;border-left:4px solid var(--dentist);border-radius:12px;padding:18px;background:#fbfdfc}.time{display:grid;gap:3px}.time strong{font-size:1rem}.patient h3{margin:3px 0;font-size:.95rem}.patient p{margin:0;color:#53676a;font-size:.72rem}.status{border-radius:999px;padding:7px 9px;color:#155c5d;background:var(--mint);font-size:.6rem;font-weight:700}.context-note{display:flex;align-items:center;gap:11px;margin-top:14px;border-radius:10px;padding:12px 15px;background:#f5efe2}.context-note span{display:grid;width:20px;height:20px;place-items:center;border:1px solid #8c713d;border-radius:50%;color:#755d31;font:700 .65rem var(--serif)}.context-note p{margin:0;color:#655b48;font-size:.68rem}.timeline{display:grid;gap:0;margin:23px 0 0;padding:0;list-style:none}.timeline li{position:relative;display:flex;min-height:42px;align-items:start;gap:13px;color:#6b797b;font-size:.7rem}.timeline li:not(:last-child):before{position:absolute;top:12px;bottom:-7px;left:5px;width:1px;background:#d3dddb;content:''}.timeline li>span{position:relative;z-index:1;width:11px;height:11px;border:2px solid #a8b6b4;border-radius:50%;background:white}.timeline li.done>span{border-color:var(--dentist);background:var(--dentist)}.ready{display:flex;align-items:center;gap:9px;border-top:1px solid #123f421c;padding-top:15px;color:var(--dentist);font-size:.7rem;font-weight:700}.section{padding-block:120px}.section-heading{display:grid;grid-template-columns:1.3fr .7fr;align-items:end;gap:70px}.section h2,.journey h2,.closing h2{margin:0;font:500 clamp(2.7rem,5vw,5rem)/1 var(--serif);letter-spacing:-.05em}.section-heading>p{margin:0;color:#687477;font-size:.82rem;line-height:1.65}.problem-grid{display:grid;grid-template-columns:repeat(3,1fr);margin-top:75px;border-top:1px solid #163e4224}.problem-grid article{padding:28px 30px 20px 0;border-right:1px solid #163e4224}.problem-grid article+article{padding-left:30px}.problem-grid article:last-child{border-right:0}.problem-grid span,.steps>article>span{color:var(--dentist);font-size:.65rem;font-weight:700}.problem-grid h3{min-height:60px;margin:22px 0 15px;font-size:1.15rem}.problem-grid p,.steps p{margin:0;color:#5e6f71;font-size:.86rem;line-height:1.65}.journey{padding-block:120px;color:white;background:var(--dentist-dark)}.kicker.light{color:#8fd4cc}.journey h2{max-width:800px}.steps{display:grid;grid-template-columns:repeat(4,1fr);margin-top:78px;border-top:1px solid #ffffff30}.steps article{padding:28px 26px 0 0}.steps article+article{border-left:1px solid #ffffff30;padding-left:26px}.steps h3{margin:18px 0 13px;font-size:1.1rem}.steps p{color:#c5d3d3}.scope-grid{display:grid;grid-template-columns:1fr 1fr;gap:18px;margin-top:65px}.scope-card{position:relative;border-radius:18px;padding:36px}.scope-card>span{position:absolute;top:28px;right:30px;font-size:1.4rem}.scope-card.positive{background:var(--mint)}.scope-card.boundary{border:1px solid #123f4224;background:white}.scope-card h3{margin:0 0 28px;font:500 1.55rem var(--serif)}.scope-card ul{display:grid;gap:14px;margin:0;padding:0;list-style:none}.scope-card li{border-top:1px solid #123f4224;padding-top:14px;font-size:.82rem}.disclaimer{display:grid;grid-template-columns:180px 1fr;gap:30px;margin-top:20px;border:1px dashed #17494b4d;border-radius:14px;padding:22px 26px}.disclaimer strong{font-size:.75rem}.disclaimer p{margin:0;color:#5f7072;font-size:.78rem;line-height:1.55}.closing{display:flex;align-items:flex-end;justify-content:space-between;gap:50px;margin-bottom:90px;border-radius:24px;padding:clamp(36px,6vw,72px);color:white;background:var(--dentist)}.closing h2{max-width:780px}.closing p:not(.kicker){max-width:600px;margin:25px 0 0;color:#d9eded;line-height:1.6}.button.inverse{flex:0 0 auto;border-color:white;color:var(--dentist-dark);background:white}footer{border-top:1px solid #123f4220;padding:32px 0 46px}footer>div{display:flex;justify-content:space-between;gap:20px;color:#5d6c6e;font-size:.72rem}footer a{color:inherit;text-underline-offset:4px}
  @media(max-width:900px){.dentist-header nav{display:none}.hero{grid-template-columns:1fr;min-height:0}.app-frame{max-width:650px}.section-heading{grid-template-columns:1fr;gap:24px}.steps{grid-template-columns:1fr 1fr}.steps article:nth-child(3){border-left:0}.problem-grid{grid-template-columns:1fr}.problem-grid article,.problem-grid article+article{border-right:0;border-bottom:1px solid #163e4224;padding:26px 0}.problem-grid h3{min-height:0}.closing{align-items:flex-start;flex-direction:column}}
  @media(max-width:600px){.dentist-shell{width:calc(100% - 28px)}.dentist-header{padding-top:8px}.header-inner{gap:8px}.header-actions .button{display:none}.hero{gap:45px;padding-block:54px 80px}.hero h1{font-size:clamp(2.8rem,14vw,4.2rem)}.hero-actions{align-items:flex-start;flex-direction:column;gap:12px}.proof{display:grid}.app-frame{border-radius:18px;transform:none}.app-top{align-items:flex-start;flex-direction:column;gap:10px}.app-body{grid-template-columns:1fr}.app-body aside{display:none}.agenda{padding:22px 16px}.next-card{grid-template-columns:52px 1fr}.status{grid-column:2;width:max-content}.section,.journey{padding-block:82px}.section h2,.journey h2,.closing h2{font-size:clamp(2.35rem,12vw,3.5rem)}.steps,.scope-grid{grid-template-columns:1fr}.steps article,.steps article+article{border-left:0;border-bottom:1px solid #ffffff30;padding:25px 0}.disclaimer{grid-template-columns:1fr;gap:10px}.closing{margin-bottom:50px;border-radius:18px}footer>div{align-items:flex-start;flex-direction:column-reverse}}
</style>

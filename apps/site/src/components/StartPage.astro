---
import { PRODUCT, type Locale } from '@logic-reserva/config';
import { logic2bContact } from '@logic-reserva/config/contact';
import { COMMERCIAL_PLANS } from '@logic-reserva/config/commercial';
import { PANEL_CATALOG, localizedPanelText, panelDetailUrl } from '@logic-reserva/config/panels';
import { THEME_CATALOG, themeDetailUrl } from '@logic-reserva/config/themes';
import Base from '../layouts/Base.astro';
import { startContent } from '../content';
import CommercialChrome from './CommercialChrome.astro';
import CommercialLeadForm from './CommercialLeadForm.astro';

interface Props { locale?: Locale }

const { locale = 'es' } = Astro.props;
const prefix = locale === 'en' ? '/en' : '';
const contact = logic2bContact(locale, 'commercial');
const languagePath = locale === 'en' ? '/empezar/' : '/en/empezar/';
const languageHref = `${languagePath}${Astro.url.search}`;
const ui = startContent(locale);
const backOptions = [
  ...THEME_CATALOG.map((theme) => ({ kind: 'theme', slug: theme.slug, label: theme.name, href: themeDetailUrl(theme.slug, locale) })),
  ...PANEL_CATALOG.map((panel) => ({ kind: 'panel', slug: panel.slug, label: localizedPanelText(panel.title, locale), href: panelDetailUrl(panel, locale) })),
];
const path = `${prefix}/empezar/`;
const structuredData = [{
  '@context': 'https://schema.org', '@type': 'WebPage', name: ui.metaTitle, description: ui.description,
  url: new URL(path, PRODUCT.url).href,
}, {
  '@context': 'https://schema.org', '@type': 'BreadcrumbList', itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Logic Reserva', item: `${PRODUCT.url}${prefix}/` },
    { '@type': 'ListItem', position: 2, name: ui.formTitle, item: new URL(path, PRODUCT.url).href },
  ],
}];
---

<Base locale={locale} title={ui.metaTitle} description={ui.description} structuredData={structuredData}>
  <CommercialChrome locale={locale} languageHref={languageHref} closing={false}>
    <main id="contenido" class="start-main" tabindex="-1">
      <section class="shell start-grid" aria-labelledby="start-title">
        <div class="start-copy">
          <a class="back" href={`${prefix}/`} data-start-back data-back-options={JSON.stringify(backOptions)} data-back-prefix={ui.backSelection} data-back-plans={ui.backPlans} data-plans-url={`${prefix}/planes/`} data-plan-slugs={JSON.stringify(COMMERCIAL_PLANS.map((plan) => plan.slug))}><span aria-hidden="true">←</span><span data-start-back-label>{ui.back}</span></a>
          <p class="eyebrow">{ui.eyebrow}</p>
          <h1 id="start-title">{ui.title}</h1>
          <p class="start-intro">{ui.intro}</p>
          <ul>{ui.proofs.map((proof) => <li><span aria-hidden="true">✓</span>{proof}</li>)}</ul>
          <picture class="start-photo">
            <source type="image/avif" srcset="/images/editorial/mesa-preparada-640.avif 640w, /images/editorial/mesa-preparada-960.avif 960w" sizes="(max-width: 900px) 1px, 440px" />
            <img src="/images/editorial/mesa-preparada-960.webp" alt={ui.photoAlt} width="960" height="640" loading="lazy" decoding="async" />
          </picture>
        </div>
        <div id="solicitud" class="start-form">
          <div class="start-form__heading"><p class="eyebrow">{ui.formEyebrow}</p><h2>{ui.formTitle}</h2><p>{ui.formBody}</p></div>
          <CommercialLeadForm locale={locale} />
          <p class="start-boundary">{ui.boundary}</p>
          <aside class="start-direct"><strong>{ui.direct}</strong><a href={contact.href} target="_blank" rel="noreferrer">{ui.whatsapp}<span aria-hidden="true">↗</span></a></aside>
        </div>
      </section>
    </main>
  </CommercialChrome>
</Base>

<script>
  const back = document.querySelector<HTMLAnchorElement>('[data-start-back]');
  const label = back?.querySelector<HTMLElement>('[data-start-back-label]');
  if (back && label) {
    type BackOption = { kind: 'theme' | 'panel'; slug: string; label: string; href: string };
    const options = JSON.parse(back.dataset.backOptions ?? '[]') as BackOption[];
    const plans = JSON.parse(back.dataset.planSlugs ?? '[]') as string[];
    const params = new URLSearchParams(window.location.search);
    const theme = options.find((option) => option.kind === 'theme' && option.slug === params.get('theme'));
    const panel = options.find((option) => option.kind === 'panel' && option.slug === params.get('panel'));
    const selected = theme && !panel ? theme : panel && !theme ? panel : null;
    const requestedPlan = params.get('plan');
    const initialHref = back.getAttribute('href') ?? '/';
    const initialLabel = label.textContent;
    const syncBack = (requested: string | null) => {
      const plan = requested && plans.includes(requested) ? requested : null;
      if (selected) {
        back.href = `${selected.href}${plan ? `?plan=${encodeURIComponent(plan)}` : ''}`;
        label.textContent = `${back.dataset.backPrefix} ${selected.label}`;
      } else if (plan) {
        back.href = back.dataset.plansUrl ?? initialHref;
        label.textContent = back.dataset.backPlans ?? initialLabel;
      } else {
        back.href = initialHref;
        label.textContent = initialLabel;
      }
    };
    syncBack(requestedPlan);
    const planSelect = document.querySelector<HTMLSelectElement>('#lead-form select[name="level"]');
    planSelect?.addEventListener('change', () => syncBack(planSelect.value));
  }
</script>

<style>
  .start-main { overflow: clip; padding-bottom: 72px; background: var(--paper); }
  .start-grid { display: grid; grid-template-columns: minmax(0, .9fr) minmax(420px, 1.1fr); gap: 64px; align-items: start; padding-top: 36px; }
  .start-copy { min-width: 0; padding-bottom: 20px; }
  .back { display: inline-flex; min-height: 44px; align-items: center; gap: 9px; color: var(--slate); font-size: .8rem; text-decoration: none; }
  .start-copy > .eyebrow { margin-top: 24px; }
  .start-copy h1 { max-width: 520px; margin: 16px 0 0; font: 500 clamp(2.5rem, 4vw, 3.65rem)/1.06 var(--serif); letter-spacing: -.045em; text-wrap: balance; }
  .start-intro { max-width: 490px; margin: 22px 0 0; color: var(--slate); font: 400 1rem/1.65 var(--sans); }
  .start-copy ul { display: grid; gap: 8px; margin: 22px 0 0; padding: 0; list-style: none; }
  .start-copy li { display: flex; align-items: center; gap: 10px; font-size: .8rem; line-height: 1.4; }
  .start-copy li span { display: grid; width: 22px; height: 22px; flex: none; place-items: center; border-radius: 50%; color: white; background: var(--color-notion-blue); font-size: .7rem; }
  .start-photo { display: block; margin-top: 28px; border-radius: 12px; overflow: hidden; }
  .start-photo img { display: block; width: 100%; height: 200px; object-fit: cover; }
  .start-direct { display: grid; justify-items: start; gap: 4px; margin: 20px 30px 0; border-top: 1px solid var(--line); padding-top: 16px; }
  .start-direct strong { color: var(--slate); font-size: .7rem; font-weight: 500; }
  .start-direct a { display: inline-flex; min-height: 44px; align-items: center; gap: 14px; color: var(--ink); font-size: .82rem; text-underline-offset: 4px; }
  .start-form { min-width: 0; padding-bottom: 20px; border: 1px solid var(--line); border-radius: 20px; background: white; }
  .start-form__heading { padding: 26px 30px 8px; }
  .start-form__heading h2 { margin: 12px 0 0; font: 500 2rem/1.15 var(--serif); letter-spacing: -.035em; }
  .start-form__heading > p:last-child { margin: 12px 0 0; color: var(--slate); font: 400 .85rem/1.6 var(--sans); }
  .start-form :global(.lead-form) { border: 0; padding: 20px 30px 4px; }
  .start-boundary { margin: 8px 30px 0; color: var(--slate); font-size: .72rem; line-height: 1.5; }
  @media (max-width: 900px) {
    .start-grid { grid-template-columns: 1fr; gap: 24px; padding-top: 20px; }
    .start-photo { display: none; }
    .start-copy { padding-bottom: 0; }
    .start-copy > .eyebrow { margin-top: 16px; }
    .start-copy h1 { max-width: 600px; font-size: clamp(2.25rem, 8vw, 3rem); }
    .start-intro { margin-top: 16px; }
    .start-copy ul { display: flex; flex-wrap: wrap; gap: 8px 18px; margin-top: 18px; }
    .start-copy li { font-size: .72rem; }
    .start-form__heading { padding: 24px 22px 8px; }
    .start-form :global(.lead-form) { padding: 18px 22px 4px; }
    .start-boundary { margin-inline: 22px; }
    .start-direct { margin-inline: 22px; }
  }
  @media (max-width: 600px) {
    .start-grid { gap: 22px; padding-top: 12px; }
    .start-copy > .eyebrow, .start-copy ul, .start-form__heading > .eyebrow { display: none; }
    .start-copy h1 { margin-top: 12px; font-size: 2rem; }
    .start-intro { margin-top: 12px; font-size: .93rem; }
    .start-form__heading { padding-top: 22px; }
    .start-form__heading h2 { margin-top: 0; font-size: 1.6rem; }
    .start-form__heading > p:last-child { margin-top: 8px; }
  }
</style>

---
import type { Locale } from '@logic-reserva/config';
import { PRODUCT } from '@logic-reserva/config';
import { GUIDE_CATALOG, type GuideCatalogEntry } from '@logic-reserva/config/guides';
import Base from '../layouts/Base.astro';
import { SITE_CONTENT } from '../content';
import BrandLockup from './BrandLockup.astro';

interface Props { locale?: Locale; path: string }

const { locale = 'es', path } = Astro.props;
const shared = SITE_CONTENT[locale];
const guides: readonly GuideCatalogEntry[] = GUIDE_CATALOG;
const prefix = locale === 'en' ? '/en' : '';
const languageHref = locale === 'en' ? path : `/en${path}`;
const pageUrl = new URL(`${prefix}${path}`, PRODUCT.url).href;
const localize = (value: GuideCatalogEntry['title']): string => value[locale];
const guideHref = (guide: GuideCatalogEntry) => `${prefix}${guide.route}`;
const ui = locale === 'en'
  ? {
    title: 'Five guides before you publish.',
    intro: 'Practical notes for floor teams, operations, leadership, owners and technical partners. Scope, data, payments and responsibilities stay visible from the start.',
    topics: 'What this guide covers',
    checklist: 'Before implementation',
    boundary: 'Boundary',
    open: 'Explore related surface',
    back: 'Back to Logic Reserva',
    panels: 'Explore panels',
    plans: 'Compare plans',
    footer: 'Five role-based guides · fictional data · scope to define',
  }
  : {
    title: 'Cinco guías antes de publicar.',
    intro: 'Notas prácticas para sala, gestión, dirección, propietarios y equipos técnicos. Alcance, datos, cobros y responsabilidades quedan visibles desde el principio.',
    topics: 'Qué cubre esta guía',
    checklist: 'Antes de implantar',
    boundary: 'Límite',
    open: 'Explorar superficie relacionada',
    back: 'Volver a Logic Reserva',
    panels: 'Explorar paneles',
    plans: 'Comparar planes',
    footer: 'Cinco guías por rol · datos ficticios · alcance por definir',
  };
const pageTitle = locale === 'en' ? 'Restaurant product guides | Logic Reserva' : 'Guías de producto para restaurantes | Logic Reserva';
const structuredData: Array<Record<string, unknown>> = [
  { '@context': 'https://schema.org', '@type': 'CollectionPage', name: ui.title, description: ui.intro, url: pageUrl, isPartOf: { '@id': `${PRODUCT.url}/#website` } },
  { '@context': 'https://schema.org', '@type': 'ItemList', numberOfItems: guides.length, itemListElement: guides.map((guide, index) => ({ '@type': 'ListItem', position: index + 1, name: localize(guide.title), url: new URL(guideHref(guide), PRODUCT.url).href })) },
];
---

<Base locale={locale} title={pageTitle} description={ui.intro} structuredData={structuredData}>
  <header class="guides-nav">
    <div class="shell">
      <BrandLockup locale={locale} homeHref={`${prefix}/`} />
      <div><a class="guides-language" href={languageHref} lang={locale === 'en' ? 'es' : 'en'}>{shared.nav.language}</a><a class="pill guides-contact" href={`${prefix}/#contacto`}>{shared.nav.contact}</a></div>
    </div>
  </header>
  <main id="contenido" class="guides-main shell" tabindex="-1">
    <a class="guides-back" href={`${prefix}/`}><span aria-hidden="true">←</span> {ui.back}</a>
    <header class="guides-intro"><p class="eyebrow">{shared.nav.support}</p><h1 class="display">{ui.title}</h1><p>{ui.intro}</p></header>
    <div class="guide-list">
      {guides.map((guide, index) => (
        <article id={`guia-${guide.slug}`} class="guide-card">
          <div class="guide-card__index" aria-hidden="true">0{index + 1}</div>
          <div class="guide-card__body">
            <div class="guide-card__meta"><span>{localize(guide.role)}</span><span>Logic Reserva</span></div>
            <h2>{localize(guide.title)}</h2>
            <p class="guide-card__intro">{localize(guide.intro)}</p>
            <div class="guide-card__columns">
              <div><p class="guide-card__label">{ui.topics}</p><ul>{guide.topics.map((topic) => <li>{localize(topic)}</li>)}</ul></div>
              <div><p class="guide-card__label">{ui.checklist}</p><ul>{guide.checklist.map((item) => <li>{localize(item)}</li>)}</ul></div>
            </div>
            <p class="guide-card__boundary"><strong>{ui.boundary}</strong> {localize(guide.boundary)}</p>
            <a class="guide-card__action" href={guideHref(guide)}>{ui.open}<span aria-hidden="true"> ↗</span></a>
          </div>
        </article>
      ))}
    </div>
    <nav class="guides-related" aria-label={locale === 'en' ? 'Related product surfaces' : 'Superficies de producto relacionadas'}>
      <span>{locale === 'en' ? 'Continue with' : 'Continúa con'}</span>
      <a href={`${prefix}/paneles/`}>{ui.panels}<span aria-hidden="true"> ↗</span></a>
      <a href={`${prefix}/planes/`}>{ui.plans}<span aria-hidden="true"> ↗</span></a>
    </nav>
  </main>
  <footer class="guides-footer"><div class="shell"><span>{ui.footer}</span><nav><a href={`${prefix}/temas/`}>{shared.nav.demos}</a><a href={`${prefix}/paneles/`}>{ui.panels}</a><a href={`${prefix}/legal/`}>{shared.footer.legal}</a><a href={`${prefix}/privacidad/`}>{shared.footer.privacy}</a></nav></div></footer>
</Base>

<style>
  .guides-nav { position: sticky; z-index: 50; top: 0; height: 72px; border-bottom: 1px solid var(--line); background: rgb(255 254 252 / 92%); box-shadow: var(--shadow-nav); backdrop-filter: blur(14px); }
  .guides-nav .shell, .guides-footer .shell { display: flex; height: 100%; align-items: center; justify-content: space-between; gap: 20px; }
  .guides-nav > .shell > div { display: flex; align-items: center; gap: 12px; }
  .guides-language { display: inline-flex; min-width: 44px; min-height: 44px; align-items: center; justify-content: center; color: var(--slate); font-size: .84rem; text-decoration: none; }
  .guides-contact { min-height: 44px; }
  .guides-main { padding-block: clamp(48px, 8vw, 104px) clamp(76px, 10vw, 140px); }
  .guides-back { display: inline-flex; min-height: 44px; align-items: center; gap: 8px; margin-bottom: clamp(52px, 8vw, 94px); color: var(--slate); font-size: .84rem; text-decoration: none; }
  .guides-intro { max-width: 940px; }
  .guides-intro h1 { max-width: 880px; }
  .guides-intro > p:last-child { max-width: 68ch; margin: 26px 0 0; color: var(--slate); font-family: var(--serif); font-size: clamp(1.12rem, 1.8vw, 1.4rem); line-height: 1.58; }
  .guide-list { margin-top: clamp(58px, 8vw, 96px); border-top: 1px solid var(--line); }
  .guide-card { display: grid; grid-template-columns: 84px 1fr; gap: clamp(24px, 5vw, 72px); border-bottom: 1px solid var(--line); padding: clamp(32px, 5vw, 64px) 0; }
  .guide-card__index { color: var(--color-notion-blue-strong); font-size: .78rem; font-weight: 800; letter-spacing: .08em; }
  .guide-card__body { min-width: 0; }
  .guide-card__meta { display: flex; justify-content: space-between; gap: 20px; color: var(--slate); font-size: .68rem; font-weight: 750; letter-spacing: .06em; text-transform: uppercase; }
  .guide-card h2 { max-width: 760px; margin: 15px 0 0; font-size: clamp(1.8rem, 3.6vw, 3.3rem); letter-spacing: -.045em; line-height: 1; }
  .guide-card__intro { max-width: 65ch; margin: 16px 0 0; color: var(--slate); font-family: var(--serif); font-size: 1.08rem; line-height: 1.58; }
  .guide-card__columns { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: clamp(24px, 6vw, 90px); margin-top: 34px; }
  .guide-card__label { margin: 0; color: var(--slate); font-size: .68rem; font-weight: 800; letter-spacing: .07em; text-transform: uppercase; }
  .guide-card__columns ul { display: grid; gap: 0; margin: 10px 0 0; padding: 0; list-style: none; }
  .guide-card__columns li { border-top: 1px solid var(--line); padding: 12px 0; font-size: .82rem; font-weight: 650; line-height: 1.4; }
  .guide-card__columns li:last-child { border-bottom: 1px solid var(--line); }
  .guide-card__boundary { max-width: 70ch; margin: 28px 0 8px; color: var(--slate); font-family: var(--serif); font-size: .9rem; line-height: 1.5; }
  .guide-card__boundary strong { color: var(--ink); font-family: var(--sans); font-size: .68rem; letter-spacing: .05em; text-transform: uppercase; }
  .guide-card__action { display: inline-flex; min-width: 44px; min-height: 44px; align-items: center; color: var(--color-notion-blue-strong); font-size: .8rem; font-weight: 750; text-decoration: none; }
  .guide-card__action:hover, .guides-related a:hover { text-decoration: underline; text-underline-offset: 4px; }
  .guides-related { display: flex; flex-wrap: wrap; align-items: center; gap: 16px 28px; margin-top: 60px; border-top: 1px solid var(--line); padding-top: 24px; }
  .guides-related > span { color: var(--slate); font-size: .82rem; }
  .guides-related a { display: inline-flex; min-width: 44px; min-height: 44px; align-items: center; color: var(--ink); font-weight: 650; text-decoration: none; }
  .guides-footer { min-height: 90px; border-top: 1px solid var(--line); color: var(--slate); font-size: .74rem; }
  .guides-footer nav { display: flex; flex-wrap: wrap; gap: 18px; justify-content: flex-end; }
  .guides-footer a { display: inline-flex; min-width: 44px; min-height: 44px; align-items: center; color: var(--slate); text-decoration: none; }
  .guides-footer a:hover { color: var(--ink); text-decoration: underline; text-underline-offset: 4px; }
  @media (max-width: 760px) {
    .guide-card { grid-template-columns: 40px 1fr; gap: 14px; }
    .guide-card__columns { grid-template-columns: 1fr; gap: 28px; }
    .guides-footer { padding-block: 20px; }
    .guides-footer .shell { height: auto; align-items: flex-start; flex-direction: column; }
    .guides-footer nav { justify-content: flex-start; }
  }
  @media (max-width: 560px) {
    .guides-contact { display: none; }
    .guides-nav .shell { width: min(100% - 24px, var(--page-max-width)); }
    .guide-card__meta { align-items: flex-start; flex-direction: column; gap: 5px; }
  }
</style>

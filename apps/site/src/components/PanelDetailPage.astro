---
import { PRODUCT, type Locale } from '@logic-reserva/config';
import {
  PANEL_CATALOG,
  getPanel,
  localizedPanelText,
  panelContactUrl,
  panelDemoUrl,
  panelDetailUrl,
  type PanelSlug,
  type PanelText,
} from '@logic-reserva/config/panels';
import Base from '../layouts/Base.astro';
import CommercialChrome from './CommercialChrome.astro';

interface Props { locale?: Locale; slug: PanelSlug }

const { locale = 'es', slug } = Astro.props;
const panel = getPanel(slug);
if (!panel) throw new Error(`Unknown public panel: ${slug}`);
const local = (value: PanelText) => localizedPanelText(value, locale);
const prefix = locale === 'en' ? '/en' : '';
const index = PANEL_CATALOG.findIndex((entry) => entry.slug === slug);
const nextPanel = PANEL_CATALOG[(index + 1) % PANEL_CATALOG.length];
const address = `panel.${locale === 'en' ? 'yourdomain.com' : 'tudominio.com'}/${panel.slug}`;
const ui = locale === 'en' ? {
  titleSuffix: ' | Logic Reserva panel', back: 'All product views', product: 'Restaurant management view',
  levelManagement: 'Management', levelIntelligent: 'Intelligent', reproducible: 'Reproducible demo',
  want: 'I want this product view', open: 'Open full demo', fictional: 'Fictional demonstration: no real bookings, messages, charges or external writes.',
  resolveEyebrow: 'What it solves', resolveTitle: 'The right information when the team needs to act.',
  decision: 'Decision', evidence: 'Evidence in the demo', boundary: 'Current boundary',
  details: 'Product view details', level: 'Level', status: 'Status', configuration: 'Configured around',
  included: 'Signals included', next: 'Next product view', all: 'Explore all six views', contact: 'Discuss this starting point',
} : {
  titleSuffix: ' | Panel Logic Reserva', back: 'Todas las vistas de producto', product: 'Panel de gestión para restaurantes',
  levelManagement: 'Gestión', levelIntelligent: 'Inteligente', reproducible: 'Demo reproducible',
  want: 'Quiero esta vista de producto', open: 'Abrir demo completa', fictional: 'Demostración ficticia: sin reservas, mensajes, cobros ni escrituras externas reales.',
  resolveEyebrow: 'Qué resuelve', resolveTitle: 'La información correcta en el momento de actuar.',
  decision: 'Decisión', evidence: 'Evidencia en la demo', boundary: 'Límite actual',
  details: 'Detalles de la vista', level: 'Nivel', status: 'Estado', configuration: 'Configurada para',
  included: 'Señales incluidas', next: 'Siguiente vista de producto', all: 'Explorar las seis vistas', contact: 'Hablar de este punto de partida',
};
const level = panel.level === 'intelligent' ? ui.levelIntelligent : ui.levelManagement;
const currentUrl = new URL(panelDetailUrl(panel, locale), PRODUCT.url).href;
const structuredData = [{
  '@context': 'https://schema.org', '@type': 'WebPage', name: local(panel.title), description: local(panel.metaDescription), url: currentUrl,
  inLanguage: locale, isPartOf: { '@id': `${PRODUCT.url}/#website` },
  about: { '@type': 'SoftwareApplication', name: `${PRODUCT.name} · ${local(panel.title)}`, applicationCategory: 'BusinessApplication', operatingSystem: 'Web' },
}, {
  '@context': 'https://schema.org', '@type': 'BreadcrumbList', itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Logic Reserva', item: `${PRODUCT.url}${prefix}/` },
    { '@type': 'ListItem', position: 2, name: locale === 'en' ? 'Product views' : 'Vistas de producto', item: `${PRODUCT.url}${prefix}/paneles/` },
    { '@type': 'ListItem', position: 3, name: local(panel.title), item: currentUrl },
  ],
}];
---

<Base
  locale={locale}
  title={`${local(panel.title)}${ui.titleSuffix}`}
  description={local(panel.metaDescription)}
  image={`/images/screens/${panel.screenshot.base}-desktop.png`}
  imageAlt={local(panel.screenshot.alt)}
  imageWidth={1366}
  imageHeight={900}
  structuredData={structuredData}
>
  <CommercialChrome locale={locale} languageHref={panelDetailUrl(panel, locale === 'en' ? 'es' : 'en')}>
    <main id="contenido" class="panel-detail" tabindex="-1">
      <article>
        <header class="shell panel-detail__hero">
          <a class="back" href={`${prefix}/paneles/`}><span aria-hidden="true">←</span>{ui.back}</a>
          <div class="panel-detail__hero-grid">
            <div class="panel-detail__intro">
              <p class="eyebrow">{ui.product}</p>
              <h1>{local(panel.title)}</h1>
              <p class="panel-detail__summary">{local(panel.summary)}</p>
              <ul class="panel-detail__tags" aria-label={ui.included}>
                <li>{level}</li>
                {panel.signals.map((signal) => <li>{local(signal)}</li>)}
              </ul>
              <div class="panel-detail__actions">
                <a class="panel-detail__primary" href={panelContactUrl(panel, locale)}>{ui.want}<span aria-hidden="true">→</span></a>
                <a href={panelDemoUrl(panel, locale)}>{ui.open}<span aria-hidden="true">↗</span></a>
              </div>
              <p class="panel-detail__fictional">{ui.fictional}</p>
            </div>
            <figure class="panel-detail__preview">
              <div class="panel-detail__browser"><code>{address}</code><span aria-hidden="true">×</span></div>
              <picture>
                <source media="(max-width: 680px)" srcset={`/images/screens/${panel.screenshot.base}-mobile.png`} />
                <img src={`/images/screens/${panel.screenshot.base}-desktop.png`} alt={local(panel.screenshot.alt)} width="1366" height="900" decoding="async" fetchpriority="high" />
              </picture>
              <figcaption>{local(panel.screenshot.caption)}</figcaption>
            </figure>
          </div>
        </header>

        <section class="shell panel-detail__resolution" aria-labelledby="resolution-title">
          <div class="panel-detail__heading"><p class="eyebrow">{ui.resolveEyebrow}</p><h2 id="resolution-title">{ui.resolveTitle}</h2></div>
          <div class="panel-detail__facts">
            <article><span>01</span><h3>{ui.decision}</h3><p>{local(panel.decision)}</p></article>
            <article><span>02</span><h3>{ui.evidence}</h3><p>{local(panel.evidence)}</p></article>
            <article><span>03</span><h3>{ui.boundary}</h3><p>{local(panel.limit)}</p></article>
          </div>
        </section>

        <section class="panel-detail__specs" aria-labelledby="specs-title">
          <div class="shell panel-detail__specs-grid">
            <div><p class="eyebrow">{ui.details}</p><h2 id="specs-title">{local(panel.eyebrow)}</h2></div>
            <dl>
              <div><dt>{ui.level}</dt><dd>{level}</dd></div>
              <div><dt>{ui.status}</dt><dd>{ui.reproducible}</dd></div>
              <div><dt>{ui.configuration}</dt><dd>{local(panel.user)}</dd></div>
            </dl>
            <div class="panel-detail__signals"><h3>{ui.included}</h3><ul>{panel.signals.map((signal) => <li>{local(signal)}</li>)}</ul></div>
          </div>
        </section>

        <section class="shell panel-detail__next" aria-label={ui.next}>
          <a href={panelDetailUrl(nextPanel, locale)}><span>{ui.next}</span><strong>{local(nextPanel.title)}</strong><i aria-hidden="true">↗</i></a>
          <nav><a href={`${prefix}/paneles/`}>{ui.all}<span aria-hidden="true">→</span></a><a href={panelContactUrl(panel, locale)}>{ui.contact}<span aria-hidden="true">→</span></a></nav>
        </section>
      </article>
    </main>
  </CommercialChrome>
</Base>

<style>
  .panel-detail { overflow: clip; padding-bottom: clamp(90px, 11vw, 160px); }
  .panel-detail__hero { padding-top: 28px; }.back { display: inline-flex; min-height: 44px; align-items: center; gap: 8px; color: var(--slate); font-size: .82rem; text-decoration: none; }
  .panel-detail__hero-grid { display: grid; grid-template-columns: minmax(340px, .72fr) minmax(0, 1.28fr); gap: clamp(40px, 7vw, 100px); align-items: center; padding: clamp(42px, 7vw, 86px) 0 0; }
  .panel-detail__intro h1 { max-width: 720px; margin: 0; font-size: clamp(3.7rem, 7vw, 7.3rem); letter-spacing: -.068em; line-height: .86; }.panel-detail__summary { max-width: 52ch; margin: 28px 0 0; color: var(--slate); font-family: var(--serif); font-size: clamp(1.08rem, 1.55vw, 1.28rem); line-height: 1.58; }
  .panel-detail__tags { display: flex; flex-wrap: wrap; gap: 7px; margin: 27px 0 0; padding: 0; list-style: none; }.panel-detail__tags li { border: 1px solid rgb(0 117 222 / 22%); border-radius: 999px; padding: 7px 10px; color: var(--color-notion-blue-strong); background: var(--color-sky-tint); font-size: .74rem; font-weight: 700; }
  .panel-detail__actions { display: grid; grid-template-columns: 1fr 1fr; gap: 8px; margin-top: 28px; }.panel-detail__actions a { display: flex; min-height: 52px; align-items: center; justify-content: space-between; gap: 14px; border: 1px solid var(--line); border-radius: 8px; padding: 11px 14px; color: var(--ink); background: white; font-size: .8rem; font-weight: 750; text-decoration: none; }.panel-detail__actions .panel-detail__primary { border-color: var(--color-notion-blue); color: white; background: var(--color-notion-blue); }
  .panel-detail__fictional { margin: 15px 0 0; color: var(--slate); font-size: .74rem; line-height: 1.45; }
  .panel-detail__preview { min-width: 0; overflow: hidden; margin: 0; border: 1px solid rgb(0 0 0 / 12%); border-radius: 14px; background: white; box-shadow: 0 24px 70px rgb(7 14 43 / 15%); }.panel-detail__browser { display: flex; min-height: 50px; align-items: center; justify-content: space-between; gap: 18px; padding: 10px 16px; border-bottom: 1px solid var(--line); }.panel-detail__browser code { overflow: hidden; color: var(--slate); font-family: var(--sans); font-size: .75rem; font-weight: 650; text-overflow: ellipsis; white-space: nowrap; }.panel-detail__browser span { font-size: 1.15rem; }.panel-detail__preview picture { display: block; aspect-ratio: 1366 / 900; overflow: hidden; background: #edf0f4; }.panel-detail__preview img { display: block; width: 100%; height: 100%; object-fit: cover; object-position: center top; }.panel-detail__preview figcaption { min-height: 54px; padding: 15px 18px; color: rgb(255 255 255 / 78%); background: var(--color-midnight-ink); font-family: var(--serif); font-size: .82rem; line-height: 1.45; }
  .panel-detail__resolution { display: grid; grid-template-columns: .75fr 1.25fr; gap: clamp(50px, 9vw, 130px); margin-top: clamp(105px, 14vw, 190px); }.panel-detail__heading h2 { max-width: 620px; margin: 0; font-size: clamp(2.5rem, 5vw, 5.2rem); letter-spacing: -.058em; line-height: .94; }.panel-detail__facts { border-top: 1px solid var(--line); }.panel-detail__facts article { display: grid; grid-template-columns: 48px 145px 1fr; gap: 18px; border-bottom: 1px solid var(--line); padding: 27px 0; }.panel-detail__facts span { color: var(--color-notion-blue-strong); font-size: .7rem; font-weight: 700; }.panel-detail__facts h3 { margin: 0; font-size: .82rem; letter-spacing: .02em; text-transform: uppercase; }.panel-detail__facts p { margin: 0; color: var(--slate); font-family: var(--serif); font-size: 1.03rem; line-height: 1.58; }
  .panel-detail__specs { margin-top: clamp(90px, 12vw, 160px); padding: clamp(70px, 9vw, 110px) 0; color: white; background: var(--color-midnight-ink); }.panel-detail__specs-grid { display: grid; grid-template-columns: 1fr 1fr .75fr; gap: clamp(36px, 7vw, 100px); }.panel-detail__specs .eyebrow { color: var(--color-marigold); }.panel-detail__specs h2 { max-width: 470px; margin: 0; font-size: clamp(2.5rem, 4.5vw, 4.8rem); letter-spacing: -.055em; line-height: .94; }.panel-detail__specs dl { margin: 0; }.panel-detail__specs dl div { border-top: 1px solid rgb(255 255 255 / 22%); padding: 17px 0; }.panel-detail__specs dl div:last-child { border-bottom: 1px solid rgb(255 255 255 / 22%); }.panel-detail__specs dt { color: rgb(255 255 255 / 62%); font-size: .7rem; font-weight: 700; text-transform: uppercase; }.panel-detail__specs dd { margin: 7px 0 0; font-size: .95rem; line-height: 1.45; }.panel-detail__signals h3 { margin: 0 0 18px; color: rgb(255 255 255 / 62%); font-size: .7rem; text-transform: uppercase; }.panel-detail__signals ul { display: grid; gap: 8px; margin: 0; padding: 0; list-style: none; }.panel-detail__signals li { border: 1px solid rgb(255 255 255 / 20%); border-radius: 999px; padding: 10px 13px; font-size: .85rem; }
  .panel-detail__next { display: grid; grid-template-columns: 1fr 1fr; gap: 18px; margin-top: clamp(80px, 11vw, 150px); }.panel-detail__next > a { display: grid; min-height: 245px; grid-template-columns: 1fr auto; align-content: space-between; border-radius: 12px; padding: clamp(26px, 4vw, 44px); color: white; background: var(--color-notion-blue); text-decoration: none; }.panel-detail__next > a span { grid-column: 1 / -1; font-size: .72rem; font-weight: 700; text-transform: uppercase; }.panel-detail__next strong { align-self: end; font-size: clamp(2rem, 4vw, 4rem); letter-spacing: -.055em; line-height: .92; }.panel-detail__next i { align-self: end; font-size: 1.5rem; font-style: normal; }.panel-detail__next nav { display: grid; align-content: center; border-block: 1px solid var(--line); }.panel-detail__next nav a { display: flex; min-height: 58px; align-items: center; justify-content: space-between; border-bottom: 1px solid var(--line); font-weight: 650; text-decoration: none; }.panel-detail__next nav a:last-child { border: 0; }
  @media (max-width: 980px) { .panel-detail__hero-grid, .panel-detail__resolution, .panel-detail__next { grid-template-columns: 1fr; }.panel-detail__intro { max-width: 720px; }.panel-detail__preview { max-width: 820px; }.panel-detail__specs-grid { grid-template-columns: 1fr 1fr; }.panel-detail__signals { grid-column: 1 / -1; } }
  @media (max-width: 680px) { .panel-detail__hero { padding-top: 16px; }.panel-detail__hero-grid { gap: 36px; }.panel-detail__intro h1 { font-size: clamp(3.3rem, 17vw, 5.4rem); }.panel-detail__summary { margin-top: 22px; }.panel-detail__tags { margin-top: 22px; }.panel-detail__actions { grid-template-columns: 1fr; margin-top: 22px; }.panel-detail__preview picture { aspect-ratio: 375 / 440; }.panel-detail__facts article { grid-template-columns: 38px 1fr; gap: 9px 12px; }.panel-detail__facts p { grid-column: 2; }.panel-detail__specs-grid { grid-template-columns: 1fr; }.panel-detail__signals { grid-column: auto; }.panel-detail__next { margin-inline: 14px; } }
</style>

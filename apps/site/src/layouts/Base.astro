---
import '@fontsource-variable/inter';
import '@fontsource-variable/source-serif-4';
import '@logic-reserva/ui/theme.css';
import '../styles/commercial.css';
import { PRODUCT, type Locale } from '@logic-reserva/config';

interface Props {
  locale?: Locale;
  title: string;
  description: string;
  robots?: string;
  image?: string;
  imageAlt?: string;
  imageWidth?: number;
  imageHeight?: number;
  structuredData?: ReadonlyArray<Record<string, unknown>>;
}

const {
  locale = 'es',
  title,
  description,
  robots = 'index, follow, max-image-preview:large',
  image = '/images/heroes/solane-v2-1600.avif',
  imageAlt = locale === 'en' ? 'Logic Reserva restaurant booking experience' : 'Experiencia de reservas para restaurantes de Logic Reserva',
  imageWidth = 1600,
  imageHeight = 1200,
  structuredData = [],
} = Astro.props;
const currentPath = Astro.url.pathname;
const spanishPath = locale === 'en' ? currentPath.replace(/^\/en(?=\/)/, '') || '/' : currentPath;
const englishPath = locale === 'en' ? currentPath : currentPath === '/' ? '/en/' : `/en${currentPath}`;
const canonical = new URL(currentPath, PRODUCT.url).href;
const spanishUrl = new URL(spanishPath, PRODUCT.url).href;
const englishUrl = new URL(englishPath, PRODUCT.url).href;
const socialImage = new URL(image, PRODUCT.url).href;
const organizationUrl = 'https://logic2b.com';
const baseStructuredData: ReadonlyArray<Record<string, unknown>> = [
  {
    '@context': 'https://schema.org',
    '@type': 'Organization',
    '@id': `${organizationUrl}/#organization`,
    name: 'Logic2B',
    url: organizationUrl,
    email: PRODUCT.email,
    logo: new URL('/logo-mark.svg', PRODUCT.url).href,
    brand: { '@type': 'Brand', name: PRODUCT.name },
  },
  {
    '@context': 'https://schema.org',
    '@type': 'WebSite',
    '@id': `${PRODUCT.url}/#website`,
    url: PRODUCT.url,
    name: PRODUCT.name,
    inLanguage: ['es', 'en'],
    publisher: { '@id': `${organizationUrl}/#organization` },
  },
];
const schemas = [...baseStructuredData, ...structuredData];
const skipLabel = locale === 'en' ? 'Skip to main content' : 'Saltar al contenido principal';
---

<!doctype html>
<html lang={locale}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" href="/logo-mark.svg" type="image/svg+xml" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="author" content="Logic2B" />
    <meta name="robots" content={robots} />
    <meta name="theme-color" content="#f6f5f4" />
    <link rel="preload" href="/fonts/poppins-600-latin.woff2" as="font" type="font/woff2" crossorigin="anonymous" />
    <link rel="preload" href="/fonts/poppins-800-logo.woff2" as="font" type="font/woff2" crossorigin="anonymous" />
    <link rel="canonical" href={canonical} />
    <link rel="alternate" hreflang="es" href={spanishUrl} />
    <link rel="alternate" hreflang="en" href={englishUrl} />
    <link rel="alternate" hreflang="x-default" href={spanishUrl} />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={PRODUCT.name} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:locale" content={locale === 'en' ? 'en_GB' : 'es_ES'} />
    <meta property="og:locale:alternate" content={locale === 'en' ? 'es_ES' : 'en_GB'} />
    <meta property="og:image" content={socialImage} />
    <meta property="og:image:width" content={String(imageWidth)} />
    <meta property="og:image:height" content={String(imageHeight)} />
    <meta property="og:image:alt" content={imageAlt} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={socialImage} />
    <meta name="twitter:image:alt" content={imageAlt} />
    {schemas.map((schema) => <script is:inline type="application/ld+json" set:html={JSON.stringify(schema).replaceAll('<', '\\u003c')} />)}
  </head>
  <body class="commercial-site">
    <a class="skip-link" href="#contenido">{skipLabel}</a>
    <slot />
  </body>
</html>

<style>
  .skip-link {
    position: fixed;
    z-index: 1000;
    top: 12px;
    left: 12px;
    padding: 12px 16px;
    border: 2px solid var(--ink);
    border-radius: 8px;
    color: var(--ink);
    background: white;
    font-weight: 700;
    text-decoration: none;
    transform: translateY(calc(-100% - 20px));
    transition: transform 160ms ease;
  }
  .skip-link:focus { transform: translateY(0); }
  @media (prefers-reduced-motion: reduce) { .skip-link { transition: none; } }
</style>

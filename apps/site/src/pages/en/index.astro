---
import Base from '../../layouts/Base.astro';
import { PRODUCT } from '@logic-reserva/config';
import Landing from '../../components/Landing.astro';
import { SITE_CONTENT } from '../../content';

const faqSchema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: SITE_CONTENT.en.faq.items.map((item) => ({
    '@type': 'Question',
    name: item.question,
    acceptedAnswer: { '@type': 'Answer', text: item.answer },
  })),
};
---

<Base
  locale="en"
  title={`Restaurant and event bookings | ${PRODUCT.name}`}
  description="Restaurant booking engine for tables, menus, groups and events on one inventory. Keep your brand and avoid per-cover commissions."
  structuredData={[faqSchema]}
>
  <Landing locale="en" />
</Base>

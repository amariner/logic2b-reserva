---
import Base from '../../layouts/Base.astro';
import { PRODUCT } from '@logic-reserva/config';
import Landing from '../../components/Landing.astro';
import { SITE_CONTENT } from '../../content';

const faqSchema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: SITE_CONTENT.en.faq.items.map((item) => ({
    '@type': 'Question',
    name: item.question,
    acceptedAnswer: { '@type': 'Answer', text: item.answer },
  })),
};
---

<Base
  locale="en"
  title={`Restaurant and event bookings | ${PRODUCT.name}`}
  description="Commercial demo for exploring restaurant bookings, tables, menus, groups and events on shared inventory. Implementation is defined with Logic2B."
  image="/images/screens/05-solane-inventario-desktop.png"
  imageAlt="Solane floor plan with bookings and events sharing the same table inventory"
  imageWidth={1366}
  imageHeight={900}
  structuredData={[faqSchema]}
>
  <Landing locale="en" />
</Base>

---
import Base from '../layouts/Base.astro';
import { PRODUCT } from '@logic-reserva/config';
import Landing from '../components/Landing.astro';
import { SITE_CONTENT } from '../content';

const faqSchema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: SITE_CONTENT.es.faq.items.map((item) => ({
    '@type': 'Question',
    name: item.question,
    acceptedAnswer: { '@type': 'Answer', text: item.answer },
  })),
};
---

<Base
  locale="es"
  title={`Reservas para restaurantes y eventos | ${PRODUCT.name}`}
  description="Demostración comercial para explorar reservas, mesas, menús, grupos y eventos sobre un inventario compartido. La implantación se define con Logic2B."
  image="/images/screens/05-solane-inventario-desktop.png"
  imageAlt="Plano de Solane con reservas y eventos sobre el mismo inventario de mesas"
  imageWidth={1366}
  imageHeight={900}
  structuredData={[faqSchema]}
>
  <Landing locale="es" />
</Base>

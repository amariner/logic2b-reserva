---
import DashboardDemo from '@logic-reserva/dashboard';
import '@logic-reserva/dashboard/styles.css';
import DemoLayout from '../../../../layouts/DemoLayout.astro';
import { DEMO_FIXTURES } from '../../../../data';

const fixture = DEMO_FIXTURES.solane;
---

<DemoLayout slug="solane" locale="es" title="Gestor Solane · Logic Reserva">
  <DashboardDemo
    slug="solane"
    restaurant={fixture.restaurant}
    initialBookings={fixture.bookings}
    initialEvents={fixture.events}
    initialPrivateHires={fixture.privateHires}
    initialCustomers={fixture.customers}
    locale="es"
    client:load
  />
</DemoLayout>

---
import type { Locale } from '@logic-reserva/config';
import BrandHero from './BrandHero.astro';
import { BRASCA_PAGE_COPY, DEMO_COPY, DEMO_DATE, DEMO_FIXTURES, localized } from '../data';

interface Props { locale?: Locale }

const { locale = 'es' } = Astro.props;
const fixture = DEMO_FIXTURES.brasca;
const shared = DEMO_COPY.brasca;
const copy = BRASCA_PAGE_COPY;
const localePrefix = locale === 'en' ? '/en' : '';
const languageHref = locale === 'en' ? '/demos/brasca/' : '/en/demos/brasca/';
const price = new Intl.NumberFormat(locale, { style: 'currency', currency: 'EUR', minimumFractionDigits: 0, maximumFractionDigits: 2 });
const categories = Array.from(new Set(fixture.menuItems.map((item) => localized(item.category, locale))));
const ui = locale === 'en' ? { nav: 'Brasca navigation', invalid: 'Check the required fields.' } : { nav: 'Navegación de Brasca', invalid: 'Revisa los campos obligatorios.' };
---

<header class="brasca-header">
  <div class="shell">
    <a class="brasca-lockup" href={`${localePrefix}/demos/brasca/`} aria-label="Brasca"><span aria-hidden="true">B</span><b>Brasca</b></a>
    <nav aria-label={ui.nav}>
      {shared.nav.map((item) => <a href={item.href}>{localized(item.label, locale)}</a>)}
    </nav>
    <div class="brasca-actions"><a class="brasca-language" href={languageHref}>{localized(copy.footer.language, locale)}</a><a class="brand-button" href="#reserva">{localized(shared.hero.primaryAction, locale)}</a></div>
  </div>
</header>

<main id="contenido" tabindex="-1">
  <BrandHero slug="brasca" locale={locale} />

  <section id="carta" class="brasca-section shell menu-section" aria-labelledby="menu-title">
    <div class="brasca-intro"><p class="brand-hero__eyebrow">{localized(copy.menu.eyebrow, locale)}</p><h2 id="menu-title">{localized(copy.menu.title, locale)}</h2><p>{localized(copy.menu.intro, locale)}</p></div>
    <div class="menu-groups">
      {categories.map((category) => (
        <section class="menu-group" aria-labelledby={`menu-${category.replaceAll(' ', '-').toLowerCase()}`}>
          <h3 id={`menu-${category.replaceAll(' ', '-').toLowerCase()}`}>{category}</h3>
          <div>
            {fixture.menuItems.filter((item) => localized(item.category, locale) === category).map((item) => (
              <article class="menu-item">
                <div><h4>{localized(item.name, locale)}</h4><p>{localized(item.description, locale)}</p></div>
                <strong>{price.format(item.priceCents / 100)}</strong>
              </article>
            ))}
          </div>
        </section>
      ))}
    </div>
  </section>

  <section id="bistro" class="brasca-section story-band" aria-labelledby="story-title">
    <div class="shell story-grid">
      <div class="story-illustration" aria-hidden="true"><span class="story-sun"></span><span class="story-table"></span><span class="story-plate story-plate--one"></span><span class="story-plate story-plate--two"></span><span class="story-flame"></span></div>
      <div class="story-copy"><p class="brand-hero__eyebrow">{localized(copy.story.eyebrow, locale)}</p><h2 id="story-title">{localized(copy.story.title, locale)}</h2>{copy.story.paragraphs.map((paragraph) => <p>{localized(paragraph, locale)}</p>)}<span class="story-badge">{localized(copy.story.badge, locale)}</span></div>
    </div>
  </section>

  <section class="brasca-section shell visit-section" aria-labelledby="visit-title">
    <div class="brasca-intro"><p class="brand-hero__eyebrow">{localized(copy.visit.eyebrow, locale)}</p><h2 id="visit-title">{localized(copy.visit.title, locale)}</h2></div>
    <div class="visit-grid">
      <div class="visit-details card">
        <section><h3>{localized(copy.visit.hours, locale)}</h3>{fixture.hours.map((hours) => <p>{localized(hours, locale)}</p>)}</section>
        <section><h3>{localized(copy.visit.address, locale)}</h3><p>{localized(fixture.address, locale)}</p><small>{localized(copy.visit.mapCaption, locale)}</small></section>
      </div>
      <div class="brasca-map" role="img" aria-label={localized(copy.visit.mapLabel, locale)}>
        <span class="street street--a"></span><span class="street street--b"></span><span class="street street--c"></span><span class="street street--d"></span><span class="map-block map-block--one"></span><span class="map-block map-block--two"></span><span class="map-block map-block--three"></span><span class="map-marker"><i>B</i></span>
      </div>
    </div>
  </section>

  <section id="reserva" class="brasca-section request-band" aria-labelledby="request-title">
    <div class="shell request-grid">
      <div><p class="brand-hero__eyebrow">{localized(copy.form.eyebrow, locale)}</p><h2 id="request-title">{localized(shared.form.title, locale)}</h2><p class="request-intro">{localized(copy.form.intro, locale)}</p><p class="request-privacy">{localized(shared.form.privacy, locale)}</p></div>
      <form id="brasca-request" class="request-form" novalidate>
        <div class="request-row"><label>{localized(shared.form.date, locale)}<input name="date" type="date" value={DEMO_DATE} required /></label><label>{localized(shared.form.partySize, locale)}<select name="partySize">{Array.from({ length: 8 }, (_, index) => index + 1).map((people) => <option value={people}>{people}</option>)}</select></label></div>
        <label>{localized(shared.form.service, locale)}<select name="service"><option value="lunch">{localized(copy.form.lunch, locale)}</option><option value="dinner">{localized(copy.form.dinner, locale)}</option></select></label>
        <div class="request-row"><label>{localized(shared.form.name, locale)}<input name="name" autocomplete="name" required /></label><label>{localized(shared.form.email, locale)}<input name="email" type="email" autocomplete="email" required /></label></div>
        <button class="brand-button" type="submit">{localized(shared.form.submit, locale)}</button>
        <p class="request-status" data-request-status data-success={localized(copy.form.success, locale)} data-invalid={ui.invalid} role="status"></p>
        <a class="next-level-link" href={`${localePrefix}/demos/vedra/`}>{localized(copy.form.nextLevel, locale)}<span aria-hidden="true"> →</span></a>
      </form>
    </div>
  </section>
</main>

<footer class="brasca-footer" id="contacto"><div class="shell"><div><a class="brasca-lockup" href={`${localePrefix}/demos/brasca/`}><span aria-hidden="true">B</span><b>Brasca</b></a><p>{localized(copy.footer.level, locale)}</p></div><nav><a href={`${localePrefix}/`}>{localized(copy.footer.back, locale)}</a><a href={languageHref}>{localized(copy.footer.language, locale)}</a></nav></div></footer>

<script>
  const requestForm = document.querySelector<HTMLFormElement>('#brasca-request');
  const requestStatus = document.querySelector<HTMLElement>('[data-request-status]');
  requestForm?.addEventListener('submit', (event) => {
    event.preventDefault();
    if (!requestForm.checkValidity()) {
      if (requestStatus) requestStatus.textContent = requestStatus.dataset.invalid ?? '';
      requestForm.reportValidity();
      return;
    }
    if (requestStatus) requestStatus.textContent = requestStatus.dataset.success ?? '';
    requestForm.reset();
  });
</script>

<style>
  .brasca-header { position: sticky; z-index: 30; top: 0; height: 66px; border-bottom: 1px solid var(--brand-line); background: rgb(251 244 235 / 94%); backdrop-filter: blur(12px); }
  .brasca-header .shell, .brasca-footer .shell { display: flex; height: 100%; align-items: center; justify-content: space-between; gap: 24px; }
  .brasca-lockup { display: inline-flex; min-height: 44px; align-items: center; gap: 10px; color: var(--brand-ink); text-decoration: none; }.brasca-lockup span { display: grid; width: 34px; height: 34px; place-items: center; border: 2px solid var(--brand); border-radius: 50%; background: var(--brand-card); font-family: var(--brand-display); }
  .brasca-header nav { display: flex; gap: 4px; }.brasca-header nav a, .brasca-language { display: inline-flex; min-width: 44px; min-height: 44px; align-items: center; justify-content: center; border-radius: 8px; padding: 9px 12px; color: var(--brand-muted); font-size: .82rem; font-weight: 600; text-decoration: none; }.brasca-header nav a:hover, .brasca-language:hover { color: var(--brand-ink); background: var(--brand-soft); }.brasca-actions { display: flex; align-items: center; gap: 6px; }.brasca-header .brand-button { min-height: 44px; padding-block: 6px; }
  .brasca-section { padding-block: clamp(80px, 11vw, 144px); }.brasca-intro { max-width: 820px; }.brasca-intro h2, .story-copy h2, .request-grid h2 { margin: 0; font-family: var(--brand-display); font-size: clamp(3rem, 6.5vw, 6.2rem); font-weight: 520; letter-spacing: -.05em; line-height: .94; text-wrap: balance; }.brasca-intro > p:last-child { max-width: 62ch; margin: 24px 0 0; color: var(--brand-muted); font-family: var(--serif); font-size: 1.15rem; line-height: 1.6; }
  .menu-groups { display: grid; max-width: 980px; margin: 64px 0 0 auto; gap: 54px; }.menu-group { display: grid; grid-template-columns: 180px 1fr; gap: 36px; border-top: 1px solid var(--brand-line); padding-top: 22px; }.menu-group h3 { margin: 0; color: var(--brand); font-size: .74rem; letter-spacing: .12em; text-transform: uppercase; }.menu-item { display: flex; align-items: start; justify-content: space-between; gap: 30px; border-bottom: 1px solid var(--brand-line); padding: 0 0 22px; }.menu-item + .menu-item { padding-top: 22px; }.menu-item h4 { margin: 0; font-family: var(--brand-display); font-size: 1.35rem; font-weight: 600; }.menu-item p { margin: 7px 0 0; color: var(--brand-muted); font-family: var(--serif); line-height: 1.45; }.menu-item strong { flex: 0 0 auto; font-size: 1rem; }
  .story-band { background: var(--brand-strong); color: #fff; }.story-grid { display: grid; grid-template-columns: 1.1fr .9fr; align-items: center; gap: clamp(50px, 9vw, 130px); }.story-illustration { position: relative; min-height: 620px; overflow: hidden; border-radius: 12px; background: #d9a37d; }.story-sun { position: absolute; top: 70px; left: 70px; width: 120px; height: 120px; border-radius: 50%; background: #f5c96d; }.story-table { position: absolute; right: 10%; bottom: 80px; width: 75%; height: 190px; border-radius: 50%; background: #f7ead8; box-shadow: 0 45px 0 -15px #8a422d; }.story-plate { position: absolute; z-index: 2; bottom: 160px; width: 100px; height: 42px; border-radius: 50%; background: white; }.story-plate--one { left: 28%; }.story-plate--two { right: 22%; }.story-flame { position: absolute; top: 90px; right: 80px; width: 130px; height: 260px; border-radius: 70px 70px 16px 16px; background: #2d1a13; }.story-flame::after { position: absolute; right: 28px; bottom: 0; left: 28px; height: 130px; border-radius: 60px 60px 10px 10px; background: #d27a3c; content: ''; }.story-copy .brand-hero__eyebrow { color: #f1bb91; }.story-copy > p:not(.brand-hero__eyebrow) { color: rgb(255 255 255 / 72%); font-family: var(--serif); font-size: 1.08rem; line-height: 1.65; }.story-badge { display: inline-block; margin-top: 18px; border: 1px solid rgb(255 255 255 / 40%); border-radius: 999px; padding: 8px 13px; font-size: .78rem; }
  .visit-section .brasca-intro { max-width: 960px; }.visit-grid { display: grid; grid-template-columns: .8fr 1.2fr; gap: 12px; margin-top: 60px; }.visit-details { display: grid; align-content: stretch; background: var(--brand-card); }.visit-details section { padding: 30px; }.visit-details section + section { border-top: 1px solid var(--brand-line); }.visit-details h3 { margin: 0 0 18px; color: var(--brand); font-size: .75rem; letter-spacing: .1em; text-transform: uppercase; }.visit-details p { margin: 7px 0; font-family: var(--serif); font-size: 1.05rem; }.visit-details small { display: block; margin-top: 16px; color: var(--brand-muted); }.brasca-map { position: relative; min-height: 500px; overflow: hidden; border-radius: 12px; background: var(--brand-soft); }.street { position: absolute; background: #fff8ef; }.street--a { top: 42%; left: -5%; width: 110%; height: 44px; transform: rotate(-9deg); }.street--b { top: -5%; left: 38%; width: 48px; height: 110%; transform: rotate(14deg); }.street--c { top: 18%; left: -5%; width: 110%; height: 25px; transform: rotate(7deg); }.street--d { top: -5%; right: 18%; width: 24px; height: 110%; transform: rotate(-5deg); }.map-block { position: absolute; border: 2px solid rgb(163 71 44 / 22%); border-radius: 12px; background: rgb(163 71 44 / 8%); }.map-block--one { top: 10%; left: 8%; width: 25%; height: 25%; }.map-block--two { right: 7%; bottom: 10%; width: 28%; height: 34%; }.map-block--three { bottom: 8%; left: 8%; width: 24%; height: 25%; }.map-marker { position: absolute; top: 51%; left: 55%; display: grid; width: 76px; height: 76px; place-items: center; border: 3px solid var(--brand); border-radius: 50% 50% 50% 10%; color: #fff; background: var(--brand); box-shadow: 0 0 0 10px rgb(255 255 255 / 55%); transform: rotate(-45deg); }.map-marker i { font-family: var(--brand-display); font-size: 1.6rem; font-style: normal; transform: rotate(45deg); }
  .request-band { background: var(--brand-soft); }.request-grid { display: grid; grid-template-columns: .8fr 1.2fr; gap: clamp(50px, 9vw, 130px); }.request-intro { max-width: 50ch; color: var(--brand-muted); font-family: var(--serif); font-size: 1.08rem; line-height: 1.6; }.request-privacy { margin-top: 24px; color: var(--brand); font-size: .76rem; font-weight: 650; }.request-form { border: 1px solid var(--brand-line); border-radius: 12px; padding: clamp(24px, 4vw, 38px); background: var(--brand-card); }.request-form label { display: grid; gap: 8px; margin-bottom: 15px; color: var(--brand-muted); font-size: .78rem; font-weight: 650; }.request-form input, .request-form select { width: 100%; min-height: 44px; border: 1px solid var(--brand-line); border-radius: 8px; padding: 12px; color: var(--brand-ink); background: #fff; }.request-row { display: grid; grid-template-columns: 1fr 1fr; gap: 14px; }.request-status { min-height: 62px; margin: 16px 0 0; color: var(--brand); font-size: .84rem; font-weight: 600; line-height: 1.5; }.next-level-link { display: inline-flex; min-height: 44px; align-items: center; margin-top: 4px; color: var(--brand-muted); font-size: .8rem; line-height: 1.4; text-decoration: none; }.next-level-link:hover { color: var(--brand); }
  .brasca-footer { padding-block: 50px; border-top: 1px solid var(--brand-line); background: var(--brand-card); }.brasca-footer .shell { align-items: flex-start; }.brasca-footer p { color: var(--brand-muted); font-size: .82rem; }.brasca-footer nav { display: grid; gap: 10px; text-align: right; }.brasca-footer nav a { display: inline-flex; min-height: 44px; align-items: center; justify-content: flex-end; color: var(--brand-muted); font-size: .82rem; text-decoration: none; }.brasca-footer nav a:hover { color: var(--brand); }
  @media (max-width: 900px) { .brasca-header nav { display: none; }.story-grid, .visit-grid, .request-grid { grid-template-columns: 1fr; }.story-illustration { min-height: 480px; }.visit-details { grid-template-columns: 1fr 1fr; }.visit-details section + section { border-top: 0; border-left: 1px solid var(--brand-line); } }
  @media (max-width: 620px) { .brasca-language { display: none; }.brasca-header .shell { width: min(100% - 24px, var(--page-max-width)); }.menu-group { grid-template-columns: 1fr; gap: 18px; }.menu-item { gap: 16px; }.story-illustration { min-height: 390px; }.story-sun { top: 40px; left: 35px; width: 80px; height: 80px; }.story-flame { top: 55px; right: 35px; width: 95px; height: 190px; }.visit-details { grid-template-columns: 1fr; }.visit-details section + section { border-top: 1px solid var(--brand-line); border-left: 0; }.brasca-map { min-height: 390px; }.request-row { grid-template-columns: 1fr; }.brasca-footer .shell { flex-direction: column; }.brasca-footer nav { text-align: left; } }
</style>

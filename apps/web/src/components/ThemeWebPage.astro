---
import type { Locale } from '@logic-reserva/config';
import { localizedThemeText, themeUrl, type ThemeEntry, type ThemeSlug } from '@logic-reserva/config/themes';

interface Props { theme: ThemeEntry; locale?: Locale }

const { theme, locale = 'es' } = Astro.props;
if (!theme.web) throw new Error(`Theme ${theme.slug} has no website copy`);
const web = theme.web;
const local = (value: ThemeEntry['format']) => localizedThemeText(value, locale);
const prefix = locale === 'en' ? '/en' : '';
const otherLocale: Locale = locale === 'en' ? 'es' : 'en';
const ui = locale === 'en' ? {
  menu: 'Menu', story: 'Approach', visit: 'Visit', book: 'Start a booking',
  location: 'Location', hours: 'Opening hours', fictional: 'Fictional restaurant',
  today: 'Today at the restaurant', available: 'Website direction open to explore',
  menuEyebrow: 'A short menu', storyEyebrow: 'Website direction', visitEyebrow: 'Before you arrive',
  bookingEyebrow: 'How booking would begin', bookingTitle: 'The website hands over the right context before offering a table.',
  bookingBody: 'This web-only direction does not include an active booking engine, availability, messages or payments. In a real project, those rules would be agreed with Logic2B around the restaurant operation.',
  bookingPoints: ['Party size and occasion', 'Service or venue choice', 'Terms shown before confirmation'],
  discuss: 'Discuss this direction', allThemes: 'View all 12 websites', powered: 'A fictional website direction by Logic Reserva',
  language: 'ES', navigation: 'Restaurant navigation', backLabel: 'Logic Reserva website catalogue',
} : {
  menu: 'Carta', story: 'Enfoque', visit: 'Visita', book: 'Empezar reserva',
  location: 'Ubicación', hours: 'Horario', fictional: 'Restaurante ficticio',
  today: 'Hoy en el restaurante', available: 'Dirección web abierta para explorar',
  menuEyebrow: 'Una carta corta', storyEyebrow: 'Dirección de la web', visitEyebrow: 'Antes de llegar',
  bookingEyebrow: 'Cómo empezaría la reserva', bookingTitle: 'La web entrega el contexto correcto antes de ofrecer una mesa.',
  bookingBody: 'Esta dirección solo web no incluye motor activo, disponibilidad, mensajes ni pagos. En un proyecto real, esas reglas se acordarían con Logic2B alrededor de la operativa del restaurante.',
  bookingPoints: ['Tamaño del grupo y ocasión', 'Servicio o local elegido', 'Condiciones antes de confirmar'],
  discuss: 'Hablar de esta dirección', allThemes: 'Ver las 12 webs', powered: 'Una dirección web ficticia de Logic Reserva',
  language: 'EN', navigation: 'Navegación del restaurante', backLabel: 'Catálogo de webs de Logic Reserva',
};
---

<div class="restaurant-site">
  <header class="restaurant-nav">
    <a class="restaurant-brand" href="#contenido" aria-label={`${theme.name} — ${ui.fictional}`}><span>{theme.mark}</span><strong>{theme.name}</strong></a>
    <nav aria-label={ui.navigation}><a href="#carta">{ui.menu}</a><a href="#enfoque">{ui.story}</a><a href="#visita">{ui.visit}</a></nav>
    <div class="restaurant-actions"><a class="restaurant-language" href={themeUrl(theme.slug as ThemeSlug, otherLocale)} hreflang={otherLocale}>{ui.language}</a><a class="restaurant-book" href="#reservar">{ui.book}</a></div>
  </header>

  <main id="contenido" tabindex="-1">
    <section class="restaurant-hero" aria-labelledby="restaurant-title">
      <div class="hero-copy">
        <p class="restaurant-kicker"><span>{local(theme.format)}</span><span>{local(theme.location)}</span></p>
        <h1 id="restaurant-title">{theme.name}</h1>
        <p class="restaurant-promise">{local(theme.promise)}</p>
        <p class="restaurant-body">{local(web.body)}</p>
        <div class="hero-actions"><a href="#reservar">{ui.book}<span aria-hidden="true">↘</span></a><a href="#carta">{ui.menu}<span aria-hidden="true">↓</span></a></div>
      </div>
      <div class="hero-art" aria-hidden="true">
        <span class="art-number">01 / 04</span><span class="art-mark">{theme.mark}</span>
        <div class="art-table"><i></i><i></i><i></i><i></i></div>
        <p>{theme.name}</p>
      </div>
      <p class="hero-side-note">{ui.fictional} · {local(theme.tone)}</p>
    </section>

    <aside class="restaurant-status" aria-label={ui.today}><strong>{ui.today}</strong><span>{web.hours[locale]}</span><span>{ui.available}</span></aside>

    <section id="carta" class="restaurant-menu restaurant-section" aria-labelledby="menu-title">
      <div class="section-heading"><p>{ui.menuEyebrow}</p><h2 id="menu-title">{local(web.menuTitle)}</h2><span>02 / 04</span></div>
      <div class="menu-body">
        <p>{local(web.menuIntro)}</p>
        <ol>{web.menu.map((item, index) => <li><span>0{index + 1}</span><div><h3>{local(item.name)}</h3><p>{local(item.detail)}</p></div></li>)}</ol>
      </div>
    </section>

    <section id="enfoque" class="restaurant-story restaurant-section" aria-labelledby="story-title">
      <div class="story-graphic" aria-hidden="true"><span>{theme.mark}</span><i></i><b>{theme.name}</b></div>
      <div class="story-copy"><p class="section-eyebrow">{ui.storyEyebrow}</p><h2 id="story-title">{local(web.storyTitle)}</h2><p>{local(web.story)}</p></div>
    </section>

    <section id="visita" class="restaurant-visit restaurant-section" aria-labelledby="visit-title">
      <div><p class="section-eyebrow">{ui.visitEyebrow}</p><h2 id="visit-title">{local(theme.location)}</h2></div>
      <dl><div><dt>{ui.hours}</dt><dd>{local(web.hours)}</dd></div><div><dt>{ui.location}</dt><dd>{local(web.address)}</dd></div></dl>
    </section>

    <section id="reservar" class="restaurant-booking" aria-labelledby="booking-title">
      <div class="booking-title"><p>{ui.bookingEyebrow}</p><h2 id="booking-title">{ui.bookingTitle}</h2></div>
      <div class="booking-explainer"><p>{ui.bookingBody}</p><ol>{ui.bookingPoints.map((point, index) => <li><span>0{index + 1}</span>{point}</li>)}</ol><div><a href={`${prefix}/#contacto`}>{ui.discuss}<span aria-hidden="true">↗</span></a><a href={`${prefix}/temas/`}>{ui.allThemes}</a></div></div>
    </section>
  </main>

  <footer class="restaurant-footer"><a href={`${prefix}/temas/`} aria-label={ui.backLabel}>Logic Reserva</a><span>{ui.powered}</span><span>© 2026</span></footer>
</div>

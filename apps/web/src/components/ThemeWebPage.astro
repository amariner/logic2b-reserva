---
import RestaurantMobileMenu from './RestaurantMobileMenu.astro';
import type { Locale } from '@logic-reserva/config';
import { localizedThemeText, themeContactUrl, themeUrl, type ThemeEntry, type ThemeSlug } from '@logic-reserva/config/themes';

interface Props { theme: ThemeEntry; locale?: Locale }

const { theme, locale = 'es' } = Astro.props;
if (!theme.web) throw new Error(`Theme ${theme.slug} has no website copy`);
const web = theme.web;
const local = (value: ThemeEntry['format']) => localizedThemeText(value, locale);
const prefix = locale === 'en' ? '/en' : '';
const otherLocale: Locale = locale === 'en' ? 'es' : 'en';
const isVenue = theme.slug === 'nave-nueve';
const isGroup = theme.slug === 'trama';
const ui = locale === 'en' ? {
  menu: isVenue ? 'The space' : isGroup ? 'Our venues' : 'Menu', story: 'Our place', visit: 'Visit', book: isVenue ? 'Your event' : 'Bookings',
  location: 'Location', hours: 'Opening hours', fictional: 'Fictional restaurant',
  today: 'Plan your visit', visitDetails: 'Location & hours',
  menuEyebrow: 'A short menu', storyEyebrow: 'Our way of welcoming', visitEyebrow: 'Before you arrive',
  bookingEyebrow: isVenue ? 'Your event' : 'Bookings', bookingTitle: isVenue ? 'Room for your next occasion.' : 'A place at the table.',
  bookingBody: 'This is a fictional restaurant. Bookings, messages and payments are not enabled in this example.',
  discuss: 'I want a website like this', allThemes: 'Explore other websites', powered: 'A fictional website by Logic Reserva',
  language: 'ES', navigation: 'Restaurant navigation', backLabel: 'Logic Reserva website catalogue',
} : {
  menu: isVenue ? 'El espacio' : isGroup ? 'Nuestras casas' : 'Carta', story: 'La casa', visit: 'Visita', book: isVenue ? 'Tu evento' : 'Reservas',
  location: 'Ubicación', hours: 'Horario', fictional: 'Restaurante ficticio',
  today: 'Prepara tu visita', visitDetails: 'Ubicación y horario',
  menuEyebrow: 'Una carta corta', storyEyebrow: 'Nuestra forma de recibir', visitEyebrow: 'Antes de llegar',
  bookingEyebrow: isVenue ? 'Tu evento' : 'Reservas', bookingTitle: isVenue ? 'Un lugar para tu próximo encuentro.' : 'Un lugar en la mesa.',
  bookingBody: 'Este restaurante es ficticio. Las reservas, los mensajes y los pagos no están activados en este ejemplo.',
  discuss: 'Quiero una web así', allThemes: 'Explorar otras webs', powered: 'Una web ficticia de Logic Reserva',
  language: 'EN', navigation: 'Navegación del restaurante', backLabel: 'Catálogo de webs de Logic Reserva',
};
---

<div class="restaurant-site">
  <header class="restaurant-nav">
    <a class="restaurant-brand" href="#contenido" aria-label={`${theme.name} — ${ui.fictional}`}><span>{theme.mark}</span><strong>{theme.name}</strong></a>
    <nav aria-label={ui.navigation}><a href="#carta">{ui.menu}</a><a href="#enfoque">{ui.story}</a><a href="#visita">{ui.visit}</a></nav>
    <div class="restaurant-actions"><a class="restaurant-language" href={themeUrl(theme.slug as ThemeSlug, otherLocale)} hreflang={otherLocale} aria-label={otherLocale === 'en' ? 'View in English' : 'Ver en español'}>{ui.language}</a><a class="restaurant-book" href="#reservar">{ui.book}</a><RestaurantMobileMenu locale={locale} links={[{ href: "#carta", label: ui.menu }, { href: "#enfoque", label: ui.story }, { href: "#visita", label: ui.visit }, { href: themeUrl(theme.slug as ThemeSlug, otherLocale), label: otherLocale === "en" ? "View in English" : "Ver en español" }, { href: `${prefix}/temas/`, label: ui.allThemes }]} /></div>
  </header>

  <main id="contenido" tabindex="-1">
    <section class="restaurant-hero" aria-labelledby="restaurant-title">
      <div class="hero-copy">
        <div class="hero-identity">
          <p class="restaurant-kicker"><span>{local(theme.format)}</span><span>{local(theme.location)}</span></p>
          <h1 id="restaurant-title">{theme.name}</h1>
          <p class="restaurant-promise">{local(theme.promise)}</p>
        </div>
        <p class="restaurant-body">{local(web.body)}</p>
        <div class="hero-actions"><a href="#reservar">{ui.book}<span aria-hidden="true">↘</span></a><a href="#carta">{ui.menu}<span aria-hidden="true">↓</span></a></div>
      </div>
      <figure class="hero-art">
        <picture>
          <source type="image/avif" srcset={`${theme.imageBase}-640.avif 640w, ${theme.imageBase}-960.avif 960w, ${theme.imageBase}-1600.avif 1600w`} sizes={theme.layout === 'panorama' ? '100vw' : '(max-width: 900px) 100vw, 50vw'} />
          <img src={`${theme.imageBase}-960.avif`} alt={theme.imageAlt ? local(theme.imageAlt) : `${theme.name} · ${local(theme.format)}`} width="1536" height="1024" loading="eager" fetchpriority="high" decoding="async" />
        </picture>
        <figcaption><span>{theme.name}</span><span>{local(theme.location)}</span></figcaption>
      </figure>
    </section>

    <aside class="restaurant-status" aria-label={ui.today}><strong>{local(theme.location)}</strong><span>{web.hours[locale]}</span><a href="#visita">{ui.visitDetails}<span aria-hidden="true">↗</span></a></aside>

    <section id="carta" class="restaurant-menu restaurant-section" aria-labelledby="menu-title">
      <div class="section-heading"><p>{isVenue || isGroup ? ui.menu : ui.menuEyebrow}</p><h2 id="menu-title">{local(web.menuTitle)}</h2></div>
      <div class="menu-body">
        <p>{local(web.menuIntro)}</p>
        <ol>{web.menu.map((item, index) => <li><span>0{index + 1}</span><div><h3>{local(item.name)}</h3><p>{local(item.detail)}</p></div></li>)}</ol>
      </div>
    </section>

    <section id="enfoque" class="restaurant-story restaurant-section" aria-labelledby="story-title">
      <div class="story-graphic" aria-hidden="true"><span>{theme.mark}</span><i></i><b>{theme.name}</b></div>
      <div class="story-copy"><p class="section-eyebrow">{ui.storyEyebrow}</p><h2 id="story-title">{local(web.storyTitle)}</h2><p>{local(web.story)}</p></div>
    </section>

    <section id="visita" class="restaurant-visit restaurant-section" aria-labelledby="visit-title">
      <div><p class="section-eyebrow">{ui.visitEyebrow}</p><h2 id="visit-title">{local(theme.location)}</h2></div>
      <dl><div><dt>{ui.hours}</dt><dd>{local(web.hours)}</dd></div><div><dt>{ui.location}</dt><dd>{local(web.address)}</dd></div></dl>
    </section>

    <section id="reservar" class="restaurant-booking" aria-labelledby="booking-title">
      <div class="booking-title"><p>{ui.bookingEyebrow}</p><h2 id="booking-title">{ui.bookingTitle}</h2></div>
      <div class="booking-explainer"><p>{ui.bookingBody}</p><div><a href={themeContactUrl(theme.slug as ThemeSlug, locale)}>{ui.discuss}<span aria-hidden="true">↗</span></a><a href={`${prefix}/temas/`}>{ui.allThemes}</a></div></div>
    </section>
  </main>

  <footer class="restaurant-footer"><a href={`${prefix}/temas/`} aria-label={ui.backLabel}>Logic Reserva</a><span>{ui.powered}</span><span>© 2026</span></footer>
</div>

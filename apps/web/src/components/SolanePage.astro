---
import type { Locale } from '@logic-reserva/config';
import BrandHero from './BrandHero.astro';
import SolaneBookingWidget from '../islands/SolaneBookingWidget';
import { DEMO_COPY, DEMO_FIXTURES, SOLANE_PAGE_COPY, localized } from '../data';
import '../styles/booking-widget.css';

interface Props { locale?: Locale }
const { locale = 'es' } = Astro.props;
const fixture = DEMO_FIXTURES.solane;
const shared = DEMO_COPY.solane;
const copy = SOLANE_PAGE_COPY;
const prefix = locale === 'en' ? '/en' : '';
const languageHref = locale === 'en' ? '/demos/solane/' : '/en/demos/solane/';
const price = new Intl.NumberFormat(locale, { style: 'currency', currency: 'EUR', maximumFractionDigits: 0 });
---

<header class="solane-header"><div class="shell"><a class="solane-lockup" href={`${prefix}/demos/solane/`}><span>S</span><b>Solane</b></a><nav>{shared.nav.map((item) => <a href={item.href}>{localized(item.label, locale)}</a>)}</nav><div><a class="solane-language" href={languageHref}>{localized(copy.header.language, locale)}</a><a class="brand-button ghost" href={`${prefix}/demos/solane/bonos/`}>{localized(copy.header.vouchers, locale)}</a><a class="brand-button ghost" href={`${prefix}/demos/solane/eventos/`}>{localized(copy.header.events, locale)}</a><a class="brand-button ghost" href={`${prefix}/demos/solane/gestion/`}>{localized(copy.header.manager, locale)}</a><a class="brand-button" href="#reserva">{localized(shared.hero.primaryAction, locale)}</a></div></div></header>
<main id="contenido" tabindex="-1">
  <BrandHero slug="solane" locale={locale} />
  <section id="experiencia" class="solane-section shell" aria-labelledby="solane-experience-title"><div class="solane-intro"><p class="brand-hero__eyebrow">{localized(copy.intro.eyebrow, locale)}</p><h2 id="solane-experience-title">{localized(copy.intro.title, locale)}</h2><p>{localized(copy.intro.body, locale)}</p></div><div class="solane-menu-grid">{copy.intro.menus.map((item, index) => { const menu = fixture.restaurant.menus.find((candidate) => candidate.id === item.id); return <article><span>0{index + 1}</span><h3>{localized(item.label, locale)}</h3><p>{localized(item.description, locale)}</p><div><strong>{menu ? price.format(menu.pricePerPersonCents / 100) : ''}</strong><small>{localized(copy.intro.perPerson, locale)}</small></div></article>; })}</div></section>
  <section id="eventos" class="solane-events-band"><div class="shell"><div><p class="brand-hero__eyebrow">{localized(copy.eventTeaser.eyebrow, locale)}</p><h2>{localized(copy.eventTeaser.title, locale)}</h2></div><div><p>{localized(copy.eventTeaser.body, locale)}</p><div class="solane-events-actions"><a class="brand-button" href={`${prefix}/demos/solane/eventos/`}>{localized(copy.eventTeaser.action, locale)}</a><a href={`${prefix}/demos/solane/bonos/`}>{localized(copy.eventTeaser.voucherAction, locale)}</a></div></div></div></section>
  <section id="reserva" class="solane-section shell solane-booking" aria-labelledby="solane-booking-title"><div class="solane-booking-copy"><p class="brand-hero__eyebrow">{localized(copy.widget.eyebrow, locale)}</p><h2 id="solane-booking-title">{localized(copy.widget.title, locale)}</h2><p>{localized(copy.widget.body, locale)}</p></div><SolaneBookingWidget restaurant={fixture.restaurant} initialBookings={fixture.bookings} initialEvents={fixture.events} initialPrivateHires={fixture.privateHires} locale={locale} client:load /></section>
  <section id="privado" class="solane-private"><div class="shell"><p class="brand-hero__eyebrow">{localized(copy.private.eyebrow, locale)}</p><h2>{localized(copy.private.title, locale)}</h2><p>{localized(copy.private.body, locale)}</p></div></section>
</main>
<footer class="solane-footer"><div class="shell"><div><a class="solane-lockup" href={`${prefix}/demos/solane/`}><span>S</span><b>Solane</b></a><p>{localized(copy.footer.level, locale)}</p></div><a href={`${prefix}/`}>{localized(copy.footer.back, locale)}</a></div></footer>

<style>
  .solane-header { position: sticky; z-index: 30; top: 0; height: 66px; border-bottom: 1px solid var(--brand-line); background: rgb(244 245 248 / 94%); backdrop-filter: blur(12px); }.solane-header .shell, .solane-footer .shell { display: flex; height: 100%; align-items: center; justify-content: space-between; gap: 18px; }.solane-lockup { display: inline-flex; min-height: 44px; align-items: center; gap: 10px; text-decoration: none; }.solane-lockup span { display: grid; width: 34px; height: 34px; place-items: center; border: 1px solid var(--brand-accent); border-radius: 50%; color: var(--brand-strong); background: var(--brand-accent); font-family: var(--serif); font-weight: 750; }.solane-header nav { display: flex; gap: 2px; }.solane-header nav a, .solane-language { display: inline-flex; min-width: 44px; min-height: 44px; align-items: center; justify-content: center; border-radius: 8px; padding: 9px 10px; color: var(--brand-muted); font-size: .78rem; font-weight: 600; text-decoration: none; }.solane-header nav a:hover, .solane-language:hover { color: var(--brand-ink); background: var(--brand-soft); }.solane-header .shell > div { display: flex; align-items: center; gap: 5px; }.solane-header .brand-button { min-height: 44px; padding: 6px 12px; }
  .solane-section { padding-block: clamp(85px, 11vw, 150px); }.solane-intro { display: grid; grid-template-columns: 1.2fr .8fr; align-items: end; gap: 50px; }.solane-intro h2, .solane-booking-copy h2, .solane-events-band h2, .solane-private h2 { margin: 0; font-family: var(--serif); font-size: clamp(3.2rem, 6vw, 6rem); font-weight: 480; letter-spacing: -.055em; line-height: .93; text-wrap: balance; }.solane-intro > p:last-child, .solane-booking-copy > p:last-child { margin: 0; color: var(--brand-muted); font-family: var(--serif); font-size: 1.08rem; line-height: 1.6; }
  .solane-menu-grid { display: grid; grid-template-columns: repeat(2, 1fr); gap: 12px; margin-top: 60px; }.solane-menu-grid article { position: relative; min-height: 350px; overflow: hidden; border: 1px solid var(--brand-line); border-radius: 12px; padding: 26px; background: var(--brand-card); }.solane-menu-grid article:last-child { color: white; background: var(--brand-strong); }.solane-menu-grid > article > span { color: var(--brand-strong); font-size: .69rem; }.solane-menu-grid > article:last-child > span { color: var(--brand-accent); }.solane-menu-grid h3 { max-width: 11ch; margin: 90px 0 14px; font-family: var(--serif); font-size: 2.2rem; font-weight: 500; }.solane-menu-grid p { max-width: 40ch; color: var(--brand-muted); font-family: var(--serif); line-height: 1.55; }.solane-menu-grid article:last-child p { color: rgb(255 255 255 / 62%); }.solane-menu-grid article > div { position: absolute; right: 26px; bottom: 25px; left: 26px; display: flex; align-items: baseline; justify-content: space-between; }.solane-menu-grid strong { font-size: 1.7rem; }.solane-menu-grid small { opacity: .55; }
  .solane-events-band { padding-block: clamp(80px, 10vw, 130px); color: white; background: var(--brand-strong); }.solane-events-band .shell { display: grid; grid-template-columns: 1.1fr .9fr; align-items: end; gap: 70px; }.solane-events-band .brand-hero__eyebrow { color: var(--brand-accent); }.solane-events-band p { max-width: 52ch; color: rgb(255 255 255 / 64%); font-family: var(--serif); font-size: 1.08rem; line-height: 1.6; }.solane-events-band .brand-button { margin-top: 18px; border-color: var(--brand-accent); color: var(--brand-strong); background: var(--brand-accent); }
  .solane-events-actions { display: flex; flex-wrap: wrap; align-items: center; gap: 12px; }.solane-events-actions > a:not(.brand-button) { display: inline-flex; min-height: 44px; align-items: center; color: white; font-size: .86rem; font-weight: 650; }
  .solane-booking { display: grid; grid-template-columns: .8fr 1.2fr; align-items: start; gap: clamp(45px, 8vw, 110px); }.solane-booking-copy { position: sticky; top: 105px; }.sw-widget .vw-button, .solane .vw-success__mark { background: var(--brand-strong); }.sw-widget .vw-times button:hover, .sw-widget .vw-times button.selected { border-color: var(--brand-accent); color: var(--brand-strong); background: var(--brand-accent); }
  .solane-private { padding-block: clamp(95px, 13vw, 170px); background: var(--brand-soft); }.solane-private .shell { max-width: 1000px; text-align: center; }.solane-private h2 { margin-inline: auto; }.solane-private > div > p:last-child { max-width: 62ch; margin: 26px auto 0; color: var(--brand-muted); font-family: var(--serif); font-size: 1.1rem; line-height: 1.6; }
  .solane-footer { padding-block: 50px; border-top: 1px solid var(--brand-line); background: var(--brand-card); }.solane-footer .shell { align-items: flex-start; }.solane-footer p, .solane-footer > div > a { color: var(--brand-muted); font-size: .8rem; }.solane-footer > div > a { display: inline-flex; min-height: 44px; align-items: center; text-decoration: none; }
  @media (max-width: 1080px) { .solane-header nav, .solane-language { display: none; } }
  @media (max-width: 820px) { .solane-intro, .solane-events-band .shell, .solane-booking { grid-template-columns: 1fr; }.solane-intro > p:last-child { margin-top: 22px; }.solane-booking-copy { position: static; } }
  @media (max-width: 620px) { .solane-header .shell { width: min(100% - 24px, var(--page-max-width)); }.solane-header .brand-button.ghost, .solane-header .solane-language { display: none; }.solane-header .brand-button { padding-inline: 10px; }.solane-menu-grid { grid-template-columns: 1fr; }.solane-menu-grid article { min-height: 300px; }.solane-footer .shell { align-items: flex-start; flex-direction: column; } }
</style>

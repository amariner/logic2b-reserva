---
import type { Locale } from '@logic-reserva/config';
import BookingWidget from '../islands/BookingWidget';
import BrandHero from './BrandHero.astro';
import { DEMO_COPY, DEMO_FIXTURES, VEDRA_PAGE_COPY, localized } from '../data';
import '../styles/booking-widget.css';

interface Props { locale?: Locale }
const { locale = 'es' } = Astro.props;
const fixture = DEMO_FIXTURES.vedra;
const shared = DEMO_COPY.vedra;
const copy = VEDRA_PAGE_COPY;
const prefix = locale === 'en' ? '/en' : '';
const languageHref = locale === 'en' ? '/demos/vedra/' : '/en/demos/vedra/';
const price = new Intl.NumberFormat(locale, { style: 'currency', currency: 'EUR', maximumFractionDigits: 0 });
const tablesLabel = locale === 'en' ? 'tables' : 'mesas';
---

<header class="vedra-header"><div class="shell"><a class="vedra-lockup" href={`${prefix}/demos/vedra/`}><span>V</span><b>Vedra</b></a><nav>{shared.nav.map((item) => <a href={item.href}>{localized(item.label, locale)}</a>)}</nav><div><a class="vedra-language" href={languageHref}>{localized(copy.header.language, locale)}</a><a class="brand-button ghost" href={`${prefix}/demos/vedra/gestion/`}>{localized(copy.header.manager, locale)}</a><a class="brand-button" href="#reserva">{localized(shared.hero.primaryAction, locale)}</a></div></div></header>
<main>
  <BrandHero slug="vedra" locale={locale} />
  <section id="espacios" class="vedra-section shell" aria-labelledby="spaces-title"><div class="vedra-intro"><p class="brand-hero__eyebrow">{localized(copy.intro.eyebrow, locale)}</p><h2 id="spaces-title">{localized(copy.intro.title, locale)}</h2><p>{localized(copy.intro.body, locale)}</p></div><div class="space-grid">{copy.intro.spaces.map((space, index) => <article><span>0{index + 1}</span><h3>{localized(space.label, locale)}</h3><p>{localized(space.description, locale)}</p><small>{fixture.restaurant.spaces.find((candidate) => candidate.id === space.id)?.tables.length} {tablesLabel}</small></article>)}</div></section>
  <section id="menus" class="vedra-section menu-band" aria-labelledby="vedra-menus-title"><div class="shell"><div class="vedra-intro"><p class="brand-hero__eyebrow">{localized(copy.menus.eyebrow, locale)}</p><h2 id="vedra-menus-title">{localized(copy.menus.title, locale)}</h2></div><div class="vedra-menu-grid">{copy.menus.items.map((item) => { const menu = fixture.restaurant.menus.find((candidate) => candidate.id === item.id); return <article><h3>{localized(item.label, locale)}</h3><p>{localized(item.description, locale)}</p><strong>{menu ? price.format(menu.pricePerPersonCents / 100) : ''}</strong><small>{localized(copy.menus.perPerson, locale)}</small></article>; })}</div></div></section>
  <section id="reserva" class="vedra-section shell booking-section" aria-labelledby="booking-title"><div class="booking-copy"><p class="brand-hero__eyebrow">{localized(copy.widget.eyebrow, locale)}</p><h2 id="booking-title">{localized(copy.widget.title, locale)}</h2><p>{localized(copy.widget.body, locale)}</p></div><BookingWidget restaurant={fixture.restaurant} initialBookings={fixture.bookings} locale={locale} client:load /></section>
</main>
<footer class="vedra-footer" id="grupos"><div class="shell"><div><a class="vedra-lockup" href={`${prefix}/demos/vedra/`}><span>V</span><b>Vedra</b></a><p>{localized(copy.footer.level, locale)}</p></div><a href={`${prefix}/`}>{localized(copy.footer.back, locale)}</a></div></footer>

<style>
  .vedra-header { position: sticky; z-index: 30; top: 0; height: 66px; border-bottom: 1px solid var(--brand-line); background: rgb(246 247 238 / 94%); backdrop-filter: blur(12px); }.vedra-header .shell, .vedra-footer .shell { display: flex; height: 100%; align-items: center; justify-content: space-between; gap: 20px; }.vedra-lockup { display: inline-flex; align-items: center; gap: 10px; text-decoration: none; }.vedra-lockup span { display: grid; width: 34px; height: 34px; place-items: center; border: 2px solid var(--brand); border-radius: 50%; background: white; font-weight: 750; }.vedra-header nav { display: flex; gap: 3px; }.vedra-header nav a, .vedra-language { border-radius: 8px; padding: 9px 11px; color: var(--brand-muted); font-size: .8rem; font-weight: 600; text-decoration: none; }.vedra-header nav a:hover, .vedra-language:hover { color: var(--brand-ink); background: var(--brand-soft); }.vedra-header .shell > div { display: flex; align-items: center; gap: 6px; }.vedra-header .brand-button { min-height: 40px; padding-block: 6px; }
  .vedra-section { padding-block: clamp(80px, 11vw, 144px); }.vedra-intro { max-width: 850px; }.vedra-intro h2, .booking-copy h2 { margin: 0; font-size: clamp(3rem, 6vw, 5.7rem); letter-spacing: -.058em; line-height: .94; text-wrap: balance; }.vedra-intro > p:last-child, .booking-copy > p:last-child { max-width: 62ch; margin: 24px 0 0; color: var(--brand-muted); font-family: var(--serif); font-size: 1.12rem; line-height: 1.6; }.space-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 12px; margin-top: 56px; }.space-grid article { min-height: 290px; border-radius: 12px; padding: 24px; background: var(--brand-soft); }.space-grid article:nth-child(2) { background: #cbd4ac; }.space-grid article:nth-child(3) { color: white; background: var(--brand-strong); }.space-grid span { font-size: .72rem; opacity: .55; }.space-grid h3 { margin: 85px 0 12px; font-size: 1.7rem; }.space-grid p { min-height: 48px; line-height: 1.45; }.space-grid small { opacity: .6; }
  .menu-band { background: var(--brand-strong); color: white; }.menu-band .brand-hero__eyebrow { color: #cbd4ac; }.vedra-menu-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 12px; margin-top: 56px; }.vedra-menu-grid article { position: relative; min-height: 300px; border: 1px solid rgb(255 255 255 / 16%); border-radius: 12px; padding: 24px; }.vedra-menu-grid h3 { max-width: 12ch; margin: 0; font-size: 1.8rem; }.vedra-menu-grid p { color: rgb(255 255 255 / 65%); font-family: var(--serif); line-height: 1.5; }.vedra-menu-grid strong { position: absolute; bottom: 40px; left: 24px; font-size: 2.1rem; }.vedra-menu-grid small { position: absolute; bottom: 20px; left: 24px; color: rgb(255 255 255 / 52%); }
  .booking-section { display: grid; grid-template-columns: .78fr 1.22fr; align-items: start; gap: clamp(45px, 8vw, 110px); }.booking-copy { position: sticky; top: 106px; }.vedra-footer { padding-block: 50px; border-top: 1px solid var(--brand-line); background: var(--brand-card); }.vedra-footer .shell { align-items: flex-start; }.vedra-footer p, .vedra-footer > div > a { color: var(--brand-muted); font-size: .8rem; }.vedra-footer > div > a { text-decoration: none; }
  @media (max-width: 940px) { .vedra-header nav, .vedra-language { display: none; }.space-grid, .vedra-menu-grid { grid-template-columns: 1fr; }.space-grid article, .vedra-menu-grid article { min-height: 230px; }.space-grid h3 { margin-top: 55px; }.booking-section { grid-template-columns: 1fr; }.booking-copy { position: static; } }
  @media (max-width: 620px) { .vedra-header .shell { width: min(100% - 24px, var(--page-max-width)); }.vedra-header .brand-button.ghost { display: none; }.vedra-footer .shell { align-items: flex-start; flex-direction: column; } }
</style>

---
import type { Locale } from '@logic-reserva/config';
import GiftVouchers from '../islands/GiftVouchers';
import { DEMO_FIXTURES, SOLANE_PAGE_COPY, localized } from '../data';
import '../styles/gift-vouchers.css';

interface Props { locale?: Locale }
const { locale = 'es' } = Astro.props;
const fixture = DEMO_FIXTURES.solane;
const copy = SOLANE_PAGE_COPY.vouchers;
const prefix = locale === 'en' ? '/en' : '';
const languageHref = locale === 'en' ? '/demos/solane/bonos/' : '/en/demos/solane/bonos/';
const languageLabel = locale === 'en' ? 'Español' : 'English';
---

<header class="vouchers-header"><div class="shell"><a class="vouchers-lockup" href={`${prefix}/demos/solane/`}><span>S</span><b>Solane</b></a><nav><a href={`${prefix}/demos/solane/`}>{localized(copy.back, locale)}</a><a href={languageHref}>{languageLabel}</a><a class="brand-button" href={`${prefix}/demos/solane/gestion/?vista=bonos`}>{localized(copy.manager, locale)}</a></nav></div></header>
<main id="contenido" class="vouchers-main shell" tabindex="-1"><header><p class="brand-hero__eyebrow">{localized(copy.eyebrow, locale)}</p><h1>{localized(copy.title, locale)}</h1><p>{localized(copy.body, locale)}</p></header><GiftVouchers restaurant={fixture.restaurant} initialBookings={fixture.bookings} initialEvents={fixture.events} initialPrivateHires={fixture.privateHires} locale={locale} client:load /></main>

<style>
  .vouchers-header { height: 66px; border-bottom: 1px solid var(--brand-line); background: var(--brand-card); }.vouchers-header .shell { display: flex; height: 100%; align-items: center; justify-content: space-between; gap: 20px; }.vouchers-lockup { display: inline-flex; min-height: 44px; align-items: center; gap: 10px; text-decoration: none; }.vouchers-lockup span { display: grid; width: 34px; height: 34px; place-items: center; border: 1px solid var(--brand-accent); border-radius: 50%; color: var(--brand-strong); background: var(--brand-accent); font-weight: 750; }.vouchers-header nav { display: flex; align-items: center; gap: 8px; }.vouchers-header nav > a:not(.brand-button) { display: inline-flex; min-width: 44px; min-height: 44px; align-items: center; justify-content: center; padding: 8px; color: var(--brand-muted); font-size: .78rem; text-decoration: none; }
  .vouchers-main { padding-block: clamp(70px, 9vw, 120px); }.vouchers-main > header { max-width: 950px; margin-bottom: 55px; }.vouchers-main h1 { margin: 0; font-family: var(--serif); font-size: clamp(3.4rem, 8vw, 7rem); font-weight: 480; letter-spacing: -.06em; line-height: .91; }.vouchers-main > header > p:last-child { max-width: 68ch; margin: 25px 0 0; color: var(--brand-muted); font-family: var(--serif); font-size: 1.1rem; line-height: 1.6; }
  @media (max-width: 560px) { .vouchers-header nav > a:nth-child(2) { display: none; }.vouchers-header .brand-button { min-height: 44px; padding-inline: 10px; }.vouchers-main { padding-top: 55px; } }
</style>

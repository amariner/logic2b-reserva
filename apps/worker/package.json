{
  "name": "@logic-reserva/worker",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsc --noEmit && node scripts/compose.mjs",
    "dev": "pnpm build && wrangler dev --config wrangler.jsonc",
    "deploy": "pnpm run deploy:production",
    "deploy:production": "pnpm build && wrangler deploy --config wrangler.jsonc --env=\"\" --strict",
    "deploy:production:dry-run": "pnpm build && wrangler deploy --config wrangler.jsonc --env=\"\" --strict --dry-run",
    "deploy:preview": "pnpm build && wrangler deploy --config wrangler.jsonc --env preview --strict",
    "deploy:preview:dry-run": "pnpm build && wrangler deploy --config wrangler.jsonc --env preview --strict --dry-run",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src scripts --no-error-on-unmatched-pattern",
    "test": "vitest run --passWithNoTests && node scripts/verify-deploy-config.mjs && node scripts/verify-demo-boundaries.mjs"
  },
  "dependencies": {
    "@logic-reserva/domain": "workspace:*",
    "@logic-reserva/site": "workspace:*",
    "@logic-reserva/web": "workspace:*",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20250705.0",
    "typescript": "^5.8.0",
    "vitest": "^3.2.7",
    "wrangler": "^4.111.0"
  }
}
